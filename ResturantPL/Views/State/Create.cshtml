@model State

@{
    ViewData["Title"] = "Create";
}

<div class="container">
    <h1>اضافة</h1>
    <h4>حالة المبلغ</h4>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method="post">

                @*For Server Side Validation Data Annotation*@
                <div asp-validation-summary="ModelOnly" class="text-danger"> </div>





                <div class="form-group">
                    <label asp-for="StateName"></label>
                    <input asp-for="StateName" class="form-control" />
                    @*For Server Side Validation Data Annotation*@
                    <span asp-validation-for="StateName" class="text-danger"></span>
                </div>
            

                <br />
                <div class="form-group">
                    <input type="submit" value="اضافة" class="btn btn-success" />
                </div>
            </form>

        </div>
    </div>


    <br />
    <div>
        <a asp-action="Index">عودة لقائمة حالة المبلغ</a>
    </div>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}