@model IEnumerable<kitchen>
<h1 class="text-center">المطابخ</h1>
<hr />
<p>
    <a asp-action="Create">اضافة مطبخ جديد</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                اسم المطبخ
            </th>
            <th>
                عدد الاقسام
            </th>


            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                </td>
                <td>
                    @(item.MenuSections != null ? item.MenuSections.Count() : 0)
                </td>
                <td>
                    <a style="color: white;
                        font-size: large;
                        font-weight: bold;" asp-action="Create" asp-route-id="@item.Id" class="btn btn-light-primary btn-sm">تعديل</a>
                    <a id="btn-delete" style="color: red;
                        font-size: large;
                        font-weight: bold;" onclick="DeleteKitchen(@item.Id)" class="btn btn-light-danger btn-sm">
                        حذف
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>
<script src="~/lib/sweetalert/sweetalert.min.js"></script>
@if (TempData["success"] != null)
{
    <script>
        swal("Good job!", "", "success");

    </script>
}
@if (TempData["faild"] != null)
{
    <script>
        swal("Faild!", "", "error");

    </script>

}


