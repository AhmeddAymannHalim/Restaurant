@model RoleViewModel
@{
    ViewData["Title"] = "Update";
}





<h1 class="text-center">تعديل الفئة</h1>
<hr />


<form asp-action="Update" class=" row col-md-4">
    <div class="form-group">
        <label asp-for="@Model.RoleName" class="col-form-label">اسم الفئة</label>
        <input asp-for="@Model.RoleName" class="form-control" />
        <span asp-validation-for="@Model.RoleName" class="text-danger"></span>

    </div>


    <div class="form-group mt-3">
        <input type="submit" value="تعديل" class="btn btn-success" /> |
        <a asp-action="Roles" >عودة للفئات</a>
    </div>


</form>

