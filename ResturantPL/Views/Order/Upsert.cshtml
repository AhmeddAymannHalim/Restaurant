@model OrderViewModel
@{
    ViewBag.Title = L["Cashier"].Value;
    var isArabic = LanguageHelper.IsArabic();
    var invariant = CultureInfo.InvariantCulture;
    var sections = Model.Menu.GroupBy(a => a.SectionId).Select(g => g.First()).ToList();
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-cash-register" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title <small>@Model.OrderCode</small></h1>
    </div>
    <div class="ad-card-body">
        <form id="orderForm" asp-action="Upsert" method="post" class="pos">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" id="cash" name="Cash" value="false" />
            <input type="hidden" id="onAccount" name="OnAccount" value="false" />

            <section class="pos-menu" aria-label="@L["MenuItems"]">
                <div class="pos-sections">
                    <button type="button" class="pos-section is-active" data-section="">@L["AllTypes"]</button>
                    @foreach (var sec in sections)
                    {
                        <button type="button" class="pos-section" data-section="@sec.SectionId">@(isArabic ? sec.SectionArName : sec.SectionEnName)</button>
                    }
                </div>
                <div class="pos-items">
                    @foreach (var item in Model.Menu)
                    {
                        <button type="button" class="pos-item @(item.IsAvailable ? "" : "is-unavailable")" data-id="@item.Id" data-section="@item.SectionId" data-price="@item.Price.ToString(invariant)" data-name="@(isArabic ? item.ArName : item.EnName)" disabled="@(item.IsAvailable ? null : "disabled")" title="@(item.IsAvailable ? (isArabic ? item.ArIngredients : item.EnIngredients) : L["MenuItemNotAvailable"].Value)">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" loading="lazy" />
                            }
                            <span>@(isArabic ? item.ArName : item.EnName)</span>
                            @if (!string.IsNullOrWhiteSpace(isArabic ? item.ArIngredients : item.EnIngredients))
                            {
                                <small class="pos-item-ing">@(isArabic ? item.ArIngredients : item.EnIngredients)</small>
                            }
                            <b>@item.Price.ToString("N2")</b>
                            <em class="pos-stock" data-left="@item.Available" title="@L["InStock"]"><i class="fas fa-boxes-stacked" aria-hidden="true"></i> <span></span></em>
                        </button>
                    }
                </div>
            </section>

            <section class="pos-cart">
                <div class="ad-form pos-fields">
                    <div class="form-group">
                        <label class="control-label" for="orderType">@L["OrderType"]</label>
                        <select id="orderType" name="Type" class="form-select">
                            <option value="Hall" selected="@(Model.Type == OrderType.Hall)">@L["Hall"]</option>
                            <option value="TakeAway" selected="@(Model.Type == OrderType.TakeAway)">@L["TakeAway"]</option>
                            <option value="Delivery" selected="@(Model.Type == OrderType.Delivery)">@L["Delivery"]</option>
                        </select>
                        
                    </div>
                    <div class="form-group" data-for="Hall">
                        <label class="control-label" for="TableId">@L["Table"]</label>
                        <select id="TableId" name="TableId" class="form-select">
                            <option value="">@L["Select"]</option>
                            @foreach (var item in Model.Tables)
                            {
                                <option value="@item.Id" selected="@(Model.TableId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="CustomerId">@L["Customer"]</label>
                        <select id="CustomerId" name="CustomerId" class="form-select">
                            <option value="">@L["Select"]</option>
                            @foreach (var item in Model.Customers)
                            {
                                <option value="@item.Id" selected="@(Model.CustomerId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="CustomerName">@L["CustomerName"]</label>
                        <input id="CustomerName" name="CustomerName" value="@Model.CustomerName" class="form-control" maxlength="100" />
                    </div>
                    <div class="form-group" data-for="Delivery Delivery_Online">
                        <label class="control-label" for="EmployeeId">@L["DeliveryDriver"]</label>
                        <select id="EmployeeId" name="EmployeeId" class="form-select">
                            <option value="">@L["Select"]</option>
                            @foreach (var item in Model.DeliveryDrivers)
                            {
                                <option value="@item.Id" selected="@(Model.EmployeeId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group" data-for="Delivery Delivery_Online">
                        <label class="control-label" for="DeliveryZoneId">@L["DeliveryZone"]</label>
                        <select id="DeliveryZoneId" name="DeliveryZoneId" class="form-select">
                            <option value="" data-fee="0">@L["Select"]</option>
                            @foreach (var zone in Model.DeliveryZones)
                            {
                                <option value="@zone.Id" data-fee="@zone.Fee.ToString(invariant)" selected="@(Model.DeliveryZoneId == zone.Id)">@(isArabic ? zone.ArName : zone.EnName) - @zone.Fee.ToString("N2")</option>
                            }
                        </select>
                        
                    </div>
                    <div class="form-group" data-for="Delivery Delivery_Online">
                        <label class="control-label" for="Address">@L["Address"]</label>
                        <input id="Address" name="Address" value="@Model.Address" class="form-control" maxlength="250" />
                    </div>
                    <div class="form-group" data-for="Delivery Delivery_Online">
                        <label class="control-label" for="PhoneNumber">@L["PhoneNumber"]</label>
                        <input id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" maxlength="11" />
                    </div>
                </div>

                <div class="ad-table-wrap">
                    <table id="cartTable" class="ad-table">
                        <thead>
                            <tr>
                                <th>@L["Product"]</th>
                                <th>@L["Quantity"]</th>
                                <th>@L["Price"]</th>
                                <th>@L["LineTotal"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr data-id="@item.MenuItemId" data-price="@item.PriceForUnit.ToString(invariant)" data-qty="@item.Quantity.ToString(invariant)" data-name="@(isArabic ? item.MenuItemArName : item.MenuItemEnName)"></tr>
                            }
                        </tbody>
                    </table>
                    <p id="cartEmpty" class="ad-empty">@L["EmptyCart"]</p>
                </div>

                <div class="pos-totals">
                    <div><span>@L["SubTotal"]</span><b id="subTotal">0.00</b></div>
                    <div><span>@L["Tax"] (@Model.TaxPercent.ToString("0.##", invariant)%)</span><b id="tax">0.00</b></div>
                    <div><span>@L["Service"]</span><b id="service">0.00</b></div>
                    <div id="deliveryRow"><span>@L["DeliveryFee"]</span><b id="deliveryFee">0.00</b></div>
                    <div class="pos-discount">
                        <span>@L["DiscountPercent"]</span>
                        <input id="discountPercent" type="number" step="0.01" min="0" max="100" value="0" class="form-control" aria-label="@L["DiscountPercent"]" placeholder="%" />
                        <input id="discount" name="Discount" type="hidden" value="@Model.Discount.ToString(invariant)" />
                    </div>
                    <div id="discountRow" class="pos-saved" hidden><span>@L["Discount"]</span><b id="discountShown">0.00</b></div>
                    <div class="pos-total"><span>@L["TotalPrice"]</span><b id="total">0.00</b></div>
                </div>

                <div class="ad-form-actions">
                    <input type="hidden" id="paymentMethod" name="PaymentMethod" value="Cash" />
                    <button type="button" id="payNow" class="btn-ad btn-ad-primary"><i class="fas fa-money-bill-wave" aria-hidden="true"></i> @L["PayOrder"]</button>
                    <button type="submit" id="payLater" class="btn-ad btn-ad-ghost"><i class="fas fa-clock" aria-hidden="true"></i> @L["SaveUnpaid"]</button>
                    <button type="submit" id="payOnAccount" class="btn-ad btn-ad-ghost" hidden><i class="fas fa-user-tag" aria-hidden="true"></i> @L["ChargeToAccount"]</button>
                    <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
                </div>
            </section>
        </form>
    </div>
</div>

<partial name="_PayDrawer" />

@section Styles {
    <link rel="stylesheet" href="~/css/pay-drawer.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pos-stock.js" asp-append-version="true"></script>
    <script>
/* POS payment drawer.
   Cash and wallets: confirm the amount. Visa: a card form with a short "processing" step.
   This is a front-end flow only: card details stay in these inputs, are never submitted,
   and are cleared as soon as the order is sent. The server only receives the payment method. */
(function ($) {
    'use strict';

    var $drawer = $('#payDrawer');
    if (!$drawer.length) { return; }

    var $form = $('#orderForm');
    var $stage = $drawer.find('.pay-stage');
    var names = $drawer.data('names') || {};
    var currency = $drawer.data('currency');
    var method = 'Cash';
    var busy = false;
    var holderText = $drawer.find('.pay-card-name').text();
    var approvedText = $drawer.find('.pay-done-msg').text();
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var receiptWindow = null;
    var dashboardUrl = $drawer.data('dashboardUrl');

    function wait(ms) { return $.Deferred(function (d) { setTimeout(d.resolve, reduce ? Math.min(ms, 120) : ms); }).promise(); }
    function amount() { return $('#total').text(); }
    function fill(text, values) {
        return text.replace('{0}', values[0]).replace('{1}', values[1] || '');
    }

    function quickMessage() {
        var sum = amount() + ' ' + currency;
        return method === 'Cash'
            ? fill($drawer.data('msg-cash'), [sum])
            : fill($drawer.data('msg-via'), [sum, names[method]]);
    }

    // Slide the current pane up, then slide the next one down; the stage height follows the content.
    function show(pane, prepare) {
        var $cur = $stage.children('.pay-pane:not([hidden])');
        var $next = $stage.children('[data-pane="' + pane + '"]');
        var from = $stage.outerHeight();
        $stage.css('height', from);
        $cur.addClass('is-leaving');

        wait(170).then(function () {
            $cur.prop('hidden', true).removeClass('is-leaving');
            if (prepare) { prepare(); }
            $next.prop('hidden', false).addClass('is-entering');
            $stage.css('height', $next.outerHeight(true));
            wait(320).then(function () {
                $next.removeClass('is-entering');
                $stage.css('height', '');
            });
        });
    }

    function setMethod(next) {
        if (busy || next === method) { return; }
        method = next;
        $drawer.find('.pay-chip').each(function () {
            var on = $(this).data('method') === method;
            $(this).toggleClass('is-on', on).attr('aria-checked', on);
        });
        $('#paymentMethod').val(method);

        if (method === 'Visa') {
            show('card', function () { $drawer.find('.pay-error').text(''); });
            wait(520).then(function () { $('#cardName').trigger('focus'); });
        } else {
            show('quick', function () {
                $drawer.find('.pay-msg').text(quickMessage());
                $drawer.find('.pay-badge i').attr('class', 'fas ' + $drawer.find('.pay-chip.is-on i').attr('class').split(' ')[1]);
            });
        }
    }

    function open() {
        if (!$form[0].reportValidity()) { return; }
        if ($('#cartTable tbody tr').length === 0) {
            if (window.toastr) { toastr.error($('#cartEmpty').text()); }
            return;
        }

        method = 'Cash';
        $('#paymentMethod').val(method);
        $drawer.find('.pay-chip').removeClass('is-on').attr('aria-checked', false)
            .filter('[data-method="Cash"]').addClass('is-on').attr('aria-checked', true);
        $stage.children('.pay-pane').prop('hidden', true);
        $stage.children('[data-pane="quick"]').prop('hidden', false);
        $drawer.find('.pay-amount').text(amount() + ' ' + currency);
        $drawer.find('.pay-msg').text(quickMessage());
        $drawer.find('.pay-badge i').attr('class', 'fas fa-money-bill-wave');
        $drawer.removeClass('is-busy is-closing').prop('hidden', false);
        wait(50).then(function () { $drawer.find('.pay-confirm').trigger('focus'); });
    }

    function close() {
        if (busy) { return; }
        $drawer.addClass('is-closing');
        wait(280).then(function () {
            $drawer.prop('hidden', true).removeClass('is-closing');
            clearCard();
        });
    }

    function clearCard() {
        $('#cardName, #cardNumber, #cardExp, #cardCvv').val('');
        $drawer.find('.pay-card-no').text('•••• •••• •••• ••••');
        $drawer.find('.pay-card-name').text(holderText);
        $drawer.find('.pay-card-exp').text('MM/YY');
    }

    // ---- card form ----
    $('#cardNumber').on('input', function () {
        var digits = this.value.replace(/\D/g, '').slice(0, 16);
        this.value = digits.replace(/(.{4})/g, '$1 ').trim();
        var padded = (digits + '•'.repeat(16)).slice(0, 16);
        $drawer.find('.pay-card-no').text(padded.replace(/(.{4})/g, '$1 ').trim());
    });
    $('#cardExp').on('input', function () {
        var d = this.value.replace(/\D/g, '').slice(0, 4);
        this.value = d.length > 2 ? d.slice(0, 2) + '/' + d.slice(2) : d;
        $drawer.find('.pay-card-exp').text(this.value || 'MM/YY');
    });
    $('#cardCvv').on('input', function () { this.value = this.value.replace(/\D/g, '').slice(0, 3); });
    $('#cardName').on('input', function () {
        $drawer.find('.pay-card-name').text(this.value || holderText);
    });

    function cardError() {
        if ($('#cardName').val().trim().length < 3) { return '#cardName'; }
        if ($('#cardNumber').val().replace(/\D/g, '').length !== 16) { return '#cardNumber'; }
        var m = /^(\d{2})\/(\d{2})$/.exec($('#cardExp').val());
        var now = new Date();
        if (!m || +m[1] < 1 || +m[1] > 12 || (2000 + +m[2]) * 12 + +m[1] < now.getFullYear() * 12 + now.getMonth() + 1) { return '#cardExp'; }
        if ($('#cardCvv').val().length !== 3) { return '#cardCvv'; }
        return null;
    }

    // ---- confirm ----
    // Fires the real order submission immediately (in parallel with the confirmation animation
    // below) so the receipt tab starts loading as soon as the network allows, instead of sitting
    // blank for the ~1.1-3.4s the animation takes before it was previously allowed to navigate.
    function submitOrder() {
        clearCard();
        $('#cash').val('true');
        $('#onAccount').val('false');
        if (window.buildOrderLineInputs) { window.buildOrderLineInputs(); }

        var form = $form[0];
        var data = new FormData(form);
        return fetch(form.action, {
            method: 'POST',
            body: data,
            credentials: 'same-origin',
            headers: { 'X-Ajax-Form': '1' }
        }).then(function (response) { return response.json(); })
            .then(function (result) {
                if (result && result.redirect) {
                    if (receiptWindow) {
                        receiptWindow.location.href = result.redirect + (result.redirect.indexOf('?') > -1 ? '&' : '?') + 'autoPrint=1';
                    }
                    return result;
                }
                // Validation failed server-side: fall back to a normal submit so errors render.
                if (receiptWindow) { receiptWindow.close(); }
                form.submit();
                return null;
            })
            .catch(function () {
                if (receiptWindow) { receiptWindow.close(); }
                form.submit();
                return null;
            });
    }

    function confirm() {
        if (busy) { return; }

        if (method === 'Visa') {
            var bad = cardError();
            if (bad) {
                $drawer.find('.pay-error').text($drawer.data('bad'));
                $(bad).trigger('focus');
                $drawer.find('.pay-pane[data-pane="card"]').removeClass('is-shaking');
                void $drawer[0].offsetWidth;
                $drawer.find('.pay-pane[data-pane="card"]').addClass('is-shaking');
                return;
            }
        }

        // Open the receipt tab now, still inside the click — browsers block window.open()
        // called later from a timer chain, which is why this used to get silently cancelled.
        receiptWindow = window.open('', 'orderReceipt');

        busy = true;
        $drawer.addClass('is-busy');

        // Kick off the order submission now, in parallel with the confirmation animation,
        // instead of waiting for the animation to finish before even sending the request.
        var orderPromise = submitOrder();

        var run = $.Deferred().resolve().promise();
        if (method === 'Visa') {
            show('busy');
            run = wait(2300);
        }

        run.then(function () {
            show('done', function () {
                $drawer.find('.pay-done-msg').text(method === 'Visa' ? approvedText : quickMessage());
            });
            return wait(1100);
        }).then(function () {
            return orderPromise;
        }).then(function (result) {
            if (!result) { return; }
            $('.ad-card').addClass('is-leaving');
            $drawer.addClass('is-closing');
            return wait(380).then(function () {
                if (dashboardUrl) { window.location.href = dashboardUrl; }
            });
        });
    }

    $drawer.find('.pay-chip').on('click', function () { setMethod($(this).data('method')); });
    $drawer.find('.pay-confirm').on('click', confirm);
    $drawer.find('.pay-cancel, .pay-x').on('click', close);
    $drawer.on('keydown', function (e) {
        if (e.key === 'Escape') { close(); }
        if (e.key === 'Enter' && $(e.target).is('input')) { e.preventDefault(); confirm(); }
    });

    $('#payNow').on('click', function (e) {
        e.preventDefault();
        open();
    });
})(jQuery);
</script>
    <script>
        $(function () {
            var taxPercent = @Model.TaxPercent.ToString(invariant);
            var defaultService = @Model.DefaultService.ToString(invariant);
            var msgPick = @Html.Raw(Json.Serialize(L["AtLeastOneItem"].Value));
            var msgInfo = @Html.Raw(Json.Serialize(L["Select"].Value));

            function number(value) { return parseFloat(value) || 0; }
            function money(value) { return (Math.round(value * 100) / 100).toFixed(2); }

            function render() {
                var body = $('#cartTable tbody');
                body.find('tr').each(function () {
                    var row = $(this);
                    var qty = number(row.data('qty'));
                    var price = number(row.data('price'));
                    row.html(
                        '<td></td>' +
                        '<td><div class="qty"><button type="button" class="minus" aria-label="-">-</button><b></b><button type="button" class="plus" aria-label="+">+</button></div></td>' +
                        '<td class="num"></td><td class="num"></td>' +
                        '<td class="ad-row-actions"><button type="button" class="btn-ad btn-ad-danger btn-icon remove"><i class="fas fa-trash" aria-hidden="true"></i></button></td>');
                    row.children().eq(0).text(row.data('name'));
                    row.find('b').text(qty);
                    row.children().eq(2).text(money(price));
                    row.children().eq(3).text(money(qty * price));
                });
                $('#cartEmpty').toggle(body.find('tr').length === 0);
                totals();
            }

            function totals() {
                var sub = 0;
                $('#cartTable tbody tr').each(function () { sub += number($(this).data('qty')) * number($(this).data('price')); });
                var tax = Math.round(sub * taxPercent) / 100;
                var service = $('#orderType').val() === 'TakeAway' ? 0 : defaultService;
                var type = $('#orderType').val();
                var isDelivery = type === 'Delivery' || type === 'Delivery_Online';
                var zone = $('#DeliveryZoneId');
                var fee = isDelivery ? number(zone.is('select') ? zone.find('option:selected').data('fee') : zone.data('fee')) : 0;
                var gross = sub + tax + service + fee;
                var discount = Math.min(number($('#discount').val()), gross);
                $('#subTotal').text(money(sub));
                $('#tax').text(money(tax));
                $('#service').text(money(service));
                $('#deliveryFee').text(money(fee));
                $('#deliveryRow').toggle(isDelivery);
                $('#discountRow').prop('hidden', discount <= 0);
                $('#discountShown').text('-' + money(discount));
                $('#total').text(money(gross - discount));
                $('#discount').data('gross', gross);
            }

            function addItem(id, name, price) {
                var row = $('#cartTable tbody tr[data-id="' + id + '"]');
                if (row.length) {
                    row.data('qty', number(row.data('qty')) + 1);
                } else {
                    $('#cartTable tbody').append($('<tr>').attr('data-id', id).data({ id: id, name: name, price: price, qty: 1 }));
                }
                render();
            }

            $('.pos-item').on('click', function () {
                var b = $(this);
                if (b.is(':disabled') || b.hasClass('is-unavailable')) {
                    return;
                }
                addItem(b.data('id'), b.data('name'), b.data('price'));
                b.removeClass('is-added');
                void b[0].offsetWidth;
                b.addClass('is-added');

                var fly = $('<span class="pos-item-fly">+1</span>');
                b.append(fly);
                setTimeout(function () { fly.remove(); }, 700);
            });

            $(document).on('click', '#cartTable .plus', function () { var r = $(this).closest('tr'); r.data('qty', number(r.data('qty')) + 1); render(); });
            $(document).on('click', '#cartTable .minus', function () {
                var r = $(this).closest('tr');
                var qty = number(r.data('qty')) - 1;
                if (qty <= 0) { r.remove(); } else { r.data('qty', qty); }
                render();
            });
            $(document).on('click', '#cartTable .remove', function () { $(this).closest('tr').remove(); render(); });

            $('.pos-section').on('click', function () {
                var id = String($(this).data('section'));
                $('.pos-section').removeClass('is-active');
                $(this).addClass('is-active');

                $('.pos-item').each(function () {
                    var item = $(this);
                    var show = id === '' || String(item.data('section')) === id;
                    if (show) {
                        item.css('display', '').removeClass('pos-item-hidden');
                    } else if (!item.hasClass('pos-item-hidden')) {
                        item.addClass('pos-item-hidden');
                        setTimeout(function () {
                            if (item.hasClass('pos-item-hidden')) { item.css('display', 'none'); }
                        }, 180);
                    }
                });
            });

            $('#discountPercent').on('input', function () {
                $('#discount').val(money(number($('#discount').data('gross')) * number($(this).val()) / 100));
                totals();
            });

            function showFields() {
                var type = $('#orderType').val();
                $('[data-for]').each(function () {
                    var on = $(this).data('for').split(' ').indexOf(type) >= 0;
                    $(this).toggle(on);
                    $(this).find('input,select').prop('disabled', !on);
                });
                $('#payLater').toggle(type === 'Hall');
                totals();
            }
            $('#orderType').on('change', showFields);
            $('#DeliveryZoneId').on('change', totals);

            $('#CustomerId').on('change', function () {
                var id = $(this).val();
                $('#payOnAccount').prop('hidden', !id);
                if (!id) { return; }
                $.get('/Order/CustomerInfo', { customerId: id }, function (c) {
                    $('#CustomerName').val(@(isArabic ? "c.arName" : "c.enName"));
                    $('#Address').val(c.address);
                    $('#PhoneNumber').val(c.phoneNumber);
                });
            });

            $('#payLater').on('click', function () {
                $('#cash').val('false');
                $('#onAccount').val('false');
            });
            $('#payOnAccount').on('click', function () {
                $('#cash').val('true');
                $('#onAccount').val('true');
            });

            // Shared by the native submit and the pay-drawer's AJAX submit (neither can rely on the
            // other to run first), so the Items[] hidden inputs always exist before the form is sent.
            window.buildOrderLineInputs = function () {
                var form = $('#orderForm');
                form.find('input.line-input').remove();
                var rows = $('#cartTable tbody tr');
                if (rows.length === 0) { return false; }
                rows.each(function (i) {
                    var row = $(this);
                    $.each({ MenuItemId: row.data('id'), Quantity: row.data('qty') }, function (name, value) {
                        $('<input type="hidden" class="line-input">').attr('name', 'Items[' + i + '].' + name).val(value).appendTo(form);
                    });
                });
                return true;
            };

            $('#orderForm').on('submit', function (e) {
                if (!window.buildOrderLineInputs()) { e.preventDefault(); toastr.error(msgPick); }
            });

            render();
            showFields();
            $('#payOnAccount').prop('hidden', !$('#CustomerId').val());
        });
    </script>
}
