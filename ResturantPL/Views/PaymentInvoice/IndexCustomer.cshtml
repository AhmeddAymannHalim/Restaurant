@model IEnumerable<Restaurant.DAL.Models.PaymentInvoiceCustomer>

@{
    ViewData["Title"] = "IndexSupplier";
}

<h1 class="text-center">فواتير سندات العملاء</h1>

<p>
    <a asp-action="InvoicePayForCustomer">اضافة سند جديد</a>
</p>
<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                اسم العميل
            <th>
                كود الفاتورة
            </th>
            <th>
                تاريخ الفاتورة
            </th>
            <th>
                البيان
            </th>
            <th>
                المدفوع
            </th>
            <th>
                المتبقي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.ArName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ProcessCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Paid)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Balance)
                </td>
                <td>
                    @Html.ActionLink("التفاصيل", "CustomerInvoiceDetails", new { id = item.Id }) |
                    @Html.ActionLink("تعديل", "CustomerInvoiceEdit", new { id = item.Id }) |
                    <a onclick="Delete('/PaymentInvoice/DeleteCustomerPayment/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>


<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>





<script src="~/lib/sweetalert/sweetalert.min.js"></script>
<script src="~/modules/deleteobjects.js"></script>

