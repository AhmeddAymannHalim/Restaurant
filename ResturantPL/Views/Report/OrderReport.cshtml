@model Restaurant.Data.Models.Order

@{
    ViewData["Title"] = "Order Report";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }

    h1 {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }

    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>




<h1>@Model.CustomerName</h1>
<hr />

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr>
            <th colspan="2">التفاصيل</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mainRow">كود الفاتورة</td>
            <td>@Model.OrderCode</td>
        </tr>
        <tr>
            <td class="mainRow">تاريخ الفاتورة</td>
            <td>@Model.OrderDate.ToString("dd-MM-yyyy  hh:mm tt")</td>
        </tr>
        <tr>
            <td class="mainRow">موظف الشيفت البائع</td>
            <td>@Model.Seller.FullName</td>
        </tr>
        @if (Model.ReceiverId != null)
        {
            <tr>
                <td class="mainRow">موظف الشيفت المستلم</td>
                <td>@Model.Receiver.FullName</td>
            </tr>
        }
        <tr>
            <td class="mainRow"> نوع الفاتورة</td>
            @if (Model.Type == OrderType.TakeAway)
            {
                <td>تيك اواي</td>
            }
            else if (Model.Type == OrderType.Hall)
            {
                <td>صالة</td>
            }
            else if (Model.Type == OrderType.Delivery)
            {
                <td>دليفري</td>
            }
            else if (Model.Type == OrderType.Delivery_Online)
            {
                <td>دليفري اونلاين</td>
            }
        </tr>
        @if (Model.Type == OrderType.Hall)
        {
            <tr>
                <td class="mainRow">اسم الطاولة</td>
                <td>@Model.Table.Name</td>
            </tr>
        }
        @if (Model.Type == OrderType.Delivery || Model.Type == OrderType.Delivery_Online)
        {
            <tr>
                <td class="mainRow">الطيار</td>
                <td>@Model.Employee.FullName</td>
            </tr>
            <tr>
                <td class="mainRow">العنوان</td>
                <td>@Model.Address</td>
            </tr>
            <tr>
                <td class="mainRow"> رقم الهاتف</td>
                <td>@Model.PhoneNumber</td>
            </tr>
            <tr>
                <td class="mainRow"> رقم الموبايل</td>
                <td>@Model.MobileNumber</td>
            </tr>
        }
        @if (Model.Service > 0)
        {
            <tr>
                <td class="mainRow">الخدمة</td>
                <td>@Model.Service</td>
            </tr>
        }
        @if (Model.Tax > 0)
        {
            <tr>
                <td class="mainRow">الضريبة</td>
                <td>@Model.Tax</td>
            </tr>
        }
        @if (Model.Discount > 0)
        {
            <tr>
                <td class="mainRow">الخصم</td>
                <td>@Model.Discount</td>
            </tr>
        }
        <tr>
            <td class="mainRow">تم الدفع</td>
            @if (Model.Cash)
            {
                <td>نعم</td>
            }
            else
            {
                <td>لا</td>
            }
        </tr>
        <tr>
            <td class="mainRow">اجمالي الفاتورة</td>
            <td>@Model.TotalPrice</td>
        </tr>
        <tr>
            <td class="mainRow">المنتجات</td>
            <td>
                <table class="mt-3 table table-bordered table-light text-dark">
                    <thead>
                        <tr>
                            <th>اسم المنتج</th>
                            <th>كمية المنتج</th>
                            <th>سعر الوحدة</th>
                            <th>الاجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderMenuItems)
                        {
                            <tr>
                                <td>@item.MenuItem.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.PriceForUnit</td>
                                <td>@item.Price</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </td>
        </tr>

    </tbody>
</table>

