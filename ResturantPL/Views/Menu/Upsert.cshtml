@model MenuItemViewModel
@{
    var isNew = Model.Id == 0;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    ViewBag.Title = isNew ? L["NewMenuItem"].Value : L["UpdateMenuItem"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-utensils" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="bo-card-body">
        <form id="menuForm" asp-action="Upsert" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Code" class="control-label">@L["Code"]</label>
                <input asp-for="Code" class="form-control" readonly />
            </div>
            <input type="hidden" asp-for="ImageUrl" />

            <section class="menu-step">
                <h2><b>1</b> @L["MenuStepDetails"]</h2>
                <div class="row">
                    <div class="form-group col-md-3">
                        <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                        <input asp-for="ArName" class="form-control" />
                        <span asp-validation-for="ArName" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                        <input asp-for="EnName" class="form-control" />
                        <span asp-validation-for="EnName" class="text-danger"></span>
                    </div>
                     <div class="form-group col-md-3">
                        <label asp-for="ArDescription" class="control-label">@L["ArabicDescription"]</label>
                        <input asp-for="ArDescription" class="form-control" />
                        <span asp-validation-for="ArDescription" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="EnDescription" class="control-label">@L["EnglishDescription"]</label>
                        <input asp-for="EnDescription" class="form-control" />
                        <span asp-validation-for="EnDescription" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="MenuSectionId" class="control-label">@L["MenuSection"]</label>
                        <select asp-for="MenuSectionId" class="form-control">
                            <option value="">@L["Select"]</option>
                            @foreach (var item in Model.MenuSections)
                            {
                                <option value="@item.Id" selected="@(Model.MenuSectionId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                            }
                        </select>
                        <span asp-validation-for="MenuSectionId" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Size" class="control-label">@L["Size"]</label>
                        <select asp-for="Size" class="form-control">
                            <option value="">@L["Select"]</option>
                            @foreach (var size in new[] { Size.Small, Size.Medium, Size.Large, Size.Syrian_Bread })
                            {
                                <option value="@size" selected="@(Model.Size == size)">@L["Size." + size]</option>
                            }
                        </select>
                        <span asp-validation-for="Size" class="text-danger"></span>
                    </div>
                   
                    <div class="form-group col-md-3">
                        <label asp-for="ImageFile" class="control-label">@L["Image"]</label>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2"><img src="@Model.ImageUrl" alt="" class="menu-thumb" /></div>
                        }
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-3">
                        <label class="control-label d-block">@L["Availability"]</label>
                        <div class="form-check">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label">@L["IsAvailable"]</label>
                        </div>
                    </div>
                </div>
            </section>

            <section class="menu-step">
                <h2><b>2</b> @L["MenuStepRecipe"]</h2>

                <div class="row">
                    <div class="form-group col-md-3">
                        <label asp-for="StoreId" class="control-label">@L["Store"]</label>
                        <select id="storeList" asp-for="StoreId" class="form-control">
                            <option value="">@L["Select"]</option>
                            @foreach (var item in Model.Stores)
                            {
                                <option value="@item.Id" selected="@(Model.StoreId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                            }
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-3">
                        <label class="control-label">@L["ProductCategory"]</label>
                        <select id="categoryList" class="form-control">
                            <option value="">@L["AllCategories"]</option>
                            @foreach (var item in Model.Categories)
                            {
                                <option value="@item.Id">@(isArabic ? item.ArName : item.EnName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="control-label">@L["Products"]</label>
                        <select id="productList" class="form-control">
                            <option value="">@L["Select"]</option>
                        </select>
                    </div>
                </div>

                <p id="noMaterials" class="menu-note" hidden>
                    @L["NoRawMaterialsHelp"]
                    <a asp-controller="Product" asp-action="Index">@L["Products"]</a>
                </p>

                <div class="recipe-line">
                    <div>
                        <span>@L["AvailableQuantity"]</span>
                        <input id="availableQuantity" class="form-control" readonly />
                    </div>
                    <div>
                        <span>@L["UnitCost"]</span>
                        <input id="unitCost" class="form-control" readonly />
                    </div>
                    <div>
                        <span>@L["Unit"]</span>
                        <select id="unitList" class="form-control"></select>
                        <small id="unitSell" class="text-muted"></small>
                    </div>
                    <div>
                        <span>@L["RequiredQuantity"]</span>
                        <input id="quantity" type="number" step="0.001" min="0" class="form-control" />
                    </div>
                    <div>
                        <span>@L["Cost"]</span>
                        <input id="cost" class="form-control" readonly />
                    </div>
                    <button id="addComponent" type="button" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["AddToRecipe"]</button>
                </div>
                <p id="formula" class="menu-formula">@L["CostFormula"]</p>

                <div class="bo-table-wrap">
                    <table id="componentTable" class="bo-table">
                        <thead>
                            <tr>
                                <th>@L["Products"]</th>
                                <th>@L["Quantity"]</th>
                                <th>@L["Unit"]</th>
                                <th>@L["UnitCost"]</th>
                                <th>@L["Cost"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Components.Count; i++)
                            {
                                var component = Model.Components[i];
                                <tr data-id="@component.ProductId" data-unit="@component.UnitPriceId">
                                    <td>@(isArabic ? component.ProductArName : component.ProductEnName)</td>
                                    <td class="num c-qty">@component.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</td>
                                    <td>@(isArabic ? component.UnitArName : component.UnitEnName)</td>
                                    <td class="num c-unit">@component.UnitCost.ToString("0.00####", CultureInfo.InvariantCulture)</td>
                                    <td class="num c-cost">@component.Cost.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                    <td class="bo-row-actions"><button type="button" class="btn-ad btn-ad-danger btn-icon cancelRow" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p id="recipeEmpty" class="bo-empty" hidden>@L["RecipeEmpty"]</p>
                </div>
            </section>

            <section class="menu-step">
                <h2><b>3</b> @L["MenuStepPrice"]</h2>
                <div class="profit-box" id="profitBox">
                    <div class="profit-price">
                        <label asp-for="Price" class="control-label">@L["Price"]</label>
                        <input id="price" asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="profit-figures">
                        <div><span>@L["TotalCost"]</span><strong id="totalCostText">0.00</strong></div>
                        <div><span>@L["Benefit"]</span><strong id="benefitText">0.00</strong></div>
                        <div><span>@L["ProfitMargin"]</span><strong id="marginText">0%</strong></div>
                    </div>
                    <p id="lossWarning" class="profit-warning" hidden></p>
                </div>
                <input type="hidden" id="totalCost" />
                <input type="hidden" id="benefit" />
            </section>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
                @if (!isNew)
                {
                    <button type="button" onclick="Delete('/Menu/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push"><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            var isArabic = @Html.Raw(Json.Serialize(isArabic));
            var msgFill = @Html.Raw(Json.Serialize(L["FillComponentFields"].Value));
            var msgNegative = @Html.Raw(Json.Serialize(L["NegativeBenefitConfirm"].Value));
            var msgSelect = @Html.Raw(Json.Serialize(L["Select"].Value));
            var msgLoss = @Html.Raw(Json.Serialize(L["LossWarning"].Value));
            var alertTitle = @Html.Raw(Json.Serialize(L["LossAlertTitle"].Value));
            var saveAnywayText = @Html.Raw(Json.Serialize(L["SaveAnyway"].Value));
            var cancelText = @Html.Raw(Json.Serialize(L["Cancel"].Value));
            var removeText = @Html.Raw(Json.Serialize(L["Delete"].Value));
            var formulaText = @Html.Raw(Json.Serialize(L["CostFormula"].Value));
            var lastBuyText = @Html.Raw(Json.Serialize(L["PriceLastPurchase"].Value));
            var storeLoaded = false;
            var stock = {};

            function number(value) {
                return parseFloat(value) || 0;
            }

            // a unit cost can be a fraction of a cent (cost of one gram), so show up to 6 decimals
            function unitText(value) {
                var text = (Math.round(value * 1000000) / 1000000).toFixed(6);
                while (text.endsWith('0') && /\.\d{3,}$/.test(text)) {
                    text = text.slice(0, -1);
                }

                return text;
            }

            function recalc() {
                var total = 0;
                var rows = $('#componentTable tbody tr');
                rows.each(function () {
                    total += number($(this).find('.c-cost').text());
                });

                var price = number($('#price').val());
                var benefit = price - total;
                var percent = price > 0 ? (benefit / price) * 100 : 0;

                $('#totalCost').val(total.toFixed(2));
                $('#benefit').val(benefit.toFixed(2));
                $('#totalCostText').text(total.toFixed(2));
                $('#benefitText').text(benefit.toFixed(2));
                $('#marginText').text(percent.toFixed(0) + '%');
                $('#recipeEmpty').prop('hidden', rows.length > 0);

                var loss = total > 0 && benefit < 0;
                $('#profitBox').toggleClass('is-loss', loss).toggleClass('is-ok', total > 0 && !loss);
                $('#lossWarning').prop('hidden', !loss).text(msgLoss.replace('{0}', total.toFixed(2)));
            }

            function renderProducts() {
                var category = $('#categoryList').val();
                var list = $('#productList').empty().append($('<option>', { value: '', text: msgSelect }));
                var count = 0;
                $.each(stock, function (id, p) {
                    if (category && String(p.productCategoryId) !== category) {
                        return;
                    }

                    count++;
                    list.append($('<option>', { value: p.productId, text: isArabic ? p.productArName : p.productEnName }));
                });
                $('#noMaterials').prop('hidden', count > 0);
            }

            function loadProducts(storeId) {
                $.get('/Menu/GetProductsByStore', { storeId: storeId || 0 }, function (data) {
                    stock = {};
                    $.each(data, function (i, p) { stock[p.productId] = p; });
                    renderProducts();
                });
            }

            function clearLine() {
                $('#availableQuantity, #unitCost, #quantity, #cost').val('');
                $('#formula').text(formulaText);
            }

            $('#categoryList').on('change', function () {
                clearLine();
                renderProducts();
            });

            $('#storeList').on('change', function () {
                if (storeLoaded) {
                    $('#componentTable tbody').empty();
                }

                storeLoaded = true;
                clearLine();
                loadProducts($(this).val());
                recalc();
            });

            // quantity and cost are kept per base unit; the chosen unit multiplies the cost by its rate
            function fillUnits(item) {
                var list = $('#unitList').empty();
                var units = item && item.units ? item.units : [];
                if (!units.length) {
                    list.append($('<option>', { value: '', text: '-' }).attr('data-rate', 1));
                    return;
                }

                $.each(units, function (i, u) {
                    var option = $('<option>', { value: u.unitPriceId, text: isArabic ? u.unitArName : u.unitEnName }).attr('data-rate', u.transRate).attr('data-sell', u.price || '');
                    option.prop('selected', u.isDefault);
                    list.append(option);
                });
            }

            function showUnitFigures() {
                var item = stock[$('#productList').val()];
                var rate = number($('#unitList option:selected').attr('data-rate')) || 1;
                $('#availableQuantity').val(item ? Math.round(item.quantity / rate * 1000) / 1000 : '');
                $('#unitCost').val(item ? Math.round(item.cost * rate * 10000) / 10000 : '');
                var lastBuy = $('#unitList option:selected').attr('data-sell');
                $('#unitSell').text(lastBuy ? lastBuyText + ': ' + lastBuy : '');
                $('#quantity').trigger('input');
            }

            $('#productList').on('change', function () {
                var item = stock[$(this).val()];
                clearLine();
                fillUnits(item);
                showUnitFigures();
            });

            $('#unitList').on('change', showUnitFigures);

            $('#quantity').on('input', function () {
                var quantity = number($(this).val());
                var unit = number($('#unitCost').val());
                var cost = quantity * unit;
                $('#cost').val(cost.toFixed(2));
                $('#formula').text(quantity + ' x ' + unitText(unit) + ' = ' + cost.toFixed(2));
            });

            $('#price').on('input', recalc);

            $('#addComponent').on('click', function () {
                var id = $('#productList').val();
                var quantity = $('#quantity').val();
                if (!id || number(quantity) <= 0) {
                    toastr.error(msgFill);
                    return;
                }

                var unitId = $('#unitList').val() || '';
                $('#componentTable tbody tr').filter(function () {
                    return String($(this).attr('data-id')) === String(id) && ($(this).attr('data-unit') || '') === unitId;
                }).remove();

                var unit = number($('#unitCost').val());
                var row = $('<tr>').attr('data-id', id).attr('data-unit', unitId)
                    .append($('<td>').text($('#productList option:selected').text()))
                    .append($('<td class="num c-qty">').text(quantity))
                    .append($('<td>').text(unitId ? $('#unitList option:selected').text() : ''))
                    .append($('<td class="num c-unit">').text(unitText(unit)))
                    .append($('<td class="num c-cost">').text((number(quantity) * unit).toFixed(2)))
                    .append($('<td class="bo-row-actions">').append($('<button type="button" class="btn-ad btn-ad-danger btn-icon cancelRow">').attr('title', removeText).attr('aria-label', removeText).html('<i class="fas fa-trash" aria-hidden="true"></i>')));
                $('#componentTable tbody').append(row);
                $('#productList').val('').trigger('change');
                recalc();
            });

            $(document).on('click', '.cancelRow', function () {
                $(this).closest('tr').remove();
                recalc();
            });

            var confirmed = false;

            $('#menuForm').on('submit', function (e) {
                var form = $(this);
                form.find('input.component-input').remove();
                $('#componentTable tbody tr').each(function (i) {
                    var row = $(this);
                    $('<input type="hidden" class="component-input">').attr('name', 'Components[' + i + '].ProductId').val(row.data('id')).appendTo(form);
                    $('<input type="hidden" class="component-input">').attr('name', 'Components[' + i + '].Quantity').val(row.find('.c-qty').text()).appendTo(form);
                    if (row.attr('data-unit')) {
                        $('<input type="hidden" class="component-input">').attr('name', 'Components[' + i + '].UnitPriceId').val(row.attr('data-unit')).appendTo(form);
                    }
                });

                if (confirmed || number($('#benefit').val()) >= 0) {
                    return;
                }

                e.preventDefault();
                if (form.valid && !form.valid()) {
                    return;
                }

                Swal.fire({
                    title: alertTitle,
                    text: msgNegative + ' (' + $('#totalCost').val() + ' > ' + number($('#price').val()).toFixed(2) + ')',
                    icon: 'warning',
                    showCancelButton: true,
                    cancelButtonText: cancelText,
                    confirmButtonText: saveAnywayText
                }).then(function (answer) {
                    if (answer.isConfirmed) {
                        confirmed = true;
                        form[0].submit();
                    }
                });
            });

            var storeOptions = $('#storeList option').filter(function () { return $(this).val() !== ''; });
            if (!$('#storeList').val() && storeOptions.length === 1) {
                $('#storeList').val(storeOptions.first().val());
            }

            fillUnits(null);
            loadProducts($('#storeList').val());
            storeLoaded = !!$('#storeList').val();
            recalc();
        });
    </script>
}
