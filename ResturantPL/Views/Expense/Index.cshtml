@model IEnumerable<Expense>


<h1 class="text-center">المصروفات</h1>
<hr />

@* <a asp-action="Create" class="btn-menu animated fadeInUp scrollto float-end m-5">إضافه مصروف جديد</a> *@
<p>
    <a asp-action="Create">إضافه مصروف جديد</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <tr>
        <td>الاسم</td>
        <td>المبلغ</td>
        <td></td>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>

            <td>
                <a href="/Expense/Edit/@item.Id">تعديل</a> |
                <a onclick="Delete('/Expense/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
            </td>
        </tr>
    }
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>

<script src="~/lib/sweetalert/sweetalert.min.js"></script>
<script src="~/modules/deleteobjects.js"></script>