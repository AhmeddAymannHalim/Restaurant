@model Restaurant.Data.Models.PaymentInvoiceCustomer

@{
    ViewData["Title"] = "SupplierInvoiceDetails";
}




<style>
    /* Define styles for the page content */
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #111;
    }

    .container {
        max-width: 576px; /* Set the maximum width to fit within the paper size */
        margin: 0 auto; /* Center the content horizontally */
        background-color: #fff; /* White background for better readability */
        padding: 20px; /* Add padding for spacing */
        color: black;
    }

    h1 {
        text-align: center;
    }

    dl {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    dt, dd {
        width: 45%; /* Set width for better alignment */
        padding: 10px;
        margin-bottom: 10px;
        border: 1px solid #ccc; /* Add border for styling */
        box-sizing: border-box;
    }

    dt {
        background-color: #f2f2f2; /* Light gray background for dt elements */
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

    th {
        background-color: #f2f2f2; /* Light gray background for table header */
    }
</style>



<div class="container">
    <h1>فاتورة @Model.Customer.Name</h1>
    <hr />

    <dl>
        <dt class="col-sm-3">
            اسم المورد
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Customer.Name)
        </dd>

        <dt class="col-sm-3">
            كود العملية
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.ProcessCode)
        </dd>
        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class="col-sm-3">
            البيان
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-3">
            المدفوع
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Paid)
        </dd>

        <dt class="col-sm-3">
            المتبقي
        </dt>
        <dd class="col-sm-8">
            @Model.Customer.Balance
        </dd>

    </dl>

    <div>
        <a asp-action="IndexCustomer">عودة لفواتير العملاء</a>
    </div>

</div>


