@model Store
@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center">حذف بيانات مخزن </h1>
<hr />



<div>
    <dl class="row">

        <dt class="col-sm-2">
            الاسم
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>


        <dt class="col-sm-2">
            العنوان
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Address)
        </dd>

        <dt class="col-sm-2">
            الموبايل
        </dt>
        <dd class="col-sm-9">
            @Model.MobileNumber
        </dd>
        <dt class="col-sm-2">
            الهاتف
        </dt>
        <dd class="col-sm-9">
            @Model.PhoneNumber
        </dd>

        <dt class="col-sm-2">
            امين المخزن
        </dt>
        <dd class="col-sm-9">
            @Model.Storekeeper.FirstName @Model.Storekeeper.LastName
        </dd>
        <dt class="col-sm-2">
            الفواتير الخاصة بالمخزن
        </dt>
        <dd class="col-sm-9">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>

                        <th>
                            كود الفاتورة
                        </th>
                        <th>
                            تاريخ الفاتورة
                        </th>

                        <th>
                            الاجمالي بعد الخصم
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Invoices)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.InvoiceCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.InvoiceDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.TotalPrice)
                            </td>

                            <td>
                                @Html.ActionLink("التفاصيل", "DetailsInvoice", "Invoice", new { id = item.Id })
                                @* @Html.ActionLink("Delete", "Invoice", "DeleteInvoice", "Invoice", new { id = item.Id }) *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </dd>


        <dt class="col-sm-2">
            المنتجات و كمياتها و اسعارها
        </dt>
        <dd class="col-sm-9">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>

                        <th>
                            اسم الصنف
                        </th>
                        <th>
                            الكمية
                        </th>

                        <th>
                            السعر بالوحدة
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.StoreProducts)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Product.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Quantity)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.PriceForUnit)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </dd>


    </dl>

    <form asp-action="Delete">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">عودة للمخازن</a>
    </form>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
