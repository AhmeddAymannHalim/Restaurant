
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="" name="description">
    <meta content="" name="keywords">
    <title>@ViewData["Title"] - ResturantPL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ResturantPL.styles.css" asp-append-version="true" />

    <style>
        *{
            box-sizing:border-box;
        }
    </style>


    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

   


    <!-- Template Main CSS File -->
    <link href="~/assets/css/style.css" rel="stylesheet">

    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet">
   



</head>
<body>
    <!-- ======= Top Bar ======= -->
    <div id="topbar" class="d-flex align-items-center fixed-top">
        <div class="container d-flex justify-content-center justify-content-md-between">
            @if (Model != null && Model.GetType() == typeof(IndexSettings))
            {
                <div class="contact-info d-flex align-items-center">
                    <i class="bi bi-phone d-flex align-items-center"><span>@Model.Phone</span></i>
                    <i class="bi bi-clock d-flex align-items-center ms-4"><span> @Model.EndDay-@Model.StartDay: @Model.StartHour صباحا - @Model.EndHour مسائا</span></i>
                </div>

            }


        </div>
    </div>

    <!-- ======= Header ======= -->
    <header id="header" class="fixed-top d-flex align-items-cente">
        <div class="container-fluid container-xl d-flex align-items-center">

            <a asp-action="AdminDash" asp-controller="Account" class="book-a-table-btn scrollto d-none d-lg-flex">لوحة التحكم</a>

            <nav id="navbar" class="navbar order-last order-lg-0">
                <ul>
                    <li><a style="font-size:17px;" class="nav-link scrollto active" asp-action="Create" asp-controller="Order">الرئيسية</a></li>
                    <li> <a style="font-size:17px;" asp-action="Index" asp-controller="Order" class="nav-link scrollto">انهاء الشيفت</a></li>



                    <li> <a style="font-size:17px;" asp-action="PendingOrders" asp-controller="Order" class="nav-link scrollto">طلبات اونلاين</a></li>
                    <li> <a style="font-size:17px;" asp-action="PendingOnlineDelivery" asp-controller="Order" class="nav-link scrollto">اونلاين معلق</a></li>
                    <li> <a style="font-size:17px;" asp-action="PendingDelivery" asp-controller="Order" class="nav-link scrollto">الدليفري المعلق</a></li>
                    <li> <a style="font-size:17px;" asp-action="PendingHall" asp-controller="Order" class="nav-link scrollto">الصالة المعلقة</a></li>
                    <li> <a style="font-size:17px;" asp-action="HallOrders" asp-controller="Order" class="nav-link scrollto">الصالة</a></li>
                    <li> <a style="font-size:17px;" asp-action="DeliveryOrders" asp-controller="Order" class="nav-link scrollto">الدليفري</a></li>
                    <li> <a style="font-size:17px;" asp-action="DeliveryOnlineOrders" asp-controller="Order" class="nav-link scrollto">الاونلاين</a></li>
                    <li><a style="font-size:17px;" asp-action="TakeAwayOrders" asp-controller="Order" class="nav-link scrollto">التيك اواي</a></li>
                    <li><a style="font-size:17px;" asp-action="AllOrders" asp-controller="Order" class="nav-link scrollto">كل الطلبات</a></li>
                    
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li><a style="font-size:18px;" class="nav-link scrollto float-end text-danger" asp-action="SignOut" asp-controller="Account">تسجيل الخروج</a></li>
                        <img src="~/Images/chefs-1.jpg" alt="image" class="rounded-circle m-3" style="width:40px" />
                    }
                    else
                    {
                        <li><a style="font-size:18px;" class="nav-link scrollto float-end text-primary" asp-action="SignIn" asp-controller="Account">تسجيل الدخول</a></li>
                    }
                </ul>
                <i class="bi bi-list mobile-nav-toggle"></i>
            </nav><!-- .navbar -->
            @if (Model != null && Model.GetType() == typeof(IndexSettings))
            {
                <h1 class="logo me-auto me-lg-0"><a href="">@Model.Name</a></h1>
            }
        </div>
    </header><!-- End Header -->

    <main role="main" class="m-3 p-3" style="direction:rtl;">
        <div style="height:133px;"></div>
 
        @RenderBody()
    </main>

    @*  <main role="main" class="m-3 pb-3 d-flex justify-content-center align-items-center">
    @RenderBody()
    </main> *@


    @* <footer class="border-top footer text-muted">
    <div class="container">
    &copy; 2023 - ResturantPL - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
    </footer>*@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   


    <!-- Template Main JS File -->
    <script src="~/assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
