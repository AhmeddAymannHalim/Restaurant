@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employees";
    var users = ViewBag.Users;
}



<h1 class="text-center">الموظفين</h1>
<hr />
<p>
    <a asp-action="AddEmployee" asp-controller="Employee">اضافة موظف جديد</a>
</p>
<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
               الاسم
            </th>
            <th>
                الوظيفة
            </th>
            <th>
                رقم الموبايل
            </th>
            <th>
                رقم الهاتف
            </th>
            <th>
               العنوان
            </th>

            <th>
               الصورة
            </th>
            <th>
                السن
            </th>
          
            <th>
               نوع الراتب
            </th>
            <th>
             الراتب
            </th>
            <th>
              الفرع
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.FirstName @item.LastName
                </td>
                <td>
                    @item.Job.Name
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MobileNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @item.Country @item.City @item.Street
                </td>

                <td>
                    @if (item.Image != null)
                    {
                        <img src="@item.Image" alt="image" class="rounded-circle img-thumbnail" width="50" />
                    }
                    else
                    {
                        <img src="~/Employee Images/User_Image.png" class="rounded-circle img-thumbnail" width="50" />
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Age)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SalaryType.Type)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Salary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Branche.Name)
                </td>
                <td>
                    @Html.ActionLink("تعديل", "UpdateEmployee", new { id = item.EmployeeId }) |
                    @Html.ActionLink("التفاصيل", "DetailsEmployee", new { id = item.EmployeeId }) |
                    @Html.ActionLink("حذف", "DeleteEmployee", new { id = item.EmployeeId }) |
                    @{
                        bool userExists = false;
                        foreach (var user in users)
                        {
                            if (user.Code == item.Code)
                            {
                                userExists = true;
                                break;
                            }
                        }
                        if (userExists)
                        {
                            <a asp-action="CheckAccount" asp-route-id="@item.EmployeeId">تعديل الحساب</a>
                        }
                        else
                        {
                            <a asp-action="CheckAccount" asp-route-id="@item.EmployeeId">اضافة حساب</a>
                        }
                    }

                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>