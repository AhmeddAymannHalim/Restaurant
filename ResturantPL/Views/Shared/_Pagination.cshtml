@model dynamic
@{
    int current = (int)Model.PageNo;
    int total = (int)Model.NoOfPages;

    var others = string.Join("&", Context.Request.Query
        .Where(a => a.Key != "pageNo")
        .Select(a => a.Key + "=" + Uri.EscapeDataString(a.Value.ToString())));
    var prefix = others == "" ? "?" : "?" + others + "&";

    int first = Math.Max(1, current - 2);
    int last = Math.Min(total, current + 2);
}
@if (total > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(current == 1 ? "disabled" : "")">
                <a class="page-link" href="@(prefix)pageNo=@Math.Max(1, current - 1)">@L["Previous"]</a>
            </li>

            @for (int i = first; i <= last; i++)
            {
                <li class="page-item @(i == current ? "active" : "")">
                    <a class="page-link" href="@(prefix)pageNo=@i">@i</a>
                </li>
            }

            <li class="page-item @(current == total ? "disabled" : "")">
                <a class="page-link" href="@(prefix)pageNo=@Math.Min(total, current + 1)">@L["Next"]</a>
            </li>
        </ul>
    </nav>
}
