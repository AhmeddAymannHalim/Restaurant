@model SignInViewModel
@{
    ViewData["Title"] = L["SignIn"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <h1 class="auth-title">@L["Auth_Welcome"]</h1>
    <p class="auth-sub">@L["Auth_SignInSub"]</p>

    <div class="auth-alert" asp-validation-summary="ModelOnly"></div>

    <form asp-action="SignIn" method="post" novalidate>
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div class="field">
            <input asp-for="Email" type="text" placeholder="@L["Auth_EmailOrUser"]" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <input asp-for="Password" type="password" class="has-toggle" placeholder="@L["Password"]" autocomplete="current-password" />
            <button type="button" class="toggle-pass" data-show="@L["Auth_Show"]" data-hide="@L["Auth_Hide"]">@L["Auth_Show"]</button>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <label class="check"><input type="checkbox" asp-for="RememberMe" /> @L["Auth_Remember"]</label>
        <button type="submit" class="btn-auth">@L["SignIn"]</button>
    </form>

    @if (ViewBag.ShowResend == true)
    {
        <form asp-action="ResendConfirmation" method="post" class="auth-links">
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="link-btn">@L["Auth_Resend"]</button>
        </form>
    }

    <hr class="divider" />
    <div class="auth-links">
        <p><a asp-action="ForgetPassword">@L["Auth_Forgot"]</a></p>
        <p>@L["Auth_NewHere"] <a asp-action="Register">@L["Auth_CreateAccount"]</a></p>
    </div>
</div>

@section ValidationScripts {
    <partial name="_ValidationScriptsPartial" />
}
