@model CustomerViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewCustomer"].Value : L["UpdateCustomer"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-user-tag" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="ad-card-body">
        <form asp-action="Upsert" method="post" class="ad-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div data-location-cascade
                 data-countries-url="@Url.Action("Countries", "Lookup")"
                 data-governorates-url="@Url.Action("Governorates", "Lookup")"
                 data-cities-url="@Url.Action("Cities", "Lookup")"
                 data-arabic="@(LanguageHelper.IsArabic() ? "1" : "0")"
                 data-placeholder="@L["Select"]"
                 data-selected-country="@Model.CountryId"
                 data-selected-governorate="@Model.GovernorateId"
                 data-selected-city="@Model.CityId">
                <div class="form-group">
                    <label class="control-label">@L["Country"]</label>
                    <select class="form-select" data-cascade-level="country"></select>
                </div>
                <div class="form-group">
                    <label class="control-label">@L["Governorate"]</label>
                    <select class="form-select" data-cascade-level="governorate" disabled></select>
                </div>
                <div class="form-group">
                    <label asp-for="CityId" class="control-label">@L["City"]</label>
                    <select asp-for="CityId" class="form-select" data-cascade-level="city" disabled></select>
                    <span asp-validation-for="CityId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label">@L["Address"]</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label">@L["Phone"]</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Balance" class="control-label">@L["Balance"]</label>
                <input asp-for="Balance" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Balance" class="text-danger"></span>
            </div>

            <div class="ad-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/Customer/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/location-cascade.js" asp-append-version="true"></script>
}
