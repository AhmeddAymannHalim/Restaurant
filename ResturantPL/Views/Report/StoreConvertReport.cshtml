@model Restaurant.DAL.Models.StoreConvert

@{
    ViewData["Title"] = "Store Convert Report";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>


<h1> فاتورة نقل اصناف</h1>
<hr />



<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr>
            <th colspan="2">التفاصيل</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mainRow">كود الفاتورة</td>
            <td>@Model.ConvertCode</td>
        </tr>
        <tr>
            <td class="mainRow">تاريخ الفاتورة</td>
            <td>@Model.ConvertDate.ToString("dd-MM-yyyy  hh:mm tt")</td>
        </tr>

        <tr>
            <td class="mainRow">المخزن المنقول منه</td>
            <td>@Model.FromStore.ArName</td>
        </tr>
        <tr>
            <td class="mainRow">المخزن المنقول اليه</td>
            <td>@Model.ToStore.ArName</td>
        </tr>




        <tr>
            <td class="mainRow">الاصناف</td>
            <td>
                <table class="mt-3 table table-bordered table-light text-dark">
                <tr>
                    <th>اسم المنتج</th>
                    <th>الكمية</th>

                </tr>
                @foreach (var item in Model.StoreConvertProducts)
                {
                    <tr>
                        <td>@item.StoreProduct.ProductName</td>
                        <td>@item.Quantity</td>
                    </tr>
                }
            </table>
            </td>
        </tr>

    </tbody>
</table>



