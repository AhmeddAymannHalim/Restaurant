@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
/* Reusable Country -> Governorate -> City cascading select.
   Markup contract: a wrapper with [data-location-cascade] carrying the lookup URLs and
   (optionally) the previously-saved ids to preselect, containing three <select>s marked
   [data-cascade-level="country|governorate|city"]. Only the city select needs a `name`/`asp-for` —
   country and governorate exist purely to narrow the city list down. */
(function ($) {
    'use strict';

    function fillOptions($select, items, arabic, placeholder, selectedId) {
        $select.empty().append($('<option>', { value: '', text: placeholder }));
        items.forEach(function (item) {
            $select.append($('<option>', { value: item.id, text: arabic ? item.arName : item.enName }));
        });
        $select.prop('disabled', items.length === 0);
        if (selectedId) { $select.val(String(selectedId)); }
    }

    function init() {
    $('[data-location-cascade]').each(function () {
        var $root = $(this);
        var arabic = String($root.data('arabic')) === '1';
        var placeholder = $root.data('placeholder') || '';
        var urls = {
            country: $root.data('countriesUrl'),
            governorate: $root.data('governoratesUrl'),
            city: $root.data('citiesUrl')
        };
        var $country = $root.find('[data-cascade-level="country"]');
        var $governorate = $root.find('[data-cascade-level="governorate"]');
        var $city = $root.find('[data-cascade-level="city"]');

        function loadCities(governorateId, selectedCity) {
            if (!governorateId) {
                $city.empty().prop('disabled', true);
                return;
            }
            $.get(urls.city, { governorateId: governorateId }, function (data) {
                fillOptions($city, data, arabic, placeholder, selectedCity);
            });
        }

        function loadGovernorates(countryId, selectedGovernorate, selectedCity) {
            if (!countryId) {
                $governorate.empty().prop('disabled', true);
                $city.empty().prop('disabled', true);
                return;
            }
            $.get(urls.governorate, { countryId: countryId }, function (data) {
                fillOptions($governorate, data, arabic, placeholder, selectedGovernorate);
                if (selectedGovernorate) { loadCities(selectedGovernorate, selectedCity); }
                else { $city.empty().prop('disabled', true); }
            });
        }

        $country.on('change', function () { loadGovernorates($(this).val()); });
        $governorate.on('change', function () { loadCities($(this).val()); });

        $.get(urls.country, function (data) {
            var selectedCountry = $root.data('selectedCountry');
            fillOptions($country, data, arabic, placeholder, selectedCountry);
            if (selectedCountry) {
                loadGovernorates(selectedCountry, $root.data('selectedGovernorate'), $root.data('selectedCity'));
            }
        });
    });
    }

    init();
    
})(jQuery);

/* Leaves: choosing a leave type fills from / to / days; editing any one keeps the others in step. */
(function ($) {
    'use strict';

    function addDays(iso, days) {
        var d = new Date(iso + 'T00:00:00');
        d.setDate(d.getDate() + days);
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function diffDays(fromIso, toIso) {
        return Math.round((new Date(toIso + 'T00:00:00') - new Date(fromIso + 'T00:00:00')) / 86400000) + 1;
    }

    function today() {
        var d = new Date();
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function row(el) { return $(el).closest('[data-row]'); }

    function fillToDate($r) {
        var from = $r.find('[data-leave-from]').val();
        var days = parseInt($r.find('[data-leave-days]').val(), 10);
        if (from && days > 0) { $r.find('[data-leave-to]').val(addDays(from, days - 1)); }
    }

    $(document).on('change', '[data-leave-type]', function () {
        var $r = row(this);
        var days = parseInt($(this).find('option:selected').data('days'), 10);
        if (!$r.find('[data-leave-from]').val()) { $r.find('[data-leave-from]').val(today()); }
        if (days > 0) { $r.find('[data-leave-days]').val(days); }
        fillToDate($r);
    });

    $(document).on('change', '[data-leave-from], [data-leave-days]', function () { fillToDate(row(this)); });

    $(document).on('change', '[data-leave-to]', function () {
        var $r = row(this);
        var from = $r.find('[data-leave-from]').val();
        var to = $(this).val();
        if (from && to && to >= from) { $r.find('[data-leave-days]').val(diffDays(from, to)); }
    });
})(jQuery);

/* Pay: weekly / monthly hours and the daily / hourly / minute rates come from salary, work days and daily hours.
   Same formulas run again on the server (EmployeePayCalculator), so the posted numbers are never trusted. */
(function ($) {
    'use strict';
    var WEEKS_PER_MONTH = 52 / 12;
    var $f = {};

    function num($el) { var v = parseFloat($el.val()); return isNaN(v) ? 0 : v; }
    function put($el, v, digits) { $el.val(isFinite(v) && v > 0 ? v.toFixed(digits) : ''); }

    /* "HH:mm" -> minutes since midnight, or -1 while the time is empty */
    function minutes(text) {
        var p = (text || '').split(':');
        return p.length < 2 ? -1 : parseInt(p[0], 10) * 60 + parseInt(p[1], 10);
    }

    function recalc() {
        // With a shift set the hours follow it (same rule as the server); an end before the start is a night shift
        var from = minutes($f.start.val()), to = minutes($f.end.val());
        var shifted = from >= 0 && to >= 0;
        if (shifted) {
            var span = to - from;
            if (span <= 0) { span += 24 * 60; }
            $f.hours.val((span / 60).toFixed(2));
        }
        $f.hours.prop('readonly', shifted);

        var days = num($f.days), hours = num($f.hours), salary = num($f.salary);
        var weekly = days * hours;
        var monthDays = days * WEEKS_PER_MONTH;
        var daily = monthDays > 0 ? Math.round(salary / monthDays * 100) / 100 : 0;
        var hourly = hours > 0 ? Math.round(daily / hours * 100) / 100 : 0;
        put($f.weekly, weekly, 2);
        put($f.monthly, weekly * WEEKS_PER_MONTH, 2);
        put($f.daily, daily, 2);
        put($f.hourly, hourly, 2);
        put($f.minute, hourly / 60, 4);
    }

    function init() {
        $f = {};
        $('[data-pay]').each(function () { $f[$(this).data('pay')] = $(this); });
        if (!$f.salary) { return; }
        $f.salary.add($f.days).add($f.hours).add($f.start).add($f.end).on('input change keyup', recalc);
        recalc();
    }

    init();
    
})(jQuery);

/* Pay: the expected monthly net is basic salary + allowances - fixed deductions. It is only shown, never posted or stored,
   because the real net depends on the period (advances, discounts, late, absence) and is saved on the Salary row. */
(function ($) {
    'use strict';

    function sum(selector) {
        var total = 0;
        $(selector).each(function () { var v = parseFloat($(this).val()); total += isNaN(v) ? 0 : v; });
        return total;
    }

    function show() {
        var $net = $('#expectedNet');
        if (!$net.length) { return; }
        var salary = parseFloat($('[data-pay="salary"]').val());
        var net = (isNaN(salary) ? 0 : salary) + sum('[data-al-amount]') - sum('[data-de-amount]');
        $net.val(net.toFixed(2));
    }

    /* The row scripts fill the amounts after the click / change, and rows can be added or removed, so wait one tick. */
    $(document).on('input change click', '.bo-form', function () { setTimeout(show, 0); });
    show();

})(jQuery);

/* Insurance: choosing the insurance type loads its wage, allowances and shares; the amounts follow live. */
(function ($) {
    'use strict';
    var $f = {};

    function num($el) { var v = parseFloat($el.val()); return isNaN(v) ? 0 : v; }

    function amounts() {
        var wage = num($f.basic) + num($f.allowances);
        $f.employeeAmount.val($f.employee.val() === '' ? '' : (wage * num($f.employee) / 100).toFixed(2));
        $f.companyAmount.val($f.company.val() === '' ? '' : (wage * num($f.company) / 100).toFixed(2));
    }

    function init() {
        $f = {};
        $('[data-ins]').each(function () { $f[$(this).data('ins')] = $(this); });
        var $type = $('[data-insurance-category]');
        if (!$type.length || !$f.basic) { return; }

        $type.on('change', function () {
            var $o = $(this).find('option:selected');
            if (!$o.val()) { return; }
            $f.basic.val($o.data('basic') === undefined ? '' : $o.data('basic'));
            $f.allowances.val($o.data('allowances') === undefined ? '' : $o.data('allowances'));
            $f.employee.val($o.data('employee') === undefined ? '' : $o.data('employee'));
            $f.company.val($o.data('company') === undefined ? '' : $o.data('company'));
            amounts();
        });

        $f.basic.add($f.allowances).add($f.employee).add($f.company).on('input change keyup', amounts);
        amounts();
    }

    init();
    
})(jQuery);

/* A checkbox that owns [data-show-when="<its name>"] fields shows them only while it is ticked.
   Hidden fields are also disabled, so an unticked group posts nothing and saves as empty. */
(function ($) {
    'use strict';

    function setState($group, on, animate) {
        $group.addClass('bo-collapse');
        $group.find('input, select, textarea').prop('disabled', !on);

        if (!animate) {
            $group.toggleClass('open', on);
            $group.prop('hidden', !on);
            return;
        }

        if (on) {
            $group.prop('hidden', false);
            setTimeout(function () { $group.addClass('open'); }, 30);
        } else {
            $group.removeClass('open');
            setTimeout(function () {
                if (!$group.hasClass('open')) { $group.prop('hidden', true); }
            }, 900);
        }
    }

    function apply(flag, animate) {
        var on = $('input[type=checkbox][name="' + flag + '"]').prop('checked');
        $('[data-show-when="' + flag + '"]').each(function (i) {
            var $g = $(this);
            if (!animate) { setState($g, on, false); return; }
            setTimeout(function () { setState($g, on, true); }, on ? i * 120 : 0);
        });
    }

    function init() {
        var flags = {};
        $('[data-show-when]').each(function () { flags[$(this).attr('data-show-when')] = true; });
        Object.keys(flags).forEach(function (flag) { apply(flag, false); });
    }

    $(document).on('change', 'input[type=checkbox]', function () {
        var name = this.name;
        if (name && $('[data-show-when="' + name + '"]').length) { apply(name, true); }
    });

    init();
    
})(jQuery);

/* New employee: no empty date boxes.
   A single date starts as today. A start / end pair starts as one year ago -> today. */
(function ($) {
    'use strict';

    function iso(date) {
        return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
    }

    function fill(name, value) {
        var $input = $('input[name="' + name + '"]');
        if ($input.length && !$input.val()) { $input.val(value); }
    }

    function init() {
        if ($('input[name="Id"]').val() !== '0') { return; }

        var today = new Date();
        var lastYear = new Date();
        lastYear.setFullYear(today.getFullYear() - 1);

        ['BorderEntryDate', 'HireDate'].forEach(function (name) { fill(name, iso(today)); });

        [
            ['NationalIdIssueDate', 'NationalIdExpiryDate'],
            ['DrivingLicenseIssueDate', 'DrivingLicenseExpiryDate'],
            ['ContractDate', 'ContractEndDate'],
            ['InsuranceStartDate', 'InsuranceEndDate'],
            ['IssueDate', 'ExpiryDate']
        ].forEach(function (pair) {
            fill(pair[0], iso(lastYear));
            fill(pair[1], iso(today));
        });
    }

    /* a new leave row starts today -> today */
    $(document).on('click', '[data-prefix=Leaves] [data-row-add]', function () {
        var $list = $(this).closest('[data-row-list]');
        setTimeout(function () {
            var $row = $list.find('[data-row]').last();
            $row.find('[data-leave-from], [data-leave-to]').each(function () {
                if (!$(this).val()) { $(this).val(iso(new Date())); }
            });
            $row.find('[data-leave-days]').each(function () {
                if (!$(this).val()) { $(this).val(1); }
            });
        }, 0);
    });

    init();
})(jQuery);

/* Allowances: choosing an allowance type fills the row's names and amount. */
(function ($) {
    'use strict';
    $(document).on('change', '[data-allowance-type]', function () {
        var $o = $(this).find('option:selected');
        var $r = $(this).closest('[data-row]');
        if (!$o.val()) { return; }
        $r.find('[data-al-ar]').val($o.attr('data-ar'));
        $r.find('[data-al-en]').val($o.attr('data-en'));
        $r.find('[data-al-amount]').val($o.attr('data-amount'));
    });

    $(document).on('change', '[data-deduction-type]', function () {
        var $o = $(this).find('option:selected');
        var $r = $(this).closest('[data-row]');
        if (!$o.val()) { return; }
        $r.find('[data-de-ar]').val($o.attr('data-ar'));
        $r.find('[data-de-en]').val($o.attr('data-en'));
        $r.find('[data-de-amount]').val($o.attr('data-amount'));
    });
})(jQuery);
</script>
}
