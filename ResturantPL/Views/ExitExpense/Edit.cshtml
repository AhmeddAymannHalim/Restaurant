@model Restaurant.Data.Models.ExitExpense

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-center">تعديل مصروف </h1>


<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
         
            <div class="form-group">
                <input asp-for="Id" hidden />

                <label asp-for="ExpenseId" class="control-label">المصروف</label>
                <select asp-for="ExpenseId" class="form-control" asp-items="@ViewBag.Expenses"></select>
                <span asp-validation-for="ExpenseId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label">المبلغ</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="تعديل" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">عودة للمصروفات</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
