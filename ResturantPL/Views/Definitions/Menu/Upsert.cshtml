@model MenuItemViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewMenuItem"].Value : L["UpdateMenuItem"].Value;
}

<h1 class="text-center">@ViewBag.Title</h1>
<hr />

<form id="menuForm" asp-action="Upsert" method="post" enctype="multipart/form-data" class="row">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />

    <div class="form-group col-md-3">
        <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
        <input asp-for="ArName" class="form-control" />
        <span asp-validation-for="ArName" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
        <input asp-for="EnName" class="form-control" />
        <span asp-validation-for="EnName" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="MenuSectionId" class="control-label">@L["MenuSection"]</label>
        <select asp-for="MenuSectionId" class="form-control" asp-items="Model.MenuSections">
            <option value="">@L["Select"]</option>
        </select>
        <span asp-validation-for="MenuSectionId" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="Size" class="control-label">@L["Size"]</label>
        <select asp-for="Size" class="form-control">
            <option value="">@L["Select"]</option>
            @foreach (var size in new[] { Size.Small, Size.Medium, Size.Large, Size.Syrian_Bread })
            {
                <option value="@size" selected="@(Model.Size == size)">@L["Size." + size]</option>
            }
        </select>
        <span asp-validation-for="Size" class="text-danger"></span>
    </div>

    <div class="form-group col-md-3">
        <label asp-for="Description" class="control-label">@L["Description"]</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="ImageFile" class="control-label">@L["Image"]</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-2"><img src="@Model.ImageUrl" alt="" style="width:64px;height:64px;object-fit:cover;border-radius:8px;" /></div>
        }
        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="StoreId" class="control-label">@L["Store"]</label>
        <select id="storeList" asp-for="StoreId" class="form-control" asp-items="Model.Stores">
            <option value="">@L["Select"]</option>
        </select>
        <span asp-validation-for="StoreId" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="Price" class="control-label">@L["Price"]</label>
        <input id="price" asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <hr class="mt-3" />

    <div class="form-group col-md-3">
        <label class="control-label">@L["Product"]</label>
        <select id="productList" class="form-control">
            <option value="">@L["Select"]</option>
        </select>
    </div>
    <div class="form-group col-md-2">
        <label class="control-label">@L["AvailableQuantity"]</label>
        <input id="availableQuantity" class="form-control" readonly />
    </div>
    <div class="form-group col-md-2">
        <label class="control-label">@L["BuyPrice"]</label>
        <input id="buyPrice" class="form-control" readonly />
    </div>
    <div class="form-group col-md-2">
        <label class="control-label">@L["RequiredQuantity"]</label>
        <input id="quantity" type="number" step="0.001" min="0" class="form-control" />
    </div>
    <div class="form-group col-md-2">
        <label class="control-label">@L["Cost"]</label>
        <input id="cost" class="form-control" readonly />
    </div>
    <div class="form-group col-md-1">
        <label class="control-label">&nbsp;</label>
        <button id="addComponent" type="button" class="btn btn-primary form-control">+</button>
    </div>

    <div class="form-group col-md-12 mt-3">
        <table id="componentTable" class="table table-hover text-center table-bordered table-striped-columns table-dark">
            <thead>
                <tr>
                    <th>@L["Product"]</th>
                    <th>@L["Quantity"]</th>
                    <th>@L["Cost"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Components.Count; i++)
                {
                    var component = Model.Components[i];
                    <tr data-id="@component.StoreProductId">
                        <td>@component.ProductName</td>
                        <td class="c-qty">@component.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</td>
                        <td class="c-cost">@component.Cost.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td><button type="button" class="btn btn-danger cancelRow">@L["Delete"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="form-group col-md-3">
        <label asp-for="TotalCost" class="control-label">@L["TotalCost"]</label>
        <input id="totalCost" class="form-control" value="@Model.TotalCost.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
    </div>
    <div class="form-group col-md-3">
        <label asp-for="Benefit" class="control-label">@L["Benefit"]</label>
        <input id="benefit" class="form-control" value="@Model.Benefit.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="@L["Save"]" class="btn btn-primary" /> |
        <a asp-action="Index">@L["Back"]</a>
        @if (!isNew)
        {
            <text> | </text>
            <a onclick="Delete('/Menu/Delete/@Model.Id', '@Url.Action("Index")')" class="text-danger" style="font-weight:bold; cursor:pointer;">@L["Delete"]</a>
        }
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/modules/deleteobjects.js"></script>
    <script>
        $(function () {
            var msgFill = '@Html.Raw(Json.Serialize(L["FillComponentFields"].Value))';
            var msgNegative = '@Html.Raw(Json.Serialize(L["NegativeBenefitConfirm"].Value))';
            var msgSelect = '@Html.Raw(Json.Serialize(L["Select"].Value))';
            var storeLoaded = false;

            function recalc() {
                var total = 0;
                $('#componentTable tbody tr').each(function () {
                    total += parseFloat($(this).find('.c-cost').text()) || 0;
                });
                $('#totalCost').val(total.toFixed(2));
                $('#benefit').val(((parseFloat($('#price').val()) || 0) - total).toFixed(2));
            }

            function loadProducts(storeId) {
                $('#productList').empty().append($('<option>', { value: '', text: msgSelect }));
                if (!storeId) { return; }
                $.get('/Menu/GetProductsByStore', { storeId: storeId }, function (data) {
                    $.each(data, function (i, p) {
                        $('#productList').append($('<option>', { value: p.id, text: p.productName }));
                    });
                });
            }

            $('#storeList').on('change', function () {
                // Components belong to the chosen store, so changing the store starts the list again.
                if (storeLoaded) {
                    $('#componentTable tbody').empty();
                }
                storeLoaded = true;
                $('#availableQuantity, #buyPrice, #quantity, #cost').val('');
                loadProducts($(this).val());
                recalc();
            });

            $('#productList').on('change', function () {
                var id = $(this).val();
                $('#quantity, #cost').val('');
                if (!id) { $('#availableQuantity, #buyPrice').val(''); return; }
                $.get('/Menu/GetPriceByProduct', { productId: id }, function (p) {
                    $('#availableQuantity').val(p.quantity);
                    $('#buyPrice').val(p.priceForUnit);
                });
            });

            $('#quantity').on('input', function () {
                var cost = (parseFloat($(this).val()) || 0) * (parseFloat($('#buyPrice').val()) || 0);
                $('#cost').val(cost.toFixed(2));
            });

            $('#price').on('input', recalc);

            $('#addComponent').on('click', function () {
                var id = $('#productList').val();
                var qty = $('#quantity').val();
                var cost = $('#cost').val();
                if (!id || !qty || parseFloat(qty) <= 0 || !cost) {
                    toastr.error(msgFill);
                    return;
                }
                var row = $('<tr>').attr('data-id', id)
                    .append($('<td>').text($('#productList option:selected').text()))
                    .append($('<td class="c-qty">').text(qty))
                    .append($('<td class="c-cost">').text(cost))
                    .append($('<td>').append($('<button type="button" class="btn btn-danger cancelRow">').text('@L["Delete"]')));
                $('#componentTable tbody').append(row);
                $('#productList').val('').trigger('change');
                recalc();
            });

            $(document).on('click', '.cancelRow', function () {
                $(this).closest('tr').remove();
                recalc();
            });

            $('#menuForm').on('submit', function (e) {
                var form = $(this);
                form.find('input.component-input').remove();
                $('#componentTable tbody tr').each(function (i) {
                    var row = $(this);
                    $('<input type="hidden" class="component-input">').attr('name', 'Components[' + i + '].StoreProductId').val(row.data('id')).appendTo(form);
                    $('<input type="hidden" class="component-input">').attr('name', 'Components[' + i + '].Quantity').val(row.find('.c-qty').text()).appendTo(form);
                });
                if (parseFloat($('#benefit').val()) < 0 && !confirm(msgNegative)) {
                    e.preventDefault();
                }
            });

            if ($('#storeList').val()) {
                loadProducts($('#storeList').val());
                storeLoaded = true;
            }
            recalc();
        });
    </script>
}
