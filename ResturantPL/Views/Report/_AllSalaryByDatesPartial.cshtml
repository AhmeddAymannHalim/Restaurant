@model IEnumerable<Salary>

@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.SalaryCode</td>
            <td>@item.Employee.FullName</td>
            <td>@item.SalaryDate.ToString("yyyy-MM-dd")</td>
            <td>@item.User.FullName</td>
            <td>@item.SalaryAmount</td>
            <td>
                @Html.ActionLink("التفاصيل", "Details", "Salary", new { id = item.Id })
            </td>
        </tr>
    }
}
else
{
    <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
}