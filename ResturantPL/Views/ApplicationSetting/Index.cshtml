@{
    ViewData["Title"] = "Settings";
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">



<div class="container mt-5">
    <h1 class="mb-4 text-center">الاعدادات</h1>
    <hr />

    <div class="row text-center">

        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-dark text-light">
                <div class="card-body">
                    <h5 class="card-title">الاعدادات العامة</h5>
                    <i class="fa-solid fa-sliders"></i>
                    <p class="card-text">الاعدادات الخاصة بالمبيعات</p>
                </div>
                <div class="card-footer">
                    <a asp-action="ApplicationSetting" asp-controller="ApplicationSetting" class="btn btn-primary">
                        <i class="fa-solid fa-gear"></i> فتح الاعدادات
                    </a>
                </div>
            </div>
        </div>


        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-dark text-light">
                <div class="card-body">
                    <h5 class="card-title">اعدادات المطعم</h5>
                    <i class="fa-solid fa-bars-progress"></i>
                    <p class="card-text">الاعدادات الخاصة ببيانات المطعم</p>
                </div>
                <div class="card-footer">
                    <a asp-action="RestaurantSetting" asp-controller="ApplicationSetting" class="btn btn-primary">
                        <i class="fa-solid fa-gear"></i> فتح الاعدادات
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card h-100 bg-dark text-light">
                <div class="card-body">
                    <h5 class="card-title">اعدادات الطابعات</h5>
                    <i class="fa-solid fa-print"></i>
                    <p class="card-text">الاعدادات الخاصة بالطابعات</p>
                </div>
                <div class="card-footer">
                    <a asp-action="PrinterSetting" asp-controller="ApplicationSetting" class="btn btn-primary">
                        <i class="fa-solid fa-gear"></i> فتح الاعدادات
                    </a>
                </div>
            </div>
        </div>



    </div>
</div>