@model Restaurant.Data.Models.SalaryType

@{
    ViewData["Title"] = "AddSalaryType";
}



<h1 class="text-center">اضافة نوع راتب</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddSalaryType">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Type" class="control-label">نوع الراتب</label>
                <input asp-for="Type" class="form-control" required />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">عودة لانواع الرواتب</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
