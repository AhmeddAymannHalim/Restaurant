@model IEnumerable<Restaurant.Data.Models.PaymentInvoiceSupplier>

@{
    ViewData["Title"] = "IndexSupplier";
}

<h1 class="text-center">فواتير المدفوعات للموردين</h1>

<p>
    <a asp-action="InvoicePayForSupplier">اضافة فاتورة جديدة</a>
</p>
<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                اسم المورد
            <th>
                كود الفاتورة
            </th>
            <th>
              تاريخ الفاتورة
            </th>
            <th>
                البيان
            </th>
            <th>
                المدفوع
            </th>
            <th>
                المتبقي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.Name)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.ProcessCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Paid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.Balance)
            </td>
            <td>
                    @Html.ActionLink("التفاصيل", "SupplierInvoiceDetails", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>


<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>
