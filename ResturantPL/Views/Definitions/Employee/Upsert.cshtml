@model EmployeeViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewEmployee"].Value : L["UpdateEmployee"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-users" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="ad-card-body">
        <form asp-action="Upsert" method="post" enctype="multipart/form-data" class="ad-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Image" />
            <ul class="nav emp-tabs ad-full" role="tablist">
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab active" id="tab-Basic" data-bs-toggle="tab" data-bs-target="#pane-Basic" role="tab" aria-controls="pane-Basic" aria-selected="true"><i class="fas fa-id-card" aria-hidden="true"></i> @L["Emp.Tab.Basic"]</button></li>
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab" id="tab-Identity" data-bs-toggle="tab" data-bs-target="#pane-Identity" role="tab" aria-controls="pane-Identity" aria-selected="false"><i class="fas fa-passport" aria-hidden="true"></i> @L["Emp.Tab.Identity"]</button></li>
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab" id="tab-Job" data-bs-toggle="tab" data-bs-target="#pane-Job" role="tab" aria-controls="pane-Job" aria-selected="false"><i class="fas fa-briefcase" aria-hidden="true"></i> @L["Emp.Tab.Job"]</button></li>
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab" id="tab-Pay" data-bs-toggle="tab" data-bs-target="#pane-Pay" role="tab" aria-controls="pane-Pay" aria-selected="false"><i class="fas fa-wallet" aria-hidden="true"></i> @L["Emp.Tab.Pay"]</button></li>
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab" id="tab-Insurance" data-bs-toggle="tab" data-bs-target="#pane-Insurance" role="tab" aria-controls="pane-Insurance" aria-selected="false"><i class="fas fa-shield-heart" aria-hidden="true"></i> @L["Emp.Tab.Insurance"]</button></li>
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab" id="tab-Attendance" data-bs-toggle="tab" data-bs-target="#pane-Attendance" role="tab" aria-controls="pane-Attendance" aria-selected="false"><i class="fas fa-clock" aria-hidden="true"></i> @L["Emp.Tab.Attendance"]</button></li>
                <li class="nav-item" role="presentation"><button type="button" class="emp-tab" id="tab-Perks" data-bs-toggle="tab" data-bs-target="#pane-Perks" role="tab" aria-controls="pane-Perks" aria-selected="false"><i class="fas fa-plane" aria-hidden="true"></i> @L["Emp.Tab.Perks"]</button></li>
            </ul>
            <div class="tab-content ad-full">
            <div class="tab-pane fade show active emp-pane" id="pane-Basic" role="tabpanel" aria-labelledby="tab-Basic" tabindex="0">
            <div class="form-group">
                <label asp-for="Code" class="control-label">@L["Code"]</label>
                <input asp-for="Code" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label">@L["Phone"]</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <fieldset class="form-group ad-full ad-phones" data-row-list data-prefix="Phones">
                <legend class="control-label">@L["Emp.MoreMobiles"]</legend>
                <div data-rows>
                    @for (var i = 0; i < Model.Phones.Count; i++)
                    {
                        <div class="input-group mb-2" data-row>
                            <input type="hidden" name="Phones[@i].Id" value="@Model.Phones[i].Id" />
                            <input type="text" name="Phones[@i].PhoneNumber" value="@Model.Phones[i].PhoneNumber" class="form-control" maxlength="20" />
                            <button type="button" class="btn-ad btn-ad-danger btn-icon" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                            <span asp-validation-for="Phones[i].PhoneNumber" class="text-danger w-100"></span>
                        </div>
                    }
                </div>
                <button type="button" class="btn-ad btn-ad-ghost" data-row-add><i class="fas fa-plus" aria-hidden="true"></i> @L["Emp.AddMobile"]</button>
                <template data-row-template>
                    <div class="input-group mb-2" data-row>
                        <input type="hidden" name="Phones[__i__].Id" value="0" />
                        <input type="text" name="Phones[__i__].PhoneNumber" class="form-control" maxlength="20" />
                        <button type="button" class="btn-ad btn-ad-danger btn-icon" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                    </div>
                </template>
            </fieldset>
            <div class="form-group">
                <label asp-for="IDNumber" class="control-label">@L["NationalID"]</label>
                <input asp-for="IDNumber" class="form-control" />
                <span asp-validation-for="IDNumber" class="text-danger"></span>
            </div>
            <div data-location-cascade
                 data-countries-url="@Url.Action("Countries", "Lookup")"
                 data-governorates-url="@Url.Action("Governorates", "Lookup")"
                 data-cities-url="@Url.Action("Cities", "Lookup")"
                 data-arabic="@(LanguageHelper.IsArabic() ? "1" : "0")"
                 data-placeholder="@L["Select"]"
                 data-selected-country="@Model.CountryId"
                 data-selected-governorate="@Model.GovernorateId"
                 data-selected-city="@Model.TownId">
                <div class="form-group">
                    <label class="control-label">@L["Country"]</label>
                    <select name="CountryId" class="form-select" data-cascade-level="country"></select>
                </div>
                <div class="form-group">
                    <label class="control-label">@L["Governorate"]</label>
                    <select name="GovernorateId" class="form-select" data-cascade-level="governorate" disabled></select>
                </div>
                <div class="form-group">
                    <label asp-for="TownId" class="control-label">@L["City"]</label>
                    <select asp-for="TownId" class="form-select" data-cascade-level="city" disabled></select>
                    <span asp-validation-for="TownId" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label">@L["Address"]</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BranchId" class="control-label">@L["Branch"]</label>
                <select asp-for="BranchId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Branches)
                    {
                        <option value="@item.Id" selected="@(Model.BranchId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobId" class="control-label">@L["Job"]</label>
                <select asp-for="JobId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Jobs)
                    {
                        <option value="@item.Id" selected="@(Model.JobId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="JobId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SalaryType" class="control-label">@L["SalaryType"]</label>
                <select asp-for="SalaryType" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.SalaryTypes)
                    {
                        <option value="@item.Id" selected="@(Model.SalaryType.HasValue && (int)Model.SalaryType.Value == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="SalaryType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Salary" class="control-label">@L["Salary"]</label>
                <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile" class="control-label">@L["Image"]</label>
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mb-2">
                        <img src="@Model.Image" alt="@Model.ArName" class="rounded" style="width:80px; height:80px; object-fit:cover;" />
                    </div>
                }
                <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Personal"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="Email" class="control-label">@L["Emp.Email"]</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Religion" class="control-label">@L["Emp.Religion"]</label>
                    <select asp-for="Religion" class="form-control" asp-items="Html.GetLocalizedEnumNameSelectList<Shared.Enums.Religion>(L, Model.Religion)">
                        <option value="">@L["Select"]</option>
                    </select>
                    <span asp-validation-for="Religion" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NationalityId" class="control-label">@L["Emp.NationalityId"]</label>
                    <select asp-for="NationalityId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.Nationalities)
                        {
                            <option value="@item.Id" selected="@(Model.NationalityId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="NationalityId" class="text-danger"></span>
                </div>
                </div>
            </div>
            </div>
            <div class="tab-pane fade emp-pane" id="pane-Identity" role="tabpanel" aria-labelledby="tab-Identity" tabindex="0">

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Identity"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="NationalIdIssueDate" class="control-label">@L["Emp.NationalIdIssueDate"]</label>
                    <input asp-for="NationalIdIssueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="NationalIdIssueDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NationalIdExpiryDate" class="control-label">@L["Emp.NationalIdExpiryDate"]</label>
                    <input asp-for="NationalIdExpiryDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="NationalIdExpiryDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="BorderEntryDate" class="control-label">@L["Emp.BorderEntryDate"]</label>
                    <input asp-for="BorderEntryDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="BorderEntryDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ProfessionInId" class="control-label">@L["Emp.ProfessionInId"]</label>
                    <input asp-for="ProfessionInId" class="form-control" />
                    <span asp-validation-for="ProfessionInId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ActualProfession" class="control-label">@L["Emp.ActualProfession"]</label>
                    <input asp-for="ActualProfession" class="form-control" />
                    <span asp-validation-for="ActualProfession" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="VisaNumber" class="control-label">@L["Emp.VisaNumber"]</label>
                    <input asp-for="VisaNumber" class="form-control" />
                    <span asp-validation-for="VisaNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Port" class="control-label">@L["Emp.Port"]</label>
                    <input asp-for="Port" class="form-control" />
                    <span asp-validation-for="Port" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IssuingAuthority" class="control-label">@L["Emp.IssuingAuthority"]</label>
                    <input asp-for="IssuingAuthority" class="form-control" />
                    <span asp-validation-for="IssuingAuthority" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Sponsor"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="SponsorName" class="control-label">@L["Emp.SponsorName"]</label>
                    <input asp-for="SponsorName" class="form-control" />
                    <span asp-validation-for="SponsorName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SponsorPhone" class="control-label">@L["Emp.SponsorPhone"]</label>
                    <input asp-for="SponsorPhone" class="form-control" />
                    <span asp-validation-for="SponsorPhone" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Driving"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="DrivingLicenseNumber" class="control-label">@L["Emp.DrivingLicenseNumber"]</label>
                    <input asp-for="DrivingLicenseNumber" class="form-control" />
                    <span asp-validation-for="DrivingLicenseNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DrivingLicenseIssueDate" class="control-label">@L["Emp.DrivingLicenseIssueDate"]</label>
                    <input asp-for="DrivingLicenseIssueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="DrivingLicenseIssueDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DrivingLicenseExpiryDate" class="control-label">@L["Emp.DrivingLicenseExpiryDate"]</label>
                    <input asp-for="DrivingLicenseExpiryDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="DrivingLicenseExpiryDate" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full" data-row-list data-prefix="Documents">
                <h2 class="ad-section-title">@L["Emp.Section.Documents"]</h2>
                <div class="ad-rows" data-rows>
                    @for (var i = 0; i < Model.Documents.Count; i++)
                    {
                        <div class="ad-row-item" data-row>
                            <input type="hidden" name="Documents[@i].Id" value="@Model.Documents[i].Id" />
                        <div class="form-group"><label class="control-label">@L["Emp.Row.DocName"]</label><input type="text" name="Documents[@i].Name" value="@Model.Documents[i].Name" class="form-control" maxlength="150" /></div>
                        <div class="form-group"><label class="control-label">@L["Emp.Row.File"]</label><input type="file" name="Documents[@i].File" class="form-control" /><input type="hidden" name="Documents[@i].Url" value="@Model.Documents[i].Url" />@if (!string.IsNullOrEmpty(Model.Documents[i].Url)){<a href="@Model.Documents[i].Url" target="_blank" rel="noopener">@L["Emp.Row.Current"]</a>}</div>
                        <button type="button" class="btn-ad btn-ad-danger btn-icon" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                        </div>
                    }
                </div>
                <button type="button" class="btn-ad btn-ad-ghost mb-3" data-row-add><i class="fas fa-plus" aria-hidden="true"></i> @L["Emp.Row.Add"]</button>
                <template data-row-template>
                    <div class="ad-row-item" data-row>
                        <input type="hidden" name="Documents[__i__].Id" value="0" />
                        <div class="form-group"><label class="control-label">@L["Emp.Row.DocName"]</label><input type="text" name="Documents[__i__].Name"  class="form-control" maxlength="150" /></div>
                        <div class="form-group"><label class="control-label">@L["Emp.Row.File"]</label><input type="file" name="Documents[__i__].File" class="form-control" /><input type="hidden" name="Documents[__i__].Url"  /></div>
                        <button type="button" class="btn-ad btn-ad-danger btn-icon" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                    </div>
                </template>
            </div>
            </div>
            <div class="tab-pane fade emp-pane" id="pane-Job" role="tabpanel" aria-labelledby="tab-Job" tabindex="0">

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Job"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="Administration" class="control-label">@L["Emp.Administration"]</label>
                    <input asp-for="Administration" class="form-control" />
                    <span asp-validation-for="Administration" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="HireDate" class="control-label">@L["Emp.HireDate"]</label>
                    <input asp-for="HireDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="HireDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContractDate" class="control-label">@L["Emp.ContractDate"]</label>
                    <input asp-for="ContractDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="ContractDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContractEndDate" class="control-label">@L["Emp.ContractEndDate"]</label>
                    <input asp-for="ContractEndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="ContractEndDate" class="text-danger"></span>
                </div>
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="IsActive" type="checkbox" /> @L["Emp.IsActive"]</label>
                </div>
                <div class="form-group">
                    <label asp-for="Notes" class="control-label">@L["Emp.Notes"]</label>
                    <input asp-for="Notes" class="form-control" />
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full" data-fk-selects>
                <h2 class="ad-section-title">@L["Emp.Section.Org"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="DepartmentId" class="control-label">@L["Emp.DepartmentId"]</label>
                    <select asp-for="DepartmentId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.Departments)
                        {
                            <option value="@item.Id" selected="@(Model.DepartmentId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContractTypeId" class="control-label">@L["Emp.ContractTypeId"]</label>
                    <select asp-for="ContractTypeId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.ContractTypes)
                        {
                            <option value="@item.Id" selected="@(Model.ContractTypeId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="ContractTypeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SpecializationId" class="control-label">@L["Emp.SpecializationId"]</label>
                    <select asp-for="SpecializationId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.Specializations)
                        {
                            <option value="@item.Id" selected="@(Model.SpecializationId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="SpecializationId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="JobTypeId" class="control-label">@L["Emp.JobTypeId"]</label>
                    <select asp-for="JobTypeId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.JobTypes)
                        {
                            <option value="@item.Id" selected="@(Model.JobTypeId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="JobTypeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="InsuranceCategoryId" class="control-label">@L["Emp.InsuranceCategoryId"]</label>
                    <select asp-for="InsuranceCategoryId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.InsuranceCategories)
                        {
                            <option value="@item.Id" selected="@(Model.InsuranceCategoryId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="InsuranceCategoryId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="InsuranceCompanyId" class="control-label">@L["Emp.InsuranceCompanyId"]</label>
                    <select asp-for="InsuranceCompanyId" class="form-control">
                        <option value="">@L["Select"]</option>
                        @foreach (var item in Model.InsuranceCompanies)
                        {
                            <option value="@item.Id" selected="@(Model.InsuranceCompanyId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                    <span asp-validation-for="InsuranceCompanyId" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.LeaveDefaults"]</h2>
                <div class="ad-section-grid">
                <div class="form-group">
                    <label asp-for="AnnualLeaveDays" class="control-label">@L["Emp.AnnualLeaveDays"]</label>
                    <input asp-for="AnnualLeaveDays" type="number" min="0" class="form-control" />
                    <span asp-validation-for="AnnualLeaveDays" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SickLeaveDays" class="control-label">@L["Emp.SickLeaveDays"]</label>
                    <input asp-for="SickLeaveDays" type="number" min="0" class="form-control" />
                    <span asp-validation-for="SickLeaveDays" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CasualLeaveDays" class="control-label">@L["Emp.CasualLeaveDays"]</label>
                    <input asp-for="CasualLeaveDays" type="number" min="0" class="form-control" />
