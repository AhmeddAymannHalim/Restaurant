@model Restaurant.Data.Models.Invoice

@{
    ViewData["Title"] = "DeleteInvoice";
}


<div style="direction:rtl;">

    <dl class="row bg-light text-dark" style="width:500px;">

        @if (Model.InvoiceType == InvoiceType.Purchases)
        {
            <h1 class="text-center col-sm-12"> حذف فاتورة مشتريات</h1>
        }
        else
        {
            <h1 class="text-center col-sm-12">حذف فاتورة مرتجعات</h1>
        }
        <hr />
        <h3 class="text-center col-sm-12">هل انت متأكد من حذف الفاتورة</h3>
        <br />

        <dt class="col-sm-4">
            كود الفاتورة
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.InvoiceCode)
        </dd>
        <dt class="col-sm-4">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.InvoiceDate)
        </dd>
        <dt class="col-sm-4">
            الخصم
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Discount)
        </dd>
        <dt class="col-sm-4">
            الاجمالي بعد الخصم
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.TotalPrice)
        </dd>
        <dt class="col-sm-4">
            المدفوع
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Paid)
        </dd>
        <dt class="col-sm-4">
            المتبقي
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Remaining)
        </dd>

        <dt class="col-sm-4">
            نوع الدفع
        </dt>
        @if (Model.PayType == PayTypes.Cash)
        {
            <dd class="col-sm-7">كاش</dd>
        }
        else
        {
            <dd class="col-sm-7">آجل</dd>
        }

        <dt class="col-sm-4">
            المورد
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Supplier.Name)
        </dd>
        <dt class="col-sm-4">
            المخزن
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Store.Name)
        </dd>
        <dt class="col-sm-4">
            المنتجات
        </dt>
        <dd class="col-sm-10">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <tr>
                    <th>اسم المنتج</th>
                    <th>الوحدة</th>
                    <th>الكمية</th>
                    <th>السعر</th>
                    <th>الاجمالي</th>

                </tr>
                @foreach (var item in Model.InvoiceItems)
                {

                    <tr>
                        <td>@item.StoreProduct.ProductName</td>
                        <td>@item.UnitPrice.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price</td>
                        <td>@item.Total</td>
                    </tr>
                }
            </table>
        </dd>
    </dl>

    <div>
        <form asp-action="DeleteInvoice">
            <input type="submit" value="حذف" class="btn btn-danger" /> |
            <a asp-action="Invoices">عودة للفواتير</a>
        </form>
    </div>
</div>

