@model IEnumerable<OnlineOrder>
@{
    ViewData["Title"] = "Pending Orders";
    Layout = "_Layout1";

}

<h1 class="text-center">طلبات الاونلاين المعلقة</h1>
<hr />
<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>
                الاسم
            </th>
            <th>
                نوع الطلب
            </th>
            <th>
                التار يخ
            </th>
            <th>
                العنوان
            </th>
            <th>
                رقم الموبايل
            </th>
            <th>
                رقم الهاتف
            </th>
            <th>
                الاجمالي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>
                <td>
                    دليفري اونلاين
                </td>
                <td>
                    @item.OrderDate.ToString("hh:mm yyyy-MM-dd")
                </td>
                <td>
                    @item.Address
                </td>
                <td>
                    @item.MobileNumber
                </td>
                <td>
                    @item.PhoneNumber
                </td>
                <td>
                    @item.TotalPrice
                </td>
                <td>
                    @Html.ActionLink("اضافة", "AddOrder", new { id = item.Id }, new{@class="btn btn-primary"}) |
                    <a asp-action="CancelOnlineOrder" asp-controller="Order" asp-route-id="@item.Id" class="btn btn-danger">الغاء</a>
                </td>
            </tr>
        }
    </tbody>
</table>




<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/microsoft-signalr/signalr.min.js"></script>
<script>
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/orderhub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

    connection.start().then(function () {
        console.log("SignalR Connected.");
    }).catch(function (err) {
        return console.error(err.toString());
    });

    connection.on("RefreshOnlineOrders", function () {
        // Reload or update the list of orders here
        location.reload();
    });
</script>
@section Scripts {
    <script src="~/modules/kitchen.js"></script>
}




