@{
    var isManager = User.IsInRole("Admin") || User.IsInRole("Manager");
    var isArabicCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="dash-scrim" data-side-close></div>

<aside class="dash-side" id="dashSide" aria-label="@L["Dashboard"]">
    <button type="button" class="dash-toggle" data-side-toggle aria-controls="dashSide" aria-expanded="true" title="@L["Menu"]">
        <i class="fas fa-bars-staggered" aria-hidden="true"></i><span>@L["Menu"]</span>
    </button>

    <a class="dash-side-link" asp-controller="Dashboard" asp-action="Index" title="@L["Dashboard"]">
        <i class="fas fa-gauge-high" aria-hidden="true"></i><span>@L["Dashboard"]</span>
    </a>

    <label class="side-search">
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <input id="sideFilter" type="search" placeholder="@L["FilterMenu"]" aria-label="@L["FilterMenu"]" autocomplete="off" />
    </label>

    <nav class="side-scroll" aria-label="@L["Definitions"]">
        <div class="side-section">@L["SectionOperations"]</div>

        <section class="side-group">
            <button type="button" class="side-parent" aria-expanded="false" aria-controls="side-operations" title="@L["GroupOperations"]">
                <i class="fas fa-cash-register" aria-hidden="true"></i>
                <span>@L["GroupOperations"]</span>
                <i class="fas fa-chevron-down side-chevron" aria-hidden="true"></i>
            </button>
            <div class="side-children" id="side-operations">
                <div class="side-children-inner">
                    <a class="dash-side-link" asp-controller="Order" asp-action="Upsert" title="@L["NewOrder"]">
                        <i class="fas fa-cash-register" aria-hidden="true"></i><span>@L["NewOrder"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Order" asp-action="Index" title="@L["ShiftSummary"]">
                        <i class="fas fa-gauge" aria-hidden="true"></i><span>@L["ShiftSummary"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Order" asp-action="List" title="@L["Orders"]">
                        <i class="fas fa-bell-concierge" aria-hidden="true"></i><span>@L["Orders"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Order" asp-action="Online" title="@L["OnlineOrders"]">
                        <i class="fas fa-globe" aria-hidden="true"></i><span>@L["OnlineOrders"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="TableReservation" asp-action="Index" title="@L["Reservations"]">
                        <i class="fas fa-calendar-check" aria-hidden="true"></i><span>@L["Reservations"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="KitchenOrder" asp-action="Index" title="@L["KitchenOrders"]">
                        <i class="fas fa-fire-burner" aria-hidden="true"></i><span>@L["KitchenOrders"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="StoreConvert" asp-action="Index" title="@L["StoreConverts"]">
                        <i class="fas fa-right-left" aria-hidden="true"></i><span>@L["StoreConverts"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="StockMovement" asp-action="Index" title="@L["StockMovements"]">
                        <i class="fas fa-arrow-right-arrow-left" aria-hidden="true"></i><span>@L["StockMovements"]</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="side-group">
            <button type="button" class="side-parent" aria-expanded="false" aria-controls="side-invoices" title="@L["Invoices"]">
                <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                <span>@L["Invoices"]</span>
                <i class="fas fa-chevron-down side-chevron" aria-hidden="true"></i>
            </button>
            <div class="side-children" id="side-invoices">
                <div class="side-children-inner">
                    <a class="dash-side-link" asp-controller="Bill" asp-action="Index" asp-route-Type="PUR" title="@(isArabicCulture ? "فاتورة مشتريات" : "Purchase invoice")">
                        <i class="fas fa-cart-shopping" aria-hidden="true"></i><span>@(isArabicCulture ? "فاتورة مشتريات" : "Purchase invoice")</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Bill" asp-action="Index" asp-route-Type="SAL" title="@(isArabicCulture ? "فاتورة مبيعات" : "Sales invoice")">
                        <i class="fas fa-bag-shopping" aria-hidden="true"></i><span>@(isArabicCulture ? "فاتورة مبيعات" : "Sales invoice")</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Bill" asp-action="Index" asp-route-Type="PRET" title="@(isArabicCulture ? "فاتورة مرتجع مشتريات" : "Purchase return invoice")">
                        <i class="fas fa-rotate-left" aria-hidden="true"></i><span>@(isArabicCulture ? "فاتورة مرتجع مشتريات" : "Purchase return invoice")</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Bill" asp-action="Index" asp-route-Type="SRET" title="@(isArabicCulture ? "فاتورة مرتجع مبيعات" : "Sales return invoice")">
                        <i class="fas fa-rotate-left" aria-hidden="true"></i><span>@(isArabicCulture ? "فاتورة مرتجع مبيعات" : "Sales return invoice")</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="side-group">
            <button type="button" class="side-parent" aria-expanded="false" aria-controls="side-entries" title="@(isArabicCulture ? "السندات" : "Entries")">
                <i class="fas fa-book" aria-hidden="true"></i>
                <span>@(isArabicCulture ? "السندات" : "Entries")</span>
                <i class="fas fa-chevron-down side-chevron" aria-hidden="true"></i>
            </button>
            <div class="side-children" id="side-entries">
                <div class="side-children-inner">
                    <a class="dash-side-link" asp-controller="Entry" asp-action="Index" title="@L["Bill.Entries"]">
                        <i class="fas fa-book" aria-hidden="true"></i><span>@L["Bill.Entries"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="SupplierPayment" asp-action="Index" title="@L["SupplierPayments"]">
                        <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i><span>@L["SupplierPayments"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="CustomerPayment" asp-action="Index" title="@L["CustomerPayments"]">
                        <i class="fas fa-hand-holding-dollar" aria-hidden="true"></i><span>@L["CustomerPayments"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Deposit" asp-action="Index" title="@L["Deposits"]">
                        <i class="fas fa-piggy-bank" aria-hidden="true"></i><span>@L["Deposits"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="ExitExpense" asp-action="Index" title="@L["ExitExpenses"]">
                        <i class="fas fa-money-bill-transfer" aria-hidden="true"></i><span>@L["ExitExpenses"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Scrounge" asp-action="Index" title="@L["Scrounges"]">
                        <i class="fas fa-hand-holding-dollar" aria-hidden="true"></i><span>@L["Scrounges"]</span>
                    </a>
                </div>
            </div>
        </section>

        @if (isManager)
        {
            <section class="side-group">
                <button type="button" class="side-parent" aria-expanded="false" aria-controls="side-reports" title="@L["GroupReports"]">
                    <i class="fas fa-chart-column" aria-hidden="true"></i>
                    <span>@L["GroupReports"]</span>
                    <i class="fas fa-chevron-down side-chevron" aria-hidden="true"></i>
                </button>
                <div class="side-children" id="side-reports">
                    <div class="side-children-inner">
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="MoneySafe" title="@L["Report_MoneySafe"]">
                            <i class="fas fa-vault" aria-hidden="true"></i><span>@L["Report_MoneySafe"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Profit" title="@L["Report_Profit"]">
                            <i class="fas fa-chart-line" aria-hidden="true"></i><span>@L["Report_Profit"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Orders" title="@L["Report_Orders"]">
                            <i class="fas fa-bell-concierge" aria-hidden="true"></i><span>@L["Report_Orders"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Drivers" title="@L["Report_Drivers"]">
                            <i class="fas fa-motorcycle" aria-hidden="true"></i><span>@L["Report_Drivers"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Invoices" title="@L["Report_Invoices"]">
                            <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i><span>@L["Report_Invoices"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="SupplierStatement" title="@L["Report_SupplierStatement"]">
                            <i class="fas fa-truck" aria-hidden="true"></i><span>@L["Report_SupplierStatement"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="CustomerStatement" title="@L["Report_CustomerStatement"]">
                            <i class="fas fa-user-tag" aria-hidden="true"></i><span>@L["Report_CustomerStatement"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="SuppliersBalances" title="@L["Report_SuppliersBalances"]">
                            <i class="fas fa-scale-balanced" aria-hidden="true"></i><span>@L["Report_SuppliersBalances"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="SupplierPayments" title="@L["Report_SupplierPayments"]">
                            <i class="fas fa-hand-holding-dollar" aria-hidden="true"></i><span>@L["Report_SupplierPayments"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="CustomerPayments" title="@L["Report_CustomerPayments"]">
                            <i class="fas fa-hand-holding-dollar" aria-hidden="true"></i><span>@L["Report_CustomerPayments"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Deposits" title="@L["Report_Deposits"]">
                            <i class="fas fa-piggy-bank" aria-hidden="true"></i><span>@L["Report_Deposits"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Expenses" title="@L["Report_Expenses"]">
                            <i class="fas fa-receipt" aria-hidden="true"></i><span>@L["Report_Expenses"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Salaries" title="@L["Report_Salaries"]">
                            <i class="fas fa-wallet" aria-hidden="true"></i><span>@L["Report_Salaries"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Report" asp-action="Show" asp-route-report="Scrounges" title="@L["Report_Scrounges"]">
                            <i class="fas fa-coins" aria-hidden="true"></i><span>@L["Report_Scrounges"]</span>
                        </a>
                    </div>
                </div>
            </section>
        }

        <div class="side-section">@L["SectionDefinitions"]</div>

        <section class="side-group">
            <button type="button" class="side-parent" aria-expanded="false" aria-controls="side-definitions" title="@L["Definitions"]">
                <i class="fas fa-sitemap" aria-hidden="true"></i>
                <span>@L["Definitions"]</span>
                <i class="fas fa-chevron-down side-chevron" aria-hidden="true"></i>
            </button>
            <div class="side-children" id="side-definitions">
                <div class="side-children-inner">
                    <a class="dash-side-link" asp-controller="Branch" asp-action="Index" title="@L["Branches"]">
                        <i class="fas fa-code-branch" aria-hidden="true"></i><span>@L["Branches"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Job" asp-action="Index" title="@L["Jobs"]">
                        <i class="fas fa-id-badge" aria-hidden="true"></i><span>@L["Jobs"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Employee" asp-action="Index" title="@L["Employees"]">
                        <i class="fas fa-users" aria-hidden="true"></i><span>@L["Employees"]</span>
                    </a>
                    @if (isManager)
                    {
                        <a class="dash-side-link" asp-controller="EmployeeAccount" asp-action="Index" title="@L["EmployeeAccounts"]">
                            <i class="fas fa-user-lock" aria-hidden="true"></i><span>@L["EmployeeAccounts"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="User" asp-action="Index" title="@L["Users"]">
                            <i class="fas fa-user-group" aria-hidden="true"></i><span>@L["Users"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Role" asp-action="Index" title="@L["Roles"]">
                            <i class="fas fa-user-shield" aria-hidden="true"></i><span>@L["Roles"]</span>
                        </a>
                    }
                    <a class="dash-side-link" asp-controller="Specialization" asp-action="Index" title="@L["Specializations"]">
                        <i class="fas fa-user-graduate" aria-hidden="true"></i><span>@L["Specializations"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="ContractType" asp-action="Index" title="@L["ContractTypes"]">
                        <i class="fas fa-file-signature" aria-hidden="true"></i><span>@L["ContractTypes"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Department" asp-action="Index" title="@L["Departments"]">
                        <i class="fas fa-building" aria-hidden="true"></i><span>@L["Departments"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="JobType" asp-action="Index" title="@L["JobTypes"]">
                        <i class="fas fa-briefcase" aria-hidden="true"></i><span>@L["JobTypes"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="InsuranceCategory" asp-action="Index" title="@L["InsuranceCategories"]">
                        <i class="fas fa-shield-heart" aria-hidden="true"></i><span>@L["InsuranceCategories"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="InsuranceCompany" asp-action="Index" title="@L["InsuranceCompanies"]">
                        <i class="fas fa-building-shield" aria-hidden="true"></i><span>@L["InsuranceCompanies"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="AllowanceType" asp-action="Index" title="@L["AllowanceTypes"]">
                        <i class="fas fa-hand-holding-dollar" aria-hidden="true"></i><span>@L["AllowanceTypes"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="DeductionType" asp-action="Index" title="@L["DeductionTypes"]">
                        <i class="fas fa-circle-minus" aria-hidden="true"></i><span>@L["DeductionTypes"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="LeaveType" asp-action="Index" title="@L["LeaveTypes"]">
                        <i class="fas fa-umbrella-beach" aria-hidden="true"></i><span>@L["LeaveTypes"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Kitchen" asp-action="Index" title="@L["Kitchens"]">
                        <i class="fas fa-kitchen-set" aria-hidden="true"></i><span>@L["Kitchens"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="MenuSection" asp-action="Index" title="@L["MenuSections"]">
                        <i class="fas fa-list" aria-hidden="true"></i><span>@L["MenuSections"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Menu" asp-action="Index" title="@L["MenuItems"]">
                        <i class="fas fa-utensils" aria-hidden="true"></i><span>@L["MenuItems"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Table" asp-action="Index" title="@L["Tables"]">
                        <i class="fas fa-chair" aria-hidden="true"></i><span>@L["Tables"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="DeliveryZone" asp-action="Index" title="@L["DeliveryZones"]">
                        <i class="fas fa-motorcycle" aria-hidden="true"></i><span>@L["DeliveryZones"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Store" asp-action="Index" title="@L["Stores"]">
                        <i class="fas fa-warehouse" aria-hidden="true"></i><span>@L["Stores"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Product" asp-action="Index" title="@L["Products"]">
                        <i class="fas fa-box" aria-hidden="true"></i><span>@L["Products"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="ProductCategory" asp-action="Index" title="@L["ProductCategories"]">
                        <i class="fas fa-tags" aria-hidden="true"></i><span>@L["ProductCategories"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="UnitPrice" asp-action="Index" title="@L["UnitPrices"]">
                        <i class="fas fa-weight-scale" aria-hidden="true"></i><span>@L["UnitPrices"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Supplier" asp-action="Index" title="@L["Suppliers"]">
                        <i class="fas fa-truck" aria-hidden="true"></i><span>@L["Suppliers"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Customer" asp-action="Index" title="@L["Customers"]">
                        <i class="fas fa-user-tag" aria-hidden="true"></i><span>@L["Customers"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="SellType" asp-action="Index" title="@L["SellTypes"]">
                        <i class="fas fa-tags" aria-hidden="true"></i><span>@L["SellTypes"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Classification" asp-action="Index" title="@L["Classifications"]">
                        <i class="fas fa-layer-group" aria-hidden="true"></i><span>@L["Classifications"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="CustomerTier" asp-action="Index" title="@L["CustomerTiers"]">
                        <i class="fas fa-medal" aria-hidden="true"></i><span>@L["CustomerTiers"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Expense" asp-action="Index" title="@L["Expenses"]">
                        <i class="fas fa-receipt" aria-hidden="true"></i><span>@L["Expenses"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Salary" asp-action="Index" title="@L["Salaries"]">
                        <i class="fas fa-wallet" aria-hidden="true"></i><span>@L["Salaries"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="CostCenter" asp-action="Index" title="@L["CostCenters"]">
                        <i class="fas fa-bullseye" aria-hidden="true"></i><span>@L["CostCenters"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Company" asp-action="Index" title="@L["Companies"]">
                        <i class="fas fa-city" aria-hidden="true"></i><span>@L["Companies"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Currency" asp-action="Index" title="@L["Currencies"]">
                        <i class="fas fa-money-bill" aria-hidden="true"></i><span>@L["Currencies"]</span>
                    </a>
                    @if (isManager)
                    {
                        <a class="dash-side-link" asp-controller="ChartAccount" asp-action="Index" title="@L["ChartOfAccounts"]">
                            <i class="fas fa-sitemap" aria-hidden="true"></i><span>@L["ChartOfAccounts"]</span>
                        </a>
                        <a class="dash-side-link" asp-controller="Asset" asp-action="Index" title="@L["Assets"]">
                            <i class="fas fa-building-columns" aria-hidden="true"></i><span>@L["Assets"]</span>
                        </a>
                    }
                    <a class="dash-side-link" asp-controller="Chef" asp-action="Index" title="@L["Chefs"]">
                        <i class="fas fa-user-tie" aria-hidden="true"></i><span>@L["Chefs"]</span>
                    </a>
                    <a class="dash-side-link" asp-controller="Gallery" asp-action="Index" title="@L["Gallery"]">
                        <i class="fas fa-images" aria-hidden="true"></i><span>@L["Gallery"]</span>
                    </a>
                </div>
            </div>
        </section>

        @if (isManager)
        {
            <a class="dash-side-link" asp-controller="ApplicationSetting" asp-action="Index" title="@L["Settings"]">
                <i class="fas fa-gear" aria-hidden="true"></i><span>@L["Settings"]</span>
            </a>
        }
        <a class="dash-side-link is-exit" asp-controller="Account" asp-action="SignOut" title="@L["SignOut"]">
            <i class="fas fa-right-from-bracket" aria-hidden="true"></i><span>@L["SignOut"]</span>
        </a>
    </nav>
</aside>
