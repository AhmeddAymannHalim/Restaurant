@model MoneySafeViewModel

@{
    ViewData["Title"] = "Order Report";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>


<h1>حركة الخزينة بين تاريخين</h1>
<h3>@Model.FromDate.ToString("yyyy-MM-dd")  :   @Model.ToDate.ToString("yyyy-MM-dd")</h3>
<hr />

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr>
            <th class="mainRow">تاريخ التقرير</th>
            <th>@Model.ReportDate</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mainRow">الايرادات</td>
            <td>@Model.Imports</td>
        </tr>
        <tr>
            <td class="mainRow">المبيعات</td>
            <td>@Model.Sales</td>
        </tr>
        <tr>
            <td class="mainRow">مرتجع المشتريات</td>
            <td>@Model.Returns</td>
        </tr>
        <tr>
            <td class="mainRow">المشتريات</td>
            <td>@Model.Purchases</td>
        </tr>
        <tr>
            <td class="mainRow">مصروفات الموظفين </td>

            <td>@Model.EmployeeExpenses</td>
        </tr>

        <tr>
            <td class="mainRow">المصروفات</td>
            <td>@Model.Expenses</td>
        </tr>
        <tr>
            <td class="mainRow">سندات قبض الموردين</td>
            <td>@Model.SupplierPayment</td>
        </tr>
        <tr>
            <td class="mainRow"> اجمالي الواردات</td>
            <td>@Model.TotalImports</td>
        </tr>
        <tr>
            <td class="mainRow"> اجمالي الصادرات</td>
            <td>@Model.TotalExports</td>
        </tr>

        <tr>
            <td class="mainRow">صافي الخزينة</td>
            <td>@Model.TotalMoney</td>
        </tr>


    </tbody>
</table>

