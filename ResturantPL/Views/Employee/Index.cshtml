@model PaginatedResult<EmployeeViewModel>
@{
    ViewBag.Title = L["Employees"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-users" aria-hidden="true"></i></span>
        <h1>@L["Employees"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewEmployee"]</a>
        <a asp-action="Index" asp-controller="EmployeeAccount" class="btn-ad btn-ad-ghost">@L["EmployeeAccounts"]</a>
    </div>
    <div class="bo-card-body">
        <form asp-action="Index" method="get" class="bo-filters">
            <div class="bo-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="Employee-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="bo-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

@await Html.PartialAsync("_TableExportToolbar", "Employee-table")
        <div class="bo-table-wrap">
        <table id="Employee-table" class="bo-table">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Code"]</th>
            <th>@L["Image"]</th>
            <th>@L["Name"]</th>
            <th>@L["Job"]</th>
            <th>@L["Phone"]</th>
            <th>@L["Address"]</th>
            <th>@L["Salary"]</th>
            <th>@L["Branch"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Data.Any())
        {
            var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
            foreach (var item in Model.Data)
            {
                <tr>
                    <td>@counter</td>
                    <td>@item.Code</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@item.Image" alt="@(isArabic ? item.ArName : item.EnName)" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;" />
                        }
                    </td>
                    <td>@(isArabic ? item.ArName : item.EnName)</td>
                    <td>@(isArabic ? item.JobArName : item.JobEnName)</td>
                    <td>@item.PhoneNumber</td>
                    <td>@(isArabic ? item.TownArName : item.TownEnName) - @item.Address</td>
                    <td>@item.BasicSalary</td>
                    <td>@(isArabic ? item.BranchArName : item.BranchEnName)</td>
                    <td class="bo-row-actions">
                        <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                        <button type="button" onclick="Delete('/Employee/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                        <a asp-action="Upsert" asp-controller="EmployeeAccount" asp-route-employeeId="@item.Id" class="btn-ad btn-ad-ghost"><i class="fas fa-user-lock" aria-hidden="true"></i> @(item.HasLoginAccount ? L["EditAccount"] : L["AddAccount"])</a>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="11" class="bo-empty">@L["NoData"]</td>
            </tr>
        }
    </tbody>
</table>
        </div>

<div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
