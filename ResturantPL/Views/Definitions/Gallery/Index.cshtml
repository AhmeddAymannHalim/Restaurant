@model PaginatedResult<GalleryViewModel>
@{
    ViewBag.Title = L["Gallery"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-images" aria-hidden="true"></i></span>
        <h1>@L["Gallery"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewPhoto"]</a>
    </div>
    <div class="ad-card-body">
        <div class="ad-filters"><span class="ad-meta">@L["TotalRecords"]: @Model.TotalRecords</span></div>
@await Html.PartialAsync("_ExportToolbar", "Gallery-table")
        <div class="ad-table-wrap">
        <table id="Gallery-table" class="ad-table">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Image"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Data.Any())
        {
            var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
            foreach (var item in Model.Data)
            {
                <tr>
                    <td>@counter</td>
                    <td><img src="@item.PictureUrl" alt="" style="width:120px;height:80px;object-fit:cover;border-radius:8px" /></td>
                    <td class="ad-row-actions">
                        <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                        <button type="button" onclick="Delete('/Gallery/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="ad-empty">@L["NoData"]</td>
            </tr>
        }
    </tbody>
</table>
        </div>

<div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
