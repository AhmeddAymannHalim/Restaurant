@model ProductViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewProduct"].Value : L["UpdateProduct"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-box" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="ad-card-body">
        <form asp-action="Upsert" method="post" class="ad-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductCategoryId" class="control-label">@L["ProductCategory"]</label>
                <select asp-for="ProductCategoryId" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Categories)
                    {
                        <option value="@item.Id" selected="@(Model.ProductCategoryId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cost" class="control-label">@L["UnitCost"]</label>
                <input asp-for="Cost" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>

            <fieldset class="form-group ad-full ad-stocks" data-row-list data-prefix="Stocks">
                <legend class="control-label">@L["StockPerStore"]</legend>
                <div class="ad-stock-grid" data-rows>
                    @for (var i = 0; i < Model.Stocks.Count; i++)
                    {
                        <div class="ad-stock" data-row>
                            <select name="Stocks[@i].StoreId" class="form-select">
                                <option value="">@L["Select"]</option>
                                @foreach (var store in Model.Stores)
                                {
                                    <option value="@store.Id" selected="@(Model.Stocks[i].StoreId == store.Id)">@(LanguageHelper.IsArabic() ? store.ArName : store.EnName)</option>
                                }
                            </select>
                            <input type="number" name="Stocks[@i].Quantity" value="@Model.Stocks[i].Quantity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" step="0.001" min="0" class="form-control" placeholder="@L["Quantity"]" />
                            <button type="button" class="btn-ad btn-ad-danger btn-icon" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                            @Html.ValidationMessage($"Stocks[{i}].StoreId", new { @class = "text-danger ad-stock-error" })
                            @Html.ValidationMessage($"Stocks[{i}].Quantity", new { @class = "text-danger ad-stock-error" })
                        </div>
                    }
                </div>
                @Html.ValidationMessage("Stocks", new { @class = "text-danger d-block" })
                <button type="button" class="btn-ad btn-ad-ghost" data-row-add><i class="fas fa-plus" aria-hidden="true"></i> @L["AddLine"]</button>
                <template data-row-template>
                    <div class="ad-stock" data-row>
                        <select name="Stocks[__i__].StoreId" class="form-select">
                            <option value="">@L["Select"]</option>
                            @foreach (var store in Model.Stores)
                            {
                                <option value="@store.Id">@(LanguageHelper.IsArabic() ? store.ArName : store.EnName)</option>
                            }
                        </select>
                        <input type="number" name="Stocks[__i__].Quantity" value="0" step="0.001" min="0" class="form-control" placeholder="@L["Quantity"]" />
                        <button type="button" class="btn-ad btn-ad-danger btn-icon" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                    </div>
                </template>
            </fieldset>

            <div class="ad-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/Product/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
