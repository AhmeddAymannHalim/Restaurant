@model AccountDefinitionViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewAccount"].Value : L["UpdateAccount"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-sitemap" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="bo-card-body">
        <form asp-action="Upsert" method="post" class="bo-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Code" class="control-label">@L["Code"]</label>
                <input asp-for="Code" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Kind" class="control-label">@L["Account.Kind"]</label>
                @if (isNew)
                {
                    <select asp-for="Kind" class="form-control">
                        <option value="@((int)AccountKind.GeneralLedger)" selected="@(Model.Kind == AccountKind.GeneralLedger)">@L["Account.Kind.GeneralLedger"]</option>
                        <option value="@((int)AccountKind.Bank)" selected="@(Model.Kind == AccountKind.Bank)">@L["Account.Kind.Bank"]</option>
                        <option value="@((int)AccountKind.Safe)" selected="@(Model.Kind == AccountKind.Safe)">@L["Account.Kind.Safe"]</option>
                        <option value="@((int)AccountKind.Expense)" selected="@(Model.Kind == AccountKind.Expense)">@L["Account.Kind.Expense"]</option>
                    </select>
                }
                else
                {
                    <input type="hidden" asp-for="Kind" />
                    <div class="form-control">@L["Account.Kind." + Model.Kind]</div>
                }
                <span asp-validation-for="Kind" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ParentAccountId" class="control-label">@L["Account.Parent"]</label>
                <select asp-for="ParentAccountId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Parents)
                    {
                        <option value="@item.Id" selected="@(Model.ParentAccountId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="ParentAccountId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrencyId" class="control-label">@L["Account.Currency"]</label>
                <select asp-for="CurrencyId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Currencies)
                    {
                        <option value="@item.Id" selected="@(Model.CurrencyId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
            </div>
            @if (isNew)
            {
                <div class="form-group">
                    <label asp-for="OpeningBalance" class="control-label">@L["Account.OpeningBalance"]</label>
                    <input asp-for="OpeningBalance" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="OpeningBalance" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="control-label">@L["Account.Balance"]</label>
                    <div class="form-control">@Model.Balance.ToString("N2")</div>
                </div>
            }
            <div class="form-group">
                <label asp-for="MaxDebitAllowed" class="control-label">@L["Account.MaxDebitAllowed"]</label>
                <input asp-for="MaxDebitAllowed" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="MaxDebitAllowed" class="text-danger"></span>
            </div>
            <div class="form-group bo-check">
                <label class="control-label"><input asp-for="RequiresCostCenter" type="checkbox" /> @L["Account.RequiresCostCenter"]</label>
            </div>
            <div class="form-group bo-full">
                <label asp-for="Remarks" class="control-label">@L["Bill.Remarks"]</label>
                <input asp-for="Remarks" class="form-control" />
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
                @if (!isNew)
                {
                    <button type="button" onclick="Delete('/ChartAccount/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push"><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
