@model Restaurant.Data.Models.Order

@{
    ViewData["Title"] = "Move";
    Layout = "_Layout1";
}


<form asp-action="Move">

    <div class="row justify-content-between text-center m-5">
        <input hidden asp-for="Id" />

        <div class="col-md-5">
            <table class="mt-3 table table-bordered table-light text-dark">
                <h3 class="text-center">@Model.Table.Name</h3>
                <thead>
                    <tr>
                        <th></th>
                        <th>اسم المنتج</th>
                        <th>كمية المنتج</th>
                        <th>سعر الوحدة</th>
                        <th>الاجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderMenuItems)
                    {
                        <tr>
                            <td><input type="radio" name="OrderMenuItemId" value="@item.Id" /></td>
                            <td>@item.MenuItem.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.PriceForUnit</td>
                            <td>@item.Price</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-5 mt-3">
            <div class="form-group" id="tableIdField">
                <h3 class="control-label">الطاولة المنقول اليها</h3>
                <select id="OrderTableToId" name="OrderTableToId" class="form-control" asp-items="ViewBag.Tables" required>
                    <option value="">اختر الطاولة</option>
                </select>
            </div>
        </div>


        <div class="col-md-12 mt-3">

            <button type="submit" class="btn btn-primary" style="width:300px;">نقل</button>
        </div>
    </div>
</form>
