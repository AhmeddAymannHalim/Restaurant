@model HomeViewModel
@{
    ViewData["Title"] = L["Home"].Value;
}

<div class="ws">

    <section class="ff-banner" id="ws-top" data-hero="@Model.ImageUrl">
        <div class="ff-banner-inner">
            <h6 class="animated fadeIn">@L["WelcomeTo"]</h6>
            <h1 class="animated fadeInDown"><span class="lang-ar">@Model.ArName</span><span class="lang-en">@Model.EnName</span></h1>
            <p class="animated fadeInUp">@L["HeroTagline"]</p>
            <div class="ws-actions animated fadeInUp">
                <a class="ff-btn" href="#menu">@L["ViewMenu"]</a>
                <a class="ff-btn ff-btn-line" asp-controller="Reservation" asp-action="Book">@L["Reservation.Cta"]</a>
                <a class="ff-play glightbox" href="@Model.VideoUrl" aria-label="@L["PlayVideo"]"><i class="bi bi-play-fill" aria-hidden="true"></i></a>
            </div>
        </div>
    </section>

    <section class="ff-sec" id="about">
        <div class="ws-wrap ff-welcome">
            <img class="ff-welcome-img is-art wow fadeInLeft" id="welcomeImage" data-image="@Model.ImageUrl" src="~/assets/img/foodfun/welcome-bg.png" alt="" loading="lazy" />
            <div class="wow fadeInRight" data-wow-delay=".2s">
                <h2 class="ff-title">@L["AboutUs"]</h2>
                <p class="lang-ar">@Model.ArDescription</p>
                <p class="lang-en">@Model.EnDescription</p>
                <a class="ff-btn" asp-controller="Reservation" asp-action="Book">@L["Reservation.Cta"]</a>
            </div>
        </div>
    </section>

    <section class="ff-sec ff-menu" id="menu"
             data-url="@Url.Action("MenuItems", "Home")"
             data-currency="@L["Currency"]"
             data-add="@L["AddToBasket"]"
             data-made-of="@L["MadeOf"]"
             data-size-small="@L["Size.Small"]"
             data-size-medium="@L["Size.Medium"]"
             data-size-large="@L["Size.Large"]"
             data-size-syrian-bread="@L["Size.Syrian_Bread"]"
             data-size-regular="@L["Size.regular"]"
             data-empty="@L["NoMenuItems"]"
             data-failed="@L["MenuLoadFailed"]">
        <div class="ws-wrap">
            <h2 class="ff-title is-center wow fadeInUp">@L["OurMenu"]</h2>

            <div class="ws-tabs-wrap wow fadeInUp">
                <div class="ws-tabs" role="tablist" aria-label="@L["OurMenu"]">
                    <button type="button" class="ws-tab is-on" role="tab" data-section="">@L["AllCategories"]</button>
                    @foreach (var category in Model.MenuSections)
                    {
                        <button type="button" class="ws-tab" role="tab" data-section="@category.Id"><span class="lang-ar">@category.ArName</span><span class="lang-en">@category.EnName</span></button>
                    }
                </div>
            </div>

            <div class="ws-dishes" id="dishes" aria-live="polite"></div>
        </div>
    </section>

    <section class="ff-order">
        <h2><span class="lang-ar">@Model.ArName</span><span class="lang-en">@Model.EnName</span></h2>
        <p>@L["HeroTagline"]</p>
        <a class="ff-btn" asp-controller="Reservation" asp-action="Book">@L["Reservation.Cta"]</a>
    </section>

    <section class="ff-sec" id="chefs">
        <div class="ws-wrap">
            <h2 class="ff-title is-center wow fadeInUp">@L["Chefs"]</h2>
            <div class="ff-chefs owl-carousel" id="chefList">
                @foreach (var chef in Model.Chefs)
                {
                    <figure class="ff-chef">
                        <img src="@chef.ImageUrl" alt="" loading="lazy" />
                        <figcaption>
                            <strong><span class="lang-ar">@chef.ArName</span><span class="lang-en">@chef.EnName</span></strong>
                            <span>@chef.Jop</span>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>

    <section class="ff-sec" id="gallery">
        <div class="ws-wrap">
            <h2 class="ff-title is-center wow fadeInUp">@L["OurGallery"]</h2>
            <div class="ff-gallery">
                @foreach (var photo in Model.Gallery)
                {
                    <a class="ff-shot glightbox wow fadeInUp" href="@photo.PictureUrl" data-gallery="ws"><img src="@photo.PictureUrl" alt="" loading="lazy" /></a>
                }
            </div>
        </div>
    </section>

    <section class="ff-z4u" id="z4u">
        <div class="ff-z4u-inner">
            <div class="wow fadeInLeft">
                <h2>@L["Z4uTitle"]</h2>
                <p>@L["Z4uText"]</p>
                <h3 class="ff-z4u-sub">@L["Z4uServicesTitle"]</h3>
                <ul class="ff-z4u-list">
                    <li>@L["Z4uService1"]</li>
                    <li>@L["Z4uService2"]</li>
                    <li>@L["Z4uService3"]</li>
                    <li>@L["Z4uService4"]</li>
                    <li>@L["Z4uService5"]</li>
                </ul>
                <p class="ff-z4u-stack">@L["Z4uStack"]</p>
            </div>
            <div class="ff-z4u-ceo wow fadeInRight" data-wow-delay=".2s">
                <img class="ff-z4u-logo" src="~/assets/img/z4u-logo.jpg" alt="Z4U Solutions" loading="lazy" />
                <small>@L["Z4uSince"]</small>
                <strong>@L["Z4uCeoName"]</strong>
                <span>@L["Z4uCeoRole"]</span>
            </div>
        </div>
    </section>

    <section class="ff-sec ff-contact" id="contact">
        <div class="ws-wrap">
            <h2 class="ff-title is-center wow fadeInUp">@L["Contact"]</h2>
            <div class="ff-info">
                <div class="ff-card wow fadeInUp" data-value="@Model.EnLocation@Model.ArLocation">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <h3>@L["OurLocation"]</h3>
                    <p class="lang-ar">@Model.ArLocation</p>
                    <p class="lang-en">@Model.EnLocation</p>
                </div>
                <div class="ff-card wow fadeInUp" data-value="open">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    <h3>@L["WorkingHours"]</h3>
                    <p><span data-day="@Model.StartDay">@Model.StartDay</span> - <span data-day="@Model.EndDay">@Model.EndDay</span></p>
                    <p dir="ltr">@Model.StartHour - @Model.EndHour</p>
                </div>
                <div class="ff-card wow fadeInUp" data-value="@Model.Email">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <h3>@L["Email"]</h3>
                    <p><a href="mailto:@Model.Email">@Model.Email</a></p>
                </div>
                <div class="ff-card wow fadeInUp" data-value="@Model.Phone">
                    <i class="bi bi-telephone" aria-hidden="true"></i>
                    <h3>@L["Phone"]</h3>
                    <p><a href="tel:@Model.Phone" dir="ltr">@Model.Phone</a></p>
                </div>
            </div>
        </div>
    </section>

    <footer class="ff-foot">
        <span>&copy; <span id="year"></span> <span class="lang-ar">@Model.ArName</span><span class="lang-en">@Model.EnName</span>. @L["FooterRights"]</span>
        <span class="ff-foot-by"><img src="~/assets/img/z4u-logo.jpg" alt="" />@L["Z4uPowered"]</span>
    </footer>
</div>

<div id="dayNames" hidden
     data-saturday="@L["Day.Saturday"]"
     data-sunday="@L["Day.Sunday"]"
     data-monday="@L["Day.Monday"]"
     data-tuesday="@L["Day.Tuesday"]"
     data-wednesday="@L["Day.Wednesday"]"
     data-thursday="@L["Day.Thursday"]"
     data-friday="@L["Day.Friday"]"></div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
