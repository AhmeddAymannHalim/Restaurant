@model ScroungeByDatesViewModel

@if (Model.Scrounges.Count() > 0)
{
    foreach (var item in Model.Scrounges)
    {
        <tr>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Info</td>
            <td>@item.Employee.FullName</td>
            <td>@item.User.FullName</td>
            <td>@(item.State == MoneyState.Incentive ? "حافز" : item.State == MoneyState.Dept ? "سلفة" : "خصم")</td>
            <td>@item.Amount</td>
        </tr>
    }
    <tr>
        <td class="text-danger"><strong>الاجمالي</strong> </td>
        <td colspan="5"><strong>@Model.Total</strong></td>
    </tr>
}
else
{
    <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
}