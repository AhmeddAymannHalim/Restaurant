@model PaymentByDatesViewModel

@{
    ViewData["Title"] = "Imports by dates";
    Layout = null;
}

<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>



<h1>تقرير سندات صرف الموردين بين تاريخين </h1>
<h3>@Model.FromDate.ToString("yyyy-MM-dd")  :   @Model.ToDate.ToString("yyyy-MM-dd")</h3>
<hr />
<p>تاريخ الطباعة : @Model.PrintDate</p>

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>كود الفاتورة</th>
            <th>اسم المورد</th>
            <th>التاريخ</th>
            <th>الوصف</th>
            <th>المبلغ المدفوع</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Payments.Count() > 0)
        {
            foreach (var item in Model.Payments)
            {
                <tr>
                    <td>@item.ProcessCode</td>
                    <td>@item.Supplier.ArName</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>@item.Description</td>
                    <td>@item.Paid</td>
                </tr>
            }
            <tr>
                <td class="text-danger"><strong>الاجمالي</strong> </td>
                <td colspan="4"><strong>@Model.Total</strong></td>
            </tr>
        }
        else
        {
            <tr><td colspan='5'>لا توجد نتائج للعرض</td></tr>
        }
    </tbody>
</table>






