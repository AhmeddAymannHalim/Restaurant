@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isManager = User.IsInRole("Admin") || User.IsInRole("Manager");

    var groups = new (string Section, string Title, string Icon, (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[] Items)[]
    {
            ("SectionOperations", "GroupOperations", "fa-cash-register", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Order", "Upsert", "fa-cash-register", "NewOrder", false),
                ("Order", "Index", "fa-gauge", "ShiftSummary", false),
                ("Order", "List", "fa-bell-concierge", "Orders", false),
                ("Order", "Online", "fa-globe", "OnlineOrders", false),
                ("KitchenOrder", "Index", "fa-fire-burner", "KitchenOrders", false),
                ("Bill", "Index", "fa-file-invoice-dollar", "Erp.Bills", false),
                ("Entry", "Index", "fa-book", "Erp.Entries", false),
                ("StoreConvert", "Index", "fa-right-left", "StoreConverts", false),
                ("StockMovement", "Index", "fa-arrow-right-arrow-left", "StockMovements", false),
                ("SupplierPayment", "Index", "fa-file-invoice-dollar", "SupplierPayments", false),
                ("CustomerPayment", "Index", "fa-hand-holding-dollar", "CustomerPayments", false),
            }),
            ("SectionOperations", "GroupReports", "fa-chart-column", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Report", "Index", "fa-chart-column", "Reports", true),
            }),
            ("SectionDefinitions", "GroupOrganization", "fa-sitemap", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Branch", "Index", "fa-code-branch", "Branches", false),
                ("Job", "Index", "fa-id-badge", "Jobs", false),
                ("Employee", "Index", "fa-users", "Employees", false),
                ("EmployeeAccount", "Index", "fa-user-lock", "EmployeeAccounts", true),
                ("User", "Index", "fa-user-group", "Users", true),
                ("Role", "Index", "fa-user-shield", "Roles", true),
                ("Specialization", "Index", "fa-user-graduate", "Specializations", false),
                ("ContractType", "Index", "fa-file-signature", "ContractTypes", false),
                ("Department", "Index", "fa-building", "Departments", false),
                ("JobType", "Index", "fa-briefcase", "JobTypes", false),
                ("InsuranceCategory", "Index", "fa-shield-heart", "InsuranceCategories", false),
                ("InsuranceCompany", "Index", "fa-building-shield", "InsuranceCompanies", false),
                ("LeaveType", "Index", "fa-umbrella-beach", "LeaveTypes", false),
            }),
            ("SectionDefinitions", "GroupKitchen", "fa-utensils", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Kitchen", "Index", "fa-kitchen-set", "Kitchens", false),
                ("MenuSection", "Index", "fa-list", "MenuSections", false),
                ("Menu", "Index", "fa-utensils", "MenuItems", false),
                ("Table", "Index", "fa-chair", "Tables", false),
                ("DeliveryZone", "Index", "fa-motorcycle", "DeliveryZones", false),
            }),
            ("SectionDefinitions", "GroupInventory", "fa-boxes-stacked", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Store", "Index", "fa-warehouse", "Stores", false),
                ("Product", "Index", "fa-box", "Products", false),
                ("ProductCategory", "Index", "fa-tags", "ProductCategories", false),
                ("UnitPrice", "Index", "fa-weight-scale", "UnitPrices", false),
            }),
            ("SectionDefinitions", "GroupPartners", "fa-handshake", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Supplier", "Index", "fa-truck", "Suppliers", false),
                ("Customer", "Index", "fa-user-tag", "Customers", false),
                ("SellType", "Index", "fa-tags", "SellTypes", false),
                ("Classification", "Index", "fa-layer-group", "Classifications", false),
                ("CustomerTier", "Index", "fa-medal", "CustomerTiers", false),
            }),
            ("SectionDefinitions", "GroupFinance", "fa-coins", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Expense", "Index", "fa-receipt", "Expenses", false),
                ("ExitExpense", "Index", "fa-money-bill-transfer", "ExitExpenses", false),
                ("Deposit", "Index", "fa-piggy-bank", "Deposits", false),
                ("Scrounge", "Index", "fa-hand-holding-dollar", "Scrounges", false),
                ("Salary", "Index", "fa-wallet", "Salaries", false),
                ("CostCenter", "Index", "fa-bullseye", "CostCenters", false),
                ("Company", "Index", "fa-city", "Companies", false),
                ("Currency", "Index", "fa-money-bill", "Currencies", false),
                ("ChartAccount", "Index", "fa-sitemap", "ChartOfAccounts", true),
                ("Asset", "Index", "fa-building-columns", "Assets", true),
            }),
            ("SectionDefinitions", "Website", "fa-globe", new (string Controller, string Action, string Icon, string Label, bool ManagementOnly)[]
            {
                ("Chef", "Index", "fa-user-tie", "Chefs", false),
                ("Gallery", "Index", "fa-images", "Gallery", false),
            }),
    };

    string Active((string Controller, string Action, string Icon, string Label, bool ManagementOnly) item)
    {
        var sameController = string.Equals(controller, item.Controller, StringComparison.OrdinalIgnoreCase);
        var shared = groups.SelectMany(g => g.Items).Count(i => i.Controller == item.Controller) > 1;

        return sameController && (!shared || string.Equals(action, item.Action, StringComparison.OrdinalIgnoreCase)) ? "is-active" : "";
    }
}

<div class="dash-scrim" data-side-close></div>

<aside class="dash-side" id="dashSide" aria-label="@L["Dashboard"]">
    <button type="button" class="dash-toggle" data-side-toggle aria-controls="dashSide" aria-expanded="true" title="@L["Menu"]">
        <i class="fas fa-bars-staggered" aria-hidden="true"></i><span>@L["Menu"]</span>
    </button>

    @if (!User.IsInRole("User"))
    {
        <a class="dash-side-link @(string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" asp-controller="Dashboard" asp-action="Index" title="@L["Dashboard"]">
            <i class="fas fa-gauge-high" aria-hidden="true"></i><span>@L["Dashboard"]</span>
        </a>
    }

    <label class="side-search">
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        <input id="sideFilter" type="search" placeholder="@L["FilterMenu"]" aria-label="@L["FilterMenu"]" autocomplete="off" />
    </label>

    <nav class="side-scroll" aria-label="@L["Definitions"]">
        @{
            var currentSection = string.Empty;
        }
        @foreach (var group in groups)
        {
            var items = group.Items.Where(i => isManager || !i.ManagementOnly).ToList();
            if (items.Count == 0)
            {
                continue;
            }

            if (group.Section != currentSection)
            {
                currentSection = group.Section;
                <div class="side-section">@L[group.Section]</div>
            }

            var isOpen = items.Any(i => Active(i) != "");
            var panelId = "side-" + group.Title;

            <section class="side-group @(isOpen ? "is-open" : "")">
                <button type="button" class="side-parent" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@panelId" title="@L[group.Title]">
                    <i class="fas @group.Icon" aria-hidden="true"></i>
                    <span>@L[group.Title]</span>
                    <i class="fas fa-chevron-down side-chevron" aria-hidden="true"></i>
                </button>
                <div class="side-children" id="@panelId">
                    <div class="side-children-inner">
                        @foreach (var item in items)
                        {
                            <a class="dash-side-link @Active(item)" asp-controller="@item.Controller" asp-action="@item.Action" title="@L[item.Label]">
                                <i class="fas @item.Icon" aria-hidden="true"></i><span>@L[item.Label]</span>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }
    </nav>

    @if (isManager)
    {
        <a class="dash-side-link @(string.Equals(controller, "ApplicationSetting", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" asp-controller="ApplicationSetting" asp-action="Index" title="@L["Settings"]">
            <i class="fas fa-gear" aria-hidden="true"></i><span>@L["Settings"]</span>
        </a>
    }
    <a class="dash-side-link" asp-controller="Home" asp-action="Index" title="@L["Website"]">
        <i class="fas fa-store" aria-hidden="true"></i><span>@L["Website"]</span>
    </a>
    <a class="dash-side-link is-exit" asp-controller="Account" asp-action="SignOut" title="@L["SignOut"]">
        <i class="fas fa-right-from-bracket" aria-hidden="true"></i><span>@L["SignOut"]</span>
    </a>
</aside>
