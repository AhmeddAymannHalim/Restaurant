@model IEnumerable<Restaurant.DAL.Models.Order>

@{
    ViewData["Title"] = "Pending Online Delivery Orders";
    Layout = "_Layout1";                                 
 }



<h1 class="text-center">طلبات الدليفري الاونلاين المعلقة</h1>

<p>
    <a asp-action="Create">طلب جديد</a>
</p>
<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                كود الطلب
            </th>
            <th>
                تمن الخدمة
            </th>
            <th>
                الضريبة
            </th>
            <th>
                الخصم
            </th>
            <th>
                التار يخ
            </th>
            <th>
                موظف الشيفت البائع
            </th>
            <th>
                اسم العميل
            </th>
            <th>
                اسم الطيار
            </th>
            <th>
                العنوان
            </th>
            <th>
                الاجمالي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.OrderCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Service)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tax)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Discount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)
                </td>
                <td>
                    @item.Seller.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>
                <td>
                    @item.Employee.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalPrice)
                </td>
                <td>
                    @Html.ActionLink("التفاصيل", "Details", new { id = item.Id }) |
                    @Html.ActionLink("دفع", "Pay", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
  




