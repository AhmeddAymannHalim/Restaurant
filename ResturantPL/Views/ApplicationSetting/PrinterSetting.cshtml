@model PrinterSetting

@{
    ViewData["Title"] = "Printer Setting";
}

<h1 class="text-center">اعدادات الطابعات</h1>

<form id="printerForm" asp-action="PrinterSetting" method="post">
    <input asp-for="Id" hidden />


    <div class="form-group col-md-4">
        <label asp-for="PrinterForAllSections" class="control-label">اختر طابعة لكل الاقسام</label>
        <select id="printerDropdown" asp-for="PrinterForAllSections" class="form-control" required>
            <option value="">اختر الطابعة</option>
            @foreach (var printer in ViewBag.InstalledPrinters)
            {
                <option value="@printer">@printer</option>
            }
        </select>
        <span asp-validation-for="PrinterForAllSections" class="text-danger"></span>
    </div>


    <div class="form-group col-md-4">
        <label asp-for="PrinterForCashier" class="control-label">اختر طابعة للكاشير</label>
        <select id="printerDropdown" asp-for="PrinterForCashier" class="form-control" required>
            <option value="">اختر الطابعة</option>
            @foreach (var printer in ViewBag.InstalledPrinters)
            {
                <option value="@printer">@printer</option>
            }
        </select>
        <span asp-validation-for="PrinterForCashier" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4">
        <label asp-for="PrinterForEachSection" class="control-label">اختر طابعة لكل قسم</label>
        <select id="printerDropdown" asp-for="PrinterForEachSection" class="form-control" required>
            <option value="">اختر الطابعة</option>
            @foreach (var printer in ViewBag.InstalledPrinters)
            {
                <option value="@printer">@printer</option>
            }
        </select>
        <span asp-validation-for="PrinterForEachSection" class="text-danger"></span>
    </div>

    <div class="form-group col-md-4 mt-4">
        <input type="submit" value="حفظ" class="btn btn-primary" /> |
        <a asp-action="Index">عودة للاعدادات</a>
    </div>

</form>

