@* @model IEnumerable<Order> *@
    @model ResturantPL.Helper.PaginatedList<Order>
@{
    ViewData["Title"] = "All Orders";
    Layout = "_Layout1";
}

<h1 class="text-center">كل الطلبات</h1>
<hr />



<!-- Pagination Links -->
<div class="pagination d-flex justify-content-between">
    <div>
        @if (Model.HasPreviousPage)
        {
            <a href="?page=@(Model.PageIndex - 1)&pageSize=@Model.PageSize" class="btn btn-primary">&laquo; السابق</a>
        }
    </div>
    <div>
        @if (Model.HasNextPage)
        {
            <a href="?page=@(Model.PageIndex + 1)&pageSize=@Model.PageSize" class="btn btn-primary">التالي &raquo;</a>
        }
    </div>
</div>



<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>
                كود الطلب
            </th>
            <th>
                نوع الطلب
            </th>
            <th>
                التار يخ
            </th>
            <th>
                موظف الشيفت البائع
            </th>
            <th>
                موظف الشيفت المستلم
            </th>
            <th>
                الاجمالي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderCode)
                </td>

                @if (item.Type == OrderType.Hall)
                {
                    <td>
                        صالة
                    </td>
                }
                else if (item.Type == OrderType.Delivery)
                {
                    <td>
                        دليفري
                    </td>
                }
                else if (item.Type == OrderType.Delivery_Online)
                {
                    <td>
                        دليفري اونلاين
                    </td>
                }
                else
                {
                    <td>
                        تيك اواي
                    </td>
                }
                <td>
                    @item.OrderDate.ToString("yyyy-MM-dd")
                </td>
                <td>
                    @item.Seller.FullName
                </td>
                <td>
                    @item.Receiver.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalPrice)
                </td>
                <td>
                    @Html.ActionLink("التفاصيل", "Details", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>