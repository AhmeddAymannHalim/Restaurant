@{
    ViewData["Title"] = "Basket";
}

<section id="basket" class="basket section-bg m-3">
    <div class="container mt-4" data-aos="fade-up" style="min-height:200px;">
        <h2 class="section-title">سلة المشتريات</h2>
        <hr />
        <div id="basket-items" class="row">
            <!-- Basket items will be dynamically inserted here -->
        </div>
    </div>

    <!-- Order Button and Form -->
    <div class="row m-4">
        <div class="col-md-4 ">
            <button id="orderAllButton" class="btn btn-success btn-block" style="width:200px;">طلب الآن</button>
            <form id="orderForm" asp-action="Create" asp-controller="OnlineOrder" style="display: none;">
                <div class="form-group">
                    <input type="text" class="form-control mb-2" name="CustomerName" id="customerName" required placeholder="ادخل اسمك" minlength="3">
                </div>
                <div class="form-group">
                    <input type="text" class="form-control mb-2" name="PhoneNumber" id="phoneNumber"   required placeholder="ادخل رقم هاتفك" maxlength="11" minlength="11">
                </div>
                <div class="form-group">
                    <input type="text" class="form-control mb-2" name="MobileNumber" id="mobileNumber" required placeholder="ادخل رقم موبايلك" maxlength="11">
                </div>
                <div class="form-group">
                    <input type="text" class="form-control mb-2" name="Address" id="address" required placeholder="ادخل عنوانك بالتفصيل" minlength="5">
                </div>
                <!-- Quantity for each item will be dynamically inserted here -->
                <div id="quantityInputs">
                    <!-- Quantity inputs will be dynamically inserted here -->
                </div>

                <input type="text" class="form-control mb-2 total-price-input" name="TotalPrice" placeholder="السعر الإجمالي" readonly>

                <button type="submit" class="btn btn-success btn-block">تأكيد الطلب</button>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Function to display basket items
            function displayBasketItems() {
                var basketItems = JSON.parse(localStorage.getItem('basket')) || [];
                var basketContainer = $('#basket-items');
                basketContainer.empty();
                basketItems.forEach(function (item) {
                    var itemHtml = `
                                                                <div class="col-lg-6 mt-4">
                                                                    <div class="row align-items-center">
                                                                        <div class="col-md-4">
                                                                            <img src="${item.imageUrl}" class="menu-img" alt="image" style="max-width: 100%;">
                                                                        </div>
                                                                        <div class="col-md-8">
                                                                            <div class="menu-content" style="font-size:22px;">
                                                                                <span>${item.name} -- </span> <span>$${item.price}</span>
                                                                            </div>
                                                                            <div class="menu-ingredients" style="direction: rtl;">
                                                                                ${item.description}
                                                                            </div>
                                                                            <div>
                                                                                <button class="btn-menu delete-from-basket btn btn-primary mt-2"
                                                                                    data-id="${item.id}"
                                                                                    data-name="${item.name}"
                                                                                    data-price="${item.price}">
                                                                                    حذف من السلة
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                         </div>`;
                    basketContainer.append(itemHtml);
                });
            }

            // Call the function to display basket items
            displayBasketItems();

            // Function to remove item from basket
            function removeFromBasket(id) {
                var basketItems = JSON.parse(localStorage.getItem('basket')) || [];
                basketItems = basketItems.filter(function (item) {
                    return item.id !== id;
                });
                localStorage.setItem('basket', JSON.stringify(basketItems));
                //displayBasketItems(); // Update displayed basket items
            }

            // Event listener for delete buttons
            $(document).on('click', '.delete-from-basket', function () {
                const itemId = this.getAttribute('data-id');
                removeFromBasket(itemId);
                $(this).closest('.col-lg-6').remove();
            });

            // Show order form when clicking the order all button
            $('#orderAllButton').click(function () {
                $('#orderForm').show();
                $(this).hide();

                // Append a quantity input field for each item
                var quantityInputs = $('#quantityInputs');
                quantityInputs.empty(); // Clear previous quantity inputs
                $.each(JSON.parse(localStorage.getItem('basket')) || [], function (index, item) {
                    $('<input>').attr({
                        type: 'number',
                        class: 'form-control mb-2 quantity-input',
                        placeholder: 'ادخل الكمية المطلوبة لـ ' + item.name,
                        name: 'quantity-' + item.id
                    }).appendTo(quantityInputs);
                });

            });

            // Calculate total price dynamically based on quantity
            $('#orderForm').on('input', '.quantity-input', function () {
                var totalPrice = 0;
                $('.quantity-input').each(function () {
                    var itemId = $(this).attr('name').split('-')[1];
                    var itemPrice = parseFloat($('#basket-items').find('[data-id="' + itemId + '"]').data('price'));
                    var quantity = parseInt($(this).val()) || 0;
                    totalPrice += itemPrice * quantity;
                });
                $('.total-price-input').val('$' + totalPrice.toFixed(2) + ' + سعر خدمة التوصيل');
            });


            $('#orderForm').submit(function () {

                var index = 0;
                var totalPrice = 0; // Initialize totalPrice variable

                $('#quantityInputs input').each(function () {
                    var itemId = $(this).attr('name').split('-')[1];
                    var quantity = parseInt($(this).val()) || 0;
                    var itemPrice = parseFloat($('#basket-items').find('[data-id="' + itemId + '"]').data('price'));

                    totalPrice += itemPrice * quantity;

                    // Create hidden input fields for each property of the OrderOnlineMenuItemViewModel
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'OnlineOrderMenuItems[' + index + '].MenuItemId',
                        value: itemId
                    }).appendTo('#orderForm');

                    $('<input>').attr({
                        type: 'hidden',
                        name: 'OnlineOrderMenuItems[' + index + '].Quantity',
                        value: quantity
                    }).appendTo('#orderForm');

                    // Increment index
                    index++;
                });
                $('.total-price-input').val(totalPrice.toFixed(2));
                // Submit the form
                localStorage.removeItem('basket');
                displayBasketItems(); // Update displayed basket items (optional)
            });
        });
    </script>
}