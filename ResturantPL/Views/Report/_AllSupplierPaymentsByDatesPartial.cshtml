@model IEnumerable<PaymentInvoiceSupplier>

@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.ProcessCode</td>
            <td>@item.Supplier.Name</td>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Description</td>
            <td>@item.Paid</td>
            <td>
                @Html.ActionLink("التفاصيل", "SupplierInvoiceDetails", "PaymentInvoice", new { id = item.Id })
            </td>
        </tr>
    }
}
else
{
    <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
}