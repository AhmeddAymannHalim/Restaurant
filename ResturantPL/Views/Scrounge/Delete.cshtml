@model Scrounge

@{
    ViewData["Title"] = "Details";

}

<h1 class="text-center">تفاصيل</h1>

<hr />

<div>

    <dl class="row">
        <dt class="col-sm-2">
            الموظف
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Employee.FullName)
        </dd>

        <dt class="col-sm-2">
            المبلغ
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Amount)
        </dd>

        <dt class="col-sm-2">
            نوع المبلغ
        </dt>

        @if (Model.State == MoneyState.Discount)
        {
            <dd class="col-sm-9"> خصم </dd>
        }
        else if (Model.State == MoneyState.Incentive)
        {
            <dd class="col-sm-9">حافز </dd>
        }
        else
        {
            <dd class="col-sm-9"> سلفة </dd>
        }

        <dt class="col-sm-2">
            التاريخ
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Date)
        </dd>

        <dt class="col-sm-2">
            المعلومات
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Info)
        </dd>
        <dt class="col-sm-2">
            المستخدم
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.User.FullName)
        </dd>

    </dl>
</div>

<form asp-action="Delete">
    <input type="submit" value="حذف" class="btn btn-danger" /> |
    <a asp-action="Index">عودة للقائمة</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}