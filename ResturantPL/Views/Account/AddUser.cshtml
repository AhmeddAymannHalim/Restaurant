@model AddUserViewModel
@{
	ViewData["Title"] = "Add User";
}

<h1 class="text-center">اضافة مستخدم</h1>
<hr />

<div class="container m-3">
    <div class="row">
        <div class="col-md-4">
            <form asp-action="AddUser">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="FirstName" class="control-label">الاسم الاول</label>
                    <input asp-for="FirstName" class="form-control" placeholder="الاسم الاول" required="" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="control-label">الاسم الاخير</label>
                    <input asp-for="LastName" class="form-control" placeholder="الاسم الاخير" required="" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="control-label">الايميل</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="الايميل" required="" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PhoneNumber" class="control-label">رقم الهاتف</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="رقم الهاتف" required="" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="UserType" class="control-label">الفئة</label>
                    <select class="text form-control" asp-for="UserType" asp-items="@ViewBag.Roles" required=""></select>
                    <span asp-validation-for="UserType"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="control-label">الرقم السري</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="الرقم السري" required="" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="control-label">تأكيد الرقم السري</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="تأكيد الرقم السري" required="" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
               
                <div class="form-group mt-3">
                    <input type="submit" value="اضافة" class="btn btn-primary" /> |
                    <a asp-action="Index" asp-controller="User">عودة للمستخدمين</a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
