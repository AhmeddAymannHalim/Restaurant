@model Store
@{
    ViewData["Title"] = "Create";
}
<h1 class="text-center">اضافة مخزن جديد</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"> </div>

            <div class="form-group">
                <label asp-for="Name">اسم المخزن</label>
                <input asp-for="Name" class="form-control" required/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address">العنوان</label>
                <input asp-for="Address" class="form-control" required />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MobileNumber">رقم الموبايل</label>
                <input asp-for="MobileNumber" class="form-control" required maxlength="11" minlength="11" />
                <span asp-validation-for="MobileNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">رقم الهاتف</label>
                <input asp-for="PhoneNumber" class="form-control" maxlength="11" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="StorekeeperId">امين المخزن</label>
                <select asp-for="StorekeeperId" class="form-control" asp-items="@ViewBag.Employees">
                    <option value="">اختر امين المخزن</option>
                </select>
                <span asp-validation-for="StorekeeperId" class="text-danger"></span>
                <span id="storekeeperValidationMessage" class="text-danger"></span>
            </div>
           
            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" /> |
                <a asp-action="Index">عودة للمخازن</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        
        $('form').submit(function() {
            var storekeeperId = $('#StorekeeperId').val();
            if (!storekeeperId) {
                $('#storekeeperValidationMessage').text("برجاء اضافة موظف ينتمي لوظيفة امين مخزن");
                return false;
            }
            return true; 
        });
    </script>


}