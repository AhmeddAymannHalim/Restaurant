@model string[]
@{
    ViewBag.Title = L["Reports"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-chart-column" aria-hidden="true"></i></span>
        <h1>@L["Reports"]</h1>
    </div>
    <div class="ad-card-body">
        <div class="online-grid">
            @foreach (var name in Model)
            {
                <a asp-action="Show" asp-route-report="@name" class="online-card report-card">
                    <strong>@L["Report_" + name]</strong>
                    <span>@L["Report_" + name + "_Hint"]</span>
                </a>
            }
        </div>
    </div>
</div>
