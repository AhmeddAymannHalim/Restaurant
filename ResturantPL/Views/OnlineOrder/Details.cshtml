@model PendingOnlineOrderViewModel
@{
    ViewData["Title"] = L["Details"].Value + " #" + Model.Id;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">
    <section class="ws-page">
        <div class="ws-wrap">
            <header class="ws-page-head">
                <h1>@L["MyOrders"] #@Model.Id</h1>
                <p>@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
            </header>

            @if (Model.Status == OnlineOrderStatus.Rejected)
            {
                <ol class="ws-track is-rejected">
                    <li class="is-done"><span></span>@L["StatusWaiting"]</li>
                    <li class="is-done is-rejected-step"><span></span>@L["StatusRejected"]</li>
                </ol>
                <p class="ws-rejection-reason"><strong>@L["RejectionReasonLabel"]:</strong> @Model.RejectionReason</p>
            }
            else
            {
                <ol class="ws-track @(Model.IsPending ? "is-waiting" : "is-accepted")">
                    <li class="is-done"><span></span>@L["StatusWaiting"]</li>
                    <li class="@(Model.IsPending ? "" : "is-done")"><span></span>@L["StatusAccepted"]</li>
                </ol>
            }

            <div class="ws-split">
                <div class="ws-receipt-items">
                    @foreach (var item in Model.Items)
                    {
                        <div class="ws-receipt-row">
                            <div>
                                <h3 class="ws-cart-name">@(isArabic ? item.MenuItemArName : item.MenuItemEnName)</h3>
                                <div class="ws-cart-meta">@item.Quantity.ToString("0.###", CultureInfo.InvariantCulture) x @item.PriceForUnit.ToString("N2") @L["Currency"]</div>
                            </div>
                            <strong>@item.Price.ToString("N2")</strong>
                        </div>
                    }
                </div>

                <aside class="ws-ticket">
                    <h2>@L["YourOrder"]</h2>
                    <dl class="ws-facts">
                        <dt>@L["CustomerName"]</dt>
                        <dd>@Model.CustomerName</dd>
                        @if (Model.TableId.HasValue)
                        {
                            <dt>@L["Table"]</dt>
                            <dd>@(isArabic ? Model.TableArName : Model.TableEnName)</dd>
                        }
                        else
                        {
                            <dt>@L["Address"]</dt>
                            <dd>@Model.Address</dd>
                        }
                        <dt>@L["MobileNumber"]</dt>
                        <dd dir="ltr">@Model.MobileNumber</dd>
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <dt>@L["PhoneNumber"]</dt>
                            <dd dir="ltr">@Model.PhoneNumber</dd>
                        }
                    </dl>

                    <dl class="ws-sums">
                        <div><dt>@L["SubTotal"]</dt><dd>@Model.SubTotal.ToString("N2")</dd></div>
                        @if (Model.Tax > 0)
                        {
                            <div><dt>@L["Tax"]</dt><dd>@Model.Tax.ToString("N2")</dd></div>
                        }
                        @if (Model.Service > 0)
                        {
                            <div><dt>@L["Service"]</dt><dd>@Model.Service.ToString("N2")</dd></div>
                        }
                        @if (!Model.TableId.HasValue && (Model.DeliveryFee > 0 || !string.IsNullOrEmpty(Model.DeliveryZoneArName)))
                        {
                            <div><dt>@L["DeliveryFee"]@(string.IsNullOrEmpty(Model.DeliveryZoneArName) ? "" : " (" + (isArabic ? Model.DeliveryZoneArName : Model.DeliveryZoneEnName) + ")")</dt><dd>@Model.DeliveryFee.ToString("N2")</dd></div>
                        }
                    </dl>
                    <div class="ws-ticket-total">
                        <span>@L["TotalPrice"]</span>
                        <span>@Model.TotalPrice.ToString("N2") @L["Currency"]</span>
                    </div>
                    <a class="ws-link" asp-action="PendingOrders">@L["BackToMyOrders"]</a>
                </aside>
            </div>
        </div>
    </section>
</div>
