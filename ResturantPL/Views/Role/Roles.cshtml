@model IEnumerable<RoleViewModel>

@{
    ViewData["Title"] = "Index";
}




<h1 class="text-center">الفئات</h1>
<hr />


<form asp-action="Roles">
    <div class="form-group w-30">
        <input placeholder="Search by name" name="SearchValue" class="form-control" />
    </div>
    <br />
    <div class="form-group mt-3">
        <input type="submit" value="بحث" class="btn btn-success" />
    </div>
</form>

<br />



<p>
    <a asp-action="AddRole" asp-controller="Role">إضافه فئة جديدة</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>

            <th>
                اسم الفئة
            </th>

            <th> </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(d => item.RoleName)
                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">تفاصيل</a>|
                    <a asp-action="Update" asp-route-id="@item.Id">تعديل</a>|
                    <a onclick="Delete(@item.Id)" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>


<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
@if (TempData["success"] != null)
{
    <script>
        swal("برافو عمل جيد !", "", "success");

    </script>
}
@if (TempData["faild"] != null)
{
    <script>
        swal("فشلت العملية !", "", "error");

    </script>

}
@section Scripts {

    <script src="~/modules/Role.js"></script>
}