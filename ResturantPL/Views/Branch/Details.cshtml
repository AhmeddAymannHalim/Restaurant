@model ResturantPL.ViewModels.BranchViewModel

@{
    ViewData["Title"] = "Details";
}


<h1 class="text-center">تفاصيل بيانات فرع</h1>
<hr />


<div>
   
    <dl class="row">
        
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Code)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Code)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Address)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone1)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Phone1)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone2)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Phone2)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mobile1)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Mobile1)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mobile2)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Mobile2)
        </dd>
        <dt class="col-sm-2">
            الموظفين
        </dt>
        <dd class="col-sm-9">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>
                        <th>
                            الاسم
                        </th>
                        <th>
                            الوظيفة
                        </th>
                        <th>
                            رقم الموبايل
                        </th>
                        <th>
                            رقم الهاتف
                        </th>
                        <th>
                            السن
                        </th>
                        <th>
                            الراتب
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.EmployeeList)
                    {
                        <tr>
                            <td>
                                @item.FirstName @item.LastName
                            </td>
                            <td>
                                @item.UserType
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MobileNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PhoneNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Age)
                            </td>
                        
                            <td>
                                @Html.DisplayFor(modelItem => item.Salary)
                            </td>
                            <td>
                                @Html.ActionLink("تعديل", "UpdateEmployee","Employee", new { id = item.EmployeeId }) |
                                @Html.ActionLink("التفاصيل", "DetailsEmployee", "Employee", new { id = item.EmployeeId }) |
                                @Html.ActionLink("حذف", "DeleteEmployee", "Employee", new { id = item.EmployeeId }) 
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </dd>
    </dl>
</div>

<div>
    <a asp-action="UpdateBranch" asp-route-id="@Model.Id">تعديل</a> |
    <a asp-action="Index">عودة للفروع</a>
</div>
