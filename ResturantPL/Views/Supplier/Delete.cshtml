@model Supplier
@{
    ViewData["Title"] = "Delete";
}



<h1 class="text-center">حذف مورد </h1>

<hr />


<div>
    <dl class="row">

        <dt class="col-sm-2">
            الاسم
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>


        <dt class="col-sm-2">
            العنوان
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Address)
        </dd>

        <dt class="col-sm-2">
            الموبايل
        </dt>
        <dd class="col-sm-9">
            @Model.MobileNumber
        </dd>
        <dt class="col-sm-2">
            الهاتف
        </dt>
        <dd class="col-sm-9">
            @Model.PhoneNumber
        </dd>

        <dt class="col-sm-2">
            الرصيد
        </dt>
        <dd class="col-sm-9">
            @Model.Balance

    </dl>

    <form asp-action="Delete">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">عودة الموردين</a>
    </form>

</div>
@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}