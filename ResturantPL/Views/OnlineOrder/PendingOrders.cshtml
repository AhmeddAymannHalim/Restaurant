@model IEnumerable<OnlineOrder>
@{
    ViewData["Title"] = "My Orders";

}

<h1 class="text-center">طلباتي</h1>
<hr />
<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>
                الاسم
            </th>
            <th>
                نوع الطلب
            </th>
            <th>
                التاريخ
            </th>
            <th>
                العنوان
            </th>
            <th>
                رقم الموبايل
            </th>
            <th>
                رقم الهاتف
            </th>
            <th>
                الاجمالي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>

                <td>
                    دليفري اونلاين
                </td>

                <td>
                    @item.OrderDate.ToString("hh:mm yyyy-MM-dd")
                </td>
                <td>
                    @item.Address
                </td>
                <td>
                    @item.MobileNumber
                </td>
                <td>
                    @item.PhoneNumber
                </td>
                <td>
                    @item.TotalPrice
                </td>
                <td>
                    @if (item.IsPending == true)
                    {
                        <a onclick="Delete(@item.Id)" class="text-danger" style="font-weight:bold; cursor:pointer;">الغاء</a>
                        <a asp-action="Details" asp-controller="OnlineOrder" asp-route-id="@item.Id" class="btn btn-primary">التفاصيل</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-controller="OnlineOrder" asp-route-id="@item.Id" class="btn btn-primary">التفاصيل</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>




<script src="~/lib/sweetalert/sweetalert.min.js"></script>
@if (TempData["success"] != null)
{
    <script>
        swal("برافو عمل جيد !", "", "success");

    </script>
}
@if (TempData["faild"] != null)
{
    <script>
        swal("فشلت العملية !", "", "error");

    </script>

}
@section Scripts {

    <script src="~/modules/OnlineOrder.js"></script>
}