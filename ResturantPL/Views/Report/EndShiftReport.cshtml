@model EndShiftViewModel

@{
    ViewData["Title"] = "End Shift";
    Layout = null;
}




<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }

    h1,p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }

    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>


<h1>تقرير انهاء شيفت / @Model.Name</h1>
<hr />
<p>@Model.Date.ToString("dd-MM-yyyy  hh:mm tt")</p>
<br />

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr>
            <th>البيان</th>
            <th>العدد</th>
            <th>الاجمالي</th>
        </tr>
    </thead>
    <tbody>
        
        <tr>
            <td class="mainRow">طلبات الصالة المكتملة</td>
            <td>@Model.hallSummaryNumber</td>
            <td>@Model.hallSummaryTotal</td>
        </tr>
        
         <tr>
            <td class="mainRow">طلبات الدليفري المكتملة</td>
            <td>@Model.deliverySummaryNumber</td>
            <td>@Model.deliverySummaryTotal</td>
        </tr>
        
         <tr>
            <td class="mainRow">طلبات الدليفري الاونلاين المكتملة</td>
            <td>@Model.deliveryOnlineSummaryNumber</td>
            <td>@Model.deliveryOnlineSummaryTotal</td>
        </tr>
       
         <tr>
            <td class="mainRow">طلبات التيك اواي المكتملة</td>
            <td>@Model.takeAwaySummaryNumber</td>
            <td>@Model.takeAwaySummaryTotal</td>
        </tr>
         
         <tr>
            <td class="mainRow">طلبات الصالة المعلقة</td>
            <td>@Model.pendingHallNumber</td>
            <td>@Model.pendingHallTotal</td>
        </tr>
      
         <tr>
            <td class="mainRow">طلبات الدليفري المعلقة</td>
            <td>@Model.pendingDeliveryNmuber</td>
            <td>@Model.pendingDeliveryTotal</td>
        </tr>
      
         <tr>
            <td class="mainRow">طلبات الدليفري الاونلاين المعلقة</td>
            <td>@Model.pendingDeliveryOnlineNmuber</td>
            <td>@Model.pendingDeliveryOnlineTotal</td>
        </tr>
        
         <tr>
            <td class="mainRow">اجمالي الطلبات المعلقة</td>
            <td>@Model.totalPendingNumber</td>
            <td>@Model.totalPendingTotal</td>
        </tr>
        
         <tr>
            <td class="mainRow">طلبات الصالة المعلقة من الشيفت السابق</td>
            <td>@Model.lastPendingHallNumber</td>
            <td>@Model.lastPendingHallTotal</td>
        </tr>
    
         <tr>
            <td class="mainRow">طلبات الدليفري المعلقة من الشيفت السابق</td>
            <td>@Model.lastPendingDeliveryNmuber</td>
            <td>@Model.lastPendingDeliveryTotal</td>
        </tr>

         <tr>
            <td class="mainRow">طلبات الدليفري الاونلاين المعلقة من الشيفت السابق</td>
            <td>@Model.lastPendingDeliveryOnlineNmuber</td>
            <td>@Model.lastPendingDeliveryOnlineTotal</td>
        </tr>

         <tr>
            <td class="mainRow">اجمالي الطلبات المعلقة من الشيفت السابق</td>
            <td>@Model.lastTotalPendingNumber</td>
            <td>@Model.lastTotalPendingTotal</td>
        </tr>

         <tr>
            <td class="mainRow">اجمالي الطلبات المكتملة</td>
            <td>@Model.totalSummeryNumber</td>
            <td>@Model.totalSummeryTotal</td>
        </tr>

         <tr>
            <td class="mainRow">اجمالي المبيعات من االمعلق من الشيفت السابق</td>
            <td>@Model.selledLastPendingNumber</td>
            <td>@Model.selledLastPendingTotal</td>
        </tr>

         <tr>
            <td class="mainRow">اجمالي المبيعات  المعلقة</td>
            <td>@Model.TotalRemainForPendingNumber</td>
            <td>@Model.TotalRemainForPendingTotal</td>
        </tr>

         <tr>
            <td class="mainRow">اجمالي المبيعات و الايرادات</td>
            <td>@Model.totalMoneyNumber</td>
            <td>@Model.totalMoneyTotal</td>
        </tr>


    </tbody>
</table>






