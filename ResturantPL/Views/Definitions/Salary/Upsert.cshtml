@model SalaryViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewSalary"].Value : L["UpdateSalary"].Value;
}

<h1 class="text-center">@ViewBag.Title</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Upsert" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="SalaryCode" class="control-label">@L["Code"]</label>
                <input asp-for="SalaryCode" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="EmployeeId" class="control-label">@L["Employee"]</label>
                <select id="employeeId" asp-for="EmployeeId" class="form-control" asp-items="Model.Employees">
                    <option value="">@L["Select"]</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FromDate" class="control-label">@L["FromDate"]</label>
                <input id="startDate" asp-for="FromDate" type="date" class="form-control" />
                <span asp-validation-for="FromDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ToDate" class="control-label">@L["ToDate"]</label>
                <input id="endDate" asp-for="ToDate" type="date" class="form-control" />
                <span asp-validation-for="ToDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@L["MainSalary"]</label>
                <input id="mainAmount" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label class="control-label">@L["SalaryType"]</label>
                <input id="salaryType" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label class="control-label">@L["Incentives"]</label>
                <input id="incentive" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label class="control-label">@L["Discounts"]</label>
                <input id="discount" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label class="control-label">@L["Depts"]</label>
                <input id="dept" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="SalaryAmount" class="control-label">@L["TotalSalary"]</label>
                <input id="amount" asp-for="SalaryAmount" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="SalaryAmount" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="@L["Save"]" class="btn btn-primary" /> |
                <a asp-action="Index">@L["Back"]</a>
                @if (!isNew)
                {
                    <text> | </text>
                    <a onclick="Delete('/Salary/Delete/@Model.Id', '@Url.Action("Index")')" class="text-danger" style="font-weight:bold; cursor:pointer;">@L["Delete"]</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/modules/deleteobjects.js"></script>
    <script>
        $(function () {
            function loadExpenses() {
                var employeeId = $("#employeeId").val();
                var startDate = $("#startDate").val();
                var endDate = $("#endDate").val();
                if (!employeeId || !startDate || !endDate) {
                    return;
                }

                $.ajax({
                    url: '@Url.Action("EmployeeExpenses")',
                    type: "GET",
                    data: { employeeId: employeeId, startDate: startDate, endDate: endDate },
                    success: function (data) {
                        $("#mainAmount").val(data.mainSalary);
                        $("#salaryType").val(data.salaryType);
                        $("#incentive").val(data.incentives);
                        $("#discount").val(data.discounts);
                        $("#dept").val(data.depts);
                        $("#amount").val(data.totalSalary);
                    }
                });
            }

            $("#employeeId, #startDate, #endDate").change(loadExpenses);
        });
    </script>
}
