@model OrderViewModel
@{
    ViewBag.Title = L["MoveItem"].Value;
    var isArabic = LanguageHelper.IsArabic();
    var tables = (IEnumerable<LookupItem>)ViewBag.Tables;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-right-left" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title <small>@Model.OrderCode</small></h1>
    </div>
    <div class="bo-card-body">
        <form asp-action="Move" method="post" class="bo-form">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label class="control-label" for="OrderMenuItemId">@L["Product"]</label>
                <select id="OrderMenuItemId" name="OrderMenuItemId" class="form-select" required>
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Items)
                    {
                        <option value="@item.Id">@(isArabic ? item.MenuItemArName : item.MenuItemEnName) x @item.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="control-label" for="TargetTableId">@L["TargetTable"]</label>
                <select id="TargetTableId" name="TargetTableId" class="form-select" required>
                    <option value="">@L["Select"]</option>
                    @foreach (var table in tables)
                    {
                        <option value="@table.Id">@(isArabic ? table.ArName : table.EnName)</option>
                    }
                </select>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="List" asp-route-status="pending" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            </div>
        </form>
    </div>
</div>
