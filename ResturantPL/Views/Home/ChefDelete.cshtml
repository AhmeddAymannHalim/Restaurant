@model ChefItemViewModel
@{
    ViewData["Title"] = "ChefDelete";
}



<br />
<br />
<br />
<br />
<div class="container mt-5">

    <h1 class="float-end text-danger">هل انت متأكد من إزاله ذلك الطباخ</h1>
    <br />
    <br />
    <br />
    <br />
    <form asp-action="ChefDelete" method="post" enctype="multipart/form-data">
        <div class="d-flex flex-column  align-items-end">
            <div class=" float-end  m-3" style="width= 500px !important; ">
                <input type="text" asp-for="@Model.Name" id="name" class="text-black" style="width:70% ; direction:rtl" readonly> <span>اسم الطباخ</span>
            </div>

            <div class=" float-end  m-3" style="width= 500px !important; ">
                <input type="text" asp-for="@Model.Jop" id="name" class="text-black" style="width:70% ; direction:rtl" readonly> <span>وظيفه الطباخ</span>
            </div>


        </div>
        <div class="text-center  d-block  "><input type="submit" style="width:5%" class=" text-white bg-black border-black" value="إزاله"></div>
    </form>
</div>