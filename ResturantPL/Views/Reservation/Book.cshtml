@model ReservationCreateViewModel
@{
    ViewData["Title"] = L["Reservation.Title"].Value;
}

<div class="ws">
    <section class="ws-page">
        <div class="ws-wrap">
            <header class="ws-page-head">
                <h1>@L["Reservation.Title"]</h1>
                <p>@L["Reservation.Subtitle"]</p>
            </header>

            <form asp-action="Book" method="post" class="ws-split" id="rvForm" novalidate
                  data-url="@Url.Action("Slots", "Reservation")"
                  data-seats="@L["Reservation.Seats"]"
                  data-taken="@L["Reservation.Taken"]"
                  data-small="@L["Reservation.TooSmall"]"
                  data-none="@L["Reservation.NoTables"]"
                  data-pick="@L["Reservation.PickTime"]"
                  data-failed="@L["Reservation.LoadFailed"]"
                  data-not-chosen="@L["Reservation.NotChosen"]">

                <input type="datetime-local" asp-for="ReservationDate" id="rvWhen" class="d-none" />
                <input type="hidden" asp-for="TableId" id="rvTableId" />
                <input type="hidden" asp-for="GuestCount" id="rvGuests" />

                <div class="rv-steps">
                    <section class="ws-block">
                        <h2>@L["Reservation.When"]</h2>
                        <div class="rv-when">
                            <div class="ws-field">
                                <label for="rvDate">@L["Reservation.Date"]</label>
                                <input type="date" id="rvDate" data-date-upgraded="1" required />
                            </div>
                            <div class="ws-field">
                                <label for="rvTime">@L["Reservation.Time"]</label>
                                <input type="time" id="rvTime" step="900" required />
                            </div>
                            <div class="ws-field">
                                <label for="rvGuestsView">@L["Reservation.Guests"]</label>
                                <div class="ws-stepper rv-stepper">
                                    <button type="button" data-guests="-1" aria-label="-">-</button>
                                    <input type="text" id="rvGuestsView" readonly />
                                    <button type="button" data-guests="1" aria-label="+">+</button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="ws-block">
                        <h2>@L["Reservation.ChooseTable"]</h2>
                        <p class="ws-hint rv-hint">@L["Reservation.ChooseTableHint"]</p>
                        <div class="rv-tables" id="rvTables"></div>
                    </section>

                    <section class="ws-block">
                        <h2>@L["Reservation.YourDetails"]</h2>
                        <div class="ws-fields">
                            <div class="ws-field">
                                <label asp-for="CustomerName">@L["Reservation.Name"]</label>
                                <input asp-for="CustomerName" id="rvName" maxlength="100" autocomplete="name" required />
                            </div>
                            <div class="ws-field">
                                <label asp-for="PhoneNumber">@L["Reservation.Phone"]</label>
                                <input asp-for="PhoneNumber" id="rvPhone" maxlength="20" autocomplete="tel" required />
                            </div>
                            <div class="ws-field ws-full">
                                <label asp-for="Email">@L["Reservation.Email"]</label>
                                <input asp-for="Email" id="rvEmail" maxlength="150" autocomplete="email" />
                            </div>
                            <div class="ws-field ws-full">
                                <label asp-for="Notes">@L["Reservation.Notes"]</label>
                                <textarea asp-for="Notes" id="rvNotes" rows="3" maxlength="500" placeholder="@L["Reservation.NotesHint"]"></textarea>
                            </div>
                        </div>
                    </section>
                </div>

                <aside class="ws-ticket rv-ticket">
                    <h2>@L["Reservation.Summary"]</h2>
                    <dl class="ws-facts">
                        <dt>@L["Reservation.When2"]</dt><dd id="rvSumWhen">-</dd>
                        <dt>@L["Reservation.Guests"]</dt><dd id="rvSumGuests"></dd>
                        <dt>@L["Reservation.Table"]</dt><dd id="rvSumTable"></dd>
                    </dl>
                    <button type="submit" class="ff-btn rv-submit" id="rvSubmit" disabled>
                        <i class="bi bi-calendar-check" aria-hidden="true"></i> @L["Reservation.Submit"]
                    </button>
                    <small>@L["Reservation.Hold"]</small>
                </aside>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/reservation-book.js" asp-append-version="true"></script>
}
