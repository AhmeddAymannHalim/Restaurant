@model TableExportRequest
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@(Model.IsRightToLeft ? "ar" : "en")" dir="@(Model.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, Arial, sans-serif; color: #111; font-size: 11px; margin: 14px; }
        h1 { margin: 0 0 2px; font-size: 18px; }
        .when { margin: 0 0 12px; color: #666; font-size: 10px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #bbb; padding: 5px 7px; text-align: start; vertical-align: top; }
        th { background: #112233; color: #fff; font-weight: 600; }
        tr:nth-child(even) td { background: #f6f8fa; }
    </style>
</head>
<body>
    <h1>@Model.Title</h1>
    <p class="when">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>

    <table>
        <thead>
            <tr>
                @foreach (var heading in Model.Headings)
                {
                    <th>@heading</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@cell</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
