@model ExitExpenseViewModel
@{
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewExitExpense"].Value : L["UpdateExitExpense"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-money-bill-transfer" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="bo-card-body">
        <form asp-action="Upsert" method="post" class="bo-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ExpenseId" class="control-label">@L["Expense"]</label>
                <select asp-for="ExpenseId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Expenses)
                    {
                        <option value="@item.Id" selected="@(Model.ExpenseId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="ExpenseId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label">@L["Price"]</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/ExitExpense/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
