@{
    ViewBag.Title = L["StartShift"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-lock" aria-hidden="true"></i></span>
        <h1>@L["StartShift"]</h1>
    </div>
    <div class="ad-card-body">
        <form asp-action="Login" method="post" class="ad-form">
            <div class="form-group">
                <label class="control-label">@L["UserName"]</label>
                <input class="form-control" value="@User.Identity?.Name" readonly />
            </div>
            <div class="form-group">
                <label class="control-label" for="password">@L["Setting_Password"]</label>
                <input id="password" name="password" type="password" class="form-control" autocomplete="off" required autofocus />
            </div>
            <div class="ad-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-play" aria-hidden="true"></i> @L["StartShift"]</button>
            </div>
        </form>
    </div>
</div>
