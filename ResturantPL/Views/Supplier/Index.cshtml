@model IEnumerable<Supplier>


  
<h1 class="text-center">الموردين</h1>
<hr />


<p>
    <a asp-action="Create">اضافة مورد جديد</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <tr>
        <td>الاسم</td>
        <td>العنوان</td>
        <td>الموبايل</td>
        <td>الهاتف</td>
        <td>الرصيد</td>
        <td></td>

    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Address</td>
            <td>@item.MobileNumber</td>
            <td>@item.PhoneNumber</td>
            <td>@item.Balance</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">التفاصيل</a>|
                <a asp-action="Edit"  asp-route-id="@item.Id">تعديل</a>|
                <a asp-action="Delete"  asp-route-id="@item.Id">حذف</a>
            </td>
        </tr>
    }
</table>


<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>