@model DashboardViewModel
@{
    Layout = null;
    var title = L["Dashboard"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var otherCulture = isArabic ? "en" : "ar";

    // section title key + (controller, action, icon, label key, count)
    var sections = new (string Title, (string Controller, string Action, string Icon, string Label, int Count)[] Items)[]
    {
        ("GroupOperations", new[]
        {
            ("Invoice", "Invoices", "fa-file-invoice", "Invoices", Model.Invoices),
            ("StoreConvert", "Index", "fa-right-left", "StoreConverts", Model.StoreConverts),
            ("PaymentInvoice", "IndexSupplier", "fa-file-invoice-dollar", "SupplierPayments", Model.SupplierPayments),
            ("PaymentInvoice", "IndexCustomer", "fa-hand-holding-dollar", "CustomerPayments", Model.CustomerPayments)
        }),
        ("GroupOrganization", new[]
        {
            ("Branch", "Index", "fa-code-branch", "Branches", Model.Branches),
            ("Job", "Index", "fa-id-badge", "Jobs", Model.Jobs),
            ("Employee", "Index", "fa-users", "Employees", Model.Employees),
            ("EmployeeAccount", "EmployeeAccounts", "fa-user-lock", "EmployeeAccounts", Model.EmployeeAccounts),
            ("SalaryType", "Index", "fa-money-bill-wave", "SalaryTypes", Model.SalaryTypes),
            ("User", "Index", "fa-user-group", "Users", Model.Users),
            ("Role", "Roles", "fa-user-shield", "Roles", Model.Roles)
        }),
        ("GroupKitchen", new[]
        {
            ("Kitchen", "Index", "fa-fire-burner", "Kitchens", Model.Kitchens),
            ("MenuSection", "Index", "fa-list", "MenuSections", Model.MenuSections),
            ("Menu", "Index", "fa-utensils", "MenuItems", Model.MenuItems),
            ("Table", "Index", "fa-chair", "Tables", Model.Tables)
        }),
        ("GroupInventory", new[]
        {
            ("Store", "Index", "fa-warehouse", "Stores", Model.Stores),
            ("Product", "Index", "fa-box", "Products", Model.Products),
            ("UnitPrice", "Index", "fa-weight-scale", "UnitPrices", Model.UnitPrices)
        }),
        ("GroupPartners", new[]
        {
            ("Supplier", "Index", "fa-truck", "Suppliers", Model.Suppliers),
            ("Customer", "Index", "fa-user-tag", "Customers", Model.Customers)
        }),
        ("GroupFinance", new[]
        {
            ("Expense", "Index", "fa-receipt", "Expenses", Model.Expenses),
            ("ExitExpense", "Index", "fa-money-bill-transfer", "ExitExpenses", Model.ExitExpenses),
            ("Deposit", "Index", "fa-piggy-bank", "Deposits", Model.Deposits),
            ("Scrounge", "Index", "fa-hand-holding-dollar", "Scrounges", Model.Scrounges),
            ("Salary", "Index", "fa-wallet", "Salaries", Model.Salaries)
        })
    };
    var tile = 0;
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Restaurant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dash">

    <div class="dash-scrim" data-side-close></div>

    <aside class="dash-side" id="dashSide" aria-label="@L["Dashboard"]">
        <button type="button" class="dash-toggle" data-side-toggle aria-controls="dashSide" aria-expanded="true" title="@L["Menu"]">
            <i class="fas fa-bars-staggered" aria-hidden="true"></i><span>@L["Menu"]</span>
        </button>
        <a class="dash-side-link is-active" asp-controller="Dashboard" asp-action="Index" title="@L["Dashboard"]">
            <i class="fas fa-gauge-high" aria-hidden="true"></i><span>@L["Dashboard"]</span>
        </a>
        <a class="dash-side-link" asp-controller="Home" asp-action="Index" title="@L["Website"]">
            <i class="fas fa-store" aria-hidden="true"></i><span>@L["Website"]</span>
        </a>
        <a class="dash-side-link" asp-controller="Chef" asp-action="Index" title="@L["Chefs"]">
            <i class="fas fa-kitchen-set" aria-hidden="true"></i><span>@L["Chefs"]</span>
        </a>
        <a class="dash-side-link" asp-controller="Gallery" asp-action="Index" title="@L["Gallery"]">
            <i class="fas fa-images" aria-hidden="true"></i><span>@L["Gallery"]</span>
        </a>
        <a class="dash-side-link" asp-controller="User" asp-action="Index" title="@L["Users"]">
            <i class="fas fa-user-group" aria-hidden="true"></i><span>@L["Users"]</span>
        </a>
        <a class="dash-side-link" asp-controller="ApplicationSetting" asp-action="Index" title="@L["Settings"]">
            <i class="fas fa-gear" aria-hidden="true"></i><span>@L["Settings"]</span>
        </a>
        <a class="dash-side-link is-exit" asp-controller="Account" asp-action="SignOut" title="@L["SignOut"]">
            <i class="fas fa-right-from-bracket" aria-hidden="true"></i><span>@L["SignOut"]</span>
        </a>
    </aside>

    <main class="dash-main">

        <header class="dash-head">
            <button type="button" class="dash-burger" data-side-toggle aria-controls="dashSide" aria-label="@L["Menu"]">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
            <div class="dash-who">
                @if (!string.IsNullOrEmpty(Model.UserImage))
                {
                    <img src="@Model.UserImage" alt="" />
                }
                else
                {
                    <img src="~/Employee Images/User_Image.png" alt="" />
                }
                <div>
                    <h1>@L["Welcome"] @Model.UserName</h1>
                    <p>@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
                </div>
            </div>
            <span class="dash-live" id="dashLive" data-state="connecting"><i aria-hidden="true"></i><b>@L["Live"]</b></span>
            <a class="dash-lang" asp-controller="SetLanguage" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@(isArabic ? "English" : "العربية")</a>
        </header>

        <section class="dash-now" aria-label="@L["RightNow"]">
            <a class="now-card now-orders @(Model.PendingKitchenOrders > 0 ? "has-pending" : "")" asp-controller="KitchenOrder" asp-action="KitchenOrders">
                <span class="now-count" data-stat="pendingKitchenOrders">@Model.PendingKitchenOrders</span>
                <span class="now-label">@L["PendingKitchenOrders"]</span>
                @if (Model.PendingKitchenOrders > 0)
                {
                    <span class="now-dot" aria-hidden="true"></span>
                }
            </a>
            <a class="now-card now-new" asp-controller="Order" asp-action="Create">
                <i class="fas fa-bell-concierge" aria-hidden="true"></i>
                <span class="now-label">@L["NewOrder"]</span>
            </a>
            <a class="now-card now-report" asp-controller="Report" asp-action="Index">
                <i class="fas fa-chart-column" aria-hidden="true"></i>
                <span class="now-label">@L["Reports"]</span>
            </a>
        </section>

        @foreach (var section in sections)
        {
            <section class="dash-sec">
                <h2>@L[section.Title]</h2>
                <div class="dash-grid">
                    @foreach (var item in section.Items)
                    {
                        <a class="tile" style="--i:@(tile++)" asp-controller="@item.Controller" asp-action="@item.Action">
                            <span class="tile-icon"><i class="fas @item.Icon" aria-hidden="true"></i></span>
                            <span class="tile-text">
                                <span class="tile-label">@L[item.Label]</span>
                                <span class="tile-count" data-stat="@(char.ToLowerInvariant(item.Label[0]) + item.Label[1..])">@item.Count</span>
                            </span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="dash-sec">
            <h2>@L["TopCustomers"]</h2>
            @if (Model.TopCustomers.Any())
            {
                <div class="dash-table-wrap">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>@L["Name"]</th>
                                <th>@L["Mobile"]</th>
                                <th>@L["Balance"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.TopCustomers)
                            {
                                <tr>
                                    <td>@(isArabic ? customer.ArName : customer.EnName)</td>
                                    <td>@customer.MobileNumber</td>
                                    <td class="num">@customer.Balance.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="dash-empty">@L["NoCustomersYet"] <a asp-controller="Customer" asp-action="Upsert">@L["NewCustomer"]</a></p>
            }
        </section>

    </main>

    <script src="~/microsoft-signalr/signalr.min.js"></script>
    <script>
        (function () {
            var body = document.body;
            var KEY = "dashSideShut";
            var phone = window.matchMedia("(max-width: 860px)");
            var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // ---- sidebar toggle: pinned open / collapsed on desktop, a drawer on phones ----
            try { if (localStorage.getItem(KEY) === "1") { body.classList.add("side-shut"); } } catch (e) { }

            function syncAria() {
                var open = phone.matches ? body.classList.contains("side-open") : !body.classList.contains("side-shut");
                document.querySelectorAll("[data-side-toggle]").forEach(function (b) { b.setAttribute("aria-expanded", open); });
            }

            document.querySelectorAll("[data-side-toggle]").forEach(function (button) {
                button.addEventListener("click", function () {
                    if (phone.matches) {
                        body.classList.toggle("side-open");
                    } else {
                        body.classList.toggle("side-shut");
                        try { localStorage.setItem(KEY, body.classList.contains("side-shut") ? "1" : "0"); } catch (e) { }
                    }
                    syncAria();
                });
            });
            document.querySelectorAll("[data-side-close]").forEach(function (el) {
                el.addEventListener("click", function () { body.classList.remove("side-open"); syncAria(); });
            });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { body.classList.remove("side-open"); syncAria(); }
            });
            phone.addEventListener("change", function () { body.classList.remove("side-open"); syncAria(); });
            syncAria();

            // ---- pointer light on tiles / cards ----
            document.querySelectorAll(".tile, .now-card").forEach(function (el) {
                el.addEventListener("pointermove", function (e) {
                    var r = el.getBoundingClientRect();
                    el.style.setProperty("--mx", (e.clientX - r.left) + "px");
                    el.style.setProperty("--my", (e.clientY - r.top) + "px");
                });
            });

            // ---- numbers: count up on load, flash when a live value changes ----
            function show(el, value) { el.textContent = value; }

            function countUp(el, to) {
                var from = parseInt(el.textContent, 10) || 0;
                if (reduce || from === to) { show(el, to); return; }
                var start = null, span = 700;
                function frame(t) {
                    if (start === null) { start = t; }
                    var k = Math.min((t - start) / span, 1);
                    var eased = 1 - Math.pow(1 - k, 3);
                    show(el, Math.round(from + (to - from) * eased));
                    if (k < 1) { requestAnimationFrame(frame); }
                }
                requestAnimationFrame(frame);
            }

            var stats = document.querySelectorAll("[data-stat]");
            stats.forEach(function (el) {
                var target = parseInt(el.textContent, 10) || 0;
                el.dataset.value = target;
                if (!reduce && target > 0) { el.textContent = "0"; countUp(el, target); }
            });

            function apply(data) {
                stats.forEach(function (el) {
                    var next = data[el.dataset.stat];
                    if (typeof next !== "number" || String(next) === el.dataset.value) { return; }
                    el.dataset.value = next;
                    countUp(el, next);
                    el.classList.remove("is-bumped");
                    void el.offsetWidth;
                    el.classList.add("is-bumped");

                    if (el.dataset.stat === "pendingKitchenOrders") {
                        var card = el.closest(".now-card");
                        card.classList.toggle("has-pending", next > 0);
                        var dot = card.querySelector(".now-dot");
                        if (next > 0 && !dot) {
                            dot = document.createElement("span");
                            dot.className = "now-dot";
                            dot.setAttribute("aria-hidden", "true");
                            card.appendChild(dot);
                        } else if (next === 0 && dot) {
                            dot.remove();
                        }
                    }
                });
            }

            // ---- live: SignalR pushes on new orders, a light poll covers everything else ----
            var live = document.getElementById("dashLive");
            var busy = false;
            function setLive(state) {
                live.dataset.state = state;
                live.querySelector("b").textContent = state === "off" ? "@L["LiveOffline"].Value" : "@L["Live"].Value";
            }

            function refresh() {
                if (busy || document.hidden) { return; }
                busy = true;
                fetch('@Url.Action("Stats", "Dashboard")', { headers: { "Accept": "application/json" }, credentials: "same-origin" })
                    .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); })
                    .then(function (data) { apply(data); setLive("on"); })
                    .catch(function () { setLive("off"); })
                    .then(function () { busy = false; });
            }

            setInterval(refresh, 15000);
            document.addEventListener("visibilitychange", refresh);
            setLive("on");

            if (window.signalR) {
                var hub = new signalR.HubConnectionBuilder().withUrl("/OrderHub").withAutomaticReconnect().build();
                hub.on("RefreshOrders", refresh);
                hub.on("RefreshOnlineOrders", refresh);
                hub.onreconnecting(function () { setLive("off"); });
                hub.onreconnected(function () { setLive("on"); refresh(); });
                hub.start().catch(function () { /* the poll keeps the page live */ });
            }
        })();
    </script>
</body>
</html>
