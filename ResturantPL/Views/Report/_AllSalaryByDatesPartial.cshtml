@model SalaryByDatesViewModel

@if (Model.Salaries.Count() > 0)
{
    foreach (var item in Model.Salaries)
    {
        <tr>
            <td>@item.SalaryCode</td>
            <td>@item.Employee.FullName</td>
            <td>@item.SalaryDate.ToString("yyyy-MM-dd")</td>
            <td>@item.User.FullName</td>
            <td>@item.SalaryAmount</td>
            <td>
                @Html.ActionLink("التفاصيل", "Details", "Salary", new { id = item.Id })
            </td>
        </tr>
    }
    <tr>
        <td class="text-danger"><strong>الاجمالي</strong> </td>
        <td colspan="5"><strong>@Model.Total</strong></td>
    </tr>
}
else
{
    <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
}