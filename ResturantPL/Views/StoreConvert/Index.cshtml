@model IEnumerable<Restaurant.DAL.Models.StoreConvert>

@{
    ViewData["Title"] = "Store Converts";
}

<h1 class="text-center">فواتير نقل الاصناف</h1>
<hr />
<div style="direction:rtl;" class="m-3">

    <p>
        <a asp-action="Create">فتح فاتورة جديدة</a>
    </p>
    <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
        <thead>
            <tr>

                <th>
                    كود الفاتورة
                </th>
                <th>
                    تاريخ الفاتورة
                </th>

                <th>
                    المخزن المنقول منه
                </th>
                <th>
                    المخزن المنقول اليه
                </th>
                <th>
                    عدد الاصناف
                </th>


                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.ConvertCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ConvertDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FromStore.ArName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ToStore.ArName)
                    </td>
                    <td>
                        @item.StoreConvertProducts.Count()
                    </td>
                    <td>
                        @Html.ActionLink("التفاصيل", "Details", new { id = item.Id }) |
                        <a onclick="Delete('/StoreConvert/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div>
        <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
    </div>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
<script src="~/modules/deleteobjects.js"></script>