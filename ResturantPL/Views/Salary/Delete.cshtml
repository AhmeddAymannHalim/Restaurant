@model Restaurant.Data.Models.Salary

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center">حذف المرتب</h1>
    <hr />

<h3>هل انت متأكد من الحذف ؟</h3>
<div>
    <dl class="row">
       
        <dt class="col-sm-2">
            كود المرتب
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SalaryCode)
        </dd>
        <dt class="col-sm-2">
            من تاريخ 
        </dt>
        <dd class="col-sm-9">
            @Model.FromDate.ToString("yyyy-MM-dd")
        </dd>
        <dt class="col-sm-2">
            الي تاريخ
        </dt>
        <dd class="col-sm-9">
            @Model.ToDate.ToString("yyyy-MM-dd")
        </dd>
        <dt class="col-sm-2">
            تاريخ المرتب
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SalaryDate)
        </dd>
        <dt class="col-sm-2">
            مبلغ المرتب
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SalaryAmount)
        </dd>
        <dt class="col-sm-2">
            اسم الموظف
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Employee.FullName)
        </dd>
        <dt class="col-sm-2">
            اسم المستخدم
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.User.FullName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">عودة للمرتبات</a>
    </form>
</div>
