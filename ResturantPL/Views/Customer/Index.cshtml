@model IEnumerable<Customer>



<h1 class="text-center">العملاء</h1>
<hr />

<p>
    <a asp-action="Create">اضافة عميل جديد</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <tr>
        <td>الاسم</td>
        <td>العنوان</td>
        <td>الموبايل</td>
        <td>الهاتف</td>
        <td>الرصيد</td>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Address</td>
            <td>@item.MobileNumber</td>
            <td>@item.PhoneNumber</td>
            <td>@item.Balance</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">التفاصيل</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">تعديل</a>|
                <a onclick="Delete(@item.Id)" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
            </td>
        </tr>
    }
</table>


<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
@if (TempData["success"] != null)
{
    <script>
        swal("برافو عمل جيد !", "", "success");

    </script>
}
@if (TempData["faild"] != null)
{
    <script>
        swal("فشلت العملية !", "", "error");

    </script>

}
@section Scripts {

    <script src="~/modules/Customer.js"></script>
}


