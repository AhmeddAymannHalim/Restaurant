@model Scrounge

@{
    ViewData["Title"] = "Details";

    // this 3 lines of code for _Dashboard
    // ViewBag.PageTitle = "Category Management";
    // ViewBag.CardTitle = "Delete Category";
    //Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container">
    <h1>تفاصيل</h1>
    <h4>الاستدان</h4>
    <hr />


    <div class="row ">
        <div class="col-md-4 float-end">
            <form asp-action="Details">

                @* to link the id parameter in action Delete(int? id)*@
                <input hidden asp-for="Id" />

                @*For Server Side Validation Data Annotation*@
                <div asp-validation-summary="ModelOnly" class="text-danger"> </div>


                <div class="form-group">
                    <label asp-for="CreatedTime"></label>
                    <input disabled asp-for="CreatedTime" class="form-control" />
                    @*For Server Side Validation Data Annotation*@
                    <span asp-validation-for="CreatedTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Info"></label>
                    <input disabled asp-for="Info" disabled class="form-control" />
                    @*For Server Side Validation Data Annotation*@
                    <span asp-validation-for="Info" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Amount"></label>
                    <input disabled asp-for="Amount" class="form-control" />
                    @*For Server Side Validation Data Annotation*@
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>


                @*For Any DropDown List Input*@
                <div class="form-group">
                    <label asp-for="EmployeeId"></label>
                    <select disabled asp-for="EmployeeId" class="form-control">
                        @*asp-items property to get data of Model Category on it*@
                        <option disabled selected>-- Select Employee --</option> @*selected with first tag called option to appear in the first above*@ @*disabled to make user can't choose it*@



                    </select>
                    @*For Server Side Validation Data Annotation*@
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>

                @*For Any DropDown List Input*@
                <div class="form-group">
                    <label asp-for="StateId"></label>
                    <select disabled asp-for="StateId" class="form-control">
                        @*asp-items property to get data of Model Category on it*@
                        <option disabled selected>-- Select State --</option> @*selected with first tag called option to appear in the first above*@ @*disabled to make user can't choose it*@


                    </select>
                    @*For Server Side Validation Data Annotation*@
                    <span asp-validation-for="StateId" class="text-danger"></span>
                </div>

                @*             <div class="form-group">
                <input type="submit" value="Delete" class="btn btn-success" />
                </div> *@
            </form>

        </div>
    </div>


    <br />
    <div>
        <a asp-action="Index">عودة لقائمة الاستدان</a>
    </div>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}