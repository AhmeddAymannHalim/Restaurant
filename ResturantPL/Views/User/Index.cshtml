@model IEnumerable<UsersViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">المستخدمين</h1>
<hr />

<form asp-action="Index" class="row">
    <div class="form-group col-md-4">
        <input placeholder="ابحث" name="SearchValue" class="form-control col-md-8" />
        <input type="submit" value="بحث" class="btn btn-success col-md-3 mt-3" />
    </div>
</form>
<br />

<p>
    <a asp-action="AddUser" asp-controller="Account">اضافة مستخدم</a>
</p>

<div>
    <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>اسم المستخدم</th>
                <th>الايميل</th>
                <th>رقم الهاتف</th>
                <th>الفئة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                @if (!string.IsNullOrEmpty(item.UserType))
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.UserType)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id">التفاصيل</a> |
                            <a asp-action="Update" asp-route-id="@item.Id">تعديل</a> |
                            <a class="text-danger" asp-action="Delete" asp-route-userId="@item.Id"><strong>حذف</strong></a>
                            @* <a onclick="Delete(@item.Id)" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a> *@
                               
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="bg-black">&nbsp;</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}