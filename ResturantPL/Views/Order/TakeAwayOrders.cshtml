@model IEnumerable<Restaurant.DAL.Models.Order>

@{
    ViewData["Title"] = "Take Away Orders";
    Layout = "_Layout1";
}

<h1 class="text-center">طلبات التيك اواي</h1>

<p>
    <a asp-action="Create">طلب جديد</a>
</p>
<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                كود الطلب
            </th>
            <th>
                التار يخ
            </th>
            <th>
                موظف الشيفت 
            </th>
            <th>
                اسم العميل
            </th>
            <th>
                الاجمالي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)
                </td>
                <td>
                    @item.Seller.FullName
                </td>
                <td>
                    @item.CustomerName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalPrice)
                </td>

                <td>
                    @Html.ActionLink("التفاصيل", "Details", new { id = item.Id }) 
                </td>
            </tr>
        }
    </tbody>
</table>
