@{
    ViewData["Title"] = "Add Order Page";
    Layout = "_Layout1";
    var user = ViewBag.CurrentUser;
    var items = ViewBag.MenuItems as List<MenuItem>;
    var distinctMenuSections = items.Select(i => i.MenuSection.Name).Distinct();
}



<div class="justify-content-between row m-4">
    <button class="btn btn-primary text-center col-md-3" style="font-size:20px;">اسم المستخدم : @user.FullName</button>
    <button class="btn text-center col-md-3" style="font-size:20px; background-color:green; color:white;">الشيفت مستمر</button>
</div>
<hr />


<div class="row">


    <!--order Buttons-->
    <div class="col-sm-6 row" id="accordion">
        <div class="col-md-3 text-center">
            <ul class="order-actions list-unstyled text-center">
                @foreach (var menuSection in distinctMenuSections)
                {
                    <li>
                        <button class="btn btn-primary" style="margin:2px; width:100px;" data-bs-toggle="collapse" data-bs-target="#@menuSection" aria-expanded="false">@menuSection</button>
                    </li>
                }
            </ul>
        </div>
        <div style="min-height: 200px;" class="col-md-8 " data-bs-parent="#accordion">
            @foreach (var menuSection in distinctMenuSections)
            {
                <div class="collapse collapse-horizontal" id="@menuSection">
                    <div class="card-body" style="width: 500px;">
                        @foreach (var item in items.Where(i => i.MenuSection.Name == menuSection))
                        {
                            <button class="btn btn-info mealBtn" data-id="@item.Id" style="margin:2px; width:95px; height:135px;">
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 80%; height: 50%;">
                                <span>@item.Name</span> <span>$@item.Price</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Menu Items Table-->
    <div class="col-sm-6 row mb-5" style="border-right:solid 3px white; min-height:200px;">


        <form asp-action="AddOrder" id="orderForm" class="col-sm-12 row">


            <div class="form-group col-md-3">
                <label class="control-label">نوع الطلب</label>
                <select id="orderType" name="Type" class="form-control" required>
                    <option value="@OrderType.Delivery_Online">دليفرى اونلاين</option>
                </select>
            </div>

            <div class="form-group col-md-3">
                <label class="control-label">كود الطلب</label>
                <input id="orderCode" name="OrderCode" value="@ViewBag.OrderCode" class="form-control" readonly />
                <input id="cash" name="Cash" type="radio" class="form-control" hidden />
            </div>

            <div class="form-group col-md-3">
                <label class="control-label">خدمة</label>
                <input type="number" id="service" value="0" name="Service" class="form-control" required />
            </div>

            <div class="form-group col-md-3">
                <label class="control-label">ضريبة</label>
                <input type="number" step="0.01" id="tax" name="Tax" class="form-control" required />
            </div>


            <div class="form-group col-md-3">
                <label class="control-label">خصم</label>
                <input type="number" value="@ViewBag.Settings.OrderDiscount" step="0.01" id="discount" name="Discount" class="form-control" required />
            </div>

            <div class="form-group col-md-3">
                <label class="control-label">اجمالي السعر</label>
                <input id="totalPrice" type="number" value="0" name="TotalPrice" class="form-control" required readonly />
                <input id="allTotalPrice" value="@ViewBag.OnlineOrder.TotalPrice" type="number" class="form-control" hidden />
            </div>


            <div class="form-group col-md-3">
                <label class="control-label">اسم العميل</label>
                <input id="customerName" value="@ViewBag.OnlineOrder.CustomerName" name="CustomerName" class="form-control" />
            </div>



            <div class="form-group col-md-3" id="addressField">
                <label class="control-label">العنوان</label>
                <input id="address" value="@ViewBag.OnlineOrder.Address" name="Address" class="form-control" />
            </div>

            <div class="form-group col-md-3" id="phoneNumberField">
                <label class="control-label">رقم الهاتف</label>
                <input id="phoneNumber" value="@ViewBag.OnlineOrder.PhoneNumber" name="PhoneNumber" class="form-control" />
            </div>

            <div class="form-group col-md-3" id="mobileNumberField">
                <label class="control-label">رقم الموبايل</label>
                <input id="mobileNumber" value="@ViewBag.OnlineOrder.MobileNumber" name="MobileNumber" class="form-control" />
            </div>

            <div class="form-group col-md-3" id="employeeIdField">
                <label class="control-label">الطيار</label>
                <select id="employeeId" name="EmployeeId" class="form-control" asp-items="ViewBag.Tayars">
                </select>
            </div>

            <div class="form-group col-md-3" id="addInvoiceBtnField">
                <label class="control-label">حفظ</label>
                <input id="addInvoiceBtn" type="submit" value="حفظ" class="btn btn-primary form-control" />
            </div>

            <table id="selectedItemsTable" class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>
                        <th hidden>رقم المنتج</th>
                        <th>اسم المنتج</th>
                        <th>كمية المنتج</th>
                        <th>سعر الوحدة</th>
                        <th>اجمالي السعر</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.OnlineItems)
                    {
                        <tr data-id="@item.MenuItem.Id">
                            <td hidden>@item.MenuItem.Id</td>
                            <td>@item.MenuItem.Name</td>
                            <td class="quantity">@item.Quantity</td>
                            <td>@item.PriceForUnit</td>
                            <td class="total-price">@item.Price</td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>


    </div>

</div>





@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
        
            $('#discount, #tax, #service').on('input', function () {
                var subtotal = $('#allTotalPrice').val();
                var taxRate = 0;

                $.ajax({
                    url: '/Order/GetTaxPercentage', 
                    type: 'GET',
                    success: function (data) {
                       
                        taxRate = parseFloat(data.orderTax) / 100;

                        var tax = subtotal * taxRate;
                        var discount = parseFloat($('#discount').val());
                        var service = parseFloat($('#service').val());
                        var allTotalPrice = parseFloat($('#allTotalPrice').val());
                        var totalPrice = (allTotalPrice + service + tax) - discount;

                        $('#tax').val(tax.toFixed(2));
                        $('#totalPrice').val(totalPrice.toFixed(2));
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });





            });
        });
    </script>
    <script>
        $(document).ready(function () {
            // Get the modal element
            var modal = $('#myModal');

            // Event listener for when the modal is shown
            modal.on('shown.bs.modal', function () {
                // Set focus on the password input field
                $('#modalPassword').focus();
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#customerId').change(function () {
                var customerId = $(this).val();

                if (!customerId) {
                    $('#address').val("");
                    $('#mobileNumber').val("");
                    $('#phoneNumber').val("");
                    $('#customerName').val("عميل نقدي");
                    return; // Exit the function early if customerId is empty
                }

                $.ajax({
                    url: '/Order/CustomerInfo',
                    type: 'GET',
                    data: { customerId: customerId },
                    success: function (data) {
                        // Update the balance input field with the retrieved SupplierBalance
                        $('#address').val(data.address);
                        $('#mobileNumber').val(data.mobileNumber);
                        $('#phoneNumber').val(data.phoneNumber);
                        $('#customerName').val(data.name);
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            // Function to handle click on item buttons
            $('.mealBtn').click(function () {
                var itemId = $(this).data('id');
                var itemName = $(this).find('span:first').text();
                var itemPrice = parseFloat($(this).find('span:last').text().replace('$', ''));

                // Check if the item already exists in the table
                var existingRow = $('#selectedItemsTable tbody tr[data-id="' + itemId + '"]');
                if (existingRow.length > 0) {
                    // If the item exists, increase its quantity by 1 and update total price
                    var quantity = parseInt(existingRow.find('.quantity').text()) + 1;
                    existingRow.find('.quantity').text(quantity);
                    existingRow.find('.total-price').text('$' + (quantity * itemPrice).toFixed(2));
                } else {
                    // If the item doesn't exist, add it with quantity 1
                    addItem(itemId, itemName, itemPrice, 1);
                }

                calculateTotalPrice();
            });

            // Function to handle canceling an item or decreasing its quantity
            $('#selectedItemsTable tbody').on('click', 'tr', function () {
                var row = $(this);
                var quantity = parseInt(row.find('.quantity').text());

                if (quantity > 1) {
                    // If the quantity is greater than 1, decrease it by 1
                    var itemId = row.data('id');
                    var itemName = row.find('td:eq(1)').text();
                    var itemPrice = parseFloat(row.find('td:eq(3)').text().replace('$', ''));

                    quantity--;
                    row.find('.quantity').text(quantity);
                    row.find('.total-price').text('$' + (quantity * itemPrice).toFixed(2));
                } else {
                    // If the quantity is 1, cancel the item
                    cancelItem(row);
                }

                calculateTotalPrice();
            });



            // Function to add an item to the table
            function addItem(itemId, itemName, itemPrice, quantity) {
                var newRow =
                    '<tr  data-id="'
                    + itemId + '"><td hidden>'
                    + itemId + '</td><td>'
                    + itemName + '</td><td class="quantity">'
                    + quantity + '</td><td>$' + itemPrice.toFixed(2) +
                    '</td><td class="total-price">$' + (quantity * itemPrice).toFixed(2) +
                    '</td></tr>';
                $('#selectedItemsTable tbody').append(newRow);

            }

            // Function to cancel an item from the table
            function cancelItem(row) {
                var itemId = row.data('id');
                row.remove();
            }




            // Function to calculate total price
            function calculateTotalPrice() {
                var subtotal = 0;
                $('#selectedItemsTable tbody tr').each(function () {
                    var price = parseFloat($(this).find('.total-price').text().replace('$', ''));
                    subtotal += price;
                });

                var discount = parseFloat($('#discount').val()) || 0;
                var tax = parseFloat($('#tax').val()) || 0;
                var service = parseFloat($('#service').val()) || 0;
                var totalPrice = subtotal + tax + service - discount;

                $('#totalPrice').val(totalPrice.toFixed(2));
            }


            function calculateTotalPrice() {
                var subtotal = 0;
                $('#selectedItemsTable tbody tr').each(function () {
                    var price = parseFloat($(this).find('.total-price').text().replace('$', ''));
                    subtotal += price;
                });

                var taxRate = 0;

                $.ajax({
                    url: '/Order/GetTaxPercentage', // Adjust the URL to match your controller action
                    type: 'GET',
                    success: function (data) {
                        // On success, update the tax input field with the retrieved value
                        taxRate = parseFloat(data.orderTax) / 100;

                        // Calculate tax and total price after retrieving tax rate
                        var tax = subtotal * taxRate;
                        var discount = parseFloat($('#discount').val()) || 0;
                        var service = parseFloat($('#service').val()) || 0;
                        var totalPrice = subtotal + tax + service - discount;

                        // Set tax and total price fields
                        $('#tax').val(tax.toFixed(2));
                        $('#totalPrice').val(totalPrice.toFixed(2));
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });
            }



        });

    </script>

    <script>
        $(document).ready(function () {


            $('#addInvoiceBtn').click(function () {
                // Set the value of the hidden input field "cash" to false
                $('#cash').val('false');
            });

            // Function to handle click on payInvoiceBtn
            $('#payInvoiceBtn').click(function () {
                // Set the value of the hidden input field "cash" to true
                $('#cash').val('true');
            });


            $('#orderForm').submit(function () {
                // Initialize index
                var index = 0;

                // Loop through each selected item in the table
                $('#selectedItemsTable tbody tr').each(function () {
                    var itemId = $(this).data('id');
                    var quantity = parseInt($(this).find('.quantity').text());
                    var priceForUnit = parseFloat($(this).find('td:eq(3)').text().replace('$', ''));
                    var price = parseFloat($(this).find('.total-price').text().replace('$', ''));

                    // Create hidden input fields for each property of the OrderMenuItemViewModel
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'OrderMenuItems[' + index + '].MenuItemId',
                        value: itemId
                    }).appendTo('#orderForm');

                    $('<input>').attr({
                        type: 'hidden',
                        name: 'OrderMenuItems[' + index + '].Quantity',
                        value: quantity
                    }).appendTo('#orderForm');

                    $('<input>').attr({
                        type: 'hidden',
                        name: 'OrderMenuItems[' + index + '].PriceForUnit',
                        value: priceForUnit
                    }).appendTo('#orderForm');

                    $('<input>').attr({
                        type: 'hidden',
                        name: 'OrderMenuItems[' + index + '].Price',
                        value: price
                    }).appendTo('#orderForm');

                    // Increment index
                    index++;
                });
            });
        });
    </script>

}