@model LookupEditViewModel
@{
    string titleKey = ViewBag.TitleKey;
    string icon = ViewBag.Icon;
    bool hasCode = ViewBag.HasCode;
    var fields = (IReadOnlyList<LookupField>)ViewBag.Fields;
    string controllerName = (string)ViewContext.RouteData.Values["controller"];
    var isNew = Model.Id == 0;
    var isArabic = LanguageHelper.IsArabic();
    ViewBag.Title = (isNew ? L["New"].Value : L["Edit"].Value) + " - " + L[titleKey].Value;

    string Extra(string name) => Model.Extras.TryGetValue(name, out var value) ? value : string.Empty;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas @icon" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="ad-card-body">
        <form asp-action="Upsert" method="post" class="ad-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            @if (hasCode)
            {
                <div class="form-group">
                    <label asp-for="Code" class="control-label">@L["Code"]</label>
                    <input asp-for="Code" class="form-control" maxlength="20" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
            }

            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>

            @foreach (var field in fields)
            {
                var name = "Extras[" + field.Name + "]";
                var label = L["Lookup.Field." + field.Name];
                <div class="form-group @(field.Kind == LookupFieldKind.Bool ? "ad-check" : string.Empty)">
                    @switch (field.Kind)
                    {
                        case LookupFieldKind.Bool:
                            <label class="control-label">
                                <input type="checkbox" name="@name" value="true" checked="@(Extra(field.Name) == "true")" />
                                <input type="hidden" name="@name" value="false" />
                                @label
                            </label>
                            break;

                        case LookupFieldKind.Decimal:
                            <label class="control-label">@label</label>
                            <input type="number" step="0.01" min="0" name="@name" value="@Extra(field.Name)" class="form-control" />
                            break;

                        case LookupFieldKind.Int:
                            <label class="control-label">@label</label>
                            <input type="number" min="0" name="@name" value="@Extra(field.Name)" class="form-control" />
                            break;

                        case LookupFieldKind.Enum:
                            <label class="control-label">@label</label>
                            <select name="@name" class="form-control">
                                <option value="">@L["Select"]</option>
                                @foreach (var value in Enum.GetValues(field.EnumType))
                                {
                                    <option value="@((int)value)" selected="@(Extra(field.Name) == ((int)value).ToString())">@value</option>
                                }
                            </select>
                            break;

                        case LookupFieldKind.Parent:
                        case LookupFieldKind.Reference:
                            <label class="control-label">@label</label>
                            <select name="@name" class="form-control">
                                <option value="">@L["Select"]</option>
                                @if (Model.Options.TryGetValue(field.Name, out var options))
                                {
                                    @foreach (var item in options)
                                    {
                                        <option value="@item.Id" selected="@(Extra(field.Name) == item.Id.ToString())">@(isArabic ? item.ArName : item.EnName)</option>
                                    }
                                }
                            </select>
                            break;

                        default:
                            <label class="control-label">@label</label>
                            <input type="text" name="@name" value="@Extra(field.Name)" class="form-control" />
                            break;
                    }
                    @if (ViewData.ModelState.TryGetValue(name, out var state) && state.Errors.Count > 0)
                    {
                        <span class="text-danger">@state.Errors[0].ErrorMessage</span>
                    }
                </div>
            }

            <div class="ad-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/@controllerName/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
