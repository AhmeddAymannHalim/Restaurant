@model Customer

@{
    ViewData["Title"] = "Details";
}


<h1 class="text-center">تفاصيل بيانات عميل</h1>
<hr />


<div>
   
    <dl class="row">
        
        <dt class="col-sm-2">
            الاسم
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-2">
            العنوان
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Address)
        </dd>

        <dt class="col-sm-2">
            الموبايل
        </dt>
        <dd class="col-sm-9">
            @Model.MobileNumber
        </dd>
        <dt class="col-sm-2">
            الهاتف
        </dt>
        <dd class="col-sm-9">
            @Model.PhoneNumber
        </dd>

        <dt class="col-sm-2">
            الرصيد
        </dt>
        <dd class="col-sm-9">
            @Model.Balance
            </dd>

        <dt class="col-sm-2">
            فواتير الدفع و التسديد
        </dt>
        <dd class="col-sm-9">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>

                        <th>
                            كود الفاتورة
                        </th>
                        <th>
                            تاريخ الفاتورة
                        </th>

                        <th>
                            المدفوع
                        </th>
                        <th>
                            المتبقي
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PaymentInvoices)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.ProcessCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Paid)
                            </td>
                            <td>
                                @Model.Balance
                            </td>
                            <td>
                                @Html.ActionLink("التفاصيل", "CustomerInvoiceDetails", "PaymentInvoice", new { id = item.Id })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </dd>

    </dl>


</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">تعديل</a> |
    <a asp-action="Index">عودة للعملاء</a>
</div>
