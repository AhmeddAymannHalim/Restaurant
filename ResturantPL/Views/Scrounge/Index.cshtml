@model IEnumerable<Scrounge>




    <h1 class="text-center">جميع مصروفات الموظفين</h1>
    <hr />


    <a class="btn btn-success" href="/Scrounge/Create">اضافة مصروف لموظف</a>

    <table class="table table-hover text-center table-bordered table-striped-columns table-dark">

        <thead>
            <tr>

                <td>المستخدم</td>
                <td>التاريخ</td>
                <td>الموظف</td>
                <td>حالة المبلغ</td>
                <td>المبلغ</td>
                <td>الوصف</td>
                <td>التوجيهات</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User.FullName</td>
                    <td>@item.CreatedTime</td>
                    <td>@item.Employee.FullName</td>
                    <td>@item.State.StateName</td>
                    <td>@item.Amount</td>
                    <td>@item.Info</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">تفاصيل</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">تعديل</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
