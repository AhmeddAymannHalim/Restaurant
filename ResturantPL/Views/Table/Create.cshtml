@model Table

@{
    ViewData["Title"] = "Create";
}


<h1 class="text-center">اضافة طاولة جديدة</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            @*For Server Side Validation Data Annotation*@
            <div asp-validation-summary="ModelOnly" class="text-danger"> </div>

            <div class="form-group">
                <label asp-for="Name">الاسم</label>
                <input asp-for="Name" class="form-control" required />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumOfPersons">عدد الكراسي</label>
                <input asp-for="NumOfPersons" class="form-control" required />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="NumOfPersons" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" /> | 
                <a asp-action="Index">عودة للطاولات</a>
            </div>
        </form>

    </div>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}