@model ResturantPL.ViewModels.BranchViewModel

@{
    ViewData["Title"] = "AddBranch";
}



<h1 class="text-center">اضافة فرع جديد</h1>
<hr />

<div class="container m-3">
    <div class="row">
        <div class="col-md-4">
            <form asp-action="AddBranch">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Code" class="control-label"></label>
                    <input id="codeInput" name="Code" value="@ViewBag.Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address" class="control-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
              

                
                <div class="form-group">
                    <label asp-for="Phone1" class="control-label"></label>
                    <input asp-for="Phone1" class="form-control" />
                    <span asp-validation-for="Phone1" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Phone2" class="control-label"></label>
                    <input asp-for="Phone2" class="form-control" />
                    <span asp-validation-for="Phone2" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Mobile1" class="control-label"></label>
                    <input asp-for="Mobile1" class="form-control" />
                    <span asp-validation-for="Mobile1" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Mobile2" class="control-label"></label>
                    <input asp-for="Mobile2" class="form-control" />
                    <span asp-validation-for="Mobile2" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="اضافة" class="btn btn-primary" /> | 
                    <a asp-action="Index">عودة للفروع</a>
                </div>
            </form>
        </div>
    </div>

    <div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $.ajax({
                type: 'GET',
                url: '/Branch/CheckExists',
                success: function (data) {
                    if (data.exists) {
                        $("#codeInput").prop("readonly", true);
                    }
                },
                error: function (xhr, status, error) {
                    console.error(error);
                }
            });
        });
    </script>

}
