@model Deposit

@{
    ViewData["Title"] = "Delete";
}


<h1 class="text-center">حذف الايداع</h1>
<hr />


<div class="row">
    <div class="col-md-4">
        <form asp-action="Delete" method="post">

            <input hidden asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger"> </div>


            <div class="form-group">
                <label asp-for="ProcessCode">كود العملية</label>
                <input disabled asp-for="ProcessCode" class="form-control" />
                <span asp-validation-for="ProcessCode" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="DeposerName"></label>
                <input disabled asp-for="DeposerName" class="form-control" /> 
                <span asp-validation-for="DeposerName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Amount"></label>
                <input disabled asp-for="Amount" class="form-control" /> 
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedTime"></label>
                <input disabled asp-for="CreatedTime" class="form-control" /> 
                <span asp-validation-for="CreatedTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <input disabled asp-for="Description" class="form-control" /> 
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>


            <br />
            <div class="form-group">
                <input type="submit" value="حذف" class="btn btn-danger" /> |
                <a asp-action="Index">عودة لقائمة الايداعات</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}