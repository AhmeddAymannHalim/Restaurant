@model EntryViewModel
@{
    ViewBag.Title = L["Bill.Entry"].Value + " " + Model.Code;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-book" aria-hidden="true"></i></span>
        <h1>@L["Bill.Entry"] #@Model.Code</h1>
        @if (Model.BillId.HasValue)
        {
            <a asp-controller="Bill" asp-action="Details" asp-route-id="@Model.BillId" class="btn-ad btn-ad-ghost">@L["Bill.Bill"] @Model.BillCode</a>
        }
        @if (Model.IsManual)
        {
            <button type="button" onclick="Delete('/Entry/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger"><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
        }
        <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
    </div>
    <div class="bo-card-body">
        <div class="bo-form">
            <div class="form-group"><label>@L["Bill.EntryType"]</label><div class="form-control">@(isArabic ? Model.SettingArName : Model.SettingEnName)</div></div>
            <div class="form-group"><label>@L["InvoiceDate"]</label><div class="form-control">@Model.EntryDate.ToString("yyyy-MM-dd HH:mm")</div></div>
            <div class="form-group"><label>@L["LineTotal"]</label><div class="form-control">@Model.Total.ToString("N2")</div></div>
            <div class="form-group"><label>@L["Bill.Entry"]</label><div class="form-control">@(Model.IsPosted ? L["Bill.Posted"] : L["Bill.NotPosted"])</div></div>
            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="form-group bo-full"><label>@L["Bill.Remarks"]</label><div class="form-control">@Model.Remarks</div></div>
            }
        </div>

        <div class="bo-table-wrap">
            <table class="bo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Bill.Account"]</th>
                        <th>@L["Debit"]</th>
                        <th>@L["Credit"]</th>
                        <th>@L["Bill.Remarks"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Row</td>
                            <td>@line.AccountCode - @(isArabic ? line.AccountArName : line.AccountEnName)</td>
                            <td class="num">@((line.Debit ?? 0).ToString("N2"))</td>
                            <td class="num">@((line.Credit ?? 0).ToString("N2"))</td>
                            <td>@line.Remarks</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2">@L["LineTotal"]</th>
                        <th class="num">@Model.Lines.Sum(a => a.Debit ?? 0).ToString("N2")</th>
                        <th class="num">@Model.Lines.Sum(a => a.Credit ?? 0).ToString("N2")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
