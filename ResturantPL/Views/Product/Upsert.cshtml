@model ProductViewModel
@{
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewProduct"].Value : L["UpdateProduct"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-box" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="bo-card-body">
        <form asp-action="Upsert" method="post" class="bo-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Code" class="control-label">@L["Code"]</label>
                <input asp-for="Code" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductCategoryId" class="control-label">@L["ProductCategory"]</label>
                <select asp-for="ProductCategoryId" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Categories)
                    {
                        <option value="@item.Id" selected="@(Model.ProductCategoryId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
            </div>
            <div class="form-group bo-full" data-row-list data-prefix="Units">
                <label class="control-label">@L["UnitPrices"]</label>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle bo-fit-table">
                        <thead class="table-light">
                            <tr>
                                <th>@L["Unit"]</th>
                                <th>@L["TransRate"]</th>
                                <th>@L["ProductUnitPrice"]</th>
                                <th class="text-center">@L["DefaultUnit"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-rows>
                            @for (var i = 0; i < Model.Units.Count; i++)
                            {
                                var unitRow = Model.Units[i];
                                <tr data-row>
                                    <td>
                                        <select name="Units[@i].UnitPriceId" class="form-select form-select-sm" aria-label="@L["Unit"]">
                                            <option value="">@L["Select"]</option>
                                            @foreach (var unit in Model.UnitList)
                                            {
                                                <option value="@unit.Id" selected="@(unitRow.UnitPriceId == unit.Id)">@(isArabic ? unit.ArName : unit.EnName)</option>
                                            }
                                        </select>
                                        @Html.ValidationMessage($"Units[{i}].UnitPriceId", new { @class = "text-danger" })
                                    </td>
                                    <td>
                                        <input type="number" name="Units[@i].TransRate" value="@unitRow.TransRate.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)" step="0.000001" min="0" class="form-control form-control-sm" aria-label="@L["TransRate"]" />
                                        @Html.ValidationMessage($"Units[{i}].TransRate", new { @class = "text-danger" })
                                    </td>
                                    <td><input type="number" name="Units[@i].Price" value="@unitRow.Price.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)" step="any" min="0" class="form-control form-control-sm" aria-label="@L["ProductUnitPrice"]" /></td>
                                    <td class="text-center"><input type="checkbox" name="Units[@i].IsDefault" value="true" class="form-check-input unit-default" checked="@unitRow.IsDefault" aria-label="@L["DefaultUnit"]" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @Html.ValidationMessage("Units", new { @class = "text-danger d-block" })
                <button type="button" class="btn btn-sm btn-outline-secondary" data-row-add><i class="fas fa-plus" aria-hidden="true"></i> @L["AddLine"]</button>
                <template data-row-template>
                    <tr data-row>
                        <td>
                            <select name="Units[__i__].UnitPriceId" class="form-select form-select-sm" aria-label="@L["Unit"]">
                                <option value="">@L["Select"]</option>
                                @foreach (var unit in Model.UnitList)
                                {
                                    <option value="@unit.Id">@(isArabic ? unit.ArName : unit.EnName)</option>
                                }
                            </select>
                        </td>
                        <td><input type="number" name="Units[__i__].TransRate" value="1" step="0.000001" min="0" class="form-control form-control-sm" aria-label="@L["TransRate"]" /></td>
                        <td><input type="number" name="Units[__i__].Price" value="0" step="any" min="0" class="form-control form-control-sm" aria-label="@L["ProductUnitPrice"]" /></td>
                        <td class="text-center"><input type="checkbox" name="Units[__i__].IsDefault" value="true" class="form-check-input unit-default" aria-label="@L["DefaultUnit"]" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" data-row-remove title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-xmark" aria-hidden="true"></i></button></td>
                    </tr>
                </template>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/Product/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // the default unit is priced by hand; every other unit is its price per base unit times its rate
        function fillUnitPrices() {
            var rows = Array.from(document.querySelectorAll('[data-rows] [data-row]'));
            var main = rows.find(function (row) { return row.querySelector('.unit-default').checked; });
            var mainPrice = main ? parseFloat(main.querySelector('input[name$=".Price"]').value) || 0 : 0;
            var mainRate = main ? parseFloat(main.querySelector('input[name$=".TransRate"]').value) || 0 : 0;
            rows.forEach(function (row) {
                var price = row.querySelector('input[name$=".Price"]');
                var follows = main && row !== main && mainPrice > 0 && mainRate > 0;
                price.readOnly = !!follows;
                if (follows) {
                    var rate = parseFloat(row.querySelector('input[name$=".TransRate"]').value) || 0;
                    price.value = Math.round(mainPrice / mainRate * rate * 1000000) / 1000000;
                }
            });
        }

        document.addEventListener('change', function (event) {
            if (event.target.classList.contains('unit-default') && event.target.checked) {
                document.querySelectorAll('.unit-default').forEach(function (box) {
                    if (box !== event.target) {
                        box.checked = false;
                    }
                });
            }

            fillUnitPrices();
        });
        document.addEventListener('input', fillUnitPrices);
        document.addEventListener('click', function (event) {
            if (event.target.closest('[data-row-add], [data-row-remove]')) {
                setTimeout(fillUnitPrices, 0);
            }
        });
        fillUnitPrices();
    </script>
}
