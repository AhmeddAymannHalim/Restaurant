@model ExpensesByDatesViewModel
@if (Model.Expenses.Count() > 0)
{
    foreach (var item in Model.Expenses)
    {
        <tr>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Expense.ArName</td>
            <td>@item.User.FullName</td>
            <td>@item.Price</td>
        </tr>
    }
    <tr>
        <td class="text-danger"><strong>الاجمالي</strong> </td>
        <td colspan="3"><strong>@Model.Total</strong></td>
    </tr>
}
else
{
    <tr><td colspan='4'>لا توجد نتائج للعرض</td></tr>
}