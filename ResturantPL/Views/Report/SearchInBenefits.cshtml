@{
    ViewData["Title"] = "Search By Dates";
    // Layout = "_Layout1";
}


<div class="container">
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label for="startDate">تاريخ البداية:</label>
                <input type="date" id="startDate" name="startDate" value="@ViewBag.DateNow" class="form-control" required />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="endDate">تاريخ النهاية:</label>
                <input type="date" id="endDate" name="endDate" value="@ViewBag.DateNow" class="form-control" required />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <button id="show" type="button" class="btn btn-primary mt-4" style="width:100%;">عرض الربح</button>
            </div>
        </div>

        <div class="form-group mb-4 col-md-3">
            <label class="control-label">ربح المبيعات</label>
            <input id="benefit" class="form-control" readonly />
        </div>


    </div>

    <a id="report" class="btn btn-primary"> تصدير الي PDF</a>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#show").click(function () {
                var startDate = $("#startDate").val();
                var endDate = $("#endDate").val();

                $.ajax({
                    type: "GET",
                    url: "/Report/BenefitsByDates",
                    data: {
                        startDate: startDate,
                        endDate: endDate
                    },

                    success: function (data) {
                        $('#benefit').val(data);
                        //$("#report").attr("href", `/Report/OrdersReport?startDate=${startDate}&endDate=${endDate}`);
                    },

                    error: function (xhr, status, error) {
                        console.error(error);
                        $('#benefit').val('');

                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#startDate, #endDate').change(function () {
                $('#benefit').val('');
                $("#report").attr("href", `#`);
            });
        });
    </script>
}



