@model SupliersByDatesViewModel

@if (Model.Suppliers.Count() > 0)
{
    foreach (var item in Model.Suppliers)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.TotalDeptor</td>
            <td>@item.TotalCreditor</td>
            <td>@item.Total</td>
            <td class="text-primary">@item.LastBalance</td>
            <td class="text-danger">@item.LastTotalDeptor</td>
            <td class="text-danger">@item.LastTotalCreditor</td>
            <td class="text-danger">@item.LastTotal</td>
            <td class="text-success">@item.AllTotal</td>

        </tr>
    }
    <tr>
        <td class="text-primary"><strong>اجمالي أرصدة الموردرين</strong> </td>
        <td colspan="8"><strong>@Model.Total</strong></td>
    </tr>

}
else
{
    <tr><td colspan='9'>لا توجد نتائج للعرض</td></tr>
}