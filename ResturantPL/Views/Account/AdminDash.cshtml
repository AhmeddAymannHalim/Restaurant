@model AdminDashViewModel
@{
    Layout = null;
    ApplicationUser user = ViewBag.CurrentAdmin;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="~/css/admindashstyle.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DashBoard</title>
</head>

<body>
    <div class="menu">
        <ul>
            <li class="profile">
                <div class="img-box">
                    @if (user.Image != null)
                    {
                        <img src="@user.Image" alt="profile-image">
                    }
                    else
                    {
                        <img src="~/Employee Images/User_Image.png" class="profile-image" width="60" />
                    }
                </div>
                <h2>@ViewBag.CurrentAdmin.FirstName @ViewBag.CurrentAdmin.LastName</h2>
            </li>
            <li>
                <a class="active" href="#">
                    <i class="fas fa-home"></i>
                    <p> لوحة التحكم</p>
                </a>
            </li>
            <li>
                <a asp-action="Index" asp-controller="User">
                    <i class="fas fa-user-group"></i>
                    <p>المستخدمين</p>
                </a>
            </li>
            <li>
                <a asp-action="Index" asp-controller="Home">
                    <i class="fa-solid fa-trowel-bricks"></i>
                    <p>الصفحة الرئيسية</p>
                </a>
            </li>

            <li>
                <a asp-action="Index" asp-controller="ApplicationSetting">
                    <i class="fas fa-cog"></i>
                    <p>الاعدادات</p>
                </a>
            </li>
            <li class="log-out">
                <a asp-action="SignOut" asp-controller="Account">
                    <i class="fas fa-sign-out"></i>
                    <p>تسجيل الخروج</p>
                </a>
            </li>
        </ul>
    </div>




    <div class="content">
        <div class="title-inf">
            <i class="fas fa-chart-bar"></i>
            <p>لوحــة التـحـكــم</p>
        </div>

        <div class="data-inf">



            <a style="text-decoration:none;" asp-action="Invoices" asp-controller="Invoice" class="box">

                <i class="fa-solid fa-receipt"></i>

                <div class="data">
                    <p>فواتير المشتريات و المرتجعات</p>
                    <span>@Model.Invoices.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="StoreConvert" class="box">

                <i class="fa-solid fa-receipt"></i>

                <div class="data">
                    <p>فواتير نقل الاصناف</p>
                    <span>@Model.StoreConverts.Count()</span>
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="Index" asp-controller="Product" class="box">

                <i class="fa-solid fa-apple-whole"></i>
                <div class="data">
                    <p>الاصناف</p>
                    <span>@Model.Products.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="Supplier" class="box">

                <i class="fa-solid fa-truck-field"></i>
                <div class="data">
                    <p>الموردين</p>
                    <span>@Model.Suppliers.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="Customer" class="box">
                <i class="fa-solid fa-person-chalkboard"></i>
                <div class="data">
                    <p>العملاء</p>
                    <span>@Model.Customers.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="IndexSupplier" asp-controller="PaymentInvoice" class="box">

                <i class="fa-solid fa-receipt"></i>
                <div class="data">
                    <p>فواتير تسديد الموردين</p>
                    <span>@Model.PaymentInvoiceSuppliers.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="IndexCustomer" asp-controller="PaymentInvoice" class="box">
                <i class="fa-solid fa-receipt"></i>
                <div class="data">
                    <p>فواتير تسديد العملاء</p>
                    <span>@Model.PaymentInvoiceCustomers.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="Expense" class="box">

                <i class="fa-solid fa-sack-dollar"></i>
                <div class="data">
                    <p>المصروفات</p>
                    <span>@Model.Expenses.Count()</span>
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="Index" asp-controller="ExitExpense" class="box">

                <i class="fa-solid fa-sack-dollar"></i>
                <div class="data">
                    <p>خروج مصروف</p>
                    <span>@Model.ExitExpenses.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="Scrounge" class="box">

                <i class="fa-solid fa-sack-dollar"></i>
                <div class="data">
                    <p>حوافز و خصومات و سلف</p>
                    <span>@Model.Scrounges.Count()</span>
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="Index" asp-controller="Salary" class="box">

                <i class="fa-solid fa-sack-dollar"></i>
                <div class="data">
                    <p>صرف المرتبات</p>
                    <span>@Model.Salaries.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="SalaryType" class="box">

                <i class="fa-solid fa-money-bills"></i>
                <div class="data">
                    <p>انواع الرواتب</p>
                    <span>@Model.SalaryTypes.Count()</span>
                </div>
            </a>

            <a style="text-decoration:none;" asp-action="Index" asp-controller="Table" class="box">

                <i class="fa-solid fa-chair"></i>
                <div class="data">
                    <p>الطاولات</p>
                    <span>@Model.Tables.Count()</span>
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="Index" asp-controller="UnitPrice" class="box">

                <i class="fa-brands fa-unity"></i>
                <div class="data">
                    <p>الوحدات</p>
                    <span>@Model.UnitPrice.Count()</span>
                </div>
            </a>




            <a style="text-decoration:none;" asp-action="Index" asp-controller="Branch" class="box">

                <i class="fa-solid fa-code-branch"></i>
                <div class="data">
                    <p>الفروع</p>
                    <span>@Model.Branches.Count()</span>
                </div>
            </a>





            <a style="text-decoration:none;" asp-action="Index" asp-controller="Store" class="box">

                <i class="fa-solid fa-store"></i>
                <div class="data">
                    <p>المخازن</p>
                    <span>@Model.Stores.Count()</span>
                </div>
            </a>




            <a style="text-decoration:none;" asp-action="Jobs" asp-controller="Job" class="box">

                <i class="fa-solid fa-utensils"></i>
                <div class="data">
                    <p>الوظايف</p>
                    <span>@Model.Jobs.Count()</span>
                </div>
            </a>





            <a style="text-decoration:none;" asp-action="Employees" asp-controller="Employee" class="box">
                <i class="fa-solid fa-person-digging"></i>
                <div class="data">
                    <p>الموظفين</p>
                    <span>@Model.Employees.Count()</span>
                </div>
            </a>





            <a style="text-decoration:none;" asp-action="EmployeeAccounts" asp-controller="Employee" class="box">
                <i class="fa-solid fa-building-user"></i>
                <div class="data">
                    <p>حسابات الموظفين</p>
                    <span>@Model.EmployeeAccounts.Count()</span>
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="Index" asp-controller="kitchen" class="box">
                <i class="fa-solid fa-utensils"></i>
                <div class="data">
                    <p>المطابخ</p>
                    <span>@Model.kitchens.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Roles" asp-controller="Role" class="box">
                <i class="fa-solid fa-hand-sparkles"></i>
                <div class="data">
                    <p>الفئات</p>
                    <span>@Model.Roles.Count()</span>
                </div>
            </a>




            <a style="text-decoration:none;" asp-action="Index" asp-controller="Menu" class="box">
                <i class="fa-solid fa-utensils"></i>
                <div class="data">
                    <p>المنيو</p>
                    <span>@Model.MenuItems.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="MenuSection" class="box">
                <i class="fa-solid fa-utensils"></i>
                <div class="data">
                    <p>اقسام المنيو</p>
                    <span>@Model.MenuSections.Count()</span>
                </div>
            </a>



            <a style="text-decoration:none;" asp-action="Index" asp-controller="Deposit" class="box">
                <i class="fa-solid fa-money-bill-transfer"></i>
                <div class="data">
                    <p>الايرادات</p>
                    <span>@Model.Deposits.Count()</span>
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="Index" asp-controller="Report" class="box">
                <i class="fa-solid fa-file"></i>
                <div class="data">
                    <p>التقارير</p>
                </div>
            </a>





            <a style="text-decoration:none;" asp-action="Create" asp-controller="Order" class="box">
                <i class="fa-solid fa-cart-shopping"></i>
                <div class="data">
                    <p>شاشة المبيعات</p>
                    @* <span>@Model.MenuItems.Count()</span> *@
                </div>
            </a>


            <a style="text-decoration:none;" asp-action="KitchenOrders" asp-controller="kitchen" class="box">
                <i class="fa-solid fa-kitchen-set"></i>
                <div class="data">
                    <p>شاشة المطبخ</p>
                    <span>@Model.kitchenOrders.Count()</span>
                </div>
            </a>



        </div>








        @*

        <div class="box">
        <i class="fa-solid fa-hourglass-end"></i>
        <div class="data">
        <p>Pending Orders</p>
        <span>@Model.Orders.Count()</span>
        </div>
        </div>
        <div class="box">
        <i class="fa-solid fa-chair"></i>
        <div class="data">
        <p>Tables</p>
        <span>@Model.ChefItems.Count()</span>
        </div>
        </div>
        <div class="box">
        <i class="fa-solid fa-shop-lock"></i>

        <div class="data">
        <p>Store</p>
        <span>@Model.BasketItems.Count()</span>
        </div>
        </div> *@





        <div class="title-inf">
            <i class="fas fa-dollar"></i>
            <p>العملاء</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>الرصيد</th>
                    <th>العنوان</th>
                    <th>رقم الهاتف</th>
                    <th>رقم الموبايل</th>
                    <th>اسم العميل</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Customers)
                {
                    <tr>

                        <td><span class="price">LE @item.Balance</span></td>
                        <td><span class="count">@item.Address</span></td>
                        <td><span class="count">@item.PhoneNumber</span></td>
                        <td><span class="count">@item.MobileNumber</span></td>
                        <td>@item.Name</td>
                    </tr>

                }
            </tbody>
        </table>

    </div>
</body>
</html>
<script>
    // Function to redirect to the specified link
    function redirectToLink(action, controller) {
        window.location.href = "/" + controller + "/" + action;
    }

    // Bind click event to each div with class "box"
    document.querySelectorAll('.box').forEach(function (box) {
        box.addEventListener('click', function () {
            // Extract action and controller attributes from the anchor tag inside the div
            var anchor = this.querySelector('a');
            var action = anchor.getAttribute('asp-action');
            var controller = anchor.getAttribute('asp-controller');
            // Check if action and controller are not null or undefined
            if (action && controller) {
                // Redirect to the specified link
                redirectToLink(action, controller);
            } else {
                console.error("Action or controller attribute is missing.");
            }
        });
    });
</script>
