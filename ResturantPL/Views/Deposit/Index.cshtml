@model IEnumerable<Deposit>
@{
    ViewData["Title"] = "Index";
}

    <h1 class="text-center">جميع الايداع</h1>
    <hr />

    <p>
        <a class="btn btn-success" href="/Deposit/Create">اضافة ايداع</a>
    </p>


    <table class="table table-hover text-center table-bordered table-striped-columns table-dark">

        <thead>
            <tr>
                <td>كود العملية</td>
                <td>اسم المودع</td>
                <td>المبلغ</td>
                <td>التاريخ</td>
                <td>الوصف</td>
                <td>المستخدم</td>
                <td>التوجيهات</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProcessCode</td>
                    <td>@item.DeposerName</td>
                    <td>@item.Amount</td>
                    <td>@item.CreatedTime</td>
                    <td>@item.Description</td>
                    <td>@item.User.FullName</td>
                </tr>   
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">تفاصيل</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">تعديل</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>



<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>