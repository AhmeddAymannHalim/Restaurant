@model PaginatedResult<InvoiceViewModel>
@{
    ViewBag.Title = L["Invoices"].Value;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-file-invoice" aria-hidden="true"></i></span>
        <h1>@L["Invoices"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewInvoice"]</a>
    </div>
    <div class="ad-card-body">
        <form asp-action="Index" method="get" class="ad-filters">
            <div class="ad-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="Invoice-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <select name="type" class="form-select w-auto" aria-label="@L["InvoiceType"]">
                <option value="">@L["AllTypes"]</option>
                <option value="Purchases" selected="@(Model.Type == "Purchases")">@L["Purchases"]</option>
                <option value="Returns" selected="@(Model.Type == "Returns")">@L["Returns"]</option>
            </select>
            <input type="date" name="fromDate" class="form-control w-auto" value="@Model.FromDate?.ToString("yyyy-MM-dd")" aria-label="@L["From"]" title="@L["From"]" />
            <input type="date" name="toDate" class="form-control w-auto" value="@Model.ToDate?.ToString("yyyy-MM-dd")" aria-label="@L["To"]" title="@L["To"]" />
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="ad-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

        @await Html.PartialAsync("_ExportToolbar", "Invoice-table")
        <div class="ad-table-wrap">
            <table id="Invoice-table" class="ad-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["InvoiceCode"]</th>
                        <th>@L["InvoiceDate"]</th>
                        <th>@L["InvoiceType"]</th>
                        <th>@L["Supplier"]</th>
                        <th>@L["Store"]</th>
                        <th>@L["NetTotal"]</th>
                        <th>@L["Paid"]</th>
                        <th>@L["Remaining"]</th>
                        <th data-export-ignore="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Data.Any())
                    {
                        var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@item.InvoiceCode</td>
                                <td>@item.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@L[item.InvoiceType.ToString()]</td>
                                <td>@(isArabic ? item.SupplierArName : item.SupplierEnName)</td>
                                <td>@(isArabic ? item.StoreArName : item.StoreEnName)</td>
                                <td class="num">@item.TotalPrice.ToString("N2")</td>
                                <td class="num">@item.Paid.ToString("N2")</td>
                                <td class="num">@item.Remaining.ToString("N2")</td>
                                <td class="ad-row-actions">
                                    <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                    <a asp-action="Pdf" asp-route-id="@item.Id" data-no-loader class="btn-ad btn-ad-ghost btn-icon" title="@L["Print"]" aria-label="@L["Print"]"><i class="fas fa-print" aria-hidden="true"></i></a>
                                    <button type="button" onclick="Delete('/Invoice/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="ad-empty">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
