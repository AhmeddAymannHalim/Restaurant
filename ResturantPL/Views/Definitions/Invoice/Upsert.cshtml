@model InvoiceViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewInvoice"].Value : L["UpdateInvoice"].Value;
    var invariant = CultureInfo.InvariantCulture;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-file-invoice" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title <small>@Model.InvoiceCode</small></h1>
        @if (!isNew)
        {
            <a asp-action="Pdf" asp-route-id="@Model.Id" data-no-loader class="btn-ad btn-ad-ghost"><i class="fas fa-print" aria-hidden="true"></i> @L["Print"]</a>
        }
    </div>
    <div class="ad-card-body">
        <form id="invoiceForm" asp-action="Upsert" method="post" class="ad-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label class="control-label">@L["InvoiceCode"]</label>
                <input class="form-control" value="@Model.InvoiceCode" readonly />
            </div>
            <div class="form-group">
                <label asp-for="InvoiceType" class="control-label">@L["InvoiceType"]</label>
                <select asp-for="InvoiceType" class="form-select">
                    <option value="Purchases" selected="@(Model.InvoiceType == InvoiceType.Purchases)">@L["Purchases"]</option>
                    <option value="Returns" selected="@(Model.InvoiceType == InvoiceType.Returns)">@L["Returns"]</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="PayType" class="control-label">@L["PayType"]</label>
                <select asp-for="PayType" class="form-select">
                    <option value="Cash" selected="@(Model.PayType == PayTypes.Cash)">@L["PayCash"]</option>
                    <option value="Later" selected="@(Model.PayType == PayTypes.Later)">@L["PayLater"]</option>
                    <option value="Money" selected="@(Model.PayType == PayTypes.Money)">@L["PayMoney"]</option>
                    <option value="Visa" selected="@(Model.PayType == PayTypes.Visa)">@L["PayVisa"]</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="SupplierId" class="control-label">@L["Supplier"]</label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Suppliers)
                    {
                        <option value="@item.Id" selected="@(Model.SupplierId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@L["SupplierBalance"]</label>
                <input id="supplierBalance" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="StoreId" class="control-label">@L["Store"]</label>
                <select asp-for="StoreId" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Stores)
                    {
                        <option value="@item.Id" selected="@(Model.StoreId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="StoreId" class="text-danger"></span>
            </div>

            <div class="ad-full ad-lines-picker">
                <div class="form-group">
                    <label class="control-label">@L["ProductCategory"]</label>
                    <select id="categoryList" class="form-select">
                        <option value="">@L["AllCategories"]</option>
                        @foreach (var item in Model.Categories)
                        {
                            <option value="@item.Id">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="control-label">@L["Product"]</label>
                    <select id="productList" class="form-select"><option value="">@L["Select"]</option></select>
                </div>
                <div class="form-group">
                    <label class="control-label">@L["AvailableQuantity"]</label>
                    <input id="available" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label class="control-label">@L["Unit"]</label>
                    <select id="unitList" class="form-select">
                        @foreach (var item in Model.Units)
                        {
                            <option value="@item.Id">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="control-label">@L["Quantity"]</label>
                    <input id="quantity" type="number" step="any" min="0" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">@L["Price"]</label>
                    <input id="price" type="number" step="any" min="0" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">@L["LineTotal"]</label>
                    <input id="lineTotal" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label class="control-label">&nbsp;</label>
                    <button id="addLine" type="button" class="btn-ad btn-ad-primary w-100"><i class="fas fa-plus" aria-hidden="true"></i> @L["AddLine"]</button>
                </div>
            </div>

            <div class="ad-full">
                <div class="ad-table-wrap">
                    <table id="linesTable" class="ad-table">
                        <thead>
                            <tr>
                                <th>@L["Product"]</th>
                                <th>@L["Unit"]</th>
                                <th>@L["Quantity"]</th>
                                <th>@L["Price"]</th>
                                <th>@L["LineTotal"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr data-product="@item.ProductId" data-unit="@item.UnitPriceId" data-qty="@item.Quantity.ToString(invariant)" data-price="@item.Price.ToString(invariant)">
                                    <td>@item.ProductName</td>
                                    <td>@item.UnitName</td>
                                    <td class="num">@item.Quantity.ToString("0.###", invariant)</td>
                                    <td class="num">@item.Price.ToString("N2")</td>
                                    <td class="num">@item.Total.ToString("N2")</td>
                                    <td class="ad-row-actions"><button type="button" class="btn-ad btn-ad-danger btn-icon removeLine" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <span asp-validation-for="Items" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">@L["SubTotal"]</label>
                <input id="subTotal" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Discount" class="control-label">@L["Discount"]</label>
                <input id="discount" asp-for="Discount" type="number" step="any" min="0" class="form-control" />
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@L["NetTotal"]</label>
                <input id="net" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Paid" class="control-label">@L["Paid"]</label>
                <input id="paid" asp-for="Paid" type="number" step="any" min="0" class="form-control" />
                <span asp-validation-for="Paid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@L["Remaining"]</label>
                <input id="remaining" class="form-control" readonly />
            </div>

            <div class="ad-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
                @if (!isNew)
                {
                    <button type="button" onclick="Delete('/Invoice/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push"><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            var stock = {};
            var storeLoaded = false;
            var msgFill = @Html.Raw(Json.Serialize(L["FillComponentFields"].Value));
            var msgStock = @Html.Raw(Json.Serialize(L["InsufficientStock"].Value));
            var msgSelect = @Html.Raw(Json.Serialize(L["Select"].Value));

            function number(value) { return parseFloat(value) || 0; }
            function money(value) { return (Math.round(value * 100) / 100).toFixed(2); }

            function recalc() {
                var sub = 0;
                $('#linesTable tbody tr').each(function () {
                    sub += number($(this).data('qty')) * number($(this).data('price'));
                });
                var net = sub - number($('#discount').val());
                $('#subTotal').val(money(sub));
                $('#net').val(money(net));
                $('#remaining').val(money(net - number($('#paid').val())));
            }

            var isArabic = @Html.Raw(Json.Serialize(LanguageHelper.IsArabic()));

            function renderProducts() {
                var category = $('#categoryList').val();
                $('#productList').empty().append($('<option>', { value: '', text: msgSelect }));
                $('#available, #quantity, #price, #lineTotal').val('');
                $.each(stock, function (id, p) {
                    if (category && String(p.productCategoryId) !== category) { return; }
                    $('#productList').append($('<option>', { value: p.productId, text: isArabic ? p.productArName : p.productEnName }));
                });
            }

            function loadProducts(storeId) {
                stock = {};
                renderProducts();
                if (!storeId) { return; }
                $.get('/Lookup/StoreProducts', { storeId: storeId }, function (data) {
                    $.each(data, function (i, p) { stock[p.productId] = p; });
                    renderProducts();
                });
            }

            $('#categoryList').on('change', renderProducts);

            $('#StoreId').on('change', function () {
                if (storeLoaded) { $('#linesTable tbody').empty(); }
                storeLoaded = true;
                loadProducts($(this).val());
                recalc();
            });

            $('#SupplierId').on('change', function () {
                var id = $(this).val();
                if (!id) { $('#supplierBalance').val(''); return; }
                $.get('/Invoice/SupplierBalance', { supplierId: id }, function (balance) { $('#supplierBalance').val(money(balance)); });
            });

            $('#productList').on('change', function () {
                var item = stock[$(this).val()];
                $('#available').val(item ? item.quantity : '');
                $('#price').val(item ? item.cost : '');
                $('#quantity').val('');
                $('#lineTotal').val('');
            });

            $('#quantity, #price').on('input', function () {
                $('#lineTotal').val(money(number($('#quantity').val()) * number($('#price').val())));
            });

            $('#addLine').on('click', function () {
                var productId = $('#productList').val();
                var qty = number($('#quantity').val());
                var price = number($('#price').val());
                if (!productId || qty <= 0 || $('#price').val() === '') {
                    toastr.error(msgFill);
                    return;
                }
                if ($('#InvoiceType').val() === 'Returns' && qty > number($('#available').val())) {
                    toastr.error(msgStock);
                    return;
                }
                $('#linesTable tbody').append(
                    $('<tr>').attr({ 'data-product': productId, 'data-unit': $('#unitList').val(), 'data-qty': qty, 'data-price': price })
                        .append($('<td>').text($('#productList option:selected').text()))
                        .append($('<td>').text($('#unitList option:selected').text()))
                        .append($('<td class="num">').text(qty))
                        .append($('<td class="num">').text(money(price)))
                        .append($('<td class="num">').text(money(qty * price)))
                        .append($('<td class="ad-row-actions">').append($('<button type="button" class="btn-ad btn-ad-danger btn-icon removeLine"><i class="fas fa-trash" aria-hidden="true"></i></button>'))));
                $('#productList').val('').trigger('change');
                recalc();
            });

            $(document).on('click', '.removeLine', function () {
                $(this).closest('tr').remove();
                recalc();
            });

            $('#discount, #paid').on('input', recalc);

            $('#invoiceForm').on('submit', function () {
                var form = $(this);
                form.find('input.line-input').remove();
                $('#linesTable tbody tr').each(function (i) {
                    var row = $(this);
                    var values = { ProductId: row.data('product'), UnitPriceId: row.data('unit'), Quantity: row.data('qty'), Price: row.data('price') };
                    $.each(values, function (name, value) {
                        $('<input type="hidden" class="line-input">').attr('name', 'Items[' + i + '].' + name).val(value).appendTo(form);
                    });
                });
            });

            var storeOptions = $('#StoreId option').filter(function () { return $(this).val() !== ''; });
            if (!$('#StoreId').val() && storeOptions.length === 1) {
                $('#StoreId').val(storeOptions.first().val());
            }
            if ($('#StoreId').val()) { loadProducts($('#StoreId').val()); storeLoaded = true; }
            if ($('#SupplierId').val()) { $('#SupplierId').trigger('change'); }
            recalc();
        });
    </script>
}
