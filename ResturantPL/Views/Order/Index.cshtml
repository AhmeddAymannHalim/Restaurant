@model ShiftDashboardViewModel
@{
    ViewBag.Title = L["ShiftSummary"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-cash-register" aria-hidden="true"></i></span>
        <h1>@L["ShiftSummary"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewOrder"]</a>
    </div>
    <form asp-controller="Shift" asp-action="End" method="post" class="ad-filters shift-end">
        <input name="password" type="password" class="form-control w-auto" placeholder="@L["Setting_Password"]" autocomplete="off" required />
        <input name="countedCash" type="number" step="0.01" min="0" class="form-control w-auto" placeholder="@L["CountedCash"]" required />
        <button type="submit" class="btn-ad btn-ad-danger"><i class="fas fa-flag-checkered" aria-hidden="true"></i> @L["EndShift"]</button>
    </form>
    <div class="ad-card-body">
        @if (Model.LastShiftReport is not null)
        {
            <div class="ad-table-wrap shift-last-report">
                <table class="ad-table">
                    <caption>@L["LastShiftReport"] (@Model.LastShiftReport.ClosedAt.ToString("g"))</caption>
                    <thead>
                        <tr>
                            <th>@L["ExpectedCash"]</th>
                            <th>@L["CountedCash"]</th>
                            <th>@L["Variance"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.LastShiftReport.ExpectedCash.ToString("N2")</td>
                            <td>@Model.LastShiftReport.CountedCash.ToString("N2")</td>
                            <td class="@(Model.LastShiftReport.Variance == 0 ? "" : "text-danger")">@Model.LastShiftReport.Variance.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        <div class="shift-totals">
            <div class="shift-tile">
                <span>@L["MoneyInDrawer"]</span>
                <strong>@Model.MoneyInDrawer.ToString("N2")</strong>
                <small>@Model.MoneyInDrawerCount @L["Orders"]</small>
            </div>
            <div class="shift-tile">
                <span>@L["Collected"]</span>
                <strong>@Model.CollectedTotal.ToString("N2")</strong>
                <small>@Model.CollectedCount @L["Orders"]</small>
            </div>
            <div class="shift-tile">
                <span>@L["CollectedFromOthers"]</span>
                <strong>@Model.CollectedFromOthers.Amount.ToString("N2")</strong>
                <small>@Model.CollectedFromOthers.Count @L["Orders"]</small>
            </div>
            <div class="shift-tile">
                <span>@L["ElectronicPayments"]</span>
                <strong>@Model.Electronic.Amount.ToString("N2")</strong>
                <small>@Model.Electronic.Count @L["Orders"]</small>
            </div>
            <div class="shift-tile">
                <span>@L["OnAccountOrders"]</span>
                <strong>@Model.OnAccount.Amount.ToString("N2")</strong>
                <small>@Model.OnAccount.Count @L["Orders"]</small>
            </div>
            <div class="shift-tile shift-tile-warn">
                <span>@L["PendingOrders"]</span>
                <strong>@Model.PendingTotal.ToString("N2")</strong>
                <small>@Model.PendingCount @L["Orders"]</small>
            </div>
        </div>

        @{
            var sections = new[]
            {
                (L["Collected"].Value, Model.Collected, "shift"),
                (L["PendingMine"].Value, Model.PendingMine, "pending"),
                (L["PendingOthers"].Value, Model.PendingOthers, "pending")
            };
        }

        <div class="shift-sections">
            @foreach (var (title, rows, status) in sections)
            {
                <div class="ad-table-wrap">
                    <table class="ad-table">
                        <caption>@title</caption>
                        <thead>
                            <tr>
                                <th>@L["OrderType"]</th>
                                <th>@L["Count"]</th>
                                <th>@L["Amount"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    <td>@L[row.Type.ToString()]</td>
                                    <td class="num">@row.Count</td>
                                    <td class="num">@row.Amount.ToString("N2")</td>
                                    <td class="ad-row-actions">
                                        <a asp-action="List" asp-route-status="@status" asp-route-type="@row.Type" class="btn-ad btn-ad-ghost btn-icon" title="@L["View"]" aria-label="@L["View"]"><i class="fas fa-eye" aria-hidden="true"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
