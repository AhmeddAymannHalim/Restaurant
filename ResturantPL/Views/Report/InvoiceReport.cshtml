@model Restaurant.Data.Models.Invoice

@{
    ViewData["Title"] = "Invoice report";
    Layout = null;
}

<style>
    body {
    font-family: Arial, sans-serif;
    padding: 20px;
    margin: 0;
    background-color: #fff;
    direction: rtl;
}


h1, h2, h3, p {
    text-align: center;
}

table {
    width: 100%;
    border-collapse: collapse; /* Collapse table borders */
    margin-top: 20px; /* Add margin at the top */
    font-size: 22px;
}


.mainRow, th {
    background-color: #f2f2f2; /* Light gray background for dt elements */
    font-weight: bold;
}

th, td {
    border: 1px solid #ccc; /* Add border for styling */
    padding: 8px;
    text-align: center;
}

</style>


@if (Model.InvoiceType == InvoiceType.Purchases)
{
    <h1> فاتورة مشتريات</h1>
}
else
{
    <h1>فاتورة مرتجعات</h1>
}
<hr />


<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr>
            <th colspan="2">التفاصيل</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mainRow">كود الفاتورة</td>
            <td>@Model.InvoiceCode</td>
        </tr>
        <tr>
            <td class="mainRow">تاريخ الفاتورة</td>
            <td>@Model.InvoiceDate.ToString("dd-MM-yyyy  hh:mm tt")</td>
        </tr>

        <tr>
            <td class="mainRow">الخصم</td>
            <td>@Model.Discount</td>
        </tr>
        <tr>
            <td class="mainRow">  الاجمالي بعد الخصم</td>
            <td>@Model.TotalPrice</td>
        </tr>
        <tr>
            <td class="mainRow">المدفوع</td>
            <td>@Model.Paid</td>
        </tr>
        <tr>
            <td class="mainRow">المتبقي</td>
            <td>@Model.Remaining</td>
        </tr>

        <tr>
            <td class="mainRow">  نوع الدفع</td>

            @if (Model.PayType == PayType.Cash)
            {
                <td>كاش</td>
            }
            else
            {
                <td>آجل</td>
            }
        </tr>

        <tr>
            <td class="mainRow">المورد</td>
            <td>@Model.Supplier.Name</td>
        </tr>
         <tr>
            <td class="mainRow">المخزن</td>
            <td>@Model.Store.Name</td>
        </tr>


       
        <tr>
            <td class="mainRow">المنتجات</td>
            <td>
                <table class="mt-3 table table-bordered table-light text-dark">
                    <tr>
                        <th>اسم المنتج</th>
                        <th>الوحدة</th>
                        <th>الكمية</th>
                        <th>السعر</th>
                        <th>الاجمالي</th>

                    </tr>
                    @foreach (var item in Model.InvoiceItems)
                    {
                        <tr>
                            <td>@item.StoreProduct.ProductName</td>
                            <td>@item.UnitPrice.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price</td>
                            <td>@item.Total</td>
                        </tr>
                    }
                </table>
            </td>
        </tr>

    </tbody>
</table>
