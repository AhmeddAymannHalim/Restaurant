                    <input type="hidden" name="lastPendingDeliveryTotal" value="@ViewBag.LastPendingDelivery.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.LastPendingDelivery.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.LastPendingDelivery.TotalAmount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div id="lastPendingDeliveryOnline" class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">الاونلاين المعلق من الشيفت السابق</h5>
                    <input type="hidden" name="lastPendingDeliveryOnlineNmuber" value="@ViewBag.lastPendingOnlineDelivery.NumberOfOrder" />
                    <input type="hidden" name="lastPendingDeliveryOnlineTotal" value="@ViewBag.lastPendingOnlineDelivery.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.lastPendingOnlineDelivery.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.lastPendingOnlineDelivery.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="totalLastPending" class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">اجمالي المعلق من الشيفت السابق</h5>
                    <input type="hidden" name="lastTotalPendingNumber" value="@ViewBag.TotalLastPending.NumberOfOrder" />
                    <input type="hidden" name="lastTotalPendingTotal" value="@ViewBag.TotalLastPending.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.TotalLastPending.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.TotalLastPending.TotalAmount</p>
                </div>
            </div>
        </div>
    </div>
    <hr />






    <div class="row m-3">
        <div id="totalSummary" class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">الطلبات المباعة من الشيفت الحالي</h5>
                    <input type="hidden" name="totalSummeryNumber" value="@ViewBag.TotalSummary.NumberOfOrder" />
                    <input type="hidden" name="totalSummeryTotal" value="@ViewBag.TotalSummary.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.TotalSummary.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.TotalSummary.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="selledLastPending" class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">الطلبات المباعة من الشيفت السابق</h5>
                    <input type="hidden" name="selledLastPendingNumber" value="@ViewBag.SelledLastPending.NumberOfOrder" />
                    <input type="hidden" name="selledLastPendingTotal" value="@ViewBag.SelledLastPending.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.SelledLastPending.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.SelledLastPending.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="totalMoney" class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">اجمالي المال المعلق</h5>
                    <input type="hidden" name="TotalRemainForPendingNumber" value="@ViewBag.RemainForPending.NumberOfOrder" />
                    <input type="hidden" name="TotalRemainForPendingTotal" value="@ViewBag.RemainForPending.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.RemainForPending.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.RemainForPending.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="totalMoney" class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">اجمالي المال في الدرج</h5>
                    <input type="hidden" name="totalMoneyNumber" value="@ViewBag.TotalMoney.NumberOfOrder" />
                    <input type="hidden" name="totalMoneyTotal" value="@ViewBag.TotalMoney.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.TotalMoney.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.TotalMoney.TotalAmount</p>
                </div>
            </div>
        </div>
    </div>
    <hr />
    <button id="export" type="submit" class="btn btn-primary text-center col-md-12">تصدير الي pdf</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

