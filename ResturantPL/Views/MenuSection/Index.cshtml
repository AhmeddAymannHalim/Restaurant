@model IEnumerable<Restaurant.Data.Models.MenuSection>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">الاقسام</h1>
<hr />
<p>
    <a asp-action="Create">اضافة قسم جديد</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                اسم القسم
            </th>
            <th>
                عدد المنتجات
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @item.MenuItems.Count()
                </td>

                <td>
                    @Html.ActionLink("تعديل", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("التفاصيل", "Details", new { id = item.Id }) |
                    @Html.ActionLink("حذف", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>