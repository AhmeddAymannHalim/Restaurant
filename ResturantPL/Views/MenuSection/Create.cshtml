@model Restaurant.Data.Models.MenuSection

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-center">اضافة قسم جديد</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label">اسم القسم</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
           
            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" /> |
                <a asp-action="Index">عودة للاقسام</a>
            </div>
        </form>
    </div>
</div>

<div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
