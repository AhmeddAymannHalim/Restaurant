@model CompanyViewModel
@{
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewCompany"].Value : L["UpdateCompany"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-city" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title</h1>
    </div>
    <div class="bo-card-body">
        <form asp-action="Upsert" method="post" class="bo-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Code" class="control-label">@L["Code"]</label>
                <input asp-for="Code" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="ArName" class="control-label">@L["ArabicName"]</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnName" class="control-label">@L["EnglishName"]</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label">@L["Address"]</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone1" class="control-label">@L["Phone"]</label>
                <input asp-for="Phone1" class="form-control" />
                <span asp-validation-for="Phone1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone2" class="control-label">@L["Phone2"]</label>
                <input asp-for="Phone2" class="form-control" />
                <span asp-validation-for="Phone2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label">@L["Email"]</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VatNumber" class="control-label">@L["VatNumber"]</label>
                <input asp-for="VatNumber" class="form-control" />
                <span asp-validation-for="VatNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RegistrationNumber" class="control-label">@L["RegistrationNumber"]</label>
                <input asp-for="RegistrationNumber" class="form-control" />
                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrencyId" class="control-label">@L["Account.Currency"]</label>
                <select asp-for="CurrencyId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Currencies)
                    {
                        <option value="@item.Id" selected="@(Model.CurrencyId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="CurrencyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaxId" class="control-label">@L["Tax"]</label>
                <select asp-for="TaxId" class="form-control">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Taxes)
                    {
                        <option value="@item.Id" selected="@(Model.TaxId == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="TaxId" class="text-danger"></span>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/Company/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
