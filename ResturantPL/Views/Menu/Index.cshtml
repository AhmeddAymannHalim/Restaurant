@model IEnumerable<Restaurant.Data.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";
}



<section id="menu" class="menu section-bg mt-5 ">
    <div class="container mt-4" data-aos="fade-up">
        <div class="section-title">
            <p class="float-end">اختار اشهى المأكولات من المنيو الخاص بنا</p>
            <br />
            <br />
            <br />
            <br />
            <a asp-action="CreateMenuItem" asp-controller="Menu" class="btn btn-primary d-inline-block ">إضافه للمنيو</a>
        </div>

      
        <div class="row mt-5" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-12 d-flex justify-content-center">
                <ul id="menu-flters">
                    <li data-filter="*" class="filter-active">الكل</li>
                    @foreach (var menuSection in Model.Select(x => x.MenuSection.Name).Distinct())
                    {
                        <li data-filter=".filter-@menuSection">@menuSection</li>
                    }
                </ul>
            </div>
        </div>

        <div class="row menu-container" data-aos="fade-up" data-aos-delay="200">
            <div class="mt-5">
                @foreach (var groupName in Model.Select(x => x.Name).Distinct())
                {
                    var items = Model.Where(x => x.Name == groupName);
                    var firstItem = items.FirstOrDefault();
                    if (firstItem != null)
                    {
                        <div class="col-lg-5 offset-1 menu-item filter-@firstItem.MenuSection.Name">
                            <img src="@firstItem.ImageUrl" class="menu-img" alt="image">
                            <div class="menu-content">
                                <span>@firstItem.Name</span>
                                <span>LE @firstItem.Price</span>
                            </div>
                            <div class="menu-ingredients" style="direction: rtl;">
                                @firstItem.Description
                            </div>
                            <div>
                                @if (items.Count() > 1)
                                {
                                    <select onchange="location = this.value;" class="form-select float-end m-1" style="width: 200px;">

                                        <option value="">اختر النوع</option>
                                        @foreach (var item in items)
                                        {
                                            string sizeLabel = item.Size switch
                                            {
                                                Size.Small => "صغير",
                                                Size.Medium => "متوسط",
                                                Size.Large => "كبير",
                                                Size.Syrian_Bread => "عيش سوري",
                                                _ => "عادي"
                                            };
                                            <option value="@Url.Action("Details", "Menu", new { id = item.Id })">@sizeLabel -- LE @item.Price</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-controller="Menu" asp-route-id="@firstItem.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">تفاصيل العنصر</a>
                                }
                                <a asp-action="Delete" asp-controller="Menu" asp-route-id="@firstItem.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">حذف العنصر</a>
                                <a asp-action="AddSize" asp-controller="Menu" asp-route-id="@firstItem.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">اضافة حجم</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>



