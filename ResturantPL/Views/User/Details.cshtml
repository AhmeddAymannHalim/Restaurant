@model UsersViewModel
@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center">تفاصيل مستخدم</h1>

<hr />


<form asp-action="Update row">

        <div class="form-group col-md-4">
        <label asp-for="@Model.Name" class="col-form-label">الاسم</label>
        <input asp-for="@Model.Name" class="form-control" readonly />


    </div>

        <div class="form-group col-md-4">
        <label asp-for="@Model.PhoneNumber" class="col-form-label">الايميل</label>
        <input asp-for="@Model.PhoneNumber" class="form-control" readonly />


    </div>

        <div class="form-group col-md-4">
        <label asp-for="@Model.Email" class="col-form-label">رقم الهاتف</label>
        <input asp-for="@Model.Email" class="form-control" readonly />


    </div>

        <div class="form-group col-md-4">
        <label asp-for="@Model.Id" class="col-form-label">ID</label>
        <input asp-for="@Model.Id" class="form-control" readonly />


    </div>
    
    <div>

        @* <a asp-action="Update" asp-route-id="@Model.Id">تعديل</a> |  *@
        <a asp-action="Index" >عودة للمستخدمين</a>
    </div>

</form>


