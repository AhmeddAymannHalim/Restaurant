@model PaymentViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewSupplierPayment"].Value : L["UpdateSupplierPayment"].Value;
    var invariant = CultureInfo.InvariantCulture;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title <small>@Model.ProcessCode</small></h1>
        @if (!isNew)
        {
            <a asp-action="Pdf" asp-route-id="@Model.Id" data-no-loader class="btn-ad btn-ad-ghost"><i class="fas fa-print" aria-hidden="true"></i> @L["Print"]</a>
        }
    </div>
    <div class="bo-card-body">
        <form asp-action="Upsert" method="post" class="bo-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label class="control-label">@L["ProcessCode"]</label>
                <input class="form-control" value="@Model.ProcessCode" readonly />
            </div>
            <div class="form-group">
                <label asp-for="PartnerId" class="control-label">@L["Supplier"]</label>
                <select asp-for="PartnerId" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.Partners)
                    {
                        <option value="@item.Id" selected="@(Model.PartnerId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="PartnerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BillMasterId" class="control-label">@L["Invoice"]</label>
                <select asp-for="BillMasterId" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in Model.OpenInvoices)
                    {
                        <option value="@item.Id" selected="@(Model.BillMasterId == item.Id)">@(LanguageHelper.IsArabic() ? item.ArName : item.EnName)</option>
                    }
                </select>
                <span asp-validation-for="BillMasterId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@L["AmountDue"]</label>
                <input id="due" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Paid" class="control-label">@L["Paid"]</label>
                <input asp-for="Paid" type="number" step="any" min="0" class="form-control" />
                <span asp-validation-for="Paid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@L["Remaining"]</label>
                <input id="remaining" class="form-control" readonly />
            </div>
            <div class="form-group bo-full">
                <label asp-for="Description" class="control-label">@L["Description"]</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
                @if (!isNew)
                {
                    <button type="button" onclick="Delete('/SupplierPayment/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push"><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            var savedBillMasterId = '@(isNew ? "" : Model.BillMasterId.ToString())';
            var savedPaid = @(isNew ? "0" : Model.Paid.ToString(invariant));
            var due = 0;

            function number(value) { return parseFloat(value) || 0; }
            function money(value) { return (Math.round(value * 100) / 100).toFixed(2); }

            function recalc() {
                $('#due').val(money(due));
                $('#remaining').val(money(due - number($('#Paid').val())));
            }

            function loadInvoices(partnerId, selectAfterLoad) {
                $.get('/SupplierPayment/OpenInvoices', { partnerId: partnerId }, function (invoices) {
                    var $select = $('#BillMasterId');
                    $select.find('option[value!=""]').remove();
                    $.each(invoices, function (i, invoice) {
                        $select.append($('<option>').val(invoice.id).text(invoice.enName));
                    });
                    if (selectAfterLoad) { $select.val(selectAfterLoad); }
                    $select.trigger('change');
                });
            }

            $('#PartnerId').on('change', function () {
                var id = $(this).val();
                due = 0;
                if (!id) { recalc(); return; }
                loadInvoices(id);
            });

            $('#BillMasterId').on('change', function () {
                var billId = $(this).val();
                if (!billId) { due = 0; recalc(); return; }
                var text = $('#BillMasterId option:selected').text();
                var parts = text.split(' - ');
                due = number(parts[parts.length - 1]) + (billId === savedBillMasterId ? savedPaid : 0);
                recalc();
            });

            $('#Paid').on('input', recalc);

            if ($('#PartnerId').val()) {
                loadInvoices($('#PartnerId').val(), savedBillMasterId);
            }
            recalc();
        });
    </script>
}
