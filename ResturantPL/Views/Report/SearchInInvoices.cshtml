@{
    ViewData["Title"] = "Search By Dates";
            // Layout = "_Layout1";
}






<div class="container">
        <div class="row justify-content-center">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="startDate">نوع الفواتير:</label>
                    <select id="type" name="type" class="form-control">
                        <option value="All">الكل</option>
                        <option value="Purchase">المشتريات</option>
                        <option value="Returns">المرتجعات</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="startDate">تاريخ البداية:</label>
                <input type="date" id="startDate" name="startDate" value="@ViewBag.DateNow" class="form-control" required />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="endDate">تاريخ النهاية:</label>
                <input type="date" id="endDate" name="endDate" value="@ViewBag.DateNow" class="form-control" required />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <button id="show" type="button" style="width:100%;" class="btn btn-primary mt-4">عرض الفواتير</button>
                </div>
            </div>
        </div>
</div>
<hr />


<h1 class="text-center">الفواتير </h1>
<hr />

<table id="invoiceTable" class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th> كود الفاتورة</th>
            <th> نوع الفاتورة</th>
            <th> تاريخ الفاتورة</th>
            <th> المورد</th>
            <th> المخزن </th>
            <th> عدد المنتجات</th>
            <th> الاجمالي بعد الخصم</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<br />

<a id="report" class="btn btn-primary"> تصدير الي PDF</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#show").click(function () {
                var startDate = $("#startDate").val();
                var endDate = $("#endDate").val();
                var type = $("#type").val();

                $.ajax({
                    type: "GET",
                    url: "/Report/AllInvoicesByDates",
                    data: {
                        type: type,
                        startDate: startDate,
                        endDate: endDate
                    },

                    success: function (result) {
                        $("#invoiceTable tbody").empty();
                        $("#invoiceTable tbody").append(result);
                        $("#report").attr("href", `/Report/InvoicesReport?type=${type}&startDate=${startDate}&endDate=${endDate}`);
                        $("#report").show();
                    },

                    error: function (xhr, status, error) {
                        $("#invoiceTable tbody").empty();
                        $("#invoiceTable tbody").append("<tr><td colspan='7'>حدث خطأ أثناء جلب البيانات</td></tr>");
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#type, #startDate, #endDate').change(function () {
                $("#invoiceTable tbody").empty();
                $("#report").attr("href", `#`);
            });
        });
    </script>
}



