@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="m-5">

<h1 class="text-danger text-center">خطأ</h1>
<hr />

<h2 class="text-danger">حدث خطأ اثناء اجراء العملية</h2>
<br />


@if (Model.ShowErrorMessage)
{
    <h4>
            <strong>رسالة الخطأ : </strong>  <span style="color:deeppink">@Model.ErrorMessage</span>
    </h4>
}

</div>