@model PaginatedResult<PaymentViewModel>
@{
    ViewBag.Title = L["SupplierPayments"].Value;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i></span>
        <h1>@L["SupplierPayments"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewSupplierPayment"]</a>
    </div>
    <div class="ad-card-body">
        <form asp-action="Index" method="get" class="ad-filters">
            <div class="ad-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="SupplierPayment-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <input type="date" name="fromDate" class="form-control w-auto" value="@Model.FromDate?.ToString("yyyy-MM-dd")" aria-label="@L["From"]" title="@L["From"]" />
            <input type="date" name="toDate" class="form-control w-auto" value="@Model.ToDate?.ToString("yyyy-MM-dd")" aria-label="@L["To"]" title="@L["To"]" />
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="ad-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

        @await Html.PartialAsync("_TableExportToolbar", "SupplierPayment-table")
        <div class="ad-table-wrap">
            <table id="SupplierPayment-table" class="ad-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["ProcessCode"]</th>
                        <th>@L["InvoiceDate"]</th>
                        <th>@L["Supplier"]</th>
                        <th>@L["Description"]</th>
                        <th>@L["Paid"]</th>
                        <th data-export-ignore="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Data.Any())
                    {
                        var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@item.ProcessCode</td>
                                <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(isArabic ? item.PartnerArName : item.PartnerEnName)</td>
                                <td>@item.Description</td>
                                <td class="num">@item.Paid.ToString("N2")</td>
                                <td class="ad-row-actions">
                                    <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                    <a asp-action="Pdf" asp-route-id="@item.Id" data-no-loader class="btn-ad btn-ad-ghost btn-icon" title="@L["Print"]" aria-label="@L["Print"]"><i class="fas fa-print" aria-hidden="true"></i></a>
                                    <a asp-action="Refunds" asp-route-paymentId="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Refunds"]" aria-label="@L["Refunds"]"><i class="fas fa-rotate-left" aria-hidden="true"></i></a>
                                    <button type="button" onclick="Delete('/SupplierPayment/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="ad-empty">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
