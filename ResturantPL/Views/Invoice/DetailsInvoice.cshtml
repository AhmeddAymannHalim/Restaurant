@model Restaurant.Data.Models.Invoice

@{
    ViewData["Title"] = "DetailsInvoice";
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link href="~/css/invoicesstyle.css" rel="stylesheet" />


<div class="container">

    @if (Model.InvoiceType == InvoiceType.Purchases)
    {
        <h1> فاتورة مشتريات</h1>
    }
    else
    {
        <h1>فاتورة مرتجعات</h1>
    }
    <hr />


    <dl>

        <dt class="col-sm-3">
            كود الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.InvoiceCode)
        </dd>
        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.InvoiceDate)
        </dd>
        <dt class="col-sm-3">
            الخصم
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Discount)
        </dd>
        <dt class="col-sm-3">
            الاجمالي بعد الخصم
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TotalPrice)
        </dd>
        <dt class="col-sm-3">
            المدفوع
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Paid)
        </dd>
        <dt class="col-sm-3">
            المتبقي
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Remaining)
        </dd>

        <dt class="col-sm-3">
            نوع الدفع
        </dt>

        @if (Model.PayType == PayType.Cash)
        {
            <dd class="col-sm-8">كاش</dd>
        }
        else
        {
            <dd class="col-sm-8">آجل</dd>
        }

        <dt class="col-sm-3">
            المورد
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Supplier.Name)
        </dd>
        <dt class="col-sm-3">
            المخزن
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Store.Name)
        </dd>
        <dt class="col-sm-3">
            المنتجات
        </dt>
        <dd class="col-sm-8">
            @* <table class="table table-hover text-center table-bordered table-striped-columns table-dark"> *@
            <table class="mt-3 table table-bordered table-light text-dark">
                <tr>
                    <th>اسم المنتج</th>
                    <th>الوحدة</th>
                    <th>الكمية</th>
                    <th>السعر</th>
                    <th>الاجمالي</th>

                </tr>
                @foreach (var item in Model.InvoiceItems)
                {
                    <tr>
                        <td>@item.StoreProduct.ProductName</td>
                        <td>@item.UnitPrice.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price</td>
                        <td>@item.Total</td>
                    </tr>
                }
            </table>
        </dd>

    </dl>

  
    <div id="print-button" class="no-print">
        <a class="btn btn-primary" onclick="window.print()"> طباعة</a>
        <a class="btn btn-primary" asp-action="InvoiceReport" asp-controller="Report" asp-route-invoiceId="@Model.Id"> تصدير الي PDF</a>
        <a class="btn btn-info" asp-action="Invoices">عودة للفواتير</a>
    </div>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

