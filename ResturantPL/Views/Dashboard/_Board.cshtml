@model DashboardViewModel
@{
    var isArabic = LanguageHelper.IsArabic();
    var shiftStarted = Context.Session.GetString("IsAuthenticated") == "true";

    string Age(DateTime from)
    {
        var minutes = (int)Math.Max(0, (DateTime.Now - from).TotalMinutes);
        return minutes < 60 ? minutes + " " + L["MinutesShort"].Value : (minutes / 60) + ":" + (minutes % 60).ToString("00");
    }

    bool Late(DateTime from)
    {
        return (DateTime.Now - from).TotalMinutes > 20;
    }

    string Where(OrderType type, string tableAr, string tableEn)
    {
        if (!string.IsNullOrEmpty(tableAr))
        {
            return isArabic ? tableAr : tableEn;
        }

        return L[type.ToString()].Value;
    }
}

<section class="ops-bar">
    <span class="ops-shift @(shiftStarted ? "is-open" : "")">
        <i aria-hidden="true"></i>
        @L[shiftStarted ? "ShiftOpen" : "ShiftNotStarted"]
    </span>
    <div class="ops-actions">
        @if (shiftStarted)
        {
            <a class="btn-ad btn-ad-primary" asp-controller="Order" asp-action="Upsert"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewOrder"]</a>
            <a class="btn-ad btn-ad-ghost" asp-controller="Order" asp-action="Index"><i class="fas fa-flag-checkered" aria-hidden="true"></i> @L["ShiftSummary"]</a>
        }
        else
        {
            <a class="btn-ad btn-ad-primary" asp-controller="Shift" asp-action="Login"><i class="fas fa-play" aria-hidden="true"></i> @L["StartShift"]</a>
        }
    </div>
</section>

<div class="shift-totals">
    <div class="shift-tile">
        <i class="fas fa-sack-dollar shift-tile-icon" aria-hidden="true"></i>
        <span>@L["ShiftSales"]</span>
        <strong>@Model.ShiftSales.ToString("N2")</strong>
        <small>@Model.ShiftOrders @L["Orders"]</small>
    </div>
    <a class="shift-tile @(Model.WaitingOnline > 0 ? "shift-tile-warn" : "")" asp-controller="Order" asp-action="Online">
        <i class="fas fa-globe shift-tile-icon" aria-hidden="true"></i>
        <span>@L["OnlineRequests"]</span>
        <strong>@Model.WaitingOnline</strong>
        <small>@L["OnlineOrders"]</small>
    </a>
    <a class="shift-tile @(Model.InKitchen > 0 ? "shift-tile-warn" : "")" asp-controller="KitchenOrder" asp-action="Index">
        <i class="fas fa-fire-burner shift-tile-icon" aria-hidden="true"></i>
        <span>@L["KitchenQueue"]</span>
        <strong>@Model.InKitchen</strong>
        <small>@L["KitchenOrders"]</small>
    </a>
    <a class="shift-tile @(Model.AwaitingPayment > 0 ? "shift-tile-warn" : "")" asp-controller="Order" asp-action="List" asp-route-status="pending">
        <i class="fas fa-receipt shift-tile-icon" aria-hidden="true"></i>
        <span>@L["AwaitingPayment"]</span>
        <strong>@Model.AwaitingPaymentAmount.ToString("N2")</strong>
        <small>@Model.AwaitingPayment @L["Orders"]</small>
    </a>
    <a class="shift-tile" id="waitingTile" data-waiting="@Model.WaitingReservations" asp-controller="TableReservation" asp-action="Index" asp-route-status="Pending">
        <i class="fas fa-calendar-check shift-tile-icon" aria-hidden="true"></i>
        <span>@L["Dash.WaitingReservations"]</span>
        <strong>@Model.WaitingReservations</strong>
        <small>@L["Reservations"]</small>
    </a>
</div>

<partial name="_Floor" model="Model" />

<div class="ops-grid">
    <section class="ops-col">
        <h2><i class="fas fa-globe" aria-hidden="true"></i> @L["OnlineRequests"] <b>@Model.WaitingOnline</b></h2>
        @if (Model.OnlineRequests.Count == 0)
        {
            <p class="ad-empty">@L["NothingWaiting"]</p>
        }
        @foreach (var order in Model.OnlineRequests)
        {
            <article class="ops-card @(Late(order.OrderDate) ? "is-late" : "")">
                <header>
                    <strong>@order.CustomerName</strong>
                    <span class="ops-age">@Age(order.OrderDate)</span>
                </header>
                <p class="ops-where">
                    <i class="fas @(order.TableId.HasValue ? "fa-chair" : "fa-motorcycle")" aria-hidden="true"></i>
                    @(order.TableId.HasValue ? Where(OrderType.Hall, order.TableArName, order.TableEnName) : order.Address)
                </p>
                <ul>
                    @foreach (var line in order.Items)
                    {
                        <li><span>@(isArabic ? line.ArName : line.EnName)</span><b>x @line.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</b></li>
                    }
                </ul>
                <footer>
                    <strong>@order.TotalPrice.ToString("N2")</strong>
                    <span>
                        <a asp-controller="Order" asp-action="Upsert" asp-route-onlineOrderId="@order.Id" class="btn-ad btn-ad-primary"><i class="fas fa-check" aria-hidden="true"></i> @L["AcceptOrder"]</a>
                        <button type="button" class="btn-ad btn-ad-danger btn-icon" title="@L["CancelOrder"]" aria-label="@L["CancelOrder"]" onclick="Delete('/Order/CancelOnline/@order.Id')"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                    </span>
                </footer>
            </article>
        }
    </section>

    <section class="ops-col">
        <h2><i class="fas fa-fire-burner" aria-hidden="true"></i> @L["KitchenQueue"] <b>@Model.InKitchen</b></h2>
        @if (Model.Kitchen.Count == 0)
        {
            <p class="ad-empty">@L["NothingWaiting"]</p>
        }
        @foreach (var order in Model.Kitchen)
        {
            <article class="ops-card @(Late(order.OrderDate) ? "is-late" : "")">
                <header>
                    <strong>#@order.OrderCode</strong>
                    <span class="ops-chip ops-@order.Type.ToString().ToLowerInvariant()">@L[order.Type.ToString()]</span>
                    <span class="ops-age">@Age(order.OrderDate)</span>
                </header>
                @if (!string.IsNullOrEmpty(order.TableArName))
                {
                    <p class="ops-where"><i class="fas fa-chair" aria-hidden="true"></i> @Where(order.Type, order.TableArName, order.TableEnName)</p>
                }
                <ul>
                    @foreach (var line in order.Items)
                    {
                        <li><span>@(isArabic ? line.ArName : line.EnName)</span><b>x @line.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</b></li>
                    }
                </ul>
                <footer>
                    <span></span>
                    <button type="button" class="btn-ad btn-ad-primary kitchen-done" data-id="@order.Id"><i class="fas fa-check" aria-hidden="true"></i> @L["OrderReady"]</button>
                </footer>
            </article>
        }
    </section>

    <section class="ops-col">
        <h2><i class="fas fa-receipt" aria-hidden="true"></i> @L["AwaitingPayment"] <b>@Model.AwaitingPayment</b></h2>
        @if (Model.Unpaid.Count == 0)
        {
            <p class="ad-empty">@L["NothingWaiting"]</p>
        }
        @foreach (var order in Model.Unpaid)
        {
            <article class="ops-card">
                <header>
                    <strong>#@order.OrderCode</strong>
                    <span class="ops-chip ops-@order.Type.ToString().ToLowerInvariant()">@L[order.Type.ToString()]</span>
                    <span class="ops-age">@Age(order.OrderDate)</span>
                </header>
                @if (!string.IsNullOrEmpty(order.TableArName))
                {
                    <p class="ops-where"><i class="fas fa-chair" aria-hidden="true"></i> @Where(order.Type, order.TableArName, order.TableEnName)</p>
                }
                <footer>
                    <strong>@order.TotalPrice.ToString("N2")</strong>
                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn-ad btn-ad-ghost"><i class="fas fa-eye" aria-hidden="true"></i> @L["Details"]</a>
                </footer>
            </article>
        }
    </section>
</div>

<div class="ad-table-wrap ops-types">
    <table class="ad-table">
        <caption>@L["OrdersByType"]</caption>
        <thead>
            <tr>
                <th>@L["OrderType"]</th>
                <th>@L["KitchenQueue"]</th>
                <th>@L["AwaitingPayment"]</th>
                <th>@L["Paid"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.ByType)
            {
                var rowMax = Math.Max(1, Math.Max(row.InKitchen, Math.Max(row.Unpaid, row.Paid)));
                <tr>
                    <td><span class="ops-chip ops-@row.Type.ToString().ToLowerInvariant()">@L[row.Type.ToString()]</span></td>
                    <td class="num ops-type-cell">
                        <span>@row.InKitchen</span>
                        <i class="ops-type-bar ops-type-bar-kitchen" aria-hidden="true" style="--w:@(row.InKitchen * 100 / rowMax)%"></i>
                    </td>
                    <td class="num ops-type-cell">
                        <span>@row.Unpaid</span>
                        <i class="ops-type-bar ops-type-bar-unpaid" aria-hidden="true" style="--w:@(row.Unpaid * 100 / rowMax)%"></i>
                    </td>
                    <td class="num ops-type-cell">
                        <span>@row.Paid</span>
                        <i class="ops-type-bar ops-type-bar-paid" aria-hidden="true" style="--w:@(row.Paid * 100 / rowMax)%"></i>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
