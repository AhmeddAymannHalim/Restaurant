@model IEnumerable<Restaurant.Data.Models.PaymentInvoiceCustomer>

@{
    ViewData["Title"] = "IndexSupplier";
}

<h1 class="text-center">فواتير المدفوعات للعملاء</h1>

<p>
    <a asp-action="InvoicePayForCustomer">اضافة فاتورة جديدة</a>
</p>
<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                اسم العميل
            <th>
                كود الفاتورة
            </th>
            <th>
                تاريخ الفاتورة
            </th>
            <th>
                البيان
            </th>
            <th>
                المدفوع
            </th>
            <th>
                المتبقي
            </th>
         <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ProcessCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Paid)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer.Balance)
                </td>
                <td>
                    @* @Html.ActionLink("Edit", "Edit", new { id=item.Id }) | *@
                    @Html.ActionLink("التفاصيل", "CustomerInvoiceDetails", new { id = item.Id })
                    @* @Html.ActionLink("Delete", "Delete", new {  id=item.Id }) *@
                </td>
            </tr>
        }
    </tbody>
</table>


<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>