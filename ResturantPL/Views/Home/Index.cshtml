@model HomeViewModel
@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var restaurantName = isArabic ? Model.ArName : Model.EnName;
    if (string.IsNullOrWhiteSpace(restaurantName))
    {
        restaurantName = Model.ArName ?? Model.EnName;
    }
    ViewData["Title"] = L["Home"].Value;

    var description = isArabic
        ? (string.IsNullOrWhiteSpace(Model.ArDescription) ? Model.EnDescription : Model.ArDescription)
        : (string.IsNullOrWhiteSpace(Model.EnDescription) ? Model.ArDescription : Model.EnDescription);
    var location = isArabic
        ? (string.IsNullOrWhiteSpace(Model.ArLocation) ? Model.EnLocation : Model.ArLocation)
        : (string.IsNullOrWhiteSpace(Model.EnLocation) ? Model.ArLocation : Model.EnLocation);

    string DayName(string value)
    {
        var day = WeekDays.Normalize(value);
        return day == null ? value : L["Day." + day].Value;
    }
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">

    <section class="ws-hero" id="ws-top" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : $"--hero:url('{Model.ImageUrl}')")">
        <div class="ws-hero-inner">
            <p class="ws-kicker">@L["WelcomeTo"]</p>
            <h1 class="ws-title">@restaurantName</h1>
            <p class="ws-tagline">@L["HeroTagline"]</p>
            <div class="ws-actions">
                <a class="ws-btn ws-btn-solid" href="#menu">@L["ViewMenu"]</a>
                <a class="ws-btn ws-btn-ghost" asp-controller="OnlineOrder" asp-action="Basket">@L["BookOrderNow"]</a>
                @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                {
                    <a class="ws-play glightbox" href="@Model.VideoUrl" aria-label="@L["PlayVideo"]"><i class="bi bi-play-fill" aria-hidden="true"></i></a>
                }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(description))
    {
        <section class="ws-sec ws-about" id="about">
            <div class="ws-wrap ws-about-grid">
                <div class="ws-reveal">
                    <h2 class="ws-h2">@L["AboutUs"]</h2>
                    <p class="ws-lead">@description</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img class="ws-about-img ws-reveal" src="@Model.ImageUrl" alt="@restaurantName" loading="lazy" />
                }
            </div>
        </section>
    }

    <section class="ws-sec" id="menu"
             data-ws-menu
             data-url="@Url.Action("MenuItems", "Home")"
             data-ar="@(isArabic ? "1" : "0")"
             data-currency="@L["Currency"]"
             data-add="@L["AddToBasket"]"
             data-sizes='@Html.Raw(Json.Serialize(new Dictionary<string, string>
                 {
                     ["Small"] = L["Size.Small"].Value,
                     ["Medium"] = L["Size.Medium"].Value,
                     ["Large"] = L["Size.Large"].Value,
                     ["Syrian_Bread"] = L["Size.Syrian_Bread"].Value
                 }))'
             data-empty="@L["NoMenuItems"]"
             data-failed="@L["MenuLoadFailed"]">
        <div class="ws-wrap">
            <h2 class="ws-h2 ws-reveal">@L["OurMenu"]</h2>

            @if (Model.MenuSections.Any())
            {
                <div class="ws-tabs-wrap ws-reveal">
                    <div class="ws-tabs" role="tablist" aria-label="@L["OurMenu"]">
                        <span class="ws-tab-pill" aria-hidden="true"></span>
                        <button type="button" class="ws-tab is-on" role="tab" aria-selected="true" data-section="">@L["AllCategories"]</button>
                        @foreach (var cat in Model.MenuSections)
                        {
                            <button type="button" class="ws-tab" role="tab" aria-selected="false" data-section="@cat.Id">@(isArabic ? cat.ArName : cat.EnName)</button>
                        }
                    </div>
                </div>
            }

            <div class="ws-dishes" data-ws-dishes aria-live="polite"></div>
        </div>
    </section>

    @if (Model.Chefs.Any())
    {
        <section class="ws-sec ws-alt" id="chefs">
            <div class="ws-wrap">
                <h2 class="ws-h2 ws-reveal">@L["Chefs"]</h2>
                <div class="ws-chefs">
                    @foreach (var chef in Model.Chefs)
                    {
                        <figure class="ws-chef ws-reveal">
                            <img src="@chef.ImageUrl" alt="@(isArabic ? chef.ArName : chef.EnName)" loading="lazy" />
                            <figcaption>
                                <strong>@(isArabic ? chef.ArName : chef.EnName)</strong>
                                <span>@chef.Jop</span>
                            </figcaption>
                        </figure>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.Gallery.Any())
    {
        <section class="ws-sec" id="gallery">
            <div class="ws-wrap">
                <h2 class="ws-h2 ws-reveal">@L["OurGallery"]</h2>
                <div class="ws-gallery">
                    @foreach (var photo in Model.Gallery)
                    {
                        <a class="ws-shot glightbox ws-reveal" href="@photo.PictureUrl" data-gallery="ws"><img src="@photo.PictureUrl" alt="" loading="lazy" /></a>
                    }
                </div>
            </div>
        </section>
    }

    <section class="ws-sec ws-alt" id="contact">
        <div class="ws-wrap">
            <h2 class="ws-h2 ws-reveal">@L["Contact"]</h2>
            <div class="ws-info">
                @if (!string.IsNullOrWhiteSpace(location))
                {
                    <div class="ws-info-card ws-reveal"><i class="bi bi-geo-alt" aria-hidden="true"></i><h3>@L["OurLocation"]</h3><p>@location</p></div>
                }
                <div class="ws-info-card ws-reveal">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    <h3>@L["WorkingHours"]</h3>
                    <p>@DayName(Model.StartDay) - @DayName(Model.EndDay)<br />@Model.StartHour - @Model.EndHour</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <div class="ws-info-card ws-reveal"><i class="bi bi-envelope" aria-hidden="true"></i><h3>@L["Email"]</h3><p><a href="mailto:@Model.Email">@Model.Email</a></p></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <div class="ws-info-card ws-reveal"><i class="bi bi-telephone" aria-hidden="true"></i><h3>@L["Phone"]</h3><p><a href="tel:@Model.Phone">@Model.Phone</a></p></div>
                }
            </div>
        </div>
    </section>

    <footer class="ws-foot">
        <span>&copy; @DateTime.Now.Year @restaurantName. @L["FooterRights"]</span>
    </footer>
</div>

@section Scripts {
    <script src="~/js/website.js" asp-append-version="true"></script>
}
