@model UnitPrice
@{
    ViewData["Title"] = "Delete";
}


<h1 class="text-center">حذف بيانات وحدة </h1>
<hr />



<div>
    <dl class="row">

        <dt class="col-sm-2">
            اسم الوحدة
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>

       </dl>


    <form asp-action="Delete">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">عودة للوحدات</a>
    </form>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 

