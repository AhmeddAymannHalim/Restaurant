@model SupplierTotalViewModel

@if (Model.balances.Count() > 0)
{
    <tr>
        <td class="text-danger"><strong>الحساب السابق</strong></td>
        <td>@Model.LastTotalDeptor</td>
        <td>@Model.LastTotalCreditor</td>
        <td colspan="4">@Model.LastTotal</td>
    </tr>
    foreach (var item in Model.balances)
    {
        <tr>
            <td>@Model.Name</td>
            <td>@item.Deptor</td>
            <td>@item.Creditor</td>
            <td>@item.Balance</td>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Info</td>
            <td>
                @{
                    string controller = item.Info == "سندات قبض" ? "PaymentInvoice" : "Invoice";
                    string action = item.Info == "سندات قبض" ? "SupplierInvoiceDetails" : "DetailsInvoice";
                }
                @Html.ActionLink("التفاصيل", action, controller, new { id = item.InvoiceId })
            </td>
        </tr>
    }
   
  

    <tr>
        <td class="text-danger"><strong>الحساب الحالي</strong></td>
        <td>@Model.AllTotalDeptor</td>
        <td>@Model.AllTotalCreditor</td>
        <td colspan="4">@Model.Balance</td>
    </tr>
}
else
{
    <tr><td colspan='7'>لا توجد نتائج للعرض</td></tr>
}