@model IEnumerable<Table>


<h1 class="text-center">الطاولات</h1>
<hr />
<p>
    <a asp-action="Create">اضافة طاولة جديدة</a>
</p>


<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <tr>
        <td>اسم الطاولة</td>
        <td>عدد الاشخاص</td>
        <td></td>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.NumOfPersons</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">تعديل</a> | 
                <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
            </td>
        </tr>
    }
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>
