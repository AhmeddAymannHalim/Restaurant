@model BillViewModel
@{
    ViewBag.Title = L["Bill.Bill"].Value + " " + Model.Code;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i></span>
        <h1>@L["Bill.Bill"] #@Model.Code</h1>
        @if (Model.CanPost)
        {
            <button type="button" id="postBill" class="btn-ad btn-ad-post"><i class="fas fa-check" aria-hidden="true"></i> @L["Bill.Post"]</button>
        }
        @if (Model.IsEditable)
        {
            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn-ad btn-ad-ghost"><i class="fas fa-pen" aria-hidden="true"></i> @L["Edit"]</a>
            <a asp-action="Pdf" asp-route-id="@Model.Id" data-no-loader class="btn-ad btn-ad-ghost"><i class="fas fa-print" aria-hidden="true"></i> @L["Print"]</a>
        }
        <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
    </div>
    <div class="bo-card-body">
        <div class="bo-form">
            <div class="form-group"><label>@L["Bill.BillType"]</label><div class="form-control">@(isArabic ? Model.SettingArName : Model.SettingEnName)</div></div>
            <div class="form-group"><label>@L["InvoiceDate"]</label><div class="form-control">@Model.Date.ToString("yyyy-MM-dd HH:mm")</div></div>
            <div class="form-group"><label>@L["Partner"]</label><div class="form-control">@(isArabic ? Model.PartnerArName : Model.PartnerEnName)</div></div>
            <div class="form-group"><label>@L["Bill.Entry"]</label><div class="form-control">@(Model.IsEntryPosted ? L["Bill.Posted"] : L["Bill.NotPosted"])</div></div>
            <div class="form-group"><label>@L["Bill.Storage"]</label><div class="form-control">@(Model.IsStorageEffected ? L["Bill.StorageDone"] : L["Bill.StorageNone"])</div></div>
        </div>

        <h2 class="bo-section-title">@L["Bill.Items"]</h2>
        <div class="bo-table-wrap">
            <table class="bo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Code"]</th>
                        <th>@L["Name"]</th>
                        <th>@L["Bill.Quantity"]</th>
                        <th>@L["Bill.UnitPrice"]</th>
                        <th>@L["Bill.LineTotal"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Row</td>
                            <td>@line.ItemCode</td>
                            <td>@(isArabic ? line.ItemArName : line.ItemEnName)</td>
                            <td class="num">@line.Quantity.ToString("0.###")</td>
                            <td class="num">@line.UnitPrice.ToString("N2")</td>
                            <td class="num">@line.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bo-form">
            <div class="form-group"><label>@L["Bill.ItemsTotal"]</label><div class="form-control">@Model.ItemsTotal.ToString("N2")</div></div>
            <div class="form-group"><label>@L["Bill.Discount"]</label><div class="form-control">@Model.Discount.ToString("N2")</div></div>
            <div class="form-group"><label>@L["Bill.Extras"]</label><div class="form-control">@Model.Extras.ToString("N2")</div></div>
            <div class="form-group"><label>@L["NetTotal"]</label><div class="form-control"><b>@Model.Total.ToString("N2")</b></div></div>
            <div class="form-group"><label>@L["Paid"]</label><div class="form-control">@Model.Paid.ToString("N2")</div></div>
            <div class="form-group"><label>@L["Remaining"]</label><div class="form-control">@Model.Remaining.ToString("N2")</div></div>
            @if (Model.Cost.HasValue)
            {
                <div class="form-group"><label>@L["Bill.Cost"]</label><div class="form-control">@Model.Cost.Value.ToString("N2")</div></div>
                <div class="form-group"><label>@L["Bill.Profit"]</label><div class="form-control">@((Model.Profit ?? 0).ToString("N2"))</div></div>
            }
        </div>

        <h2 class="bo-section-title">@L["Bill.Entries"]</h2>
        @if (!Model.Entries.Any())
        {
            <p class="bo-empty">@L["Bill.NoEntry"]</p>
        }
        @foreach (var entry in Model.Entries)
        {
            <p>
                <a asp-controller="Entry" asp-action="Details" asp-route-id="@entry.Id">@L["Bill.Entry"] #@entry.Code</a>
                - @(isArabic ? entry.SettingArName : entry.SettingEnName)
                - @(entry.IsPosted ? L["Bill.Posted"] : L["Bill.NotPosted"])
            </p>
            <div class="bo-table-wrap">
                <table class="bo-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Bill.Account"]</th>
                            <th>@L["Bill.Debit"]</th>
                            <th>@L["Bill.Credit"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in entry.Lines)
                        {
                            <tr>
                                <td>@line.Row</td>
                                <td>@line.AccountCode - @(isArabic ? line.AccountArName : line.AccountEnName)</td>
                                <td class="num">@((line.Debit ?? 0).ToString("N2"))</td>
                                <td class="num">@((line.Credit ?? 0).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#postBill').on('click', function () {
                $.post('/Bill/Post', { id: @Model.Id }).done(function (result) {
                    if (result && result.success) {
                        toastr.success(@Html.Raw(Json.Serialize(L["Bill.PostedDone"].Value)));
                        location.reload();
                    } else {
                        toastr.error((result && result.errorMessage) || @Html.Raw(Json.Serialize(L["SomethingWentError"].Value)));
                    }
                }).fail(function () {
                    toastr.error(@Html.Raw(Json.Serialize(L["SomethingWentError"].Value)));
                });
            });
        });
    </script>
}
