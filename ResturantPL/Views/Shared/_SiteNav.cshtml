@using System.Globalization
@using System.Security.Claims
@{
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdmin = User.IsInRole("Admin");
    var isManager = isAdmin || User.IsInRole("Manager");
    var userName = User.Identity.Name ?? "";
    var userImage = User.FindFirstValue("Image");

    string Current(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "is-current" : "";
}

<header class="site-nav">
    <div class="site-nav-inner">

        <button type="button" class="site-burger" aria-label="@L["Menu"]" aria-controls="siteMenu" aria-expanded="false">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>

        <nav class="site-menu" id="siteMenu" aria-label="@L["Menu"]">
            <a class="site-link @Current("Home")" asp-controller="Home" asp-action="Index">@L["Home"]</a>
            <a class="site-link @Current("OnlineOrder")" asp-controller="OnlineOrder" asp-action="Menu">@L["Menu"]</a>
            <a class="site-link" href="/#gallery">@L["Gallery"]</a>
            <a class="site-link" href="/#chefs">@L["Chefs"]</a>
            @if (User.Identity.IsAuthenticated)
            {
                <a class="site-link" asp-controller="OnlineOrder" asp-action="PendingOrders">@L["MyOrders"]</a>
            }
            @if (isAdmin)
            {
                <a class="site-link @Current("Dashboard")" asp-controller="Dashboard" asp-action="Index">@L["Dashboard"]</a>
            }

            @if (User.Identity.IsAuthenticated)
            {
                <div class="dropdown site-user">
                    <button type="button" class="site-avatar" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@userName">
                        @if (!string.IsNullOrEmpty(userImage))
                        {
                            <img src="@userImage" alt="" />
                        }
                        else
                        {
                            <span>@(userName.Length > 0 ? userName.Substring(0, 1).ToUpperInvariant() : "?")</span>
                        }
                    </button>
                    <ul class="dropdown-menu site-dropdown">
                        <li class="site-dropdown-head">
                            <strong>@userName</strong>
                        </li>
                        @if (isManager)
                        {
                            <li><a class="dropdown-item" asp-controller="ApplicationSetting" asp-action="Index"><i class="bi bi-gear" aria-hidden="true"></i> @L["Settings"]</a></li>
                        }
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person" aria-hidden="true"></i> @L["MyProfile"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> @L["ChangePassword"]</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item is-exit" asp-controller="Account" asp-action="SignOut"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> @L["SignOut"]</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a class="site-link site-signin" asp-controller="Account" asp-action="SignIn">@L["SignIn"]</a>
            }
        </nav>

        <div class="site-end">
            <a class="site-lang" asp-controller="SetLanguage" asp-action="SetLanguage" asp-route-culture="@(isArabic ? "en" : "ar")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                <i class="bi bi-translate" aria-hidden="true"></i> @(isArabic ? "English" : "العربية")
            </a>
            @await Component.InvokeAsync("SiteBrand")
            <button type="button" class="site-cart" data-cart data-cart-open aria-haspopup="dialog" aria-controls="cartDrawer" data-added="@L["AddedToBasket"]" aria-label="@L["Cart"]" title="@L["Cart"]">
                <i class="bi bi-bag" aria-hidden="true"></i>
                <span class="site-cart-count" data-cart-count aria-live="polite" hidden>0</span>
                <span class="cart-toast" data-cart-toast role="status"></span>
            </button>
        </div>
    </div>
</header>

<script>
    (function () {
        var burger = document.querySelector(".site-burger");
        var menu = document.getElementById("siteMenu");
        if (!burger || !menu) { return; }
        burger.addEventListener("click", function () {
            var open = menu.classList.toggle("is-open");
            burger.setAttribute("aria-expanded", open);
        });
    })();
</script>
