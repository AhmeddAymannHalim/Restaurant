@model IEnumerable<Restaurant.Data.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";
}



<section id="menu" class="menu section-bg mt-5 ">
    <div class="container mt-4" data-aos="fade-up">
        <div class="section-title">
            <p class="float-end">اختار اشهى المأكولات من المنيو الخاص بنا</p>
            <br />
            <br />
            <a asp-action="CreateMenuItem" asp-controller="Menu" class="btn-menu animated fadeInUp scrollto float-end m-5">إضافه للمنيو</a>
        </div>

        <br />
        <br />
        <div class="row mt-5" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-12 d-flex justify-content-center">
                <ul id="menu-flters">
                    <li data-filter="*" class="filter-active">الكل</li>
                    @foreach (var menuSection in Model.Select(x => x.MenuSection.Name).Distinct())
                    {
                        <li data-filter=".filter-@menuSection">@menuSection</li>
                    }
                </ul>
            </div>
        </div>
        <div class="row menu-container" data-aos="fade-up" data-aos-delay="200">
            <div class="mt-5">
                @foreach (var menuSection in Model.Select(x => x.MenuSection.Name).Distinct())
                {
                    @foreach (var item in Model.Where(x => x.MenuSection.Name == menuSection))
                    {
                        <div class="col-lg-5 offset-1 menu-item filter-@menuSection">
                            <img src="@item.ImageUrl" class="menu-img" alt="image">
                            <div class="menu-content">
                                <span>@item.Name</span> <span>$@item.Price</span>
                            </div>
                            <div class="menu-ingredients" style="direction: rtl;">
                                @item.Description
                            </div>
                            <div>
                                <a asp-action="Details" asp-controller="Menu" asp-route-id="@item.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">تفاصيل العنصر</a>
                            </div>
                            <div>
                                <a asp-action="Delete" asp-controller="Menu" asp-route-id="@item.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">حذف العنصر</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>


