@model IEnumerable<Deposit>

@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.ProcessCode </td>
            <td>@item.CreatedTime.ToString("yyyy-MM-dd")</td>
            <td>@item.DeposerName</td>
            <td>@item.User.FullName</td>
            <td>@item.Description</td>
            <td>@item.Amount</td>
            <td>
                @Html.ActionLink("التفاصيل", "Details", "Deposit", new { id = item.Id })
            </td>
        </tr>

    }
}
else
{
    <tr><td colspan='7'>لا توجد نتائج للعرض</td></tr>
}