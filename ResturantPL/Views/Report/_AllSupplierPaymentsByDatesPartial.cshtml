@model PaymentByDatesViewModel

@if (Model.Payments.Count() > 0)
{
    foreach (var item in Model.Payments)
    {
        <tr>
            <td>@item.ProcessCode</td>
            <td>@item.Supplier.Name</td>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Description</td>
            <td>@item.Paid</td>
            <td>
                @Html.ActionLink("التفاصيل", "SupplierInvoiceDetails", "PaymentInvoice", new { id = item.Id })
            </td>
        </tr>
    }
    <tr>
        <td class="text-danger"><strong>الاجمالي</strong> </td>
        <td colspan="5"><strong>@Model.Total</strong></td>
    </tr>
}
else
{
    <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
}