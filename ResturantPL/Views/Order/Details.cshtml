@model Restaurant.Data.Models.Order

@{
    ViewData["Title"] = "Details";
    Layout = "_Layout1";
}


<style>
    /* Define styles for the page content */
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #111;
    }

    .container {
        max-width: 576px; /* Set the maximum width to fit within the paper size */
        margin: 0 auto; /* Center the content horizontally */
        background-color: #fff; /* White background for better readability */
        padding: 20px; /* Add padding for spacing */
        color: black;
    }

    h1 {
        text-align: center;
    }

    dl {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    dt, dd {
        width: 45%; /* Set width for better alignment */
        padding: 10px;
        margin-bottom: 10px;
        border: 1px solid #ccc; /* Add border for styling */
        box-sizing: border-box;
    }

    dt {
        background-color: #f2f2f2; /* Light gray background for dt elements */
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

    th {
        background-color: #f2f2f2; /* Light gray background for table header */
    }
</style>



<div class="container">

    <h1>تفاصيل فاتورة : @Model.CustomerName</h1>
    <hr />

    <dl>

        <dt class="col-sm-3">
            كود الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.OrderCode)
        </dd>


        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Model.OrderDate.ToString("dd-MM-yyyy  hh:mm tt")
        </dd>

        <dt class="col-sm-3">
            م الشيفت البائع
        </dt>
        <dd class="col-sm-8">
            @Model.Seller.FullName
        </dd>

        @if (Model.ReceiverId != null)
        {
            <dt class="col-sm-3">
                م الشيفت المستلم
            </dt>
            <dd class="col-sm-8">
                @Model.Receiver.FullName
            </dd>
        }


        @if (Model.Type == OrderType.TakeAway)
        {
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                تيك اواي
            </dd>
        }



        @if (Model.Type == OrderType.Hall)
        {
            <dt class="col-sm-3">
                اسم الطاولة
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Table.Name)
            </dd>
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                صالة
            </dd>
        }



        @if (Model.Type == OrderType.Delivery)
        {
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                دليفري
            </dd>
            <dt class="col-sm-3">
                الطيار
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Employee.FullName)
            </dd>
            <dt class="col-sm-3">
                العنوان
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Address)
            </dd>
            <dt class="col-sm-3">
                رقم الهاتف
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.PhoneNumber)
            </dd>
            <dt class="col-sm-3">
                رقم الموبايل
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.MobileNumber)
            </dd>
        }


        @if (Model.Type == OrderType.Delivery_Online)
        {
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                دليفري اونلاين
            </dd>
            <dt class="col-sm-3">
                الطيار
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Employee.FullName)
            </dd>
            <dt class="col-sm-3">
                العنوان
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Address)
            </dd>
            <dt class="col-sm-3">
                رقم الهاتف
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.PhoneNumber)
            </dd>
            <dt class="col-sm-3">
                رقم الموبايل
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.MobileNumber)
            </dd>
        }





        @if (Model.Service > 0)
        {
            <dt class="col-sm-3">
                الخدمة
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Service)
            </dd>
        }
        @if (Model.Tax > 0)
        {
            <dt class="col-sm-3">
                الضريبة
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Tax)
            </dd>
        }
        @if (Model.Discount > 0)
        {
            <dt class="col-sm-3">
                الخصم
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Discount)
            </dd>
        }


        <dt class="col-sm-3">
            تم الدفع
        </dt>

        @if (Model.Cash == true)
        {
            <dd class="col-sm-8">
                نعم
            </dd>
        }
        else
        {
            <dd class="col-sm-8">
                لا
            </dd>
        }


        <dt class="col-sm-3">
            الاجمالي
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TotalPrice)
        </dd>

        <dt class="col-sm-3">
            المنتجات
        </dt>
        <dd class="col-sm-8">
            <table class="mt-3 table table-bordered table-light text-dark text-center">
                <thead>
                    <tr>
                        <th>اسم المنتج</th>
                        <th>كمية المنتج</th>
                        <th>سعر الوحدة</th>
                        <th>الاجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderMenuItems)
                    {
                        <tr>
                            <td>@item.MenuItem.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.PriceForUnit</td>
                            <td>@item.Price</td>
                        </tr>
                    }
                </tbody>
            </table>
        </dd>

    </dl>

    <div>
        <a class="btn btn-primary" asp-action="OrderReport" asp-controller="Report" asp-route-orderId="@Model.Id"> تصدير الي PDF</a>
        <a class="btn btn-info" asp-action="Create" asp-controller="Order">طلب جديد</a>
    </div>

</div>
