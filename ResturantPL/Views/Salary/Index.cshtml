@model IEnumerable<Salary>

@{
    ViewData["Title"] = "All Salary";
}

<h1 class="text-center">كل المرتبات</h1>
<hr />

<p>
    <a asp-action="Create">إضافه مرتب</a>
</p>

<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>
                كود المرتب
            </th>
            <th>
                الموظف
            </th>
            <th>
                التار يخ
            </th>

            <th>
                المستخدم
            </th>
            <th>
                المبلغ
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.SalaryCode)
                </td>
                <td>
                    @item.Employee.FullName
                </td>
                <td>
                    @item.SalaryDate.ToString("yyyy-MM-dd")
                </td>

                <td>
                    @item.User.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SalaryAmount)
                </td>
                <td>
                    @Html.ActionLink("التفاصيل", "Details", new { id = item.Id }) |
                    @Html.ActionLink("تعديل", "Edit", new { id = item.Id }) |
                    <a onclick="Delete('/Salary/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
<script src="~/modules/deleteobjects.js"></script>