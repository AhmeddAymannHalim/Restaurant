@model PaginatedResult<GalleryViewModel>
@{
    ViewBag.Title = L["Gallery"].Value;
}

<h1 class="text-center">@L["Gallery"]</h1>
<hr />

<p>
    <a asp-action="Upsert">@L["NewPhoto"]</a>
</p>

<table id="Gallery-table" class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Image"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Data.Any())
        {
            var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
            foreach (var item in Model.Data)
            {
                <tr>
                    <td>@counter</td>
                    <td><img src="@item.PictureUrl" alt="" style="width:120px;height:80px;object-fit:cover;border-radius:8px" /></td>
                    <td>
                        <a asp-action="Upsert" asp-route-id="@item.Id">@L["Edit"]</a> |
                        <a onclick="Delete('/Gallery/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">@L["Delete"]</a>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="3">@L["NoData"]</td>
            </tr>
        }
    </tbody>
</table>

<div class="app-table-pagination">
    @await Html.PartialAsync("_Pagination", Model)
</div>

<div>
    <a asp-action="Index" asp-controller="Dashboard">@L["BackToDashboard"]</a>
</div>

@section Scripts {
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/modules/deleteobjects.js"></script>
}
