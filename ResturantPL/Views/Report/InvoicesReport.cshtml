@model IEnumerable<Invoice>

@{
    ViewData["Title"] = "Invoices by dates";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>



@{
    DateTime? firstDate = null; // Initialize with null to ensure it's assigned later
    DateTime? endDate = null;   // Initialize with null to ensure it's assigned later

    foreach (var item in Model)
    {
        if (firstDate == null || item.InvoiceDate < firstDate)
        {
            firstDate = item.InvoiceDate.Date; // Assign the first order date
        }

        if (endDate == null || item.InvoiceDate > endDate)
        {
            endDate = item.InvoiceDate.Date; // Assign the last order date
        }
    }
}

<h1>تقرير الفواتير بين تاريخين </h1>
<h3>@firstDate?.ToString("yyyy-MM-dd")  :   @endDate?.ToString("yyyy-MM-dd")</h3>
<hr />
<table id="invoiceTable" class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th> كود الفاتورة</th>
            <th> نوع الفاتورة</th>
            <th> تاريخ الفاتورة</th>
            <th> المورد</th>
            <th> المخزن </th>
            <th> عدد المنتجات</th>
            <th> الاجمالي بعد الخصم</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.InvoiceCode) </td>
                    <td>@(item.InvoiceType == InvoiceType.Purchases ? "مشتريات" : "مرتجعات")</td>
                    <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Supplier.Name</td>
                    <td>@item.Store.Name</td>
                    <td>@item.InvoiceItems.Count()</td>
                    <td>@item.TotalPrice</td>
                </tr>
            }

        }
        else
        {
            <tr><td colspan='8'>لا توجد نتائج للعرض</td></tr>
        }
    </tbody>
</table>