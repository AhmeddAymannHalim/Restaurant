@model IEnumerable<MenuItem>

@{
    ViewData["Title"] = "Menu";
}



<section id="menu" class="menu section-bg mt-5 ">
    <div class="container mt-4" data-aos="fade-up">
        <div class="section-title">
            <p class="float-end">اختار اشهى المأكولات من المنيو الخاص بنا</p>
            <br />
        </div>
        <hr />

        <div class="row mt-5" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-12 d-flex justify-content-center">
                <ul id="menu-flters">
                    <li data-filter="*" class="filter-active">الكل</li>
                    @foreach (var menuSection in Model.Select(m => m.MenuSection.ArName).Distinct())
                    {
                        <li data-filter=".filter-@menuSection">@menuSection</li>
                    }
                </ul>
            </div>
        </div>

        <div class="row menu-container" data-aos="fade-up" data-aos-delay="200">
            <div class="mt-5">
                @foreach (var groupName in Model.Select(m => m.ArName).Distinct())
                {
                    var items = Model.Where(m => m.ArName == groupName);
                    var firstItem = items.FirstOrDefault();
                    if (firstItem != null)
                    {
                        <div class="col-lg-5 offset-1 menu-item filter-@firstItem.MenuSection.ArName">
                            <img src="@firstItem.ImageUrl" class="menu-img" alt="image">
                            <div class="menu-content">
                                <span>@firstItem.ArName</span>
                                <span>LE @firstItem.Price</span>
                            </div>
                            <div class="menu-ingredients" style="direction: rtl;">
                                @firstItem.Description
                            </div>
                            <div>
                                @if (items.Count() > 1)
                                {
                                    <select onchange="addToBasket(this);" class="form-select float-end m-1" style="width: 200px;">

                                        <option value="">اختر النوع</option>
                                        @foreach (var item in items)
                                        {
                                            string sizeLabel;
                                          
                                                sizeLabel = item.Size switch
                                                {
                                                    Size.Small => "صغير",
                                                    Size.Medium => "متوسط",
                                                    Size.Large => "كبير",
                                                    Size.Syrian_Bread => "عيش سوري",
                                                    _ => "عادي"
                                                };
                                          

                                            <option value="@item.Id|@item.ArName|@item.Description|@item.Price|@item.ImageUrl|@sizeLabel">@sizeLabel -- LE @item.Price</option>

                                        }
                                    </select>
                                }
                                else
                                {
                                    <button class="btn-menu add-to-basket btn btn-primary mt-2"
                                            data-id="@firstItem.Id"
                                            data-name="@firstItem.ArName"
                                            data-description="@firstItem.Description"
                                            data-price="@firstItem.Price"
                                            data-imageUrl="@firstItem.ImageUrl"
                                            data-size="عادي">
                                        إضافة الى السلة
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>
</section>

<script>
    function addToBasket(select) {
        const selectedOption = select.options[select.selectedIndex];
        const values = selectedOption.value.split("|");
        const id = values[0];
        const name = values[1];
        const description = values[2];
        const price = values[3];
        const imageUrl = values[4];
        const size = values[5];

        const basketItem = { id, name, description, price, imageUrl, size };
        let basketItems = JSON.parse(localStorage.getItem('basket')) || [];
        basketItems.push(basketItem);
        localStorage.setItem('basket', JSON.stringify(basketItems));
        alert('تمت إضافة العنصر إلى السلة');
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const addToBasketButtons = document.querySelectorAll('.add-to-basket');

        addToBasketButtons.forEach(button => {
            button.addEventListener('click', function () {
                const itemId = this.getAttribute('data-id');
                const itemName = this.getAttribute('data-name');
                const itemPrice = this.getAttribute('data-price');
                const itemDescription = this.getAttribute('data-description');
                const itemImageUrl = this.getAttribute('data-imageUrl');
                const itemSize = this.getAttribute('data-size');

                addToBasketTwo(itemId, itemName, itemPrice, itemDescription, itemImageUrl, itemSize);
            });
        });

        function addToBasketTwo(id, name, price, description, imageUrl, size) {
            const basketItem = { id, name, price, description, imageUrl, size };
            let basketItems = JSON.parse(localStorage.getItem('basket')) || [];
            basketItems.push(basketItem);
            localStorage.setItem('basket', JSON.stringify(basketItems));
            alert('تمت إضافة العنصر إلى السلة');
        }
    });
</script>





