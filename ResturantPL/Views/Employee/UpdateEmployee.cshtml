@model ResturantPL.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "UpdateEmployee";
}




<h1 class="text-center">تحديث بيانات موظف</h1>
<hr />
<div>
    <form asp-action="UpdateEmployee" class="row m-3" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>

            <input asp-for="EmployeeId" class="form-control" hidden/>

        <div class="form-group col-md-5">
            <label asp-for="FirstName" class="control-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group col-md-5">
            <label asp-for="LastName" class="control-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        
        <div class="form-group col-md-5">
            <label asp-for="Age" class="control-label"></label>
            <input asp-for="Age" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <div class="form-group col-md-5">
            <label asp-for="PhoneNumber" class="control-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="MobileNumber" class="control-label"></label>
            <input asp-for="MobileNumber" class="form-control" />
            <span asp-validation-for="MobileNumber" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="Code" class="control-label"></label>
            <input asp-for="Code" class="form-control" readonly />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="Country" class="control-label"></label>
            <input asp-for="Country" class="form-control" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="City" class="control-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="Street" class="control-label"></label>
            <input asp-for="Street" class="form-control" />
            <span asp-validation-for="Street" class="text-danger"></span>
        </div>


        <div class="form-group col-md-5">
            <label asp-for="NationalID" class="control-label"></label>
            <input asp-for="NationalID" class="form-control" />
            <span asp-validation-for="NationalID" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="ImageUrl" class="control-label"></label>
            <input asp-for="ImageUrl" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>
     
        <div class="form-group col-md-5">
            <label asp-for="JobId" class="control-label"></label>
            <input asp-for="UserType" class="form-control" hidden />
            <select asp-for="JobId" class="form-control" asp-items="ViewBag.JobList">
                <option value="">اختر الوظيفة</option>
            </select>
            <span asp-validation-for="JobId" class="text-danger"></span>
        </div>

        <div class="form-group col-md-5">
            <label asp-for="BrancheId" class="control-label"></label>
            @* <select asp-for="BrancheId" class="form-control" asp-items="@(new SelectList(Model.Branches, "Id", "Name"))"> *@
            <select asp-for="BrancheId" class="form-control" asp-items="ViewBag.BranchList">
                <option value="">اختر الفرع</option>
            </select>
            <span asp-validation-for="BrancheId" class="text-danger"></span>
        </div>

        <div class="form-group col-md-5">
            <label asp-for="SalaryTypeId" class="control-label"></label>
            @* <select asp-for="SalaryTypeId" class="form-control" asp-items="@(new SelectList(Model.SalaryTypes, "Id", "Type"))"> *@
            <select asp-for="SalaryTypeId" class="form-control" asp-items="ViewBag.SalaryType">
                <option value="">اختر نوع الراتب</option>
            </select>
            <span asp-validation-for="SalaryTypeId" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="Salary" class="control-label"></label>
            <input asp-for="Salary" class="form-control" />
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>

        <div class="form-group col-md-5">
            <label class="control-label">روابط مهمة</label>
            <div>
                <input type="submit" class="btn btn-primary" value="تعديل" /> |
                <a asp-action="Employees" asp-controller="Employee">عودة للموظفين</a> |
                <a asp-action="AddJob" asp-controller="Job">اضافة وظيفة</a> |
                <a asp-action="AddBranch" asp-controller="Branch">اضافة فرع</a> |
                <a asp-action="AddSalaryType" asp-controller="SalaryType">اضافة نوع راتب</a>
            </div>
        </div>


    </form>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
