@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var title = string.IsNullOrWhiteSpace(ViewBag.Title as string) ? L["Dashboard"].Value : (string)ViewBag.Title;
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Restaurant</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <partial name="_CoreStyles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dash">
    <script>
        try { if (localStorage.getItem("dashSideShut") === "1") { document.body.classList.add("side-shut"); } } catch (e) { }
    </script>

    <partial name="_AdminSidebar" />

    <main class="dash-main">
        <header class="dash-bar">
            <button type="button" class="dash-burger" data-side-toggle aria-controls="dashSide" aria-label="@L["Menu"]">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
            <div class="dash-crumb">
                @if (!User.IsInRole("User"))
                {
                    <a asp-controller="Dashboard" asp-action="Index">@L["Dashboard"]</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">@L["Home"]</a>
                }
                <i class="fas fa-chevron-@(isArabic ? "left" : "right")" aria-hidden="true"></i>
                <span>@title</span>
            </div>
            <div class="dash-tools">
                <a class="dash-lang" asp-controller="SetLanguage" asp-action="SetLanguage" asp-route-culture="@(isArabic ? "en" : "ar")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@(isArabic ? "English" : "العربية")</a>
                <span class="dash-user" title="@User.Identity.Name"><i class="fas fa-circle-user" aria-hidden="true"></i><span>@User.Identity.Name</span></span>
            </div>
        </header>

        <div class="bo-page">
            @RenderBody()
        </div>
    </main>

    <partial name="_CoreScripts" />
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/modules/DeleteObjects.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/ajax.js" asp-append-version="true"></script>
    <script src="~/js/export.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
