@model PaginatedResult<MenuItemViewModel>
@{
    ViewBag.Title = L["MenuItems"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<h1 class="text-center">@L["MenuItems"]</h1>
<hr />

<p>
    <a asp-action="Upsert">@L["NewMenuItem"]</a>
</p>

<form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
    <input id="Menu-search" type="search" class="form-control w-auto" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
    <button type="submit" class="btn btn-primary">@L["Search"]</button>
</form>

<table id="Menu-table" class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Image"]</th>
            <th>@L["Name"]</th>
            <th>@L["MenuSection"]</th>
            <th>@L["Size"]</th>
            <th>@L["TotalCost"]</th>
            <th>@L["Price"]</th>
            <th>@L["Benefit"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Data.Any())
        {
            var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
            foreach (var item in Model.Data)
            {
                <tr>
                    <td>@counter</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                        }
                    </td>
                    <td>@(isArabic ? item.ArName : item.EnName)</td>
                    <td>@(isArabic ? item.MenuSectionArName : item.MenuSectionEnName)</td>
                    <td>@(item.Size.HasValue ? L["Size." + item.Size.Value].Value : L["Size.regular"].Value)</td>
                    <td>@item.TotalCost.ToString("0.00")</td>
                    <td>@item.Price.ToString("0.00")</td>
                    <td>@item.Benefit.ToString("0.00")</td>
                    <td>
                        <a asp-action="Upsert" asp-route-id="@item.Id">@L["Edit"]</a> |
                        <a asp-action="Upsert" asp-route-baseId="@item.Id">@L["AddSize"]</a> |
                        <a onclick="Delete('/Menu/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">@L["Delete"]</a>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="9">@L["NoData"]</td>
            </tr>
        }
    </tbody>
</table>

<div class="app-table-pagination">
    @await Html.PartialAsync("_Pagination", Model)
</div>

<div>
    <a asp-action="Index" asp-controller="Dashboard">@L["BackToDashboard"]</a>
</div>

@section Scripts {
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/modules/deleteobjects.js"></script>
}
