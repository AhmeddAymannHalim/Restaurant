<div class="z4i" id="z4Intro" role="dialog" aria-modal="true" aria-label="@L["Z4uIntroWelcome"]" data-welcome="@L["Z4uIntroWelcome"]">
    <button type="button" class="z4i-skip" data-z4-skip>@L["Z4uIntroSkip"]</button>

    <div class="z4i-stage">
        <div class="z4i-brand" aria-hidden="true">
            <span class="z4i-ring"></span>
            <img class="z4i-mark" src="~/assets/img/z4u-mark.png" alt="" />
        </div>

        <h2 class="z4i-welcome" aria-live="polite"><span data-z4-typed></span><i class="z4i-caret" aria-hidden="true"></i></h2>

        <div class="z4i-story">
            <p>@L["Z4uIntroStory1"]</p>
            <p>@L["Z4uIntroStory2"]</p>
            <p>@L["Z4uIntroStory3"]</p>
        </div>

        <button type="button" class="ff-btn z4i-enter" data-z4-skip>@L["Z4uIntroEnter"]</button>
    </div>
</div>

<script src="~/js/z4-intro.js" asp-append-version="true"></script>
