@model Restaurant.Data.Models.Order

@{
    ViewData["Title"] = "Details";
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link href="~/css/invoicesstyle.css" rel="stylesheet" />


<input type="hidden" id="orderType" value="@Model.Type" />


<div class="container" id="contentToPrint">

    <h1>تفاصيل فاتورة : @Model.CustomerName</h1>
    <hr />

    <dl>

        <dt class="col-sm-3">
            كود الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.OrderCode)
        </dd>


        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Model.OrderDate.ToString("dd-MM-yyyy  hh:mm tt")
        </dd>

        <dt class="col-sm-3">
            م الشيفت البائع
        </dt>
        <dd class="col-sm-8">
            @Model.Seller.FullName
        </dd>

        @if (Model.ReceiverId != null)
        {
            @if (Model.Type != OrderType.TakeAway)
            {
                <dt class="col-sm-3">
                    م الشيفت المستلم
                </dt>
                <dd class="col-sm-8">
                    @Model.Receiver.FullName
                </dd>
            }

        }

        @if (Model.Type == OrderType.TakeAway)
        {
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                تيك اواي
            </dd>
        }



        @if (Model.Type == OrderType.Hall)
        {
            <dt class="col-sm-3">
                اسم الطاولة
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Table.Name)
            </dd>
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                صالة
            </dd>
        }



        @if (Model.Type == OrderType.Delivery)
        {
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                دليفري
            </dd>
            <dt class="col-sm-3">
                الطيار
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Employee.FullName)
            </dd>
            <dt class="col-sm-3">
                العنوان
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Address)
            </dd>
            <dt class="col-sm-3">
                رقم الهاتف
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.PhoneNumber)
            </dd>
            <dt class="col-sm-3">
                رقم الموبايل
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.MobileNumber)
            </dd>
        }


        @if (Model.Type == OrderType.Delivery_Online)
        {
            <dt class="col-sm-3">
                نوع الفاتورة
            </dt>
            <dd class="col-sm-8">
                دليفري اونلاين
            </dd>
            <dt class="col-sm-3">
                الطيار
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Employee.FullName)
            </dd>
            <dt class="col-sm-3">
                العنوان
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Address)
            </dd>
            <dt class="col-sm-3">
                رقم الهاتف
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.PhoneNumber)
            </dd>
            <dt class="col-sm-3">
                رقم الموبايل
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.MobileNumber)
            </dd>
        }





        @if (Model.Service > 0)
        {
            <dt class="col-sm-3">
                الخدمة
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Service)
            </dd>
        }
        @if (Model.Tax > 0)
        {
            <dt class="col-sm-3">
                الضريبة
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Tax)
            </dd>
        }
        @if (Model.Discount > 0)
        {
            <dt class="col-sm-3">
                الخصم
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Discount)
            </dd>
        }


        <dt class="col-sm-3">
           حالة الدفع
        </dt>

        @if (Model.Cash == true)
        {
            <dd class="col-sm-8">
                تم الدفع
            </dd>
        }
        else
        {
            <dd class="col-sm-8">
                لا
            </dd>
        }


        <dt class="col-sm-3">
            الاجمالي
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TotalPrice)
        </dd>

        <dt class="col-sm-3">
            الطلبات
        </dt>
        <dd class="col-sm-8">
            <table class="mt-3 table table-bordered table-light text-dark text-center">
                <thead>
                    <tr>
                        <th>اسم الطلب</th>
                        <th>كمية الطلب</th>
                        <th>سعر الوحدة</th>
                        <th>الاجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderMenuItems)
                    {
                        <tr>
                            <td>@item.MenuItem.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.PriceForUnit</td>
                            <td>@item.Price</td>
                        </tr>
                    }
                </tbody>
            </table>
        </dd>

    </dl>

    <div id="print-button" class="no-print">
        <a class="btn btn-primary" onclick="printCopies()"> طباعة</a>
        <a class="btn btn-primary" asp-action="OrderReport" asp-controller="Report" asp-route-orderId="@Model.Id"> تصدير الي PDF</a>
        <a class="btn btn-info" asp-action="Create" asp-controller="Order">طلب جديد</a>
    </div>

</div>


<script>
    var orderType = document.getElementById("orderType").value;

    function printCopies() {
        var numberOfPrinters = @Html.Raw(Json.Serialize(ViewBag.NumberOfCustomerPrint));

        for (var i = 0; i < numberOfPrinters; i++) {
            window.print();
        }
    }

    var PrintAfterOrder = @Html.Raw(Json.Serialize(ViewBag.PrintAfterOrder));
    if (PrintAfterOrder) {
        console.log('print after order = True');
        printCopies();
    }

    var PrintForTakeawayOrder = @Html.Raw(Json.Serialize(ViewBag.PrintForTakeawayOrder));
    if (PrintForTakeawayOrder && orderType === "@(OrderType.TakeAway)") {
        console.log('Print For Takeaway Order = True');
        printCopies();
    }
</script>
