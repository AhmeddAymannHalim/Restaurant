@model Job

@{
    ViewData["Title"] = "DetailsJob";
}


<h1 class="text-center">تفاصيل الوظيفة </h1>
<hr />


<div>


    <dl class="row">
        <dt class="col-sm-2">
            الاسم
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-2">
            كود الوظيفة
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Code)
        </dd>
        <dt class="col-sm-2">
            الموظفين
        </dt>
        <dd class="col-sm-9">

            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>
                        <th>
                            الاسم
                        </th>
                       
                        <th>
                            السن
                        </th>

                        <th>
                            نوع الراتب
                        </th>
                        <th>
                            الراتب
                        </th>
                        <th>
                            الفرع
                        </th>
                        <th></th>
                       
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Employees)
                    {
                        <tr>
                            <td>
                                @item.FirstName @item.LastName
                            </td>
                            <td>
                                @item.Age
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SalaryType.Type)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Salary)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Branche.Name)
                            </td>
                           
                            <td>
                                    @Html.ActionLink("تعديل", "UpdateEmployee", "Employee", new { id = item.EmployeeId }) |
                                    @Html.ActionLink("التفاصيل", "DetailsEmployee", "Employee", new { id = item.EmployeeId }) |
                                    @Html.ActionLink("حذف", "DeleteEmployee", "Employee", new { id = item.EmployeeId })
                            </td>
                           
                           
                        </tr>
                    }
                </tbody>
            </table>


        </dd>
    </dl>
</div>
<div>
    <a asp-action="UpdateJob" asp-route-id="@Model.JobId">تعديل</a> | 
    <a asp-action="Jobs">عودة للوظائف</a>
</div>
