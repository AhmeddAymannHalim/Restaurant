@{
    ViewData["Title"] = L["Cart"].Value;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">
    <section class="ws-page">
        <div class="ws-wrap">
            <header class="ws-page-head">
                <h1>@L["Basket"]</h1>
                <p><span data-cart-summary>0</span> @L["CartItems"]</p>
            </header>

            <p id="cartEmpty" class="ws-empty" hidden>
                @L["BasketEmpty"]<br />
                <a class="ws-link" asp-action="Menu">@L["ContinueShopping"]</a>
            </p>

            <div id="cartContent" class="ws-split" hidden>
                <div id="cartList"></div>

                <aside class="ws-ticket">
                    <h2>@L["YourOrder"]</h2>
                    <div id="ticketLines"></div>
                    <div class="ws-ticket-total">
                        <span>@L["TotalPrice"]</span>
                        <span><span id="cartTotal">0.00</span> @L["Currency"]</span>
                    </div>
                    <small>@L["DeliveryFeeExtra"]</small>
                    <a class="ws-btn ws-btn-solid" asp-action="Checkout">@L["ToCheckout"]</a>
                    <a class="ws-link" asp-action="Menu">@L["ContinueShopping"]</a>
                </aside>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(function () {
            var isArabic = @Html.Raw(Json.Serialize(isArabic));
            var currency = @Html.Raw(Json.Serialize(L["Currency"].Value));
            var removeText = @Html.Raw(Json.Serialize(L["RemoveFromBasket"].Value));
            var sizeNames = {
                Small: @Html.Raw(Json.Serialize(L["Size.Small"].Value)),
                Medium: @Html.Raw(Json.Serialize(L["Size.Medium"].Value)),
                Large: @Html.Raw(Json.Serialize(L["Size.Large"].Value)),
                Syrian_Bread: @Html.Raw(Json.Serialize(L["Size.Syrian_Bread"].Value))
            };
            var menu = {};

            function nameOf(item) {
                var name = isArabic ? (item.arName || item.enName) : (item.enName || item.arName);
                return item.size ? name + ' (' + (sizeNames[item.size] || item.size) + ')' : name;
            }

            function render() {
                var basket = siteCart.read();
                var ids = Object.keys(basket).filter(function (id) { return menu[id]; });
                var list = $('#cartList').empty();
                var lines = $('#ticketLines').empty();
                var total = 0;
                var pieces = 0;

                ids.forEach(function (id) {
                    var item = menu[id];
                    var quantity = parseInt(basket[id], 10) || 1;
                    total += item.price * quantity;
                    pieces += quantity;

                    var row = $('<div class="ws-cart-row">').attr('data-id', id);
                    row.append(item.imageUrl
                        ? $('<img alt="">').attr('src', item.imageUrl)
                        : $('<div class="ws-cart-ph" aria-hidden="true"><i class="bi bi-egg-fried"></i></div>'));
                    row.append($('<div>')
                        .append($('<h3 class="ws-cart-name">').text(nameOf(item)))
                        .append($('<div class="ws-cart-meta">').text(item.price.toFixed(2) + ' ' + currency)));
                    row.append($('<div class="ws-stepper">')
                        .append($('<button type="button" class="qty-minus" aria-label="-">').text('-'))
                        .append($('<input type="number" min="1" class="qty-input">').val(quantity))
                        .append($('<button type="button" class="qty-plus" aria-label="+">').text('+')));
                    row.append($('<button type="button" class="ws-remove remove-item">').attr('title', removeText).attr('aria-label', removeText).html('<i class="bi bi-trash3" aria-hidden="true"></i>'));
                    list.append(row);

                    lines.append($('<div class="ws-ticket-line">')
                        .append($('<span>').text(quantity + ' x ' + nameOf(item)))
                        .append($('<span>').text((item.price * quantity).toFixed(2))));
                });

                $('#cartTotal').text(total.toFixed(2));
                $('[data-cart-summary]').text(pieces);
                $('#cartEmpty').prop('hidden', ids.length > 0);
                $('#cartContent').prop('hidden', ids.length === 0);
            }

            $(document).on('click', '.qty-plus', function () {
                var id = $(this).closest('.ws-cart-row').data('id');
                siteCart.set(id, (parseInt(siteCart.read()[id], 10) || 0) + 1);
            });
            $(document).on('click', '.qty-minus', function () {
                var id = $(this).closest('.ws-cart-row').data('id');
                siteCart.set(id, (parseInt(siteCart.read()[id], 10) || 0) - 1);
            });
            $(document).on('change', '.qty-input', function () {
                siteCart.set($(this).closest('.ws-cart-row').data('id'), parseInt($(this).val(), 10) || 1);
            });
            $(document).on('click', '.remove-item', function () {
                siteCart.set($(this).closest('.ws-cart-row').data('id'), 0);
            });

            document.addEventListener('cart:changed', render);

            $.get('/Home/MenuItems', function (items) {
                items.forEach(function (item) { menu[item.id] = item; });
                render();
            });
        });
    </script>
}
