@{
    var isArabicDrawer = LanguageHelper.IsArabic();
}

<div class="cart-scrim" data-cart-close hidden></div>

<aside class="cart-drawer"
       id="cartDrawer"
       role="dialog"
       aria-modal="true"
       aria-labelledby="cartDrawerTitle"
       dir="@(isArabicDrawer ? "rtl" : "ltr")"
       data-arabic="@(isArabicDrawer ? "1" : "0")"
       data-currency="@L["Currency"]"
       data-remove="@L["RemoveFromBasket"]"
       data-items="@L["MenuLoadFailed"]"
       data-delivery-one="@L["DeliveryOne"].Value"
       data-delivery-range="@L["DeliveryRange"].Value"
       data-tax="@L["Tax"]"
       data-sizes='@Html.Raw(Json.Serialize(new Dictionary<string, string>
           {
               ["Small"] = L["Size.Small"].Value,
               ["Medium"] = L["Size.Medium"].Value,
               ["Large"] = L["Size.Large"].Value,
               ["Syrian_Bread"] = L["Size.Syrian_Bread"].Value
           }))'
       hidden>
    <header class="cart-head">
        <h2 id="cartDrawerTitle">@L["Basket"]</h2>
        <button type="button" class="cart-close" data-cart-close aria-label="@L["Close"]"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </header>

    <div class="cart-body">
        <p class="cart-empty" id="cartDrawerEmpty" hidden>
            <i class="bi bi-bag" aria-hidden="true"></i>
            @L["BasketEmpty"]
            <a asp-controller="OnlineOrder" asp-action="Menu">@L["ContinueShopping"]</a>
        </p>
        <ul class="cart-lines" id="cartDrawerLines"></ul>
    </div>

    <footer class="cart-foot" id="cartDrawerFoot" hidden>
        <dl class="cart-sums">
            <div><dt>@L["SubTotal"]</dt><dd id="cartSub">0.00</dd></div>
            <div id="cartTaxRow" hidden><dt id="cartTaxLabel">@L["Tax"]</dt><dd id="cartTax">0.00</dd></div>
            <div id="cartServiceRow" hidden><dt>@L["Service"]</dt><dd id="cartService">0.00</dd></div>
        </dl>
        <div class="cart-total">
            <span>@L["TotalPrice"]</span>
            <strong><span id="cartDrawerTotal">0.00</span> @L["Currency"]</strong>
        </div>
        <small id="cartDeliveryNote" hidden></small>
        <a class="cart-checkout" asp-controller="OnlineOrder" asp-action="Checkout">@L["ToCheckout"]</a>
    </footer>
</aside>
