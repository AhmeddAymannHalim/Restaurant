@model Supplier
@{
    ViewData["Title"] = "Delete";
}



<h1 class="text-center">تفاصيل مورد </h1>

<hr />


<div>
    <dl class="row">

        <dt class="col-sm-2">
            الاسم
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>


        <dt class="col-sm-2">
            العنوان
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Address)
        </dd>

        <dt class="col-sm-2">
            الموبايل
        </dt>
        <dd class="col-sm-9">
            @Model.MobileNumber
        </dd>
        <dt class="col-sm-2">
            الهاتف
        </dt>
        <dd class="col-sm-9">
            @Model.PhoneNumber
        </dd>

        <dt class="col-sm-2">
            الرصيد
        </dt>
        <dd class="col-sm-9">
            @Model.Balance
        </dd>
        <dt class="col-sm-2">
            فواتير المشتريات و المرتجعات
        </dt>
        <dd class="col-sm-9">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>

                        <th>
                            كود الفاتورة
                        </th>
                        <th>
                            تاريخ الفاتورة
                        </th>
                        <th>
                            الخصم
                        </th>
                        <th>
                            الاجمالي بعد الخصم
                        </th>
                        <th>
                            المدفوع
                        </th>
                        <th>
                            المتبقي
                        </th>
                        <th>
                            نوع الفاتورة
                        </th>

                        <th>
                            عدد المنتجات
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Invoices)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.InvoiceCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.InvoiceDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Discount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TotalPrice)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Paid)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Remaining)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.InvoiceType)
                            <td>
                                    @item.InvoiceItems.Count()
                            </td>
                            <td>
                                    @Html.ActionLink("التفاصيل", "DetailsInvoice", "Invoice", new { id = item.Id })
                                    @* @Html.ActionLink("Delete", "Invoice", "DeleteInvoice", "Invoice", new { id = item.Id }) *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


        </dd>



        <dt class="col-sm-2">
            فواتير الدفع و التسديد
        </dt>
        <dd class="col-sm-9">
            <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
                <thead>
                    <tr>

                        <th>
                            كود الفاتورة
                        </th>
                        <th>
                            تاريخ الفاتورة
                        </th>

                        <th>
                            المدفوع
                        </th>
                        <th>
                            المتبقي
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PaymentInvoices)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.ProcessCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Paid)
                            </td>
                            <td>
                                @Model.Balance
                            </td>
                            <td>
                                @Html.ActionLink("التفاصيل", "CustomerInvoiceDetails", "PaymentInvoice", new { id = item.Id })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


        </dd>
    </dl>

</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">تعديل</a> |
    <a asp-action="Index">عودة للموردين</a>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}