@{
    var isArabicLayout = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(isArabicLayout ? "ar" : "en")" dir="@(isArabicLayout ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="" name="description">
    <meta content="" name="keywords">
    <title>@ViewData["Title"] - Restaurant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/ResturantPL.styles.css" asp-append-version="true" /> *@
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/animate.css/animate.min.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="~/assets/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/animate.css/animate.min.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/lib/datatables/css/jquery.datatables.min.css" rel="stylesheet" />
    <link href="~/lib/datatables/css/datatables.bootstrap4.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.0.1/css/buttons.dataTables.min.css">
    <!-- Template Main CSS File -->
    <link href="~/assets/css/style.css" rel="stylesheet">



    <link rel="stylesheet" href="~/css/backoffice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/website.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ======= Top Bar ======= -->
    <div id="topbar" class="d-flex align-items-center fixed-top">
        <div class="container d-flex justify-content-center justify-content-md-between">

            @if (Model is WebsiteViewModel site)
            {
                <div class="contact-info d-flex align-items-center">
                    <i class="bi bi-clock d-flex align-items-center ms-4"><span> @site.StartDay - @site.EndDay : @site.StartHour - @site.EndHour</span></i>
                    <i class="bi bi-phone d-flex align-items-center"> <span> @site.Phone </span> </i>
                </div>
            }

        </div>
    </div>

    <!-- ======= Header ======= -->
    <header id="header" class="fixed-top d-flex align-items-center">
        <div class="container-fluid container-xl d-flex align-items-center justify-content-lg-between">

            <nav id="navbar" class="navbar order-last order-lg-0">
                <ul>

                    <li><a class="nav-link scrollto" asp-controller="SetLanguage" asp-action="SetLanguage" asp-route-culture="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en" : "ar")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "English" : "العربية")</a></li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <img src="~/Images/chefs-1.jpg" alt="image" class="rounded-circle m-3" style="width:40px" />
                        <li><a class="nav-link scrollto float-end text-danger" asp-action="SignOut" asp-controller="Account">@L["SignOut"]</a></li>
                    }
                    else
                    {
                        <li><a class="nav-link scrollto float-end text-primary" asp-action="SignIn" asp-controller="Account">@L["SignIn"]</a></li>
                    }

                    @if (User.Identity.IsAuthenticated && !User.IsInRole("User"))
                    {
                        <li><a class="nav-link scrollto" asp-action="Index" asp-controller="Dashboard">@L["Dashboard"]</a></li>
                    }

                    <li><a class="nav-link scrollto" asp-action="Menu" asp-controller="OnlineOrder">@L["Menu"]</a></li>
                    <li><a class="nav-link scrollto" asp-action="PendingOrders" asp-controller="OnlineOrder">@L["MyOrders"]</a></li>
                    <li><a class="nav-link scrollto" href="/#gallery">@L["Gallery"]</a></li>
                    <li><a class="nav-link scrollto" href="/#chefs">@L["Chefs"]</a></li>
                    <li><a class="nav-link scrollto active" asp-action="Index" asp-controller="Home">@L["Home"]</a></li>

                </ul>
                <i class="bi bi-list mobile-nav-toggle"></i>
            </nav>
            <a asp-action="Basket" asp-controller="OnlineOrder" class="book-a-table-btn scrollto d-none d-lg-flex">@L["BookOrderNow"]</a>

        </div>
    </header>
    <!-- End Header -->

    <main role="main" class="m-3 pb-3">
        <div style="height:133px;"></div>
        <div style="direction:@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr");">
            @RenderBody()
        </div>

    </main>


    @if (User.Identity.IsAuthenticated && !User.IsInRole("User") && ViewData["HideDashboardFab"] == null)
    {
        <a class="bo-fab" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2" aria-hidden="true"></i> @L["Dashboard"]
        </a>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>

    <script src="~/lib/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/lib/datatables/js/datatables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables/js/datatables.jqueryui.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.0.1/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.0.1/js/buttons.html5.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/2.0.1/js/buttons.print.min.js"></script>
    <!-- Template Main JS File -->
    <script src="~/assets/js/main.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <partial name="_NotificationPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
