@model Store
@{
    int index = 1;
}
<style>
    .dataTables_wrapper .dt-buttons button {
        background-color: #4CAF50; /* Green background color */
    }

    .dataTables_wrapper .dt-buttons button {
        color: white; /* White text color */
    }
</style>

<div>
    <h4>اسم المخزن : @Model.Name</h4>
</div>
<div>
    <h4>الاجمالي : @ViewBag.Total</h4>
</div>
<table class="table" id="tbInventory">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">اسم الصنف</th>
            <th scope="col">الكمية</th>
            <th scope="col">سعر الوحده</th>
            <th scope="col">القيمة الاجمالية</th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
        @foreach(var product in Model.StoreProducts)
        {
            if (product.Quantity > 0)
            {
                <tr>
                    <th scope="row">@index</th>
                    <td>@product.ProductName</td>
                    <td>@product.Quantity</td>
                    <td>@product.PriceForUnit</td>
                    <td>@(product.PriceForUnit * product.Quantity)</td>
                </tr>
            }
           
            index++;
        }
      
      
    </tbody>
</table>
@section Scripts {
   
    <script>
        $('#tbInventory').DataTable({
            dom: 'Bfrtip',
            buttons: [
                'copy',  'pdf', 'print'
            ]
        });
    </script>
}