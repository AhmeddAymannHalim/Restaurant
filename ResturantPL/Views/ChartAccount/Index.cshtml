@model PaginatedResult<AccountDefinitionViewModel>
@{
    ViewBag.Title = L["ChartOfAccounts"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-sitemap" aria-hidden="true"></i></span>
        <h1>@L["ChartOfAccounts"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewAccount"]</a>
    </div>
    <div class="bo-card-body">
        <form asp-action="Index" method="get" class="bo-filters">
            <div class="bo-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="ChartAccount-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <select name="type" class="form-select w-auto" aria-label="@L["Account.Kind"]">
                <option value="">@L["Account.AllKinds"]</option>
                <option value="GeneralLedger" selected="@(Model.Type == "GeneralLedger")">@L["Account.Kind.GeneralLedger"]</option>
                <option value="Bank" selected="@(Model.Type == "Bank")">@L["Account.Kind.Bank"]</option>
                <option value="Safe" selected="@(Model.Type == "Safe")">@L["Account.Kind.Safe"]</option>
                <option value="Expense" selected="@(Model.Type == "Expense")">@L["Account.Kind.Expense"]</option>
                <option value="Asset" selected="@(Model.Type == "Asset")">@L["Account.Kind.Asset"]</option>
                <option value="Owned" selected="@(Model.Type == "Owned")">@L["Account.Kind.Owned"]</option>
            </select>
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="bo-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

        @await Html.PartialAsync("_TableExportToolbar", "ChartAccount-table")
        <div class="bo-table-wrap">
            <table id="ChartAccount-table" class="bo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Code"]</th>
                        <th>@L["Name"]</th>
                        <th>@L["Account.Kind"]</th>
                        <th>@L["Account.Parent"]</th>
                        <th>@L["Account.Balance"]</th>
                        <th data-export-ignore="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Data.Any())
                    {
                        var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@item.Code</td>
                                <td>@(isArabic ? item.ArName : item.EnName)</td>
                                <td>@L["Account.Kind." + item.Kind]</td>
                                <td>@(isArabic ? item.ParentArName : item.ParentEnName)</td>
                                <td class="num">@item.Balance.ToString("N2")</td>
                                <td class="bo-row-actions">
                                    @if (!item.IsOwned && item.Kind != AccountKind.Asset)
                                    {
                                        <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                        <button type="button" onclick="Delete('/ChartAccount/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                    }
                                    else if (item.Kind == AccountKind.Asset)
                                    {
                                        <a asp-controller="Asset" asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                    }
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="bo-empty">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
