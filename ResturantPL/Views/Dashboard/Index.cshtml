@model DashboardViewModel
@{
    ViewBag.Title = L["Dashboard"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-gauge-high" aria-hidden="true"></i></span>
        <h1>@L["Welcome"] @Model.UserName</h1>
        <span class="dash-live" id="dashLive" data-state="connecting"><i aria-hidden="true"></i><b>@L["Live"]</b></span>
    </div>
    <div class="bo-card-body" id="board">
        <partial name="_Board" model="Model" />
    </div>
</div>

<div class="modal fade floor-modal" id="floorModal" tabindex="-1" aria-labelledby="floorModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="floorModalTitle"><i class="fas fa-chair" aria-hidden="true"></i> @L["Tables"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Back"]"></button>
            </div>
            <div class="modal-body" id="floorBody"></div>
        </div>
    </div>
</div>

<div id="reservationTexts" hidden
     data-pending="@L["Enum.ReservationStatus.Pending"]"
     data-confirmed="@L["Enum.ReservationStatus.Confirmed"]"
     data-rejected="@L["Enum.ReservationStatus.Rejected"]"
     data-cancelled="@L["Enum.ReservationStatus.Cancelled"]"
     data-seated="@L["Enum.ReservationStatus.Seated"]"
     data-completed="@L["Enum.ReservationStatus.Completed"]"
     data-reject-title="@L["Reservation.RejectReason"]"
     data-reject="@L["Reservation.Reject"]"
     data-back="@L["Back"]"
     data-error="@L["SomethingWentError"]"></div>

@section Scripts {
    <script src="~/js/reservation-actions.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var board = $('#board');
            var live = $('#dashLive');
            var busy = false;
            var liveText = @Html.Raw(Json.Serialize(L["Live"].Value));
            var offlineText = @Html.Raw(Json.Serialize(L["LiveOffline"].Value));

            function setLive(state) {
                live.attr('data-state', state).find('b').text(state === 'off' ? offlineText : liveText);
            }

            // the board is replaced on every refresh, so the floor is moved into the open-or-closed modal each time
            function placeFloor() {
                var source = $('#floorSource');
                if (source.length) {
                    $('#floorBody').html(source.html());
                    source.remove();
                }
            }

            function markWaitingTile() {
                var tile = $('#waitingTile');
                tile.toggleClass('shift-tile-warn', Number(tile.data('waiting')) > 0);
            }

            function refresh() {
                if (busy || document.hidden) {
                    return;
                }

                busy = true;
                fetch('@Url.Action("Board", "Dashboard")', { headers: { 'X-No-Loader': '1' }, credentials: 'same-origin', cache: 'no-store' })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error(response.status);
                        }

                        return response.text();
                    })
                    .then(function (html) {
                        board.html(html);
                        placeFloor();
                        fillReservationStatuses();
                        countFloorTables();
                        markWaitingTile();
                        setLive('on');
                    })
                    .catch(function () {
                        setLive('off');
                    })
                    .then(function () {
                        busy = false;
                    });
            }

            board.on('click', '.kitchen-done', function () {
                var button = $(this);
                button.prop('disabled', true);
                $.post('/KitchenOrder/Complete', { id: button.data('id') }, function (result) {
                    if (result.success) {
                        refresh();
                    } else {
                        button.prop('disabled', false);
                        toastr.error(result.errorMessage);
                    }
                });
            });

            document.addEventListener('visibilitychange', refresh);

            placeFloor();
            fillReservationStatuses();
            countFloorTables();
            markWaitingTile();
            setLive('on');

            setInterval(refresh, 20000);
        });
    </script>
}
