@model Customer

@{
    ViewData["Title"] = "Edit";
}


<h1 class="text-center">تعديل بيانات عميل </h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">

            @* to link the id parameter in action Edit(int? id)*@
            <input hidden asp-for="Id" />

            @*For Server Side Validation Data Annotation*@
            <div asp-validation-summary="All" class="text-danger"> </div>

            <div class="form-group">
                <label asp-for="Name">اسم العميل</label>
                <input asp-for="Name" class="form-control" />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address">العنوان</label>
                <input asp-for="Address" class="form-control" />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MobileNumber">رقم الموبايل</label>
                <input asp-for="MobileNumber" class="form-control" minlength="11" maxlength="11" />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="MobileNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">رقم الهاتف</label>
                <input asp-for="PhoneNumber" class="form-control" maxlength="11" />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Balance">الرصيد</label>
                <input asp-for="Balance" class="form-control" />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Balance" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="تعديل" class="btn btn-success" />
                <a asp-action="Index">عودة للعملاء</a>

            </div>
        </form>

    </div>
</div>



@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}