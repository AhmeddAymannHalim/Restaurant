@model OnlineOrderCreateViewModel
@{
    ViewData["Title"] = L["Checkout"].Value;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">
    <section class="ws-page">
        <div class="ws-wrap">
            <header class="ws-page-head">
                <h1>@L["Checkout"]</h1>
                <p>@L["CheckoutSubtitle"]</p>
            </header>

            <form id="orderForm" asp-action="Create" asp-controller="OnlineOrder" method="post" class="ws-split">
                <div>
                    <div class="ws-block">
                        <div class="ws-choice" role="radiogroup" aria-label="@L["Checkout"]">
                            <label>
                                <input type="radio" name="service" value="delivery" checked />
                                <span>
                                    <strong><i class="bi bi-bicycle" aria-hidden="true"></i> @L["ServiceDelivery"]</strong>
                                    <small>@L["ServiceDeliveryHint"]</small>
                                </span>
                            </label>
                            <label>
                                <input type="radio" name="service" value="table" />
                                <span>
                                    <strong><i class="bi bi-cup-hot" aria-hidden="true"></i> @L["ServiceTable"]</strong>
                                    <small>@L["ServiceTableHint"]</small>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div id="tableBlock" class="ws-block" hidden>
                        <h2>@L["ChooseTable"]</h2>
                        <div class="ws-tables">
                            @foreach (var table in Model.Tables)
                            {
                                <label>
                                    <input type="radio" name="TableId" value="@table.Id" disabled />
                                    <span>@(isArabic ? table.ArName : table.EnName)</span>
                                </label>
                            }
                        </div>
                        <small class="d-block mt-2 text-muted">@L["TableOrderNote"]</small>
                    </div>

                    @if (Model.Zones.Any())
                    {
                        <div id="zoneBlock" class="ws-block">
                            <h2>@L["ChooseZone"]</h2>
                            <div class="ws-tables">
                                @foreach (var zone in Model.Zones)
                                {
                                    <label>
                                        <input type="radio" name="DeliveryZoneId" value="@zone.Id" data-fee="@zone.Fee.ToString(CultureInfo.InvariantCulture)" data-name="@(isArabic ? zone.ArName : zone.EnName)" required />
                                        <span>@(isArabic ? zone.ArName : zone.EnName) - @zone.Fee.ToString("N2") @L["Currency"]</span>
                                    </label>
                                }
                            </div>
                            <small class="d-block mt-2 text-muted">@L["DeliveryFeeVaries"]</small>
                        </div>
                    }

                    <div class="ws-block">
                        <h2>@L["YourDetails"]</h2>
                        <div class="ws-fields">
                            <div class="ws-field">
                                <label for="CustomerName">@L["CustomerName"]</label>
                                <input id="CustomerName" name="CustomerName" required minlength="3" maxlength="100" autocomplete="name" />
                            </div>
                            <div class="ws-field">
                                <label for="MobileNumber">@L["MobileNumber"]</label>
                                <input id="MobileNumber" name="MobileNumber" required maxlength="11" inputmode="tel" autocomplete="tel" />
                            </div>
                            <div class="ws-field">
                                <label for="PhoneNumber">@L["PhoneNumber"]</label>
                                <input id="PhoneNumber" name="PhoneNumber" maxlength="11" inputmode="tel" />
                            </div>
                            <div id="addressField" class="ws-field ws-full">
                                <label for="Address">@L["Address"]</label>
                                <input id="Address" name="Address" required minlength="5" maxlength="250" autocomplete="street-address" />
                            </div>
                        </div>
                    </div>
                </div>

                <aside class="ws-ticket">
                    <h2>@L["YourOrder"]</h2>
                    <div id="ticketLines"></div>
                    <dl class="ws-sums">
                        <div><dt>@L["SubTotal"]</dt><dd id="sumSub">0.00</dd></div>
                        <div id="sumTaxRow" hidden><dt>@L["Tax"] <span id="sumTaxPct"></span></dt><dd id="sumTax">0.00</dd></div>
                        <div id="sumServiceRow" hidden><dt>@L["Service"]</dt><dd id="sumService">0.00</dd></div>
                        <div id="sumDeliveryRow" hidden><dt>@L["DeliveryFee"] <span id="sumZone"></span></dt><dd id="sumDelivery">0.00</dd></div>
                    </dl>
                    <div class="ws-ticket-total">
                        <span>@L["TotalPrice"]</span>
                        <span><span id="cartTotal">0.00</span> @L["Currency"]</span>
                    </div>
                    <small id="deliveryNote" hidden>@L["ChooseZone"]</small>
                    <div id="orderLines"></div>
                    <button type="submit" class="ws-btn ws-btn-solid">@L["ConfirmOrder"]</button>
                    <a class="ws-link" asp-action="Basket">@L["Basket"]</a>
                </aside>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(function () {
            var isArabic = @Html.Raw(Json.Serialize(isArabic));
            var sizeNames = {
                Small: @Html.Raw(Json.Serialize(L["Size.Small"].Value)),
                Medium: @Html.Raw(Json.Serialize(L["Size.Medium"].Value)),
                Large: @Html.Raw(Json.Serialize(L["Size.Large"].Value)),
                Syrian_Bread: @Html.Raw(Json.Serialize(L["Size.Syrian_Bread"].Value))
            };
            var menu = {};
            var pricing = { taxPercent: 0, service: 0, zones: [] };

            function nameOf(item) {
                var name = isArabic ? (item.arName || item.enName) : (item.enName || item.arName);
                return item.size ? name + ' (' + (sizeNames[item.size] || item.size) + ')' : name;
            }

            function summary() {
                var basket = siteCart.read();
                var ids = Object.keys(basket).filter(function (id) { return menu[id]; });
                var lines = $('#ticketLines').empty();
                var total = 0;

                if (Object.keys(menu).length > 0 && ids.length === 0) {
                    window.location.replace('@Url.Action("Basket")');
                    return;
                }

                ids.forEach(function (id) {
                    var quantity = parseInt(basket[id], 10) || 1;
                    total += menu[id].price * quantity;
                    lines.append($('<div class="ws-ticket-line">')
                        .append($('<span>').text(quantity + ' x ' + nameOf(menu[id])))
                        .append($('<span>').text((menu[id].price * quantity).toFixed(2))));
                });

                var atTable = $('input[name="service"]:checked').val() === 'table';
                var zone = $('input[name="DeliveryZoneId"]:checked');
                var hasZones = pricing.zones.length > 0;
                var fee = !atTable && zone.length ? parseFloat(zone.data('fee')) || 0 : 0;
                var tax = Math.round(total * pricing.taxPercent) / 100;
                var service = pricing.service;

                $('#sumSub').text(total.toFixed(2));
                $('#sumTax').text(tax.toFixed(2));
                $('#sumTaxPct').text(pricing.taxPercent > 0 ? '(' + pricing.taxPercent + '%)' : '');
                $('#sumTaxRow').prop('hidden', tax <= 0);
                $('#sumService').text(service.toFixed(2));
                $('#sumServiceRow').prop('hidden', service <= 0);
                $('#sumDelivery').text(fee.toFixed(2));
                $('#sumZone').text(zone.length && !atTable ? '(' + zone.data('name') + ')' : '');
                $('#sumDeliveryRow').prop('hidden', atTable || !hasZones || !zone.length);
                $('#deliveryNote').prop('hidden', atTable || !hasZones || zone.length > 0);
                $('#cartTotal').text((total + tax + service + fee).toFixed(2));
            }

            function showService() {
                var atTable = $('input[name="service"]:checked').val() === 'table';
                $('#tableBlock').prop('hidden', !atTable);
                $('#tableBlock input[name="TableId"]').prop('disabled', !atTable).prop('required', atTable);
                $('#addressField').prop('hidden', atTable);
                $('#Address').prop('disabled', atTable).prop('required', !atTable);
                $('#zoneBlock').prop('hidden', atTable);
                $('#zoneBlock input').prop('disabled', atTable);
                summary();
            }

            $('input[name="service"], input[name="DeliveryZoneId"]').on('change', function () { showService(); });

            $('#orderForm').on('submit', function () {
                var basket = siteCart.read();
                var lines = $('#orderLines').empty();
                Object.keys(basket).filter(function (id) { return menu[id]; }).forEach(function (id, index) {
                    lines.append($('<input type="hidden">').attr('name', 'OnlineOrderMenuItems[' + index + '].MenuItemId').val(id));
                    lines.append($('<input type="hidden">').attr('name', 'OnlineOrderMenuItems[' + index + '].Quantity').val(basket[id]));
                });
            });

            showService();

            $.when($.get('/Home/MenuItems'), $.get('/Home/Pricing')).done(function (items, price) {
                items[0].forEach(function (item) { menu[item.id] = item; });
                pricing = price[0];
                summary();
            });
        });
    </script>
}
