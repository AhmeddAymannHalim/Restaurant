@model PrinterSettingViewModel
@{
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    ViewBag.Title = L["Setting_PrinterTitle"].Value;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-print" aria-hidden="true"></i></span>
        <h1>@L["Setting_PrinterTitle"]</h1>
    </div>
    <div class="bo-card-body">
<form asp-action="PrinterSetting" method="post" class="bo-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="PrinterForAllSections" class="control-label">@L["Setting_PrinterAll"]</label>
        <select asp-for="PrinterForAllSections" class="form-control">
            <option value="">@L["Setting_SelectPrinter"]</option>
                    @foreach (var item in Model.Printers)
                    {
                        <option value="@item.Id" selected="@(Model.PrinterForAllSections == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
        <span asp-validation-for="PrinterForAllSections" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrinterForCashier" class="control-label">@L["Setting_PrinterCashier"]</label>
        <select asp-for="PrinterForCashier" class="form-control">
            <option value="">@L["Setting_SelectPrinter"]</option>
                    @foreach (var item in Model.Printers)
                    {
                        <option value="@item.Id" selected="@(Model.PrinterForCashier == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
        <span asp-validation-for="PrinterForCashier" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrinterForEachSection" class="control-label">@L["Setting_PrinterEach"]</label>
        <select asp-for="PrinterForEachSection" class="form-control">
            <option value="">@L["Setting_SelectPrinter"]</option>
                    @foreach (var item in Model.Printers)
                    {
                        <option value="@item.Id" selected="@(Model.PrinterForEachSection == item.Id)">@(isArabic ? item.ArName : item.EnName)</option>
                    }
                </select>
        <span asp-validation-for="PrinterForEachSection" class="text-danger"></span>
    </div>

    <div class="bo-form-actions">
        <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
        <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Setting_Back"]</a>
    </div>
</form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
