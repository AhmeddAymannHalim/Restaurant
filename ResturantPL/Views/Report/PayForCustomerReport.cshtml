@model Restaurant.DAL.Models.PaymentInvoiceCustomer

@{
    ViewData["Title"] = "Supplier Invoice Report";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>


<h1>فاتورة تسديد العميل / @Model.Customer.ArName</h1>
<hr />



<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr>
            <th colspan="2">التفاصيل</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mainRow">اسم العميل</td>
            <td>@Model.Customer.ArName</td>
        </tr>
        <tr>
            <td class="mainRow">كود العملية</td>
            <td>@Model.ProcessCode</td>
        </tr>
        <tr>
            <td class="mainRow">تاريخ العملية</td>
            <td>@Model.Date.ToString("dd-MM-yyyy  hh:mm tt")</td>
        </tr>

        <tr>
            <td class="mainRow">البيان</td>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <td class="mainRow">المدفوع</td>
            <td>@Model.Paid</td>
        </tr>
        <tr>
            <td class="mainRow">المتبقي</td>
            <td>@Model.Customer.Balance</td>
        </tr>

    </tbody>
</table>






