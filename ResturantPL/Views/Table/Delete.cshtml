@model Table
@{
    ViewData["Title"] = "Delete";
}

<
<h1 class="text-center">حذف بيانات طاولة </h1>
<hr />



<div>
    <dl class="row">

        <dt class="col-sm-2">
            الاسم
        </dt>
        <dd class="col-sm-10">
            @Model.Name
        </dd>


        <dt class="col-sm-2">
            عدد الكراسي
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NumOfPersons)
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">عودة للطاولات</a>
    </form>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 
