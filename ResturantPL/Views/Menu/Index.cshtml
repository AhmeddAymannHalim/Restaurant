@model PaginatedResult<MenuItemViewModel>
@{
    ViewBag.Title = L["MenuItems"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-utensils" aria-hidden="true"></i></span>
        <h1>@L["MenuItems"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewMenuItem"]</a>
    </div>
    <div class="bo-card-body">
        <form asp-action="Index" method="get" class="bo-filters">
            <div class="bo-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="Menu-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="bo-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

@await Html.PartialAsync("_TableExportToolbar", "Menu-table")
        <div class="bo-table-wrap">
        <table id="Menu-table" class="bo-table">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Code"]</th>
            <th>@L["Image"]</th>
            <th>@L["Name"]</th>
            <th>@L["MenuSection"]</th>
            <th>@L["Ingredients"]</th>
            <th>@L["Size"]</th>
            <th>@L["TotalCost"]</th>
            <th>@L["Price"]</th>
            <th>@L["Benefit"]</th>
            <th>@L["Availability"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Data.Any())
        {
            var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
            foreach (var item in Model.Data)
            {
                <tr>
                    <td>@counter</td>
                    <td>@item.Code</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                        }
                    </td>
                    <td>@(isArabic ? item.ArName : item.EnName)</td>
                    <td>@(isArabic ? item.MenuSectionArName : item.MenuSectionEnName)</td>
                    <td>@(isArabic ? item.ArIngredients : item.EnIngredients)</td>
                    <td>@(item.Size.HasValue ? L["Size." + item.Size.Value].Value : L["Size.regular"].Value)</td>
                    <td>@item.TotalCost.ToString("0.00")</td>
                    <td>@item.Price.ToString("0.00")</td>
                    <td>@item.Benefit.ToString("0.00")</td>
                    <td>@(item.IsAvailable ? L["Yes"] : L["No"])</td>
                    <td class="bo-row-actions">
                        <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                        <button type="button" onclick="Delete('/Menu/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="12" class="bo-empty">@L["NoData"]</td>
            </tr>
        }
    </tbody>
</table>
        </div>

<div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
