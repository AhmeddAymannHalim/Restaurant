@model Restaurant.DAL.Models.StoreConvert

@{
    ViewData["Title"] = "Store Convert";
    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link href="~/css/invoicesstyle.css" rel="stylesheet" />




<div class="container">

 
        <h1> فاتورة نقل اصناف</h1>
    <hr />


    <dl>

        <dt class="col-sm-3">
            كود الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.ConvertCode)
        </dd>
        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.ConvertDate)
        </dd>
        
       
        <dt class="col-sm-3">
            المخزن المنقول منه
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.FromStore.ArName)
        </dd>
        <dt class="col-sm-3">
            المخزن المنقول اليه
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.ToStore.ArName)
        </dd>
       
      
        <dt class="col-sm-3">
            الاصناف
        </dt>
        <dd class="col-sm-8">
            @* <table class="table table-hover text-center table-bordered table-striped-columns table-dark"> *@
            <table class="mt-3 table table-bordered table-light text-dark">
                <tr>
                    <th>اسم المنتج</th>
                    <th>الكمية</th>

                </tr>
                @foreach (var item in Model.StoreConvertProducts)
                {
                    <tr>
                        <td>@item.StoreProduct.ProductName</td>
                        <td>@item.Quantity</td>
                    </tr>
                }
            </table>
        </dd>

    </dl>

    <div id="print-button" class="no-print mt-3">
        <a class="btn btn-primary" onclick="window.print()"> طباعة</a>
        <a class="btn btn-primary" asp-action="StoreConvertReport" asp-controller="Report" asp-route-invoiceId="@Model.Id"> تصدير الي PDF</a>
        <a class="btn btn-info" asp-action="Index">عودة للفواتير</a>
    </div>

</div>

