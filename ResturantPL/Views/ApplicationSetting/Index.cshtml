@{
    ViewBag.Title = L["Setting_Title"].Value;
    var tiles = new[]
    {
        (Action: "ApplicationSetting", Icon: "fa-sliders", Title: "Setting_General", Text: "Setting_GeneralDesc"),
        (Action: "RestaurantSetting", Icon: "fa-bars-progress", Title: "Setting_Restaurant", Text: "Setting_RestaurantDesc"),
        (Action: "PrinterSetting", Icon: "fa-print", Title: "Setting_Printers", Text: "Setting_PrintersDesc")
    };
    var index = 0;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-gear" aria-hidden="true"></i></span>
        <h1>@L["Setting_Title"]</h1>
    </div>
    <div class="ad-card-body">
        <div class="dash-grid">
            @foreach (var tile in tiles)
            {
                <a class="tile" style="--i:@(index++)" asp-action="@tile.Action">
                    <span class="tile-icon"><i class="fas @tile.Icon" aria-hidden="true"></i></span>
                    <span class="tile-text">
                        <span class="tile-label">@L[tile.Title]</span>
                        <span class="tile-note">@L[tile.Text]</span>
                    </span>
                </a>
            }
        </div>
    </div>
</div>
