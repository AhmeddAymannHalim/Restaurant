@{
    Layout = "_Layout";
    ViewData["HideDashboardFab"] = true; // the bar below already has the dashboard button

    var current = ViewContext.RouteData.Values["controller"]?.ToString();

    // title key + (controller, label key) of every definition screen
    var groups = new (string Title, (string Controller, string Label)[] Items)[]
    {
        ("GroupOrganization", new[] { ("Branch", "Branches"), ("Job", "Jobs"), ("Employee", "Employees"), ("SalaryType", "SalaryTypes") }),
        ("GroupKitchen", new[] { ("Kitchen", "Kitchens"), ("MenuSection", "MenuSections"), ("Table", "Tables") }),
        ("GroupInventory", new[] { ("Store", "Stores"), ("Product", "Products"), ("UnitPrice", "UnitPrices") }),
        ("GroupPartners", new[] { ("Supplier", "Suppliers"), ("Customer", "Customers") }),
        ("GroupFinance", new[] { ("Expense", "Expenses"), ("ExitExpense", "ExitExpenses"), ("Deposit", "Deposits"), ("Scrounge", "Scrounges"), ("Salary", "Salaries") })
    };
}

<div class="bo-bar">
    <a class="bo-dash" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-speedometer2" aria-hidden="true"></i>
        @L["Dashboard"]
    </a>

    <details class="bo-menu">
        <summary>@L["Definitions"]</summary>
        <nav class="bo-panel" aria-label="@L["Definitions"]">
            @foreach (var group in groups)
            {
                <div class="bo-group">
                    <h6>@L[group.Title]</h6>
                    @foreach (var item in group.Items)
                    {
                        <a asp-controller="@item.Controller" asp-action="Index" class="@(string.Equals(current, item.Controller, StringComparison.OrdinalIgnoreCase) ? "is-current" : "")">@L[item.Label]</a>
                    }
                </div>
            }
        </nav>
    </details>

    <span class="bo-crumb">@ViewBag.Title</span>
</div>

<div class="bo-page">
    @RenderBody()
</div>

@section Scripts {
    <script>
        // close the definitions menu when clicking anywhere else
        document.addEventListener("click", function (e) {
            if (!e.target.closest(".bo-menu")) {
                document.querySelectorAll(".bo-menu[open]").forEach(function (d) { d.removeAttribute("open"); });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
}
