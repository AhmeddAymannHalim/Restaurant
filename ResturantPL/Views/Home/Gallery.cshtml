@model IList<GalleryItem>
@{
    ViewData["Title"] = "Gallery";
}




<!-- ======= Gallery Section ======= -->
<section id="gallery" class="gallery">

    <div class="container mt-5" data-aos="fade-up">
        <div class="section-title">

            <p class="float-end">بعض الصور المميزه للمطعم</p>
            <br />
            <br />
            @if (User.Identity.IsAuthenticated && !User.IsInRole("User"))
            {
                <a asp-action="GalleryAdd" asp-controller="Home" class="btn-menu animated fadeInUp scrollto float-end m-5">إضافه صوره</a>
            }
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <div class="container-fluid" data-aos="fade-up" data-aos-delay="100">

        <div class="row g-0">
            @foreach (var item in Model)
            {

                <div class="col-lg-3 col-md-4 m-2">
                    <div class="gallery-item">
                        <a href="@item.PictureUrl" class="gallery-lightbox" data-gall="gallery-item">
                            <img src="@item.PictureUrl" alt="" class="img-fluid">
                        </a>
                    </div>

                    <div>
                        @if (User.Identity.IsAuthenticated && !User.IsInRole("User"))
                        {
                            <a asp-action="GalleryDelete" asp-controller="Home" asp-route-id="@item.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">حذف الصوره</a>
                        }
                    </div>
                </div>
            }



        </div>

    </div>
</section><!-- End Gallery Section -->