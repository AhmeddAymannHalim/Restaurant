@model PaginatedResult<AccountDefinitionViewModel>
@{
    ViewBag.Title = L["Assets"].Value;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-building-columns" aria-hidden="true"></i></span>
        <h1>@L["Assets"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewAsset"]</a>
    </div>
    <div class="ad-card-body">
        <form asp-action="Index" method="get" class="ad-filters">
            <div class="ad-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="Asset-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="ad-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

        @await Html.PartialAsync("_ExportToolbar", "Asset-table")
        <div class="ad-table-wrap">
            <table id="Asset-table" class="ad-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Code"]</th>
                        <th>@L["Name"]</th>
                        <th>@L["Asset.Location"]</th>
                        <th>@L["Asset.BuyDate"]</th>
                        <th>@L["Asset.BuyValue"]</th>
                        <th>@L["Asset.DepreciationType"]</th>
                        <th>@L["Account.Balance"]</th>
                        <th data-export-ignore="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Data.Any())
                    {
                        var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@item.Code</td>
                                <td>@(isArabic ? item.ArName : item.EnName)</td>
                                <td>@item.Location</td>
                                <td>@item.BuyDate?.ToString("yyyy-MM-dd")</td>
                                <td class="num">@((item.BuyValue ?? 0).ToString("N2"))</td>
                                <td>@Html.EnumText(L, item.DepreciationType)</td>
                                <td class="num">@item.Balance.ToString("N2")</td>
                                <td class="ad-row-actions">
                                    <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                    <button type="button" onclick="Delete('/Asset/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="ad-empty">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
