@model HomeViewModel
@{
    bool isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var restaurantName = isArabic ? Model.ArName : Model.EnName;
    if (string.IsNullOrWhiteSpace(restaurantName))
    {
        restaurantName = Model.ArName ?? Model.EnName;
    }
    ViewData["Title"] = L["Home"].Value;

    var description = isArabic
        ? (string.IsNullOrWhiteSpace(Model.ArDescription) ? Model.EnDescription : Model.ArDescription)
        : (string.IsNullOrWhiteSpace(Model.EnDescription) ? Model.ArDescription : Model.EnDescription);
    var location = isArabic
        ? (string.IsNullOrWhiteSpace(Model.ArLocation) ? Model.EnLocation : Model.ArLocation)
        : (string.IsNullOrWhiteSpace(Model.EnLocation) ? Model.ArLocation : Model.EnLocation);

    string DayName(string value)
    {
        var day = WeekDays.Normalize(value);
        return day == null ? value : L["Day." + day].Value;
    }
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">

    <section class="ws-hero" id="ws-top" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : $"--hero:url('{Model.ImageUrl}')")">
        <div class="ws-hero-inner">
            <p class="ws-kicker">@L["WelcomeTo"]</p>
            <h1 class="ws-title">@restaurantName</h1>
            <p class="ws-tagline">@L["HeroTagline"]</p>
            <div class="ws-actions">
                <a class="ws-btn ws-btn-solid" href="#menu">@L["ViewMenu"]</a>
                <a class="ws-btn ws-btn-ghost" asp-controller="OnlineOrder" asp-action="Basket">@L["BookOrderNow"]</a>
                @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                {
                    <a class="ws-play glightbox" href="@Model.VideoUrl" aria-label="@L["PlayVideo"]"><i class="bi bi-play-fill" aria-hidden="true"></i></a>
                }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(description))
    {
        <section class="ws-sec ws-about" id="about">
            <div class="ws-wrap ws-about-grid">
                <div class="ws-reveal">
                    <h2 class="ws-h2">@L["AboutUs"]</h2>
                    <p class="ws-lead">@description</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img class="ws-about-img ws-reveal" src="@Model.ImageUrl" alt="@restaurantName" loading="lazy" />
                }
            </div>
        </section>
    }

    <section class="ws-sec" id="menu"
             data-ws-menu
             data-url="@Url.Action("MenuItems", "Home")"
             data-ar="@(isArabic ? "1" : "0")"
             data-currency="@L["Currency"]"
             data-add="@L["AddToBasket"]"
             data-made-of="@L["MadeOf"]"
             data-sizes='@Html.Raw(Json.Serialize(new Dictionary<string, string>
                 {
                     ["Small"] = L["Size.Small"].Value,
                     ["Medium"] = L["Size.Medium"].Value,
                     ["Large"] = L["Size.Large"].Value,
                     ["Syrian_Bread"] = L["Size.Syrian_Bread"].Value
                 }))'
             data-empty="@L["NoMenuItems"]"
             data-failed="@L["MenuLoadFailed"]">
        <div class="ws-wrap">
            <h2 class="ws-h2 ws-reveal">@L["OurMenu"]</h2>

            @if (Model.MenuSections.Any())
            {
                <div class="ws-tabs-wrap ws-reveal">
                    <div class="ws-tabs" role="tablist" aria-label="@L["OurMenu"]">
                        <span class="ws-tab-pill" aria-hidden="true"></span>
                        <button type="button" class="ws-tab is-on" role="tab" aria-selected="true" data-section="">@L["AllCategories"]</button>
                        @foreach (var cat in Model.MenuSections)
                        {
                            <button type="button" class="ws-tab" role="tab" aria-selected="false" data-section="@cat.Id">@(isArabic ? cat.ArName : cat.EnName)</button>
                        }
                    </div>
                </div>
            }

            <div class="ws-dishes" data-ws-dishes aria-live="polite"></div>
        </div>
    </section>

    @if (Model.Chefs.Any())
    {
        <section class="ws-sec ws-alt" id="chefs">
            <div class="ws-wrap">
                <h2 class="ws-h2 ws-reveal">@L["Chefs"]</h2>
                <div class="ws-chefs">
                    @foreach (var chef in Model.Chefs)
                    {
                        <figure class="ws-chef ws-reveal">
                            <img src="@chef.ImageUrl" alt="@(isArabic ? chef.ArName : chef.EnName)" loading="lazy" />
                            <figcaption>
                                <strong>@(isArabic ? chef.ArName : chef.EnName)</strong>
                                <span>@chef.Jop</span>
                            </figcaption>
                        </figure>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.Gallery.Any())
    {
        <section class="ws-sec" id="gallery">
            <div class="ws-wrap">
                <h2 class="ws-h2 ws-reveal">@L["OurGallery"]</h2>
                <div class="ws-gallery">
                    @foreach (var photo in Model.Gallery)
                    {
                        <a class="ws-shot glightbox ws-reveal" href="@photo.PictureUrl" data-gallery="ws"><img src="@photo.PictureUrl" alt="" loading="lazy" /></a>
                    }
                </div>
            </div>
        </section>
    }

    <section class="ws-sec ws-alt" id="contact">
        <div class="ws-wrap">
            <h2 class="ws-h2 ws-reveal">@L["Contact"]</h2>
            <div class="ws-info">
                @if (!string.IsNullOrWhiteSpace(location))
                {
                    <div class="ws-info-card ws-reveal"><i class="bi bi-geo-alt" aria-hidden="true"></i><h3>@L["OurLocation"]</h3><p>@location</p></div>
                }
                <div class="ws-info-card ws-reveal">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    <h3>@L["WorkingHours"]</h3>
                    <p>@DayName(Model.StartDay) - @DayName(Model.EndDay)<br />@Model.StartHour - @Model.EndHour</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <div class="ws-info-card ws-reveal"><i class="bi bi-envelope" aria-hidden="true"></i><h3>@L["Email"]</h3><p><a href="mailto:@Model.Email">@Model.Email</a></p></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <div class="ws-info-card ws-reveal"><i class="bi bi-telephone" aria-hidden="true"></i><h3>@L["Phone"]</h3><p><a href="tel:@Model.Phone">@Model.Phone</a></p></div>
                }
            </div>
        </div>
    </section>

    <footer class="ws-foot">
        <span>&copy; @DateTime.Now.Year @restaurantName. @L["FooterRights"]</span>
    </footer>
</div>

@section Scripts {
    <script>
(function () {
    "use strict";

    document.documentElement.classList.add("js");

    var reveals = document.querySelectorAll(".ws-reveal");
    if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    e.target.classList.add("is-in");
                    io.unobserve(e.target);
                }
            });
        }, { rootMargin: "0px 0px -8% 0px" });
        reveals.forEach(function (el) { io.observe(el); });
    } else {
        reveals.forEach(function (el) { el.classList.add("is-in"); });
    }

    var root = document.querySelector("[data-ws-menu]");
    if (!root) { return; }

    var list = root.querySelector("[data-ws-dishes]");
    var tabs = Array.prototype.slice.call(root.querySelectorAll(".ws-tab"));
    var pill = root.querySelector(".ws-tab-pill");
    var arabic = root.dataset.ar === "1";
    var cache = {};
    var current = null;
    var ticket = 0;
    var sizeNames = {};
    try {
        sizeNames = JSON.parse(root.dataset.sizes || "{}");
    } catch (e) {
        sizeNames = {};
    }

    function esc(text) {
        var d = document.createElement("div");
        d.textContent = text == null ? "" : text;
        return d.innerHTML;
    }

    function movePill(tab) {
        if (!pill || !tab) { return; }
        pill.style.setProperty("--x", tab.offsetLeft + "px");
        pill.style.setProperty("--w", tab.offsetWidth + "px");
    }

    function card(item, index) {
        var name = arabic ? (item.arName || item.enName) : (item.enName || item.arName);
        var price = Number(item.price).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        var image = item.imageUrl
            ? '<img src="' + esc(item.imageUrl) + '" alt="' + esc(name) + '" loading="lazy" />'
            : "";
        var size = item.size ? '<span class="ws-dish-size">' + esc(sizeNames[item.size] || item.size) + "</span>" : "";
        var text = arabic ? (item.arDescription || item.enDescription) : (item.enDescription || item.arDescription);
        var desc = text ? '<p class="ws-dish-desc">' + esc(text) + "</p>" : "";
        var ingredients = arabic ? (item.arIngredients || item.enIngredients) : (item.enIngredients || item.arIngredients);
        var made = ingredients ? '<p class="ws-dish-desc ws-dish-made">' + esc(root.dataset.madeOf) + " " + esc(ingredients) + "</p>" : "";

        return '<article class="ws-dish" style="--i:' + index + '">' +
            '<div class="ws-dish-img">' + image + "</div>" +
            '<div class="ws-dish-body">' +
            '<div class="ws-dish-head"><h3 class="ws-dish-name">' + esc(name) + '</h3>' +
            '<span class="ws-dish-price">' + price + " " + esc(root.dataset.currency) + "</span></div>" +
            size + desc + made +
            '<button type="button" class="ws-dish-add" data-cart-add="' + esc(String(item.id)) + '">' +
            '<i class="bi bi-bag-plus" aria-hidden="true"></i> ' + esc(root.dataset.add) + "</button>" +
            "</div></article>";
    }

    function show(items) {
        list.classList.remove("is-leaving");
        if (!items.length) {
            list.innerHTML = '<p class="ws-note">' + esc(root.dataset.empty) + "</p>";
            return;
        }
        list.innerHTML = items.map(card).join("");
    }

    function skeleton() {
        list.innerHTML = '<div class="ws-skel"></div><div class="ws-skel"></div><div class="ws-skel"></div>';
    }

    function load(sectionId) {
        var key = sectionId || "all";
        var mine = ++ticket;
        current = key;

        var render = function (items) {
            if (mine !== ticket) { return; }
            show(items);
        };

        list.classList.add("is-leaving");
        var wait = new Promise(function (resolve) { setTimeout(resolve, 170); });

        if (cache[key]) {
            wait.then(function () { render(cache[key]); });
            return;
        }

        var url = root.dataset.url + (sectionId ? "?sectionId=" + encodeURIComponent(sectionId) : "");
        var request = fetch(url, { headers: { "Accept": "application/json" }, credentials: "same-origin" })
            .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); });

        wait.then(function () { if (mine === ticket && !cache[key]) { skeleton(); list.classList.remove("is-leaving"); } });

        request.then(function (items) {
            cache[key] = items;
            return wait.then(function () { render(items); });
        }).catch(function () {
            if (mine !== ticket) { return; }
            list.classList.remove("is-leaving");
            list.innerHTML = '<p class="ws-note">' + esc(root.dataset.failed) + "</p>";
        });
    }

    function select(tab) {
        tabs.forEach(function (t) {
            var on = t === tab;
            t.classList.toggle("is-on", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
        });
        movePill(tab);
        if (tab.scrollIntoView) { tab.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" }); }
        load(tab.dataset.section);
    }

    tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
            if (tab.classList.contains("is-on") && current !== null) { return; }
            select(tab);
        });
    });

    window.addEventListener("resize", function () {
        movePill(root.querySelector(".ws-tab.is-on"));
    });

    var first = root.querySelector(".ws-tab.is-on");
    if (first) {
        (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(function () { movePill(first); });
        movePill(first);
    }
    load(first ? first.dataset.section : "");
})();

(function () {
    if (window.GLightbox) {
        GLightbox({ selector: ".glightbox" });
    }
})();
</script>
}
