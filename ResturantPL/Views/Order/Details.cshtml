@model OrderViewModel
@{
    Layout = null;
    var isPdf = ViewBag.IsPdf == true;
    var isArabic = LanguageHelper.IsArabic();
    var print = ViewBag.Print as ApplicationSettingViewModel;
    var copies = print?.NumberOfCustomerPrint ?? 1;
    var autoPrint = !isPdf && print != null && (print.PrintAfterOrder || (print.PrintForTakeawayOrder && Model.Type == OrderType.TakeAway));
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["Orders"] @Model.OrderCode</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, Arial, sans-serif; color: #111; font-size: 14px; margin: 0; padding: 16px; background: #f4f5f7; }
        .receipt { max-width: 420px; margin: 0 auto; background: #fff; padding: 18px 20px; border: 1px solid #ddd; }
        h1 { margin: 0 0 4px; font-size: 20px; text-align: center; }
        .meta { margin: 0 0 12px; text-align: center; color: #555; font-size: 12px; }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; margin: 0 0 12px; }
        dt { color: #555; }
        dd { margin: 0; text-align: end; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        th, td { padding: 4px 2px; border-bottom: 1px dashed #bbb; text-align: start; }
        td.num, th.num { text-align: end; }
        .sum div { display: flex; justify-content: space-between; padding: 2px 0; }
        .sum .grand { font-size: 18px; font-weight: 700; border-top: 2px solid #111; margin-top: 6px; padding-top: 6px; }
        .actions { max-width: 420px; margin: 12px auto 0; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
        .actions a, .actions button { padding: 8px 14px; border: 1px solid #112233; background: #112233; color: #fff; border-radius: 6px; text-decoration: none; cursor: pointer; font: inherit; }
        .actions a.alt { background: #fff; color: #112233; }
        @@media print { body { background: #fff; padding: 0; } .receipt { border: 0; } .actions { display: none; } }
    </style>
</head>
<body>
    <div class="receipt">
        <h1>@L["Orders"] #@Model.OrderCode</h1>
        <p class="meta">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm") - @L[Model.Type.ToString()]</p>

        <dl>
            <dt>@L["CustomerName"]</dt><dd>@Model.CustomerName</dd>
            <dt>@L["Seller"]</dt><dd>@Model.SellerName</dd>
            @if (!string.IsNullOrEmpty(Model.ReceiverName))
            {
                <dt>@L["Receiver"]</dt><dd>@Model.ReceiverName</dd>
            }
            @if (Model.Type == OrderType.Hall && Model.TableId != null)
            {
                <dt>@L["Table"]</dt><dd>@(isArabic ? Model.TableArName : Model.TableEnName)</dd>
            }
            @if (Model.Type is OrderType.Delivery or OrderType.Delivery_Online)
            {
                <dt>@L["DeliveryDriver"]</dt><dd>@Model.EmployeeName</dd>
                <dt>@L["Address"]</dt><dd>@Model.Address</dd>
                <dt>@L["PhoneNumber"]</dt><dd>@Model.PhoneNumber</dd>
                <dt>@L["MobileNumber"]</dt><dd>@Model.MobileNumber</dd>
            }
            <dt>@L["PaymentStatus"]</dt><dd>@L[Model.OnAccount ? "OnAccountStatus" : Model.Cash ? "PaidStatus" : "Unpaid"]</dd>
        </dl>

        <table>
            <thead>
                <tr><th>@L["Product"]</th><th class="num">@L["Quantity"]</th><th class="num">@L["Price"]</th><th class="num">@L["LineTotal"]</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@(isArabic ? item.MenuItemArName : item.MenuItemEnName)</td>
                        <td class="num">@item.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</td>
                        <td class="num">@item.PriceForUnit.ToString("N2")</td>
                        <td class="num">@item.Price.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="sum">
            <div><span>@L["SubTotal"]</span><span>@Model.SubTotal.ToString("N2")</span></div>
            @if (Model.Tax > 0)
            {
                <div><span>@L["Tax"]</span><span>@Model.Tax.ToString("N2")</span></div>
            }
            @if (Model.Service > 0)
            {
                <div><span>@L["Service"]</span><span>@Model.Service.ToString("N2")</span></div>
            }
            @if (Model.DeliveryFee > 0)
            {
                <div><span>@L["DeliveryFee"]@(string.IsNullOrEmpty(Model.DeliveryZoneArName) ? "" : " (" + (LanguageHelper.IsArabic() ? Model.DeliveryZoneArName : Model.DeliveryZoneEnName) + ")")</span><span>@Model.DeliveryFee.ToString("N2")</span></div>
            }
            @if (Model.Discount > 0)
            {
                <div><span>@L["Discount"]</span><span>-@Model.Discount.ToString("N2")</span></div>
            }
            @if (Model.Cash && Model.PaymentMethod.HasValue)
            {
                <div><span>@L["PaymentMethod"]</span><span>@L["Pay." + Model.PaymentMethod.Value]</span></div>
            }
            <div class="grand"><span>@L["TotalPrice"]</span><span>@Model.TotalPrice.ToString("N2")</span></div>
        </div>
    </div>

    @if (!isPdf)
    {
        <div class="actions">
            <button type="button" onclick="printCopies()">@L["Print"]</button>
            <a href="@Url.Action("Pdf", new { id = Model.Id })">PDF</a>
            <a class="alt" href="@Url.Action("Upsert")">@L["NewOrder"]</a>
            <a class="alt" href="@Url.Action("List", new { status = Model.Cash ? "shift" : "pending" })">@L["Back"]</a>
        </div>
        <script>
            function printCopies() {
                for (var i = 0; i < @copies; i++) { window.print(); }
            }
            @if (autoPrint)
            {
                <text>printCopies();</text>
            }
        </script>
    }
</body>
</html>
