@model IEnumerable<Scrounge>




<h1 class="text-center">جميع مصروفات الموظفين</h1>
<hr />

<p>
    <a asp-action="Create" asp-controller="Scrounge">اضافة مصروف لموظف</a>
</p>

<table class="table table-hover text-center table-bordered table-striped-columns table-dark">

    <thead>
        <tr>

            <td>المستخدم</td>
            <td>التاريخ</td>
            <td>الموظف</td>
            <td>حالة المبلغ</td>
            <td>المبلغ</td>
            <td>الوصف</td>
            <td></td>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User.FullName</td>
                <td>@item.Date</td>
                <td>@item.Employee.FullName</td>
                @if (item.State == @MoneyState.Incentive)
                {
                    <td>حافز</td>
                }
                else if (item.State == @MoneyState.Dept)
                {
                    <td>سلفة</td>
                }
                else
                {
                    <td>خصم</td>
                }


                <td>@item.Amount</td>
                <td>@item.Info</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">تفاصيل</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">تعديل</a> |
                    <a onclick="Delete('/Scrounge/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
<script src="~/modules/deleteobjects.js"></script>