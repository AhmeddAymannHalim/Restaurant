@model UnitPrice

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-center">اضافة وحدة جديدة</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            @*For Server Side Validation Data Annotation*@
            <div asp-validation-summary="ModelOnly" class="text-danger"> </div>

            <div class="form-group">
                <label asp-for="Name">اسم الوحدة</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" /> | 
                <a asp-action="Index">عودة للوحدات</a>
            </div>
        </form>

    </div>
</div>
</div>

<div>
</div>

@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}