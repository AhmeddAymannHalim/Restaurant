@model IEnumerable<Restaurant.Data.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<h1 class="text-center">الفواتير</h1>
<hr />
<div style="direction:rtl;" class="m-3">

    <p>
        <a asp-action="OpenInvoice">فتح فاتورة جديدة</a>
    </p>
    <table class="table table-hover text-center table-bordered table-striped-columns table-dark">
        <thead>
            <tr>

                <th>
                    كود الفاتورة
                </th>
                <th>
                    تاريخ الفاتورة
                </th>
                <th>
                    الخصم
                </th>
                <th>
                    الاجمالي بعد الخصم
                </th>
                <th>
                    المدفوع
                </th>
                <th>
                    المتبقي
                </th>
                <th>
                    نوع الفاتورة
                </th>
                <th>
                    نوع الدفع
                </th>
                <th>
                    المورد
                </th>
                <th>
                    المخزن
                </th>
                <th>
                    عدد المنتجات
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.InvoiceCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.InvoiceDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Discount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TotalPrice)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Paid)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Remaining)
                    </td>

                    @if (item.InvoiceType == InvoiceType.Purchases)
                    {
                        <td>مشتريات</td>
                    }
                    else
                    {
                        <td>مرتجعات</td>
                    }

                    @if (item.PayType == PayType.Cash)
                    {
                        <td>كاش </td>
                    }
                    else
                    {
                        <td>آجل</td>
                    }

                    <td>
                        @Html.DisplayFor(modelItem => item.Supplier.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Store.Name)
                    </td>
                    <td>
                        @item.InvoiceItems.Count()
                    </td>
                    <td>
                        @Html.ActionLink("التفاصيل", "DetailsInvoice", new { id = item.Id }) |
                        @Html.ActionLink("تعديل", "UpdateInvoice", new { id = item.Id }) |
                        <a onclick="Delete('/Invoice/Delete/@item.Id')" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div>
        <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
    </div>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
<script src="~/modules/deleteobjects.js"></script>