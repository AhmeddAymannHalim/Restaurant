@model Job

@{
    ViewData["Title"] = "AddEmployee";
}


<h1 class="text-center">اضافة وظيفة جديدة</h1>
<hr />

<p class="m-3">
    <a asp-action="Employees" > الوظائف</a>
</p>

<div class="row">
    <div class="col-md-4">
    <form asp-action="AddJob" >
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Code" class="control-label">كود الوظيفة</label>
                <input id="codeInput" name="Code" value="@ViewBag.Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>


        <div class="form-group">
            <label asp-for="Name" class="control-label">المسمي الوظيفي</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

      
        <div class="t mt-3">
            <input type="submit" value="اضافة" class="btn btn-success" /> |
            <a asp-action="Jobs">عودة للوظائف</a>
        </div>

    </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $.ajax({
                type: 'GET',
                url: '/Job/CheckExists',
                success: function (data) {
                    if (data.exists) {
                        $("#codeInput").prop("readonly", true);
                    }
                },
                error: function (xhr, status, error) {
                    console.error(error);
                }
            });
        });
    </script>

}
