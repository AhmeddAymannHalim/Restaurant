@model OrderViewModel
@{
    ViewBag.Title = L["MergeOrder"].Value;
    var isArabic = LanguageHelper.IsArabic();
    var tables = (IEnumerable<LookupItem>)ViewBag.Tables;
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-code-merge" aria-hidden="true"></i></span>
        <h1>@ViewBag.Title <small>@Model.OrderCode</small></h1>
    </div>
    <div class="bo-card-body">
        <form asp-action="Merge" method="post" class="bo-form">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label class="control-label" for="TargetTableId">@L["TargetTable"]</label>
                <select id="TargetTableId" name="TargetTableId" class="form-select" required>
                    <option value="">@L["Select"]</option>
                    @foreach (var table in tables)
                    {
                        <option value="@table.Id">@(isArabic ? table.ArName : table.EnName)</option>
                    }
                </select>
            </div>

            <div class="bo-full">
                <div class="bo-table-wrap">
                    <table class="bo-table">
                        <thead>
                            <tr><th>@L["Product"]</th><th>@L["Quantity"]</th><th>@L["Price"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@(isArabic ? item.MenuItemArName : item.MenuItemEnName)</td>
                                    <td class="num">@item.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</td>
                                    <td class="num">@item.Price.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bo-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-code-merge" aria-hidden="true"></i> @L["MergeOrder"]</button>
                <a asp-action="List" asp-route-status="pending" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            </div>
        </form>
    </div>
</div>
