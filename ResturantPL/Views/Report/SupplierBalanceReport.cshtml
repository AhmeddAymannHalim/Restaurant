@model SupplierTotalViewModel
@{
    ViewData["Title"] = "Tayar Orders by dates";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>

@* @{
    DateTime? firstDate = null; // Initialize with null to ensure it's assigned later
    DateTime? endDate = null;   // Initialize with null to ensure it's assigned later

    foreach (var item in Model.balances)
    {
        if (firstDate == null || item.Date < firstDate)
        {
            firstDate = item.Date.Date; // Assign the first order date
        }

        if (endDate == null || item.Date > endDate)
        {
            endDate = item.Date.Date; // Assign the last order date
        }
    }
}
 *@
<h1>تقرير كشف حساب المورد /  @Model.Name  </h1>
<h3>  بين تاريخين : @Model.FromDate.ToString("yyyy-MM-dd")  :   @Model.ToDate.ToString("yyyy-MM-dd") </h3>
<hr />

<p>تاريخ الطباعة : @Model.Date</p>

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>اسم المورد</th>
            <th>دائن</th>
            <th>مدين</th>
            <th>الرصيد</th>
            <th>التاريخ</th>
            <th>البيان</th>
        </tr>
    </thead>
    <tbody>


        @if (Model.balances.Count() > 0)
        {
            <tr>
                <td class="text-danger"><strong>الرصيد الافتتاحي</strong></td>
                <td>@Model.LastBalance</td>
                <td>0</td>
                <td>@Model.LastBalance</td>
                <td colspan="2"></td>
            </tr>
            <tr>
                <td class="text-danger"><strong>الحساب السابق</strong></td>
                <td>@Model.LastTotalDeptor</td>
                <td>@Model.LastTotalCreditor</td>
                <td>@Model.LastTotal</td>
                <td colspan="2"></td>
            </tr>
            foreach (var item in Model.balances)
            {
                <tr>
                    <td>@Model.Name</td>
                    <td>@item.Deptor</td>
                    <td>@item.Creditor</td>
                    <td>@item.Balance</td>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>@item.Info</td>
                </tr>
            }
          

            <tr>
                <td class="text-danger"><strong>الحساب الحالي</strong></td>
                <td>@Model.AllTotalDeptor</td>
                <td>@Model.AllTotalCreditor</td>
                <td>@Model.Balance</td>
                <td colspan="2"></td>
            </tr>
        }
        else
        {
            <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
        }

    </tbody>
</table>






