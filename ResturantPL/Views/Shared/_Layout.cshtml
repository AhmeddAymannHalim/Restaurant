@{
    var isArabicLayout = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(isArabicLayout ? "ar" : "en")" dir="@(isArabicLayout ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant</title>

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,700;1,700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <partial name="_CoreStyles" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/foodfun/css/animate-3.7.0.css" rel="stylesheet">
    <link href="~/assets/foodfun/css/font-awesome-4.7.0.min.css" rel="stylesheet">
    <link href="~/assets/foodfun/css/owl-carousel.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/website.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/intro-switch.js" asp-append-version="true"></script>
</head>
<body class="site-body">
    <partial name="_Z4Intro" />
    <div class="ff-preloader" aria-hidden="true"><div class="ff-spinner"></div></div>
    <partial name="_SiteNav" />

    <main role="main" class="m-3 pb-3 site-main">
        @RenderBody()
    </main>

    <partial name="_CartDrawer" />
    <partial name="_DishDetail" />
    <partial name="_CoreScripts" />
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/foodfun/js/wow.min.js"></script>
    <script src="~/assets/foodfun/js/owl-carousel.min.js"></script>
    <script src="~/js/dish-detail.js" asp-append-version="true"></script>
    <script src="~/js/site-effects.js" asp-append-version="true"></script>
    <script src="~/js/site-cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
