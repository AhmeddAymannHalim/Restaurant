                    <label asp-for="LateDeductionMultiplierOverride" class="control-label">@L["Emp.LateDeductionMultiplierOverride"]</label>
                    <input asp-for="LateDeductionMultiplierOverride" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="LateDeductionMultiplierOverride" class="text-danger"></span>
                </div>
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="FullDayEscalationEnabledOverride" type="checkbox" /> @L["Emp.FullDayEscalationEnabledOverride"]</label>
                </div>
                <div class="form-group">
                    <label asp-for="FullDayDeductionThresholdMinutesOverride" class="control-label">@L["Emp.FullDayDeductionThresholdMinutesOverride"]</label>
                    <input asp-for="FullDayDeductionThresholdMinutesOverride" type="number" min="0" class="form-control" />
                    <span asp-validation-for="FullDayDeductionThresholdMinutesOverride" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Overtime"]</h2>
                <div class="ad-section-grid">
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="OverrideOvertimeRule" type="checkbox" /> @L["Emp.OverrideOvertimeRule"]</label>
                </div>
                <div class="form-group">
                    <label asp-for="OvertimeRuleMinutesStartOverride" class="control-label">@L["Emp.OvertimeRuleMinutesStartOverride"]</label>
                    <input asp-for="OvertimeRuleMinutesStartOverride" type="number" min="0" class="form-control" />
                    <span asp-validation-for="OvertimeRuleMinutesStartOverride" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="OvertimeRuleMinutesOverride" class="control-label">@L["Emp.OvertimeRuleMinutesOverride"]</label>
                    <input asp-for="OvertimeRuleMinutesOverride" type="number" min="0" class="form-control" />
                    <span asp-validation-for="OvertimeRuleMinutesOverride" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="OvertimeRuleAmountOverride" class="control-label">@L["Emp.OvertimeRuleAmountOverride"]</label>
                    <input asp-for="OvertimeRuleAmountOverride" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="OvertimeRuleAmountOverride" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="OvertimeCalculationModeOverride" class="control-label">@L["Emp.OvertimeCalculationModeOverride"]</label>
                    <select asp-for="OvertimeCalculationModeOverride" asp-items="Html.GetLocalizedEnumSelectList<OvertimeCalculationMode>(L)" class="form-control">
                        <option value="">@L["Select"]</option>
                    </select>
                    <span asp-validation-for="OvertimeCalculationModeOverride" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="OvertimeMultiplierOverride" class="control-label">@L["Emp.OvertimeMultiplierOverride"]</label>
                    <input asp-for="OvertimeMultiplierOverride" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="OvertimeMultiplierOverride" class="text-danger"></span>
                </div>
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="OverrideWeeklyOffDays" type="checkbox" /> @L["Emp.OverrideWeeklyOffDays"]</label>
                </div>
                <div class="form-group ad-full">
                    <label class="control-label">@L["Emp.WeeklyOffDaysSelected"]</label>
                    <div class="ad-days">
                        @foreach (var day in Enum.GetValues<WeeklyOffDays>().Where(a => a != WeeklyOffDays.None))
                        {
                            <label><input type="checkbox" name="WeeklyOffDaysSelected" value="@((int)day)" checked="@Model.WeeklyOffDaysSelected.Contains(day)" /> @Html.EnumText(L, day)</label>
                        }
                    </div>
                </div>
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="OverrideOffDayOvertimeRule" type="checkbox" /> @L["Emp.OverrideOffDayOvertimeRule"]</label>
                </div>
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="OffDayAsOvertimeOverride" type="checkbox" /> @L["Emp.OffDayAsOvertimeOverride"]</label>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.EarlyLeave"]</h2>
                <div class="ad-section-grid">
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="OverrideEarlyLeaveRule" type="checkbox" /> @L["Emp.OverrideEarlyLeaveRule"]</label>
                </div>
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="EarlyLeaveDeductionEnabledOverride" type="checkbox" /> @L["Emp.EarlyLeaveDeductionEnabledOverride"]</label>
                </div>
                <div class="form-group">
                    <label asp-for="EarlyLeaveGraceMinutesOverride" class="control-label">@L["Emp.EarlyLeaveGraceMinutesOverride"]</label>
                    <input asp-for="EarlyLeaveGraceMinutesOverride" type="number" min="0" class="form-control" />
                    <span asp-validation-for="EarlyLeaveGraceMinutesOverride" class="text-danger"></span>
                </div>
                </div>
            </div>
            </div>
            <div class="tab-pane fade emp-pane" id="pane-Perks" role="tabpanel" aria-labelledby="tab-Perks" tabindex="0">

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Travel"]</h2>
                <div class="ad-section-grid">
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="HasTravelTicket" type="checkbox" /> @L["Emp.HasTravelTicket"]</label>
                </div>
                <div class="form-group">
                    <label asp-for="TicketType" class="control-label">@L["Emp.TicketType"]</label>
                    <select asp-for="TicketType" asp-items="Html.GetLocalizedEnumSelectList<TicketType>(L)" class="form-control">
                        <option value="">@L["Select"]</option>
                    </select>
                    <span asp-validation-for="TicketType" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Destination" class="control-label">@L["Emp.Destination"]</label>
                    <input asp-for="Destination" class="form-control" />
                    <span asp-validation-for="Destination" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TicketCount" class="control-label">@L["Emp.TicketCount"]</label>
                    <input asp-for="TicketCount" type="number" min="0" class="form-control" />
                    <span asp-validation-for="TicketCount" class="text-danger"></span>
                </div>
                </div>
            </div>

            <div class="ad-section ad-full">
                <h2 class="ad-section-title">@L["Emp.Section.Car"]</h2>
                <div class="ad-section-grid">
                <div class="form-group ad-check">
                    <label class="control-label"><input asp-for="HasCar" type="checkbox" /> @L["Emp.HasCar"]</label>
                </div>
                <div class="form-group">
                    <label asp-for="CarType" class="control-label">@L["Emp.CarType"]</label>
                    <input asp-for="CarType" class="form-control" />
                    <span asp-validation-for="CarType" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CarNumber" class="control-label">@L["Emp.CarNumber"]</label>
                    <input asp-for="CarNumber" class="form-control" />
                    <span asp-validation-for="CarNumber" class="text-danger"></span>
                </div>
                </div>
            </div>
            </div>
            </div>

            <div class="ad-form-actions">
                <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Save"]</button>
                <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Back"]</a>
            @if (!isNew)
            {
                <button type="button" onclick="Delete('/Employee/Delete/@Model.Id', '@Url.Action("Index")')" class="btn-ad btn-ad-danger push" ><i class="fas fa-trash" aria-hidden="true"></i> @L["Delete"]</button>
            }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/location-cascade.js" asp-append-version="true"></script>
    <script src="~/js/row-lists.js" asp-append-version="true"></script>
}
