@model IEnumerable<Scrounge>
@* @model ScroungeViewModel *@


@*<h3>Categories List</h3>*@
<div class="container">
    <h1>جميع</h1>
    <h4>الاستدانات</h4> 
    <hr />

        <div>
            <a class="btn btn-success" href="/Scrounge/Create">اضافة استدان</a>
        </div>
        <br />

        @* <table id="mytable" class="table table-hover" width="100%"> *@
        <table class="table table-hover text-center table-bordered table-striped-columns table-dark">

            <thead>
                <tr>

                    <td>المبلغ</td>
                    <td>التاريخ</td>
                    <td>الوصف</td>

                    <td>الموظف</td>
                    <td>حالة المبلغ</td>

                    <td>التوجيهات</td>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Amount</td>
                        <td>@item.CreatedTime</td>
                        <td>@item.Info</td>

                        <td>@item.EmployeeId</td>
                        <td>@item.StateId</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id">تفاصيل</a> |
                            <a asp-action="Edit" asp-route-id="@item.Id">تعديل</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
                        </td>
                    </tr>
                }
            </tbody>





        </table>
</div>

@* @section Scripts {
    <script src="~/js/Scrounge/scrounges.js">
    </script>
} *@
