@model IEnumerable<Scrounge>

@{
    ViewData["Title"] = "Imports by dates";
    Layout = null;
}




<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }

    h1, p, h3 {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }

    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>
@{
    DateTime? firstDate = null; // Initialize with null to ensure it's assigned later
    DateTime? endDate = null;   // Initialize with null to ensure it's assigned later

    foreach (var item in Model)
    {
        if (firstDate == null || item.Date < firstDate)
        {
            firstDate = item.Date.Date; // Assign the first order date
        }

        if (endDate == null || item.Date > endDate)
        {
            endDate = item.Date.Date; // Assign the last order date
        }
    }
}

<h1>تقرير مصروفات الموظفين بين تاريخين </h1>
<h3>@firstDate?.ToString("yyyy-MM-dd")  :   @endDate?.ToString("yyyy-MM-dd")</h3>
<hr />


<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>التاريخ</th>
            <th>الوصف</th>
            <th>الموظف</th>
            <th>اسم المستخدم</th>
            <th>نوع المبلغ</th>
            <th>المبلغ</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>@item.Info</td>
                    <td>@item.Employee.FullName</td>
                    <td>@item.User.FullName</td>
                    <td>@(item.State == MoneyState.Incentive ? "حافز" : item.State == MoneyState.Dept ? "سلفة" : "خصم")</td>
                    <td>@item.Amount</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan='6'>لا توجد نتائج للعرض</td></tr>
        }
    </tbody>
</table>






