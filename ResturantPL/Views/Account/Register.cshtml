@model RegisterViewModel
@{
    ViewData["Title"] = L["Auth_CreateAccount"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card wide">
    <h1 class="auth-title">@L["Auth_RegisterTitle"]</h1>
    <p class="auth-sub">@L["Auth_RegisterSub"]</p>

    <div class="auth-alert" asp-validation-summary="ModelOnly"></div>

    <form asp-action="Register" method="post" novalidate>
        <div class="row2">
            <div class="field">
                <input asp-for="FirstName" placeholder="@L["Auth_First"]" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="field">
                <input asp-for="LastName" placeholder="@L["Auth_Last"]" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>
        <div class="field">
            <input asp-for="Email" type="email" placeholder="@L["Auth_Email"]" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <input asp-for="Password" type="password" class="has-toggle" placeholder="@L["Auth_Password"]" autocomplete="new-password" />
            <button type="button" class="toggle-pass" data-show="@L["Auth_Show"]" data-hide="@L["Auth_Hide"]">@L["Auth_Show"]</button>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <button type="submit" class="btn-auth">@L["Auth_SignUp"]</button>
    </form>

    <hr class="divider" />
    <div class="auth-links"><p>@L["Auth_HaveAccount"] <a asp-action="SignIn">@L["Auth_SignIn"]</a></p></div>
</div>

@section ValidationScripts {
    <partial name="_ValidationScriptsPartial" />
}
