@model ImportsByDatesViewModel

@if (Model.Deposits.Count() > 0)
{
    foreach (var item in Model.Deposits)
    {
        <tr>
            <td>@item.ProcessCode </td>
            <td>@item.CreatedTime.ToString("yyyy-MM-dd")</td>
            <td>@item.DeposerName</td>
            <td>@item.User.FullName</td>
            <td>@item.Description</td>
            <td>@item.Amount</td>
            <td>
                @Html.ActionLink("التفاصيل", "Details", "Deposit", new { id = item.Id })
            </td>
        </tr>

    }
    <tr>
        <td class="text-danger"><strong>الاجمالي</strong> </td>
        <td colspan="6"><strong>@Model.Total</strong></td>
    </tr>
}
else
{
    <tr><td colspan='7'>لا توجد نتائج للعرض</td></tr>
}