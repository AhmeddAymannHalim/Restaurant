@model IList<ChefItem>
@{
    ViewData["Title"] = "Chefs";
}



<!-- ======= Chefs Section ======= -->
<section id="chefs" class="chefs">
    <div class="container mt-5" data-aos="fade-up">

        <div class="section-title">
           
            <p class="float-end">الطباخين المميزين فى المطعم</p>
            <br />
            <br />
            <a asp-action="ChefAdd" asp-controller="Home" class="btn-menu animated fadeInUp scrollto float-end m-5">إضافه طباخ</a>
        </div>
        <br />
        <br />
        <br />
        <br />
        <br />
        <div class="row">
            @foreach(var item in Model)
            {
                
                <div class="col-lg-4 col-md-6">
                    <div class="member" data-aos="zoom-in" data-aos-delay="100">
                        <img src="@item.ImageUrl" class="img-fluid" alt="image">
                        <div class="member-info">
                            <div class="member-info-content">
                                <h4 class="fs-1">@item.Name</h4>
                                <span class="fs-1">@item.Jop</span>
                            </div>
                       
                        </div>
                   
                    </div>
                    <div>
                        <a asp-action="ChefUpdate" asp-controller="Home" asp-route-id="@item.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">تعديل العنصر</a>
                    </div>
                    <div>
                        <a asp-action="ChefDelete" asp-controller="Home" asp-route-id="@item.Id" class="btn-menu animated fadeInUp scrollto float-end m-1">حذف العنصر</a>
                    </div>
                </div>
            }

        </div>

    </div>
</section><!-- End Chefs Section -->