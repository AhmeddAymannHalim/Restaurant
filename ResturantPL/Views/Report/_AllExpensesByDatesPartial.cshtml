@model IEnumerable<ExitExpense>

@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@item.Expense.Name</td>
            <td>@item.User.FullName</td>
            <td>@item.Price</td>
        </tr>
    }
}
else
{
    <tr><td colspan='4'>لا توجد نتائج للعرض</td></tr>
}