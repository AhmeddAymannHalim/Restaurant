@model Restaurant.Data.Models.PaymentInvoiceSupplier

@{
    ViewData["Title"] = "Supplier Invoice Edit";
}


<h1 class="text-center">تعديل سند الدفع </h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="SupplierInvoiceEdit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <input asp-for="Id" class="form-control" hidden />
                <input asp-for="SupplierId" class="form-control" hidden />
                <input asp-for="Date" class="form-control" hidden />
                <label class="control-label">اسم المورد</label>
                <input type="text" class="form-control" value="@Model.Supplier.Name" readonly />
            </div>
           



            <div class="form-group">
                <label asp-for="ProcessCode" class="control-label">كود العملية</label>
                <input asp-for="ProcessCode" class="form-control" readonly />
                <span asp-validation-for="ProcessCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">المطلوب دفعه</label>
                <input id="balance" value="@Model.Supplier.Balance" class="form-control" readonly />

            </div>



            <div class="form-group">
                <label asp-for="Paid" class="control-label">المدفوع</label>
                <input id="lastPaid" value="@Model.Paid" class="form-control" hidden />
                <input id="paid" asp-for="Paid" class="form-control" /> 
                @* <input id="currentPaid" name="Paid" class="form-control" hidden  /> *@
                <span asp-validation-for="Paid" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">المتبقي</label>
                <input id="remain" class="form-control" readonly />

            </div>



            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="تعديل السند" class="btn btn-primary" />
            </div>

            <div>
                <a asp-action="IndexSupplier">عودة للسندات</a> |
                <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>
        $(document).ready(function () {
            $('#paid').on('input', function () {
                var balance = $('#balance').val();
                var paid = $('#paid').val();
                var lastPaid = $('#lastPaid').val();
                var currentPaid = (paid - lastPaid);
                var remain = balance - (paid - lastPaid)
                $('#remain').val(remain.toFixed(2));
            });
        });
    </script>
   

}

