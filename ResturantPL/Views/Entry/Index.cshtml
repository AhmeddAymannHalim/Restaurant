@model PaginatedResult<EntryViewModel>
@{
    ViewBag.Title = L["Bill.Entries"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-book" aria-hidden="true"></i></span>
        <h1>@L["Bill.Entries"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["Bill.NewEntry"]</a>
    </div>
    <div class="bo-card-body">
        <form asp-action="Index" method="get" class="bo-filters">
            <div class="bo-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="Entry-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <select name="type" class="form-select w-auto" aria-label="@L["Bill.EntryType"]">
                <option value="">@L["Bill.AllEntries"]</option>
                <option value="JournalSales" selected="@(Model.Type == "JournalSales")">@L["Bill.EntryJournalSales"]</option>
                <option value="JournalPurchases" selected="@(Model.Type == "JournalPurchases")">@L["Bill.EntryJournalPurchases"]</option>
                <option value="ReturnJournalSales" selected="@(Model.Type == "ReturnJournalSales")">@L["Bill.EntryReturnJournalSales"]</option>
                <option value="ReturnJournalPurchases" selected="@(Model.Type == "ReturnJournalPurchases")">@L["Bill.EntryReturnJournalPurchases"]</option>
                <option value="CustomerPayment" selected="@(Model.Type == "CustomerPayment")">@L["Bill.EntryCustomerPayment"]</option>
                <option value="SupplierPayment" selected="@(Model.Type == "SupplierPayment")">@L["Bill.EntrySupplierPayment"]</option>
                <option value="CashPayment" selected="@(Model.Type == "CashPayment")">@L["Bill.EntryCashPayment"]</option>
                <option value="Journal" selected="@(Model.Type == "Journal")">@L["Bill.EntryJournal"]</option>
            </select>
            <input type="date" name="fromDate" class="form-control w-auto" value="@Model.FromDate?.ToString("yyyy-MM-dd")" aria-label="@L["From"]" title="@L["From"]" />
            <input type="date" name="toDate" class="form-control w-auto" value="@Model.ToDate?.ToString("yyyy-MM-dd")" aria-label="@L["To"]" title="@L["To"]" />
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="bo-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

        @await Html.PartialAsync("_TableExportToolbar", "Entry-table")
        <div class="bo-table-wrap">
            <table id="Entry-table" class="bo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Code"]</th>
                        <th>@L["InvoiceDate"]</th>
                        <th>@L["Bill.EntryType"]</th>
                        <th>@L["Bill.Bill"]</th>
                        <th>@L["LineTotal"]</th>
                        <th>@L["Bill.Remarks"]</th>
                        <th>@L["Bill.Entry"]</th>
                        <th data-export-ignore="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Data.Any())
                    {
                        var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@item.Code</td>
                                <td>@item.EntryDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(isArabic ? item.SettingArName : item.SettingEnName)</td>
                                <td>
                                    @if (item.BillId.HasValue)
                                    {
                                        <a asp-controller="Bill" asp-action="Details" asp-route-id="@item.BillId">@item.BillCode</a>
                                    }
                                </td>
                                <td class="num">@item.Total.ToString("N2")</td>
                                <td>@item.Remarks</td>
                                <td>@(item.IsPosted ? L["Bill.Posted"] : L["Bill.NotPosted"])</td>
                                <td class="bo-row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Details"]" aria-label="@L["Details"]"><i class="fas fa-eye" aria-hidden="true"></i></a>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="bo-empty">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
