@model Restaurant.Data.Models.SalaryType

@{
    ViewData["Title"] = "DeleteSalaryType";
}



<h1 class="text-center">حذف نوع راتب</h1>
<hr />

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>SalaryType</h4>
    <hr />
    <dl class="row">
       
        <dt class = "col-sm-2">
          نوع الراتب
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Type)
        </dd>
    </dl>
    
    <form asp-action="DeleteSalaryType">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">عودة لانواع الرواتب</a>
    </form>
</div>
