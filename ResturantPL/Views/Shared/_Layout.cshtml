@{
    var isArabicLayout = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(isArabicLayout ? "ar" : "en")" dir="@(isArabicLayout ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant</title>

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700" rel="stylesheet">

    <partial name="_CoreStyles" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/website.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-body">
    <partial name="_SiteNav" />

    <main role="main" class="m-3 pb-3">
        @RenderBody()
    </main>

    <partial name="_CartDrawer" />
    <partial name="_CoreScripts" />
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
