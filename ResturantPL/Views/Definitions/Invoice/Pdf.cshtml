@model InvoiceViewModel
@{
    Layout = null;
    var isArabic = LanguageHelper.IsArabic();
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <title>@L["Invoices"] @Model.InvoiceCode</title>
    <style>
        body { font-family: "Segoe UI", Tahoma, Arial, sans-serif; color: #111; font-size: 13px; margin: 24px; }
        h1 { margin: 0 0 4px; font-size: 22px; }
        .meta { display: table; width: 100%; margin: 14px 0 18px; border-collapse: collapse; }
        .meta div { display: table-cell; padding: 6px 10px; border: 1px solid #ccc; }
        .meta b { display: block; color: #555; font-weight: 600; font-size: 11px; }
        table.lines { width: 100%; border-collapse: collapse; }
        table.lines th, table.lines td { border: 1px solid #bbb; padding: 7px 9px; text-align: start; }
        table.lines th { background: #f1f1f1; }
        .num { text-align: end; font-variant-numeric: tabular-nums; }
        table.totals { width: 46%; margin-top: 16px; margin-inline-start: auto; border-collapse: collapse; }
        table.totals td { padding: 6px 9px; border-bottom: 1px solid #ddd; }
        table.totals tr:last-child td { font-weight: 700; border-bottom: 2px solid #111; }
    </style>
</head>
<body>
    <h1>@L[Model.InvoiceType.ToString()] - @Model.InvoiceCode</h1>

    <div class="meta">
        <div><b>@L["InvoiceDate"]</b>@Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</div>
        @if (Model.IsSupplierInvoice)
        {
            <div><b>@L["Supplier"]</b>@(isArabic ? Model.SupplierArName : Model.SupplierEnName)</div>
        }
        else
        {
            <div><b>@L["Customer"]</b>@(isArabic ? Model.CustomerArName : Model.CustomerEnName)</div>
        }
        <div><b>@L["Store"]</b>@(isArabic ? Model.StoreArName : Model.StoreEnName)</div>
        <div><b>@L["PayType"]</b>@L["Pay" + Model.PayType]</div>
    </div>

    <table class="lines">
        <thead>
            <tr>
                <th>#</th>
                <th>@L["Product"]</th>
                <th>@L["Unit"]</th>
                <th class="num">@L["Quantity"]</th>
                <th class="num">@L["Price"]</th>
                <th class="num">@L["LineTotal"]</th>
            </tr>
        </thead>
        <tbody>
            @{ var counter = 1; }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(counter++)</td>
                    <td>@item.ProductName</td>
                    <td>@item.UnitName</td>
                    <td class="num">@item.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</td>
                    <td class="num">@item.Price.ToString("N2")</td>
                    <td class="num">@item.Total.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <table class="totals">
        <tr><td>@L["SubTotal"]</td><td class="num">@Model.SubTotal.ToString("N2")</td></tr>
        <tr><td>@L["Discount"]</td><td class="num">@Model.Discount.ToString("N2")</td></tr>
        <tr><td>@L["NetTotal"]</td><td class="num">@Model.TotalPrice.ToString("N2")</td></tr>
        <tr><td>@L["Paid"]</td><td class="num">@Model.Paid.ToString("N2")</td></tr>
        <tr><td>@L["Remaining"]</td><td class="num">@Model.Remaining.ToString("N2")</td></tr>
    </table>
</body>
</html>
