@model AddAccountForEmployee
@{
    ViewData["Title"] = "AddAccount";
}

<h1 class="text-center"> تعديل حساب موظف</h1>
<hr />


<div>
    <form asp-action="UpdateAccount" class="row m-3" >
        <div asp-validation-summary="All" class="text-danger"></div>

            <input asp-for="Id" class="form-control" hidden/>
        <div class="form-group col-md-5">
            <label asp-for="UserName" class="control-label">اسم المستخدم</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="Email" class="control-label">الايميل</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group col-md-5">
            <label asp-for="Password" class="control-label">كلمة السر</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-group col-md-5">
            <label asp-for="ConfirmPassword" class="control-label">تأكيد كلمة السر</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="text-center mt-3">
            <input type="submit" value="تعديل" class="btn btn-success" />
            <a asp-action="Employees" asp-controller="Employee" class="btn btn-primary">عودة للموظفين</a>
        </div>


    </form>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

