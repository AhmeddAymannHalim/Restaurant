@model ShiftSummaryViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "_Layout1";
    var user = ViewBag.CurrentUser;
}

<div class="row m-4">
    <button type="button" class="btn btn-danger text-center col-md-12" style="font-size:24px;" data-bs-toggle="modal" data-bs-target="#myModal">انهاء الشيفت</button>
</div>

<div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">ادخل كلمة السر لانهاء الشيفت</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="passwordForm" asp-action="Logout" asp-controller="Shift" method="post">
                <div class="modal-body text-light">
                    <div class="mb-3">
                        <label for="User_Name" class="col-form-label text-start" style="text-align: left;">اسم المستخدم</label>
                        <input type="text" class="form-control" readonly value="@($"{user.FullName}")" id="User_Name">
                    </div>
                    <div class="mb-3">
                        <label for="modalPassword" class="col-form-label text-start" style="text-align: left;">الرقم السري</label>
                        <input class="form-control" id="modalPassword" name="password" type="password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">اغلاق</button>
                    <button type="submit" class="btn btn-primary">تأكيد</button>
                </div>
            </form>
        </div>
    </div>
</div>

<hr />




<form id="shiftSummaryForm" method="post" asp-action="EndShiftReport" asp-controller="Report">


    <div class="row m-3">
        <div id="hallSummary" class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">طلبات الصالة المكتملة</h5>
                    <input type="hidden" name="hallSummaryNumber" value="@ViewBag.HallsSummary.NumberOfOrder" />
                    <input type="hidden" name="hallSummaryTotal" value="@ViewBag.HallsSummary.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.HallsSummary.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.HallsSummary.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="deliverySummary" class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">طلبات الدليفري المكتملة</h5>
                    <input type="hidden" name="deliverySummaryNumber" value="@ViewBag.DeliverySummary.NumberOfOrder" />
                    <input type="hidden" name="deliverySummaryTotal" value="@ViewBag.DeliverySummary.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.DeliverySummary.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.DeliverySummary.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="deliveryOnlineSummary" class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">طلبات الدليفري الاونلاين المكتملة</h5>
                    <input type="hidden" name="deliveryOnlineSummaryNumber" value="@ViewBag.DeliveryOnlineSummary.NumberOfOrder" />
                    <input type="hidden" name="deliveryOnlineSummaryTotal" value="@ViewBag.DeliveryOnlineSummary.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.DeliveryOnlineSummary.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.DeliveryOnlineSummary.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="takeAwaySummary" class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">طلبات التيك اواي المكتملة</h5>
                    <input type="hidden" name="takeAwaySummaryNumber" value="@ViewBag.TakeAwaySummary.NumberOfOrder" />
                    <input type="hidden" name="takeAwaySummaryTotal" value="@ViewBag.TakeAwaySummary.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.TakeAwaySummary.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.TakeAwaySummary.TotalAmount</p>
                </div>
            </div>
        </div>
    </div>
    <hr />

    <div class="row m-3">
        <div id="pendingHall" class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">الصالة المعلقة</h5>
                    <input type="hidden" name="pendingHallNumber" value="@ViewBag.PendingHalls.NumberOfOrder" />
                    <input type="hidden" name="pendingHallTotal" value="@ViewBag.PendingHalls.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.PendingHalls.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.PendingHalls.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="pendingDelivery" class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">الدليفري المعلق</h5>
                    <input type="hidden" name="pendingDeliveryNmuber" value="@ViewBag.PendingDelivery.NumberOfOrder" />
                    <input type="hidden" name="pendingDeliveryTotal" value="@ViewBag.PendingDelivery.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.PendingDelivery.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.PendingDelivery.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="pendingDeliveryOnline" class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">الدليفري الاونلاين المعلق</h5>
                    <input type="hidden" name="pendingDeliveryOnlineNmuber" value="@ViewBag.PendingOnlineDelivery.NumberOfOrder" />
                    <input type="hidden" name="pendingDeliveryOnlineTotal" value="@ViewBag.PendingOnlineDelivery.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.PendingOnlineDelivery.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.PendingOnlineDelivery.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="totalPending" class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">اجمالي المعلق</h5>
                    <input type="hidden" name="totalPendingNumber" value="@ViewBag.TotalPending.NumberOfOrder" />
                    <input type="hidden" name="totalPendingTotal" value="@ViewBag.TotalPending.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.TotalPending.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.TotalPending.TotalAmount</p>
                </div>
            </div>
        </div>
    </div>

    <hr />




    <div class="row m-3">
        <div id="lastPendingHall" class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">الصالة المعلقة من الشيفت السابق</h5>
                    <input type="hidden" name="lastPendingHallNumber" value="@ViewBag.LastPendingHalls.NumberOfOrder" />
                    <input type="hidden" name="lastPendingHallTotal" value="@ViewBag.LastPendingHalls.TotalAmount" />
                    <p class="card-text">عدد الطلبات: @ViewBag.LastPendingHalls.NumberOfOrder</p>
                    <p class="card-text">الاجمالي: @ViewBag.LastPendingHalls.TotalAmount</p>
                </div>
            </div>
        </div>
        <div id="lastPendingDelivery" class="col-md-3">
