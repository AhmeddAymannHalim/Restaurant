@model IEnumerable<SuppliersTotalViewModel>

@if (Model.Count() > 0)
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.TotalDeptor</td>
            <td>@item.TotalCreditor</td>
            <td>@item.Total</td>
            @* <td>@item.Date.ToString("yyyy-MM-dd")</td> *@
            <td class="text-danger">@item.LastTotalDeptor</td>
            <td class="text-danger">@item.LastTotalCreditor</td>
            <td class="text-danger">@item.LastTotal</td>

        </tr>
    }

}
else
{
    <tr><td colspan='7'>لا توجد نتائج للعرض</td></tr>
}