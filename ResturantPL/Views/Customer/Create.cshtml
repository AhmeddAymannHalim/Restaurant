@model Customer

@{
    ViewData["Title"] = "Create";
}



<h1 class="text-center">اضافة عميل جديد</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            @*For Server Side Validation Data Annotation*@
            <div asp-validation-summary="ModelOnly" class="text-danger"> </div>

            <div class="form-group">
                <label asp-for="Name">اسم العميل</label>
                <input asp-for="Name" class="form-control" required autofocus />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address">عنوان العميل</label>
                <input asp-for="Address" class="form-control" required />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MobileNumber">رقم الموبايل</label>
                <input asp-for="MobileNumber" id="mobileNumber" class="form-control" minlength="11" maxlength="11" required />
                <span asp-validation-for="MobileNumber" class="text-danger"></span>
                <span id="mobileNumberError" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">رقم الهاتف</label>
                <input asp-for="PhoneNumber" id="phoneNumber" class="form-control" maxlength="11" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                <span id="phoneNumberError" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Balance">الرصيد</label>
                <input asp-for="Balance" class="form-control" type="number" value="0" />
                @*For Server Side Validation Data Annotation*@
                <span asp-validation-for="Balance" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" /> |
                <a asp-action="Index">عودة للعملاء</a>
            </div>
        </form>

    </div>
</div>



@*For Client Side Validation Data Annotation - js libraries*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#phoneNumber, #mobileNumber').on('input', function () {
                var phoneNumber = $('#phoneNumber').val();
                var mobileNumber = $('#mobileNumber').val();

                if (phoneNumber !== '' && mobileNumber !== '' && phoneNumber === mobileNumber) {
                    $('#phoneNumber, #mobileNumber').addClass('input-validation-error');
                    $('#phoneNumberError').text('رقم الموبايل و رقم الهاتف لا يجب ان يكونا نفس الرقم');
                    $('#mobileNumberError').text('رقم الهاتف و رقم الموبايل لا يجب ان يكونا نفس الرقم');
                } else {
                    $('#phoneNumber, #mobileNumber').removeClass('input-validation-error');
                    $('#phoneNumberError').text('');
                    $('#mobileNumberError').text('');
                }
            });
        });
    </script>



}
