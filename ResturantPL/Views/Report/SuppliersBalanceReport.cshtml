@model SupliersByDatesViewModel
@{
    ViewData["Title"] = "Tayar Orders by dates";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>



<h1>تقرير كشف حساب الموردرين  </h1>
<h3>  بين تاريخين : @Model.FromDate.ToString("yyyy-MM-dd")  :   @Model.ToDate.ToString("yyyy-MM-dd") </h3>
<hr />

<p>تاريخ الطباعة : @Model.PrintDate</p>

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>اسم المورد</th>
            <th>اجمالي الدائن</th>
            <th>اجمالي المدين</th>
            <th>الاجمالي الحالي</th>
            <th>الرصيد الافتتاحي</th>
            <th>الدائن السابق</th>
            <th>المدين السابق</th>
            <th>الاجمالي السابق</th>
            <th>الاجمالي الكلي</th>
        </tr>
    </thead>
    <tbody>


        @if (Model.Suppliers.Count() > 0)
        {
            foreach (var item in Model.Suppliers)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.TotalDeptor</td>
                    <td>@item.TotalCreditor</td>
                    <td>@item.Total</td>
                    <td>@item.LastBalance</td>
                    <td>@item.LastTotalDeptor</td>
                    <td>@item.LastTotalCreditor</td>
                    <td>@item.LastTotal</td>
                    <td><strong>@item.AllTotal</strong></td>

                </tr>
            }
            <tr>
                <td class="text-danger"><strong>اجمالي أرصدة الموردرين</strong> </td>
                <td colspan="8"><strong>@Model.Total</strong></td>
            </tr>

        }
        else
        {
            <tr><td colspan='9'>لا توجد نتائج للعرض</td></tr>
        }

    </tbody>
</table>






