@model IEnumerable<Restaurant.Data.Models.Order>

@{
    ViewData["Title"] = "Hall Orders";
    Layout = "_Layout1";
}

<h1 class="text-center">طلبات الصالة</h1>

<p>
    <a asp-action="Create">طلب جديد</a>
</p>
<table class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
                كود الطلب
            </th>
            <th>
                 الخدمة
            </th>
            <th>
                الضريبة
            </th>
            <th>
                الخصم
            </th>
            <th>
                التار يخ
            </th>
            <th>
                موظف الشيفت
            </th>
            <th>
                اسم العميل
            </th>
            <th>
                اسم الطاولة
            </th>
            <th>
                الاجمالي
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Service)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tax)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Discount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)
                </td>
                <td>
                    @item.Seller.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>
                <td>
                    @item.Table.Name
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalPrice)
                </td>
                <td>
                    @Html.ActionLink("التفاصيل", "Details", new { id = item.Id })
                 
                </td>
            </tr>
        }
    </tbody>
</table>
