@model ChangePasswordViewModel
@{
    ViewData["Title"] = L["ChangePassword"].Value;
    Layout = "~/Views/Shared/_AuthenticationLayout.cshtml";
}

<div class="auth-card">
    <h1 class="auth-title">@L["ChangePassword"]</h1>
    <p class="auth-sub">@L["Auth_ChangePasswordSub"]</p>

    @if (TempData["PasswordChanged"] is true)
    {
        <div class="auth-ok" role="status">@L["Auth_PasswordChanged"]</div>
    }
    <div class="auth-alert" asp-validation-summary="ModelOnly"></div>

    <form asp-action="ChangePassword" method="post" novalidate>
        <div class="field">
            <input asp-for="CurrentPassword" type="password" class="has-toggle" placeholder="@L["Auth_CurrentPassword"]" autocomplete="current-password" />
            <button type="button" class="toggle-pass" data-show="@L["Auth_Show"]" data-hide="@L["Auth_Hide"]">@L["Auth_Show"]</button>
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="field">
            <input asp-for="NewPassword" type="password" placeholder="@L["Auth_NewPasswordLabel"]" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <input asp-for="ConfirmPassword" type="password" placeholder="@L["Auth_ConfirmPassword"]" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn-auth">@L["Auth_Save"]</button>
    </form>

    <hr class="divider" />
    <div class="auth-links"><p><a asp-controller="Dashboard" asp-action="Index">@L["Back"]</a></p></div>
</div>

@section ValidationScripts {
    <partial name="_ValidationScriptsPartial" />
}
