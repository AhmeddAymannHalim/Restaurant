@model Restaurant.DAL.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details (PDF)";
    Layout = null; // Prevent layout inheritance from the main view
}

<style>
    /* Define styles for the page content */
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #111;
    }

    .container {
        max-width: 576px; /* Set the maximum width to fit within the paper size */
        margin: 0 auto; /* Center the content horizontally */
        background-color: #fff; /* White background for better readability */
        padding: 20px; /* Add padding for spacing */
        color: black;
    }

    h1 {
        text-align: center;
    }

    dl {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    dt, dd {
        width: 45%; /* Set width for better alignment */
        padding: 10px;
        margin-bottom: 10px;
        border: 1px solid #ccc; /* Add border for styling */
        box-sizing: border-box;
    }

    dt {
        background-color: #f2f2f2; /* Light gray background for dt elements */
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

    th {
        background-color: #f2f2f2; /* Light gray background for table header */
    }
</style>

<h1>مطعم الاكلات الشهية يرحب بكم</h1>

<div class="container">

    @if (Model.InvoiceType == InvoiceType.Purchases)
    {
        <h1> فاتورة مشتريات</h1>
    }
    else
    {
        <h1>فاتورة مرتجعات</h1>
    }
    <hr />


    <dl>

        <dt class="col-sm-3">
            كود الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.InvoiceCode)
        </dd>
        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.InvoiceDate)
        </dd>
        <dt class="col-sm-3">
            الخصم
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Discount)
        </dd>
        <dt class="col-sm-3">
            الاجمالي بعد الخصم
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TotalPrice)
        </dd>
        <dt class="col-sm-3">
            المدفوع
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Paid)
        </dd>
        <dt class="col-sm-3">
            المتبقي
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Remaining)
        </dd>

        <dt class="col-sm-3">
            نوع الدفع
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.PayType)
        </dd>
        <dt class="col-sm-3">
            المورد
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Supplier.ArName)
        </dd>
        <dt class="col-sm-3">
            المخزن
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Store.ArName)
        </dd>
        <dt class="col-sm-3">
            المنتجات
        </dt>
        <dd class="col-sm-8">
            @* <table class="table table-hover text-center table-bordered table-striped-columns table-dark"> *@
            <table class="mt-3 table table-bordered table-light text-dark">
                <tr>
                    <th>اسم المنتج</th>
                    <th>الوحدة</th>
                    <th>الكمية</th>
                    <th>السعر</th>
                    <th>الاجمالي</th>

                </tr>
                @foreach (var item in Model.InvoiceItems)
                {
                    <tr>
                        <td>@item.StoreProduct.ProductName</td>
                        <td>@item.UnitPrice.ArName</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price</td>
                        <td>@item.Total</td>
                    </tr>
                }
            </table>
        </dd>

    </dl>

    <div>
       شكرا لتعاملكم معنا و نسعي دائما لخدمتكم
    </div>

</div>


