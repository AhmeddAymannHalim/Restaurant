@model PaginatedResult<BillListItemViewModel>
@{
    ViewBag.Title = L["Bill.Bills"].Value;
    bool isArabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var pending = Model.Data.Count(a => a.CanPost);
}

<div class="bo-card">
    <div class="bo-card-head">
        <span class="bo-icon"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i></span>
        <h1>@L["Bill.Bills"]</h1>
        <a asp-action="Upsert" class="btn-ad btn-ad-primary"><i class="fas fa-plus" aria-hidden="true"></i> @L["NewInvoice"]</a>
        <button type="button" id="postPending" class="btn-ad btn-ad-post"><i class="fas fa-check-double" aria-hidden="true"></i> @L["Bill.PostPending"]</button>
    </div>
    <div class="bo-card-body">
        <form asp-action="Index" method="get" class="bo-filters">
            <div class="bo-search">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="Bill-search" type="search" class="form-control" name="searchString" value="@Model.SearchString" placeholder="@L["SearchHere"]" />
            </div>
            <select name="type" class="form-select w-auto" aria-label="@L["Bill.BillType"]">
                <option value="">@L["AllTypes"]</option>
                <option value="ORD" selected="@(Model.Type == "ORD")">@L["Bill.Cashier"]</option>
                <option value="SAL" selected="@(Model.Type == "SAL")">@L["Sales"]</option>
                <option value="SRET" selected="@(Model.Type == "SRET")">@L["SalesReturn"]</option>
                <option value="PUR" selected="@(Model.Type == "PUR")">@L["Purchases"]</option>
                <option value="PRET" selected="@(Model.Type == "PRET")">@L["Returns"]</option>
                <option value="SHRT" selected="@(Model.Type == "SHRT")">@L["Shortage"]</option>
                <option value="SRPL" selected="@(Model.Type == "SRPL")">@L["Surplus"]</option>
                <option value="OPEN" selected="@(Model.Type == "OPEN")">@L["OpeningInventory"]</option>
            </select>
            <label class="bo-check"><input type="checkbox" name="unpaidOnly" value="true" checked="@Model.UnpaidOnly" /> @L["UnpaidInvoices"]</label>
            <input type="date" name="fromDate" class="form-control w-auto" value="@Model.FromDate?.ToString("yyyy-MM-dd")" aria-label="@L["From"]" title="@L["From"]" />
            <input type="date" name="toDate" class="form-control w-auto" value="@Model.ToDate?.ToString("yyyy-MM-dd")" aria-label="@L["To"]" title="@L["To"]" />
            <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> @L["Search"]</button>
            <span class="bo-meta">@L["TotalRecords"]: @Model.TotalRecords</span>
        </form>

        @await Html.PartialAsync("_TableExportToolbar", "Bill-table")
        <div class="bo-table-wrap">
            <table id="Bill-table" class="bo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["InvoiceCode"]</th>
                        <th>@L["InvoiceDate"]</th>
                        <th>@L["Bill.BillType"]</th>
                        <th>@L["Partner"]</th>
                        <th>@L["NetTotal"]</th>
                        <th>@L["Paid"]</th>
                        <th>@L["Remaining"]</th>
                        <th>@L["Bill.Entry"]</th>
                        <th data-export-ignore="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Data.Any())
                    {
                        var counter = ((Model.PageNo - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@item.Code</td>
                                <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(isArabic ? item.SettingArName : item.SettingEnName)</td>
                                <td>@(isArabic ? item.PartnerArName : item.PartnerEnName)</td>
                                <td class="num">@item.Total.ToString("N2")</td>
                                <td class="num">@item.Paid.ToString("N2")</td>
                                <td class="num">@item.Remaining.ToString("N2")</td>
                                <td>@(item.IsEntryPosted ? L["Bill.Posted"] : L["Bill.NotPosted"])</td>
                                <td class="bo-row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Details"]" aria-label="@L["Details"]"><i class="fas fa-eye" aria-hidden="true"></i></a>
                                    @if (item.IsEditable)
                                    {
                                        <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-ad btn-ad-ghost btn-icon" title="@L["Edit"]" aria-label="@L["Edit"]"><i class="fas fa-pen" aria-hidden="true"></i></a>
                                        <a asp-action="Pdf" asp-route-id="@item.Id" data-no-loader class="btn-ad btn-ad-ghost btn-icon" title="@L["Print"]" aria-label="@L["Print"]"><i class="fas fa-print" aria-hidden="true"></i></a>
                                        <button type="button" onclick="Delete('/Bill/Delete/@item.Id')" class="btn-ad btn-ad-danger btn-icon" title="@L["Delete"]" aria-label="@L["Delete"]"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                    }
                                    @if (item.CanPost)
                                    {
                                        <button type="button" data-post="@item.Id" class="btn-ad btn-ad-post btn-sm-label" title="@L["Bill.Post"]" aria-label="@L["Bill.Post"]"><i class="fas fa-check" aria-hidden="true"></i> @L["Bill.Post"]</button>
                                    }
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="bo-empty">@L["NoData"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="app-table-pagination">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function send(url, data) {
                $.post(url, data).done(function (result) {
                    if (result && result.success) {
                        toastr.success(@Html.Raw(Json.Serialize(L["Bill.PostedDone"].Value)));
                        location.reload();
                    } else {
                        toastr.error((result && result.errorMessage) || @Html.Raw(Json.Serialize(L["SomethingWentError"].Value)));
                    }
                }).fail(function () {
                    toastr.error(@Html.Raw(Json.Serialize(L["SomethingWentError"].Value)));
                });
            }

            $('[data-post]').on('click', function () { send('/Bill/Post', { id: $(this).data('post') }); });
            $('#postPending').on('click', function () { send('/Bill/PostPending', {}); });
        });
    </script>
}
