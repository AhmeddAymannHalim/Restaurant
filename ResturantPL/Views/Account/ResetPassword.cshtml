@model ResetPasswordViewModel
@{
    ViewData["Title"] = L["Auth_NewPassTitle"].Value;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <h1 class="auth-title">@L["Auth_NewPassTitle"]</h1>
    <p class="auth-sub">@L["Auth_NewPassSub"]</p>

    <div class="auth-alert" asp-validation-summary="ModelOnly"></div>

    <form asp-action="ResetPassword" method="post" novalidate>
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div class="field">
            <input asp-for="Password" type="password" class="has-toggle" placeholder="@L["Auth_NewPass"]" autocomplete="new-password" />
            <button type="button" class="toggle-pass" data-show="@L["Auth_Show"]" data-hide="@L["Auth_Hide"]">@L["Auth_Show"]</button>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <input asp-for="ConfirmPassword" type="password" placeholder="@L["Auth_ConfirmPassword"]" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn-auth">@L["Auth_SavePass"]</button>
    </form>
</div>

@section ValidationScripts {
    <partial name="_ValidationScriptsPartial" />
}
