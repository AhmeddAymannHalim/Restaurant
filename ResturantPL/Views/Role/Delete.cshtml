@model RoleViewModel
@{
    ViewData["Title"] = "Delete";

}



<h1 class="text-center">حذف فئة</h1>
<hr />

<h1 class="text-danger">هل انت متأكد من حذف هذه الفئة ؟</h1>


<div>

    <dl class="row">
        <dt class="col-sm-2">
            اسم الفئة
        </dt>
        <dd class="col-sm-10">
            @Model.RoleName
        </dd>
    </dl>

    <form asp-action="Delete">
   
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Roles">عودة للفئات</a>
    </form>

</div>

