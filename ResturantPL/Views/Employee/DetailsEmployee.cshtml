@model Employee

@{
    ViewData["Title"] = "DetailsEmployee";
}

<h1 class="text-center">تفاصيل موظف </h1>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            كود
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Code)
        </dd>
        <dt class = "col-sm-2">
           الاسم
        </dt>
        <dd class = "col-sm-9">
            @Model.FirstName @Model.LastName
        </dd>
       
        <dt class = "col-sm-2">
            الهاتف
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
        <dt class = "col-sm-2">
           الموبايل
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.MobileNumber)
        </dd>
       
        <dt class = "col-sm-2">
            العنوان
        </dt>
        <dd class = "col-sm-9">
            @Model.Country @Model.City @Model.Street
        </dd>
        
        <dt class = "col-sm-2">
           السن
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.Age)
        </dd>
       
        <dt class = "col-sm-2">
           الرقم القومي
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.NationalID)
        </dd>
      
        <dt class = "col-sm-2">
           نوع الراتب
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.SalaryType.Type)
        </dd>
        <dt class="col-sm-2">
             الراتب
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Salary)
        </dd>
        <dt class="col-sm-2">
            الوظيفة
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Job.Name)
        </dd>
        <dt class = "col-sm-2">
           الصورة
        </dt>
        <dd class = "col-sm-9">
            @if (Model.Image != null)
            {
                <img src="@Model.Image" alt="image" class="rounded-circle m-3" width="200" />
            }
            else
            {
                <img src="~/Employee Images/User_Image.png" class="rounded-circle img-thumbnail" width="200" />
            }
        </dd>
    </dl>
</div>
<div>
    @Html.ActionLink("تعديل", "UpdateEmployee", new { id = Model.EmployeeId }) |
    <a asp-action="Employees">عودة للموظفين</a>
</div>
