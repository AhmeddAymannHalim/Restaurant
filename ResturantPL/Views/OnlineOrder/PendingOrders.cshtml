@model IEnumerable<PendingOnlineOrderViewModel>
@{
    ViewData["Title"] = L["MyOrders"].Value;
    var isArabic = LanguageHelper.IsArabic();
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">
    <section class="ws-page">
        <div class="ws-wrap">
            <header class="ws-page-head">
                <h1>@L["MyOrders"]</h1>
            </header>

            @if (!Model.Any())
            {
                <p class="ws-empty">
                    @L["NoData"]<br />
                    <a class="ws-link" asp-action="Menu">@L["ContinueShopping"]</a>
                </p>
            }
            else
            {
                <div class="ws-orders">
                    @foreach (var item in Model)
                    {
                        <article class="ws-order @(item.Status switch { OnlineOrderStatus.Pending => "is-waiting", OnlineOrderStatus.Rejected => "is-rejected", _ => "is-accepted" })">
                            <div class="ws-order-main">
                                <h2>#@item.Id</h2>
                                <time datetime="@item.OrderDate.ToString("s")">@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</time>
                            </div>

                            <div class="ws-order-where">
                                <i class="bi @(item.TableId.HasValue ? "bi-cup-hot" : "bi-geo-alt")" aria-hidden="true"></i>
                                <span>@(item.TableId.HasValue ? (isArabic ? item.TableArName : item.TableEnName) : item.Address)</span>
                            </div>

                            <span class="ws-status">@L[item.Status switch { OnlineOrderStatus.Pending => "StatusWaiting", OnlineOrderStatus.Rejected => "StatusRejected", _ => "StatusAccepted" }]</span>

                            <div class="ws-order-total">@item.TotalPrice.ToString("N2") <small>@L["Currency"]</small></div>

                            <div class="ws-order-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="ws-btn ws-btn-ghost">@L["Details"]</a>
                                @if (item.IsPending)
                                {
                                    <button type="button" class="ws-btn ws-btn-danger" onclick="Delete('/OnlineOrder/Delete/@item.Id')">@L["Delete"]</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <partial name="_DeleteText" />
    <script src="~/modules/DeleteObjects.js"></script>
    @if (TempData["OrderPlaced"] != null)
    {
        <script>
            siteCart.clear();
        </script>
    }
}
