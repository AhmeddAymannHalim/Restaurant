@model IEnumerable<Branche>

@{
    ViewData["Title"] = "Index";
}



<h1 class="text-center">الفروع</h1>
<hr />



<p>
    <a asp-action="AddBranch">اضافة فرع جديد</a>
</p>

<table class="table table-hover text-center table-bordered table-striped-columns table-dark">

    <thead>
        <tr>
            <th>
               الاسم
            </th>
            <th>
                العنوان
            </th>
            <th>
               الكود
            </th>
            <th>
                رقم الهاتف
            </th>
            <th>
                رقم الهاتف 2
            </th>
            <th>
               رقم الموبايل
            </th>
            <th>
                رقم الموبايل 2
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Code)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone2)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Mobile1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Mobile2)
                </td>
                <td>
                    @Html.ActionLink("تعديل", "UpdateBranch", new { id = item.Id }) |
                    @Html.ActionLink("تفاصيل", "Details", new { id = item.Id }) |
                    <a onclick="Delete(@item.Id)" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>




<script src="~/lib/sweetalert/sweetalert.min.js"></script>
@if (TempData["success"] != null)
{
    <script>
        swal("برافو عمل جيد !", "", "success");

    </script>
}
@if (TempData["faild"] != null)
{
    <script>
        swal("فشلت العملية !", "", "error");

    </script>

}
@section Scripts {

    <script src="~/modules/Branch.js"></script>
}