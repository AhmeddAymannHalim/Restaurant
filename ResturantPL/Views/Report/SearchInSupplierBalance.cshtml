@{
    ViewData["Title"] = "Search By Dates";
            // Layout = "_Layout1";
}


<div class="container">
    <div class="row">

        <div class="form-group mb-4 col-md-3">
            <label for="supplierId">الموردين</label>
            <select id="supplierId" class="form-control" asp-items="@ViewBag.Suppliers" required>
                <option value="">اختر المورد</option>
            </select>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <label for="startDate">تاريخ البداية:</label>
                <input type="date" id="startDate" name="startDate" value="@ViewBag.DateNow" class="form-control" required />
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <label for="endDate">تاريخ النهاية:</label>
                <input type="date" id="endDate" name="endDate" value="@ViewBag.DateNow" class="form-control" required />
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <button id="show" type="button" class="btn btn-primary mt-4" style="width:100%;">كشف حساب</button>
            </div>
        </div>
    </div>
</div>
<hr />


<h1 class="text-center">كشف الحساب الكلي</h1>
<hr />

<table id="supplierTable" class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>اسم المورد</th>
            <th>مدين</th>
            <th>دائن</th>
            <th>التاريخ</th>
            <th>البيان</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<br />

<a id="report" class="btn btn-primary"> تصدير الي PDF</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#show").click(function () {
                var supplierId = $("#supplierId").val();
                var startDate = $("#startDate").val();
                var endDate = $("#endDate").val();

                $.ajax({
                    type: "GET",
                    url: "/Report/AllSupplierBalanceByDates",
                    data: {
                        supplierId: supplierId,
                        startDate: startDate,
                        endDate: endDate
                    },

                    success: function (result) {
                        $("#supplierTable tbody").empty();
                        $("#supplierTable tbody").append(result);
                        $("#report").attr("href", `/Report/SupplierBalanceReport?supplierId=${supplierId}&startDate=${startDate}&endDate=${endDate}`);
                        $("#report").show();
                    },

                    error: function (xhr, status, error) {
                        $("#supplierTable tbody").empty();
                        $("#supplierTable tbody").append("<tr><td colspan='6'>حدث خطأ أثناء جلب البيانات</td></tr>");
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#employeeId, #startDate, #endDate').change(function () {
                $("#supplierTable tbody").empty();
                $("#report").attr("href", `#`);
            });
        });
    </script>
}



