@model IEnumerable<OnlineMenuItemViewModel>
@{
    ViewData["Title"] = L["OurMenu"].Value;
    var isArabic = LanguageHelper.IsArabic();

    string SectionName(OnlineMenuItemViewModel item)
    {
        return isArabic ? item.SectionArName : item.SectionEnName;
    }

    string Name(OnlineMenuItemViewModel item)
    {
        return isArabic ? item.ArName : item.EnName;
    }

    string Description(OnlineMenuItemViewModel item)
    {
        return isArabic
            ? (string.IsNullOrWhiteSpace(item.ArDescription) ? item.EnDescription : item.ArDescription)
            : (string.IsNullOrWhiteSpace(item.EnDescription) ? item.ArDescription : item.EnDescription);
    }

    string Ingredients(OnlineMenuItemViewModel item)
    {
        return isArabic
            ? (string.IsNullOrWhiteSpace(item.ArIngredients) ? item.EnIngredients : item.ArIngredients)
            : (string.IsNullOrWhiteSpace(item.EnIngredients) ? item.ArIngredients : item.EnIngredients);
    }

    string SizeName(OnlineMenuItemViewModel item)
    {
        return item.Size.HasValue ? L["Size." + item.Size.Value].Value : L["Size.regular"].Value;
    }

    var sections = Model
        .GroupBy(a => a.SectionArName)
        .Select(g => g.First())
        .ToList();
}

<div class="ws" dir="@(isArabic ? "rtl" : "ltr")">
    <section class="ws-page">
        <div class="ws-wrap">
            <header class="ws-page-head">
                <h1>@L["OurMenu"]</h1>
            </header>

            @if (sections.Count > 1)
            {
                <div class="ws-tabs-wrap">
                    <div class="ws-tabs" role="tablist" aria-label="@L["OurMenu"]">
                        <span class="ws-tab-pill" aria-hidden="true"></span>
                        <button type="button" class="ws-tab is-on" role="tab" aria-selected="true" data-section="">@L["AllCategories"]</button>
                        @foreach (var sec in sections)
                        {
                            <button type="button" class="ws-tab" role="tab" aria-selected="false" data-section="@sec.SectionArName">@SectionName(sec)</button>
                        }
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <p class="ws-empty">@L["NoMenuItems"]</p>
            }

            <div class="ws-dishes">
                @{ var dishIndex = 0; }
                @foreach (var group in Model.GroupBy(a => a.ArName))
                {
                    var first = group.First();
                    var sizes = group.ToList();

                    var detail = Json.Serialize(new
                    {
                        name = Name(first),
                        description = Description(first) ?? "",
                        ingredients = Ingredients(first) ?? "",
                        image = first.ImageUrl ?? "",
                        sizes = sizes.Select(x => new { id = x.Id, label = sizes.Count > 1 ? SizeName(x) : "", price = x.Price })
                    }).ToString();

                    <article class="ws-dish" tabindex="0" data-detail="@detail" data-section="@first.SectionArName" style="--i:@(dishIndex++)">
                        <div class="ws-dish-img">
                            @if (!string.IsNullOrWhiteSpace(first.ImageUrl))
                            {
                                <img src="@first.ImageUrl" alt="@Name(first)" loading="lazy" />
                            }
                        </div>
                        <div class="ws-dish-body">
                            <div class="ws-dish-head">
                                <h3 class="ws-dish-name">@Name(first)</h3>
                                <span class="ws-dish-price">@first.Price.ToString("N2") @L["Currency"]</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Description(first)))
                            {
                                <p class="ws-dish-desc">@Description(first)</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(Ingredients(first)))
                            {
                                <p class="ws-dish-desc ws-dish-made">@L["MadeOf"] @Ingredients(first)</p>
                            }

                            @if (sizes.Count > 1)
                            {
                                <select class="dish-size form-select form-select-sm w-auto mt-2" aria-label="@L["Size"]">
                                    @foreach (var item in sizes)
                                    {
                                        <option value="@item.Id">@SizeName(item) - @item.Price.ToString("N2") @L["Currency"]</option>
                                    }
                                </select>
                                <button type="button" class="ws-dish-add" data-pick-size="true">
                                    <i class="bi bi-bag-plus" aria-hidden="true"></i> @L["AddToBasket"]
                                </button>
                            }
                            else
                            {
                                <button type="button" class="ws-dish-add" data-cart-add="@first.Id">
                                    <i class="bi bi-bag-plus" aria-hidden="true"></i> @L["AddToBasket"]
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(function () {
            var $pill = $('.ws-tab-pill');

            function movePill(tab) {
                if (!$pill.length || !tab) { return; }
                $pill.css({ '--x': tab[0].offsetLeft + 'px', '--w': tab[0].offsetWidth + 'px' });
            }

            $('.ws-tab').on('click', function () {
                var tab = $(this);
                var section = String(tab.data('section') || '');
                $('.ws-tab').removeClass('is-on').attr('aria-selected', 'false');
                tab.addClass('is-on').attr('aria-selected', 'true');
                movePill(tab);

                var shownIndex = 0;
                $('.ws-dish').each(function () {
                    var dish = $(this);
                    var match = section === '' || String(dish.data('section')) === section;
                    if (match) {
                        dish.css('--i', shownIndex++);
                        if (dish.hasClass('is-filtered-out')) {
                            dish.css('display', '');
                            void dish[0].offsetWidth;
                            dish.removeClass('is-filtered-out');
                        }
                    } else if (!dish.hasClass('is-filtered-out')) {
                        dish.addClass('is-filtered-out');
                        setTimeout(function () {
                            if (dish.hasClass('is-filtered-out')) { dish.css('display', 'none'); }
                        }, 220);
                    }
                });
            });

            movePill($('.ws-tab.is-on'));
            $(window).on('resize', function () { movePill($('.ws-tab.is-on')); });

            $(document).on('click', '[data-pick-size]', function () {
                var id = $(this).siblings('.dish-size').val();
                siteCart.add(id, 1);
                siteCart.notify($('[data-cart]').attr('data-added'));
            });
        });
    </script>
}
