 *@
<h1>تقرير الطلبات بين تاريخين </h1>
<h3>@Model.FromDate.ToString("yyyy-MM-dd")  :   @Model.ToDate.ToString("yyyy-MM-dd")</h3>
<hr />
<p>تاريخ الطباعة : @Model.PrintDate</p>

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>كود الطلب</th>
            <th>نوع الطلب</th>
            <th>تاريخ</th>
            <th>موظف الشيفت البائع</th>
            <th>موظف الشيفت المستلم</th>
            <th>الاجمالي</th>
        </tr>
    </thead>
    <tbody>


        @if (Model.Orders.Count() > 0)
        {
            foreach (var item in Model.Orders)
            {
                <tr>
                    <td> @Html.DisplayFor(modelItem => item.OrderCode) </td>
                    <td>@(item.Type == OrderType.Hall ? "صالة" : item.Type == OrderType.Delivery ? "دليفري" : item.Type == OrderType.Delivery_Online ? "دليفري اونلاين" : "تيك اواي")</td>
                    <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Seller.FullName</td>
                    <td>@item.Receiver.FullName</td>
                    <td>@item.TotalPrice</td>
                </tr>
            }
            <tr>
                <td class="text-danger"><strong>الاجمالي</strong> </td>
                <td colspan="5"><strong>@Model.Total</strong></td>
            </tr>
        }
        else
        {
            <tr><td colspan='7'>لا توجد نتائج للعرض</td></tr>
        }

    </tbody>
</table>






