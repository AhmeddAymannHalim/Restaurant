@model IEnumerable<SuppliersTotalViewModel>
@{
    ViewData["Title"] = "Tayar Orders by dates";
    Layout = null;
}


<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        margin: 0;
        background-color: #fff;
        direction: rtl;
    }


    h1, h2, h3, p {
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse; /* Collapse table borders */
        margin-top: 20px; /* Add margin at the top */
        font-size: 22px;
    }


    .mainRow, th {
        background-color: #f2f2f2; /* Light gray background for dt elements */
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc; /* Add border for styling */
        padding: 8px;
        text-align: center;
    }

</style>

@{
    DateTime? firstDate = null; // Initialize with null to ensure it's assigned later
    DateTime? endDate = null;   // Initialize with null to ensure it's assigned later

    foreach (var item in Model)
    {
        if (firstDate == null || item.Date < firstDate)
        {
            firstDate = item.Date.Date; // Assign the first order date
        }

        if (endDate == null || item.Date > endDate)
        {
            endDate = item.Date.Date; // Assign the last order date
        }
    }
}

<h1>تقرير كشف حساب الموردرين  </h1>
<h3>  بين تاريخين : @firstDate?.ToString("yyyy-MM-dd")  :   @endDate?.ToString("yyyy-MM-dd") </h3>
<hr />

@* <p>تاريخ الطباعة : @item.Date</p> *@

<table class="mt-3 table table-bordered table-light text-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>اسم المورد</th>
            <th>اجمالي المدين</th>
            <th>اجمالي الدائن</th>
            <th>الاجمالي الحالي</th>
            <th>المدين السابق</th>
            <th>الدائن السابق</th>
            <th>الاجمالي السابق</th>
        </tr>
    </thead>
    <tbody>


        @if (Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.TotalDeptor</td>
                    <td>@item.TotalCreditor</td>
                    <td>@item.Total</td>
                    @* <td>@item.Date.ToString("yyyy-MM-dd")</td> *@
                    <td>@item.LastTotalDeptor</td>
                    <td>@item.LastTotalCreditor</td>
                    <td>@item.LastTotal</td>

                </tr>
            }
        }
        else
        {
            <tr><td colspan='7'>لا توجد نتائج للعرض</td></tr>
        }

    </tbody>
</table>






