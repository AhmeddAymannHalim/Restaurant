@model IndexSettingsViewModel

@{
    ViewData["Title"] = "RestaurantSetting";
}

<h1 class="text-center"> اعدادات بيانات المطعم</h1>

<hr />
<div>
    <div>
        <form asp-action="RestaurantSetting" method="post" enctype="multipart/form-data" class="row">
            <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="Id"  hidden />

            <div class="form-group col-md-4">
                <label asp-for="ArName" class="control-label">اسم المطعم (عربي)</label>
                <input asp-for="ArName" class="form-control" />
                <span asp-validation-for="ArName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="EnName" class="control-label">اسم المطعم (English)</label>
                <input asp-for="EnName" class="form-control" />
                <span asp-validation-for="EnName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Description" class="control-label">وصف المطعم</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Phone" class="control-label">رقم الهاتف</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="StartDay" class="control-label">من يوم </label>
                <input asp-for="StartDay" class="form-control" />
                <span asp-validation-for="StartDay" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="EndDay" class="control-label">الي يوم</label>
                <input asp-for="EndDay" class="form-control" />
                <span asp-validation-for="EndDay" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="StartHour" class="control-label">من الساعة</label>
                <input asp-for="StartHour" class="form-control" />
                <span asp-validation-for="StartHour" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="EndHour" class="control-label">الي الساعة</label>
                <input asp-for="EndHour" class="form-control" />
                <span asp-validation-for="EndHour" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Video" class="control-label">الفيديو</label>
                <input type="file" asp-for="Video" class="form-control" />
                <span asp-validation-for="Video" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Image" class="control-label">الصورة</label>
                <input type="file" asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Email" class="control-label">الايميل</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Locaion" class="control-label">الموقع</label>
                <input asp-for="Locaion" class="form-control" />
                <span asp-validation-for="Locaion" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4 mt-4">
                <input type="submit" value="تحديث" class="btn btn-primary" /> |
                <a asp-action="Index">عودة للاعدادات</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
