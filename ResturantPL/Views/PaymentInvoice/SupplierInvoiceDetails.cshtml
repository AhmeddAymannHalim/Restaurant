@model Restaurant.Data.Models.PaymentInvoiceSupplier

@{
    ViewData["Title"] = "SupplierInvoiceDetails";
    Layout = null;
}


<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link href="~/css/invoicesstyle.css" rel="stylesheet" />




<div class="container">


    <h1>سند صرف / @Model.Supplier.Name</h1>
    <hr />


    <dl>

        <dt class="col-sm-3">
            اسم المورد
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Supplier.Name)
        </dd>

        <dt class="col-sm-3">
            كود العملية
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.ProcessCode)
        </dd>
        <dt class="col-sm-3">
            تاريخ الفاتورة
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class="col-sm-3">
            البيان
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-3">
            المدفوع
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Paid)
        </dd>

        <dt class="col-sm-3">
            المتبقي
        </dt>
        <dd class="col-sm-8">
            @Model.Supplier.Balance
        </dd>

       
    </dl>


    <div id="print-button" class="no-print">
        <a class="btn btn-primary" onclick="window.print()"> طباعة</a>
        <a class="btn btn-primary" asp-action="PayForSuppliertReport" asp-controller="Report" asp-route-invoiceId="@Model.Id"> تصدير الي PDF</a>
        <a class="btn btn-info" asp-action="IndexSupplier">عودة لسندات الموردين</a>
    </div>


</div>


