@model Job

@{
    ViewData["Title"] = "AddEmployee";
}


<h1 class="text-center">تعديل الوظيفة</h1>
<hr />


<div class="row">
    <div class="col-md-4">
        <form asp-action="UpdateJob">
            <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name" class="control-label">المسمي الوظيفي</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Code" class="control-label">كود الوظيفة</label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class=" mt-3">
            <input type="submit" value="تعديل" class="btn btn-success" /> |
            <a asp-action="Jobs" >عودة للوظائف</a>
        </div>

    </form>
</div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
