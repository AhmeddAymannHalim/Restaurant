@model RestaurantSettingViewModel
@{
    ViewBag.Title = L["Setting_RestaurantTitle"].Value;
}

<div class="ad-card">
    <div class="ad-card-head">
        <span class="ad-icon"><i class="fas fa-bars-progress" aria-hidden="true"></i></span>
        <h1>@L["Setting_RestaurantTitle"]</h1>
    </div>
    <div class="ad-card-body">
<form asp-action="RestaurantSetting" method="post" enctype="multipart/form-data" class="ad-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="ArName" class="control-label">@L["Setting_NameAr"]</label>
        <input asp-for="ArName" class="form-control" />
        <span asp-validation-for="ArName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EnName" class="control-label">@L["Setting_NameEn"]</label>
        <input asp-for="EnName" class="form-control" />
        <span asp-validation-for="EnName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ArDescription" class="control-label">@L["ArabicDescription"]</label>
        <input asp-for="ArDescription" class="form-control" />
        <span asp-validation-for="ArDescription" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EnDescription" class="control-label">@L["EnglishDescription"]</label>
        <input asp-for="EnDescription" class="form-control" />
        <span asp-validation-for="EnDescription" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone" class="control-label">@L["Phone"]</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StartDay" class="control-label">@L["Setting_FromDay"]</label>
        <select asp-for="StartDay" class="form-select">
            <option value="">@L["Select"]</option>
            @foreach (var day in WeekDays.Names)
            {
                <option value="@day" selected="@(WeekDays.Normalize(Model.StartDay) == day)">@L["Day." + day]</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label asp-for="EndDay" class="control-label">@L["Setting_ToDay"]</label>
        <select asp-for="EndDay" class="form-select">
            <option value="">@L["Select"]</option>
            @foreach (var day in WeekDays.Names)
            {
                <option value="@day" selected="@(WeekDays.Normalize(Model.EndDay) == day)">@L["Day." + day]</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label asp-for="StartHour" class="control-label">@L["Setting_FromHour"]</label>
        <input asp-for="StartHour" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="EndHour" class="control-label">@L["Setting_ToHour"]</label>
        <input asp-for="EndHour" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Video" class="control-label">@L["Setting_Video"]</label>
        <input asp-for="Video" type="file" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Image" class="control-label">@L["Setting_Image"]</label>
        <input asp-for="Image" type="file" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label">@L["Email"]</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ArLocation" class="control-label">@L["ArabicLocation"]</label>
        <input asp-for="ArLocation" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="EnLocation" class="control-label">@L["EnglishLocation"]</label>
        <input asp-for="EnLocation" class="form-control" />
    </div>

    <div class="ad-form-actions">
        <button type="submit" class="btn-ad btn-ad-primary"><i class="fas fa-floppy-disk" aria-hidden="true"></i> @L["Setting_Update"]</button>
        <a asp-action="Index" class="btn-ad btn-ad-ghost">@L["Setting_Back"]</a>
    </div>
</form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
