@{
    ViewData["Title"] = "Search By Dates";
    // Layout = "_Layout1";
}


<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="form-group">
                <label for="startDate">تاريخ البداية:</label>
                <input type="date" id="startDate" name="startDate" value="@ViewBag.DateNow" class="form-control" required />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label for="endDate">تاريخ النهاية:</label>
                <input type="date" id="endDate" name="endDate" value="@ViewBag.DateNow" class="form-control" required />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <button id="show" type="button" class="btn btn-primary mt-4" style="width:100%;">عرض الطلبات</button>
            </div>
        </div>
    </div>
</div>
<hr />


<h1 class="text-center">كل الطلبات</h1>
<hr />

<table id="orderTable" class="mt-3 col-sm-12 table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr style="font-size:20px;">
            <th>كود الطلب</th>
            <th>نوع الطلب</th>
            <th>تاريخ</th>
            <th>موظف الشيفت البائع</th>
            <th>موظف الشيفت المستلم</th>
            <th>الاجمالي</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
<br />

<a id="report" class="btn btn-primary"> تصدير الي PDF</a> |
<a asp-action="Index" asp-controller="Report">عودة للتقارير</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#show").click(function () {
                var startDate = $("#startDate").val();
                var endDate = $("#endDate").val();

                $.ajax({
                    type: "GET",
                    url: "/Report/AllOrdersByDates",
                    data: {
                        startDate: startDate,
                        endDate: endDate
                    },

                    success: function (result) {
                        $("#orderTable tbody").empty();
                        $("#orderTable tbody").append(result);
                        $("#report").attr("href", `/Report/OrdersReport?startDate=${startDate}&endDate=${endDate}`);
                        $("#report").show();
                    },

                    error: function (xhr, status, error) {
                        $("#orderTable tbody").empty();
                        $("#orderTable tbody").append("<tr><td colspan='7'>حدث خطأ أثناء جلب البيانات</td></tr>");
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#startDate, #endDate').change(function () {
                $("#orderTable tbody").empty();
                $("#report").attr("href", `#`);
            });
        });
    </script>
}



