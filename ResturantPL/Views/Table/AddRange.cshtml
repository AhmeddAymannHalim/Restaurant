@{
    ViewData["Title"] = "Add range";
}


<h1 class="text-center">اضافة مجموعة طاولات</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddRange" method="post">

            <div asp-validation-summary="All" class="text-danger"> </div>

            <div class="form-group">
                <label for="tableNumber">عدد الطاولات</label>
                <input name="tableNumber" class="form-control" type="number" required />
            </div>
            <div class="form-group">
                <label for="personNumber">عدد الكراسي للطاولة الواحدة</label>
                <input name="personNumber" class="form-control" type="number" min="1" max="50" required />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="اضافة" class="btn btn-primary" />
            </div>
        </form>

    </div>
</div>
<div>
    <a asp-action="Index">عودة للطاولات</a> |
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}