@model ResturantPL.ViewModels.RoleViewModel

@{
    ViewData["Title"] = "AddRole";
}


<h1 class="text-center">اضافة فئة جديدة</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddRole">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RoleName" class="control-label">اسم الفئة</label>
                <input asp-for="RoleName" class="form-control" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label class="control-label"></label>
                <input type="submit" value="اضافة" class="btn btn-primary" /> |
                <a asp-action="Roles">عودة للفئات</a>
            </div>
        </form>
    </div>
</div>

<div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
