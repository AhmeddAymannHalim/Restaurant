@using System.Globalization
@{
    bool isArabicabic = CultureInfo.CurrentUICulture.ToString().StartsWith("ar");
    var isArabic = isArabicabic;
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/fonts/cairo.css" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-bg"></div>
    <ul class="embers"><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li><li></li></ul>

    <a class="lang-switch" asp-controller="SetLanguage" asp-action="SetLanguage"
       asp-route-culture="@(isArabic ? "en" : "ar")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@(isArabic ? "English" : "العربية")</a>

    <main class="auth-wrap">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        document.querySelectorAll('.toggle-pass').forEach(function (b) {
            b.addEventListener('click', function () {
                var i = b.parentElement.querySelector('input');
                var show = i.type === 'password';
                i.type = show ? 'text' : 'password';
                b.textContent = show ? b.dataset.hide : b.dataset.show;
            });
        });
    </script>
    @await RenderSectionAsync("ValidationScripts", required: false)
</body>
</html>
