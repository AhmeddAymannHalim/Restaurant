@model ForgetPasswordViewModel
@{
    ViewData["Title"] = L["Auth_ForgotTitle"].Value;
    Layout = "~/Views/Shared/_AuthenticationLayout.cshtml";
}

<div class="auth-card">
    <h1 class="auth-title">@L["Auth_ForgotTitle"]</h1>
    <p class="auth-sub">@L["Auth_ForgotSub"]</p>

    <div class="auth-alert" asp-validation-summary="ModelOnly"></div>

    <form asp-action="ForgetPassword" method="post" novalidate>
        <div class="field">
            <input asp-for="Email" type="email" placeholder="@L["Auth_Email"]" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn-auth">@L["Auth_SendLink"]</button>
    </form>

    <hr class="divider" />
    <div class="auth-links"><p><a asp-action="SignIn">@L["Auth_Back"]</a></p></div>
</div>

@section ValidationScripts {
    <partial name="_ValidationScriptsPartial" />
}
