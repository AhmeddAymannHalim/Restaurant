@model IEnumerable<Restaurant.Data.Models.ExitExpense>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">المصروفات</h1>

<p>
    <a asp-action="Create">دفع مصروف جديد</a>
</p>
<table class="table table-hover text-center table-bordered table-striped-columns table-dark">
    <thead>
        <tr>
            <th>
               المصروف
            </th>
            <th>
              السعر
            </th>
            <th>
              التاريخ
            </th>
            <th>
               اسم المستخدم
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
          
            <td>
                @Html.DisplayFor(modelItem => item.Expense.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.FullName)
            </td>
            <td>
                @Html.ActionLink("تعديل", "Edit", new { id=item.Id}) |
                @Html.ActionLink("التفاصيل", "Details", new { id=item.Id }) |
                    <a onclick="Delete(@item.Id)" class="text-danger" style="font-weight:bold; cursor:pointer;">حذف</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-action="AdminDash" asp-controller="Account">عودة للوحة التحكم</a>
</div>



<script src="~/lib/sweetalert/sweetalert.min.js"></script>
@if (TempData["success"] != null)
{
    <script>
        swal("برافو عمل جيد !", "", "success");

    </script>
}
@if (TempData["faild"] != null)
{
    <script>
        swal("فشلت العملية !", "", "error");

    </script>

}
@section Scripts {

    <script src="~/modules/ExitExpense.js"></script>
}