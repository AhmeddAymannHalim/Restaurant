@model GalleryViewModel
@{
    var isNew = Model.Id == 0;
    ViewBag.Title = isNew ? L["NewPhoto"].Value : L["UpdatePhoto"].Value;
}

<h1 class="text-center">@ViewBag.Title</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Upsert" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ImageFile" class="control-label">@L["Image"]</label>
                <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
                @if (!string.IsNullOrEmpty(Model.PictureUrl))
                {
                    <img src="@Model.PictureUrl" alt="" class="mt-2" style="width:100%;max-height:220px;object-fit:cover;border-radius:12px" />
                }
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="@L["Save"]" class="btn btn-primary" /> |
                <a asp-action="Index">@L["Back"]</a>
                @if (!isNew)
                {
                    <text> | </text>
                    <a onclick="Delete('/Gallery/Delete/@Model.Id', '@Url.Action("Index")')" class="text-danger" style="font-weight:bold; cursor:pointer;">@L["Delete"]</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/modules/deleteobjects.js"></script>
}
